<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="utf-8">
   <title>Attendance Summary - Teacher Portal</title>
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
   <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

   <style>
      .summary-card {
         transition: all 0.3s ease;
         border-radius: 15px;
      }

      .stat-card {
         background: #3b5de7;
         color: white;
         border-radius: 12px;
         padding: 1rem;
         text-align: center;
      }

      .stat-number {
         font-size: 2rem;
         font-weight: bold;
      }

      .attendance-circle {
         width: 100px;
         height: 100px;
         border-radius: 50%;
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 1.5rem;
         font-weight: bold;
         margin: 0 auto;
      }

      .attendance-excellent {
         background: #10b981;
         color: white;
      }

      .attendance-good {
         background: #34d399;
         color: white;
      }

      .attendance-average {
         background: #fbbf24;
         color: #1e293b;
      }

      .attendance-poor {
         background: #ef4444;
         color: white;
      }

      .progress {
         height: 8px;
         border-radius: 4px;
      }

      .notification-unread {
         background-color: #e8f0fe;
         border-left: 3px solid #3b5de7;
      }

      .rank-1 {
         background: #fbbf24;
         color: #1e293b;
      }

      .rank-2 {
         background: #d1d5db;
         color: #1e293b;
      }

      .rank-3 {
         background: #fcd34d;
         color: #1e293b;
      }
   </style>
</head>

<body class="loading"
   data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
   <!-- Begin page -->
   <div class="wrapper">
      <!-- Left Sidebar -->
      <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/teacher-sidebar') %>
        <!-- Left Sidebar End -->

        

      <div class="content-page">
         <div class="content">
            <!-- Topbar -->
                <%- include('partials/teacher-navbar') %>
                <!-- end Topbar -->

            <div class="container-fluid">
               <div class="row">
                  <div class="col-12">
                     <div class="page-title-box">
                        <h4 class="page-title">
                           <i class="mdi mdi-chart-pie me-2"></i>Attendance Summary
                        </h4>
                     </div>
                  </div>
               </div>

               <!-- Error Message -->
               <% if (error) { %>
                  <div class="alert alert-danger">
                     <%= error %>
                  </div>
                  <% } %>

                     <!-- Filter Form -->
                     <div class="card mb-4">
                        <div class="card-body">
                           <form method="GET" action="/teacher/attendance-summary" class="row g-3">
                              <div class="col-md-3">
                                 <label class="form-label">Academic Year</label>
                                 <select name="academicYear" class="form-select" required>
                                    <option value="">Select Year</option>
                                    <% academicYears.forEach(function(year) { %>
                                       <option value="<%= year.year_name %>" <%=selectedAcademicYear===year.year_name
                                          ? 'selected' : '' %>>
                                          <%= year.year_name %>
                                       </option>
                                       <% }); %>
                                 </select>
                              </div>
                              <div class="col-md-3">
                                 <label class="form-label">Term</label>
                                 <select name="term" class="form-select" required>
                                    <option value="">Select Term</option>
                                    <% terms.forEach(function(t) { %>
                                       <option value="<%= t.term_name %>" <%=selectedTerm===t.term_name ? 'selected'
                                          : '' %>>
                                          <%= t.term_name %>
                                       </option>
                                       <% }); %>
                                 </select>
                              </div>
                              <div class="col-md-3">
                                 <label class="form-label">Class (Optional)</label>
                                 <select name="classId" class="form-select">
                                    <option value="">All Classes</option>
                                    <% teacherClasses.forEach(function(cls) { %>
                                       <option value="<%= cls.id %>" <%=selectedClassId==cls.id ? 'selected' : '' %>>
                                          <%= cls.className %>
                                             <%= cls.department ? '(' + cls.department + ')' : '' %>
                                       </option>
                                       <% }); %>
                                 </select>
                              </div>
                              <div class="col-md-3 d-flex align-items-end">
                                 <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search me-1"></i> View Summary
                                 </button>
                              </div>
                           </form>
                        </div>
                     </div>

                     <% if (selectedAcademicYear && selectedTerm) { %>
                        <% if (selectedClassId && classAttendanceSummary.length> 0) {
                           var classData = classAttendanceSummary[0]; %>
                           <!-- Class Header -->
                           <div class="card mb-4">
                              <div class="card-body">
                                 <div class="row">
                                    <div class="col-md-6">
                                       <h5>
                                          <%= classData.classInfo.className %>
                                       </h5>
                                       <p class="text-muted mb-0">
                                          <%= classData.classInfo.level || '' %>
                                             <%= classData.classInfo.department || '' %>
                                       </p>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                       <p class="mb-0">
                                          <strong>Term:</strong>
                                          <%= selectedTerm %><br>
                                             <strong>Academic Year:</strong>
                                             <%= selectedAcademicYear %>
                                       </p>
                                    </div>
                                 </div>
                              </div>
                           </div>

                           <!-- Summary Stats -->
                           <div class="row mb-4">
                              <div class="col-md-3">
                                 <div class="stat-card">
                                    <div class="stat-number">
                                       <%= classData.summary.totalStudents %>
                                    </div>
                                    <div>Total Students</div>
                                 </div>
                              </div>
                              <div class="col-md-3">
                                 <div class="stat-card" style="background: #10b981;">
                                    <div class="stat-number">
                                       <%= classData.summary.totalDays %>
                                    </div>
                                    <div>School Days</div>
                                 </div>
                              </div>
                              <div class="col-md-3">
                                 <div class="stat-card" style="background: #f59e0b;">
                                    <div class="stat-number">
                                       <%= classData.summary.overallPercentage %>%
                                    </div>
                                    <div>Overall Attendance</div>
                                 </div>
                              </div>
                              <div class="col-md-3">
                                 <div
                                    class="attendance-circle attendance-<%= classData.summary.overallPercentage >= 80 ? 'excellent' : classData.summary.overallPercentage >= 60 ? 'good' : classData.summary.overallPercentage >= 40 ? 'average' : 'poor' %>">
                                    <%= classData.summary.overallPercentage %>%
                                 </div>
                              </div>
                           </div>

                           <!-- Student Attendance Table -->
                           <div class="card">
                              <div class="card-header bg-white">
                                 <h6 class="mb-0">Student Attendance Details</h6>
                              </div>
                              <div class="card-body p-0">
                                 <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                       <thead class="table-light">
                                          <tr>
                                             <th>#</th>
                                             <th>Admission No.</th>
                                             <th>Student Name</th>
                                             <th>Present</th>
                                             <th>Absent</th>
                                             <th>Late</th>
                                             <th>Excused</th>
                                             <th>Attendance %</th>
                                             <th>Status</th>
                                          </tr>
                                       </thead>
                                       <tbody>
                                          <% for(var i=0; i < classData.students.length; i++) { var
                                             student=classData.students[i]; %>
                                             <tr>
                                                <td>
                                                   <%= i + 1 %>
                                                </td>
                                                <td>
                                                   <%= student.admissionNumber || 'N/A' %>
                                                </td>
                                                <td>
                                                   <%= student.fullName %>
                                                </td>
                                                <td class="text-center">
                                                   <%= student.present %>
                                                </td>
                                                <td class="text-center">
                                                   <%= student.absent %>
                                                </td>
                                                <td class="text-center">
                                                   <%= student.late %>
                                                </td>
                                                <td class="text-center">
                                                   <%= student.excused %>
                                                </td>
                                                <td class="text-center">
                                                   <strong>
                                                      <%= student.percentage %>%
                                                   </strong>
                                                   <div class="progress mt-1">
                                                      <div class="progress-bar bg-success"
                                                         style="width: <%= student.percentage %>%"></div>
                                                   </div>
                                                </td>
                                                <td class="text-center">
                                                   <span
                                                      class="badge <%= student.percentage >= 80 ? 'bg-success' : student.percentage >= 60 ? 'bg-info' : student.percentage >= 40 ? 'bg-warning' : 'bg-danger' %>">
                                                      <%= student.percentage>= 80 ? 'Excellent' : student.percentage >=
                                                         60 ? 'Good' : student.percentage >= 40 ? 'Average' : 'Poor' %>
                                                   </span>
                                                </td>
                                             </tr>
                                             <% } %>
                                       </tbody>
                                    </table>
                                 </div>
                              </div>
                           </div>
                           <% } else if (!selectedClassId && classAttendanceSummary.length> 0) { %>
                              <!-- All Classes Summary -->
                              <div class="row">
                                 <% for(var i=0; i < classAttendanceSummary.length; i++) { var
                                    cls=classAttendanceSummary[i]; %>
                                    <div class="col-md-6 col-xl-4 mb-4">
                                       <div class="card summary-card h-100">
                                          <div class="card-body">
                                             <h5 class="card-title">
                                                <%= cls.className %>
                                             </h5>
                                             <p class="text-muted small">
                                                <%= cls.level || '' %>
                                                   <%= cls.department || '' %>
                                             </p>
                                             <div class="text-center my-3">
                                                <div
                                                   class="attendance-circle attendance-<%= cls.percentage >= 80 ? 'excellent' : cls.percentage >= 60 ? 'good' : cls.percentage >= 40 ? 'average' : 'poor' %>"
                                                   style="width: 80px; height: 80px; font-size: 1.2rem;">
                                                   <%= cls.percentage %>%
                                                </div>
                                             </div>
                                             <div class="row text-center">
                                                <div class="col-6">
                                                   <div class="fw-bold">
                                                      <%= cls.totalStudents %>
                                                   </div>
                                                   <small class="text-muted">Students</small>
                                                </div>
                                                <div class="col-6">
                                                   <div class="fw-bold">
                                                      <%= cls.totalDays %>
                                                   </div>
                                                   <small class="text-muted">Days</small>
                                                </div>
                                             </div>
                                             <div class="mt-3">
                                                <div class="d-flex justify-content-between small mb-1">
                                                   <span>Attendance Rate</span>
                                                   <span>
                                                      <%= cls.percentage %>%
                                                   </span>
                                                </div>
                                                <div class="progress">
                                                   <div class="progress-bar bg-success"
                                                      style="width: <%= cls.percentage %>%"></div>
                                                </div>
                                             </div>
                                             <div class="d-grid mt-3">
                                                <a href="/teacher/attendance-summary?classId=<%= cls.classId %>&academicYear=<%= selectedAcademicYear %>&term=<%= selectedTerm %>"
                                                   class="btn btn-outline-primary btn-sm">
                                                   View Details <i class="bi bi-arrow-right"></i>
                                                </a>
                                             </div>
                                          </div>
                                       </div>
                                    </div>
                                    <% } %>
                              </div>
                              <% } else { %>
                                 <div class="alert alert-info text-center">
                                    <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
                                    <h5>Select a class to view attendance summary</h5>
                                    <p>Choose an academic year, term, and class to see detailed attendance records</p>
                                 </div>
                                 <% } %>
                                    <% } else { %>
                                       <div class="alert alert-info text-center">
                                          <i class="bi bi-calendar fs-1 d-block mb-3"></i>
                                          <h5>Select Academic Year and Term</h5>
                                          <p>Please select an academic year and term to view attendance summary</p>
                                       </div>
                                       <% } %>
            </div>
         </div>

         <footer class="footer">
            <div class="container-fluid">
               <div class="row">
                  <div class="col-md-6">
                     <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Teacher Portal
                  </div>
                  <div class="col-md-6 text-md-end">
                     <a href="#" class="text-muted">Support</a>
                     <span class="text-muted mx-1">|</span>
                     <a href="#" class="text-muted">Privacy</a>
                  </div>
               </div>
            </div>
         </footer>
      </div>
   </div>

   <script src="/assets/js/vendor.min.js"></script>
   <script src="/assets/js/app.min.js"></script>
   <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

   <script>
      // Auto-dismiss alerts
      setTimeout(function () {
         $('.alert').fadeOut('slow');
      }, 5000);
   </script>
</body>

</html>