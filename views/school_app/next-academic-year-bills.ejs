<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Next Academic Year Bills - <%= student.firstName %> <%= student.lastName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            .container { max-width: 100% !important; }
            body { font-size: 12px; }
            .progress-container { display: none; }
        }
        
        /* Import styling from bills page */
        .progress-container {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .academic-progress {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .progress-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 20px 0;
        }
        .progress-step {
            text-align: center;
            position: relative;
            z-index: 2;
        }
        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-weight: bold;
            border: 3px solid #fff;
        }
        .step-active .step-number {
            background: #0d6efd;
            color: white;
        }
        .step-completed .step-number {
            background: #198754;
            color: white;
        }
        .progress-bar-line {
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            height: 3px;
            background: #e9ecef;
            z-index: 1;
        }
        .book-list-card {
            border-left: 4px solid #0dcaf0;
        }
        .payment-info-card {
            border-left: 4px solid #198754;
        }
        .fee-structure-card {
            border-left: 4px solid #6f42c1;
        }
        .status-badge {
            font-size: 0.85em;
            padding: 0.4em 0.8em;
        }
        .card-header {
            background-color: rgba(0, 0, 0, 0.03);
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        }
        .page-title-box {
            padding: 10px 0;
            margin-bottom: 20px;
        }
        .next-year-highlight {
            background-color: #e7f5ff;
            border-left: 4px solid #0d6efd;
            padding: 15px;
            margin: 20px 0;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <a href="/student-profile/<%= student.id %>" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Profile
                        </a>
                        <a href="/session-report-card/<%= student.id %>" class="btn btn-info ms-2">
                            <i class="bi bi-file-text"></i> View Report Card
                        </a>
                    </div>
                    <h4 class="page-title">
                        <i class="bi bi-receipt"></i> Next Academic Year Bills - <%= student.firstName %> <%= student.lastName %>
                    </h4>
                </div>
            </div>
        </div>

        <!-- Academic Progress Visualization -->
        <div class="row">
            <div class="col-12">
                <div class="progress-container">
                    <div class="academic-progress">
                        <div>
                            <h5 class="mb-1">Academic Progress</h5>
                            <p class="text-muted mb-0">Current: <%= currentTerm %> <%= currentAcademicYear %></p>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-1">Next: First Term <%= nextAcademicYear %></h5>
                            <span class="badge bg-info">
                                Next Academic Year - First Term Fees
                            </span>
                        </div>
                    </div>
                    
                    <div class="progress-steps">
                        <div class="progress-bar-line"></div>
                        <div class="progress-step <%= currentTerm === 'First Term' ? 'step-active' : 'step-completed' %>">
                            <div class="step-number">1</div>
                            <small>First Term<br><%= currentAcademicYear %></small>
                        </div>
                        <div class="progress-step <%= currentTerm === 'Second Term' ? 'step-active' : (currentTerm === 'Third Term' ? 'step-completed' : '') %>">
                            <div class="step-number">2</div>
                            <small>Second Term<br><%= currentAcademicYear %></small>
                        </div>
                        <div class="progress-step <%= currentTerm === 'Third Term' ? 'step-active' : '' %>">
                            <div class="step-number">3</div>
                            <small>Third Term<br><%= currentAcademicYear %></small>
                        </div>
                        <div class="progress-step step-active">
                            <div class="step-number">4</div>
                            <small>First Term<br><%= nextAcademicYear %></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Student Information Card -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-badge"></i> Student Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-grow-1">
                                <h6 class="mb-1"><%= student.firstName %> <%= student.middleName || '' %> <%= student.lastName %></h6>
                                <p class="text-muted mb-0">Admission: <%= student.admission_number %></p>
                            </div>
                        </div>
                        
                        <div class="student-details">
                            <div class="mb-2">
                                <small class="text-muted">Class:</small>
                                <p class="mb-0"><%= student.className %></p>
                            </div>
                            <% if (student.department) { %>
                            <div class="mb-2">
                                <small class="text-muted">Department:</small>
                                <p class="mb-0"><%= student.department %></p>
                            </div>
                            <% } %>
                            <div class="mb-2">
                                <small class="text-muted">Level:</small>
                                <p class="mb-0"><%= student.level %></p>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Next Academic Year:</small>
                                <p class="mb-0">
                                    <span class="badge bg-info"><%= nextAcademicYear %></span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions Card -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-lightning"></i> Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button onclick="generateNextAcademicYearBills()" class="btn btn-success">
                                <i class="bi bi-journal-plus"></i> Generate Bills & Book List
                            </button>
                            <a href="/student-fee-history/<%= student.id %>" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-clock-history"></i> Payment History
                            </a>
                            <a href="/fees-collection?studentId=<%= student.id %>" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-cash"></i> Make Payment
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Next Academic Year Info Card -->
                <div class="card mt-3 next-year-highlight">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-info-circle"></i> Next Academic Year Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Resumption Date:</strong> September 15, <%= nextAcademicYear.split('-')[0] %></p>
                        <p><strong>Early Payment Discount:</strong> 5% discount before August 31</p>
                        <p><strong>Payment Deadline:</strong> September 30, <%= nextAcademicYear.split('-')[0] %></p>
                        
                        <div class="alert alert-warning mt-3">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Important:</strong> Late payments may attract a penalty fee of 2% per month.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-md-8">
                <!-- Bill Summary Card -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-wallet2"></i> Bill Summary - First Term <%= nextAcademicYear %>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="border-start border-4 border-primary ps-3 mb-3">
                                    <small class="text-muted">Total Amount Due</small>
                                    <h3 class="text-primary">₦<%= totalAmount.toLocaleString() %></h3>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border-start border-4 border-success ps-3 mb-3">
                                    <small class="text-muted">Bill Status</small>
                                    <div>
                                        <% if (existingBills.length > 0) { %>
                                            <span class="badge bg-success status-badge">Bills Generated</span>
                                            <small class="text-muted d-block"><%= existingBills.length %> fee items</small>
                                        <% } else { %>
                                            <span class="badge bg-warning status-badge">Pending Generation</span>
                                            <small class="text-muted d-block">Ready to generate</small>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <% if (existingBills.length > 0) { %>
                        <div class="alert alert-success">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>
                                    <strong>Bills Generated Successfully</strong>
                                    <p class="mb-0">All fee items for First Term <%= nextAcademicYear %> have been created.</p>
                                </div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="alert alert-warning">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>
                                    <strong>Bills Not Generated</strong>
                                    <p class="mb-0">No bills have been generated for First Term <%= nextAcademicYear %> yet.</p>
                                </div>
                            </div>
                            <div class="mt-2">
                                <button class="btn btn-primary" onclick="generateNextAcademicYearBills()">
                                    <i class="bi bi-receipt"></i> Generate First Term Bills
                                </button>
                                <small class="text-muted d-block mt-1">
                                    This will create all fee items based on the class fee structure.
                                </small>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Fee Structure Card -->
                <div class="card mt-3 fee-structure-card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-list-check"></i> Fee Structure Details - First Term <%= nextAcademicYear %>
                        </h5>
                    </div>
                    <div class="card-body">
                        <% if (classBills.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Fee Type</th>
                                        <th class="text-end">Amount (₦)</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% classBills.forEach(bill => { 
                                        const existingBill = existingBills.find(eb => eb.feeType === bill.fee_type);
                                    %>
                                    <tr>
                                        <td>
                                            <strong><%= bill.fee_type %></strong>
                                            <% if (bill.description) { %>
                                                <br><small class="text-muted"><%= bill.description %></small>
                                            <% } %>
                                        </td>
                                        <td class="text-end">₦<%= parseFloat(bill.amount).toLocaleString() %></td>
                                        <td>
                                            <% if (bill.due_date) { %>
                                                <%= moment(bill.due_date).format('DD MMM, YYYY') %>
                                            <% } else { %>
                                                <span class="text-muted">N/A</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (existingBill) { %>
                                                <span class="badge bg-success status-badge">Created</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary status-badge">Pending</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                                <tfoot>
                                    <tr class="table-primary">
                                        <th>Total</th>
                                        <th class="text-end">₦<%= totalAmount.toLocaleString() %></th>
                                        <th colspan="2"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <% } else { %>
                        <div class="text-center py-4">
                            <i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No fee structure defined for First Term <%= nextAcademicYear %></p>
                            <small class="text-muted">Please contact the administration to set up the fee structure.</small>
                            
                            <% if (canCopyFromCurrentYear) { %>
                            <div class="mt-4">
                                <h6>Copy from Current Academic Year</h6>
                                <p class="text-muted">You can copy the fee structure from <%= currentAcademicYear %> to <%= nextAcademicYear %></p>
                                <button class="btn btn-outline-primary" onclick="copyClassBills()">
                                    <i class="bi bi-files"></i> Copy Fee Structure
                                </button>
                            </div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Book List Card -->
                <% if (bookList.length > 0) { %>
                <div class="card mt-3 book-list-card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-book"></i> Required Books for <%= nextAcademicYear %>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Book Title</th>
                                        <th>Author</th>
                                        <th>Publisher</th>
                                        <th>ISBN</th>
                                        <th class="text-end">Price (₦)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% bookList.forEach(book => { %>
                                    <tr>
                                        <td><strong><%= book.subject %></strong></td>
                                        <td><%= book.title %></td>
                                        <td><%= book.author || 'N/A' %></td>
                                        <td><%= book.publisher || 'N/A' %></td>
                                        <td><small class="text-muted"><%= book.isbn || 'N/A' %></small></td>
                                        <td class="text-end"><%= book.price ? '₦' + parseFloat(book.price).toLocaleString() : 'N/A' %></td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Note:</strong> Books should be purchased before resumption. Some books may be available at the school bookstore.
                        </div>
                    </div>
                </div>
                <% } else { %>
                <div class="card mt-3 book-list-card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-book"></i> Book List Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center py-4">
                            <i class="bi bi-book text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-2">No book list available for <%= nextAcademicYear %> yet</p>
                            <small class="text-muted">The book list will be available closer to the start of the academic year.</small>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
    function generateNextAcademicYearBills() {
        if (confirm('Generate First Term ' + '<%= nextAcademicYear %>' + ' bills for ' + '<%= student.firstName %> <%= student.lastName %>' + '?')) {
            // Show loading state
            const btn = document.querySelector('button[onclick="generateNextAcademicYearBills()"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-arrow-repeat spinner"></i> Generating...';
            btn.disabled = true;
            
            fetch('/generate-next-academic-year-bills', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    studentId: '<%= student.id %>'
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Show success message
                    alert('✅ ' + data.message);
                    // Reload page after a short delay
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else if (data.error === 'no_bills_found') {
                    // Ask if user wants to copy from current year
                    if (confirm(data.message)) {
                        copyClassBills();
                    } else {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                } else {
                    alert('❌ Error: ' + data.error);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('❌ Failed to generate bills. Please try again.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    }

    function copyClassBills() {
        if (confirm('Copy fee structure from <%= currentAcademicYear %> to <%= nextAcademicYear %>?')) {
            // Show loading state
            const btn = document.querySelector('button[onclick="copyClassBills()"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-arrow-repeat spinner"></i> Copying...';
            btn.disabled = true;
            
            fetch('/copy-class-bills-to-next-year', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    classId: '<%= student.classId %>',
                    className: '<%= student.className %>',
                    level: '<%= student.level %>',
                    department: '<%= student.department %>',
                    currentAcademicYear: '<%= currentAcademicYear %>',
                    nextAcademicYear: '<%= nextAcademicYear %>'
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✅ ' + data.message);
                    // Reload page after a short delay
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alert('❌ Error: ' + data.error);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('❌ Failed to copy fee structure. Please try again.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        }
    }

    // Add spinner animation
    document.addEventListener('DOMContentLoaded', function() {
        const style = document.createElement('style');
        style.textContent = `
            @keyframes spin {
                0% { transform: rotate(0deg); }
                100% { transform: rotate(360deg); }
            }
            .spinner {
                animation: spin 1s linear infinite;
            }
        `;
        document.head.appendChild(style);
    });
    </script>
</body>
</html>