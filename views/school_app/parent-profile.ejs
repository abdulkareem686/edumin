<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Parent Profile - School Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- App css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link href="/assets/css/school-dashboard.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .profile-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 2rem;
            color: white;
            margin-bottom: 2rem;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .profile-avatar i {
            font-size: 4rem;
            color: #667eea;
        }

        .info-card {
            border-radius: 12px;
            transition: transform 0.3s, box-shadow 0.3s;
            margin-bottom: 1.5rem;
        }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .info-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .info-value {
            font-size: 1rem;
            font-weight: 500;
            color: #2c3e50;
            word-break: break-word;
        }

        .child-card {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            border-radius: 12px;
        }

        .child-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .quick-stat {
            text-align: center;
            padding: 1rem;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.15);
        }

        .quick-stat .number {
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
        }

        .quick-stat .text-muted {
            color: rgba(255, 255, 255, 0.8) !important;
        }

        .info-warning {
            background: #fff3cd;
            color: #856404;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 0.8rem;
            text-align: center;
        }
    </style>
</head>

<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/parent-sidebar') %>
        <!-- Left Sidebar End -->

        
        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->
                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-account-circle me-2"></i>Parent Profile
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Success/Error Messages -->
                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="mdi mdi-check-circle me-2"></i>
                            <%= success %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <% } %>
                            <% if (error) { %>
                                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                    <i class="mdi mdi-alert-circle me-2"></i>
                                    <%= error %>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                                <% } %>

                                    <!-- Profile Header -->
                                    <div class="profile-header">
                                        <div class="row align-items-center">
                                            <div class="col-md-3 text-center">
                                                <div class="profile-avatar">
                                                    <i class="mdi mdi-account-circle"></i>
                                                </div>
                                                <h4 class="text-white mb-1">
                                                    <%= parent.first_name %>
                                                        <%= parent.last_name %>
                                                </h4>
                                                <span class="badge bg-light text-dark"><i
                                                        class="mdi mdi-account-heart"></i> Parent Account</span>
                                            </div>
                                            <div class="col-md-9">
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="quick-stat">
                                                            <div class="number">
                                                                <%= childrenCount || 0 %>
                                                            </div>
                                                            <div class="text-muted small">Children Enrolled</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="quick-stat">
                                                            <div class="number">
                                                                <%= activeStudents || 0 %>
                                                            </div>
                                                            <div class="text-muted small">Active Students</div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="quick-stat">
                                                            <div class="number">₦<%= pendingFees ?
                                                                    pendingFees.toLocaleString() : 0 %>
                                                            </div>
                                                            <div class="text-muted small">Pending Fees</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Profile Content -->
                                    <div class="row">
                                        <!-- Personal Information -->
                                        <div class="col-lg-6">
                                            <div class="card info-card">
                                                <div class="card-body">
                                                    <h5 class="card-title mb-4">
                                                        <i class="mdi mdi-account-details text-primary me-2"></i>
                                                        Personal Information
                                                    </h5>
                                                    <div class="row mb-3">
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Full Name</div>
                                                            <div class="info-value">
                                                                <%= parent.first_name %>
                                                                    <%= parent.last_name %>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Email Address</div>
                                                            <div class="info-value">
                                                                <%= parent.email %>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Phone Number</div>
                                                            <div class="info-value">
                                                                <%= parent.phone || 'Not provided' %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row mb-3">
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Relationship to Student</div>
                                                            <div class="info-value">
                                                                <%= parent.relationship || 'Parent' %>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Occupation</div>
                                                            <div class="info-value">
                                                                <%= parent.occupation || 'Not provided' %>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-4">
                                                            <div class="info-label">Emergency Contact</div>
                                                            <div class="info-value">
                                                                <%= parent.emergency_contact || 'Not provided' %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <div class="info-label">Address</div>
                                                            <div class="info-value">
                                                                <%= parent.address || 'Not provided' %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Account Information -->
                                        <div class="col-lg-6">
                                            <div class="card info-card">
                                                <div class="card-body">
                                                    <h5 class="card-title mb-4">
                                                        <i class="mdi mdi-shield-account text-primary me-2"></i>
                                                        Account Information
                                                    </h5>
                                                    <div class="row mb-3">
                                                        <div class="col-sm-6">
                                                            <div class="info-label">Account Status</div>
                                                            <div class="info-value">
                                                                <span class="badge bg-success">Active</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <div class="info-label">Account Created</div>
                                                            <div class="info-value">
                                                                <%= moment(parent.created_at).format('MMMM D, YYYY') %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <div class="info-label">Last Login</div>
                                                            <div class="info-value">
                                                                <%= moment(parent.last_login).fromNow() %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                    <div class="info-warning">
                                                        <i class="mdi mdi-information-outline me-1"></i>
                                                        For any profile updates or password changes, please contact the
                                                        school administrator.
                                                    </div>
                                                    <div class="text-center mt-3">
                                                        <a href="/parent/contact" class="btn btn-primary btn-sm">
                                                            <i class="mdi mdi-email me-1"></i> Contact Administrator
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Linked Children Section -->
                                    <div class="card mt-3">
                                        <div class="card-header bg-white">
                                            <h5 class="mb-0">
                                                <i class="mdi mdi-account-group me-2 text-primary"></i>
                                                Linked Children
                                                <span class="badge bg-primary ms-2">
                                                    <%= children ? children.length : 0 %> Students
                                                </span>
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <% if (children && children.length> 0) {
                                                    for(var i = 0; i < children.length; i++) { var child=children[i]; %>
                                                        <div class="col-md-4 col-lg-3 mb-3">
                                                            <div class="card child-card"
                                                                onclick="viewChild(<%= child.id %>)">
                                                                <div class="card-body text-center">
                                                                    <div class="avatar-lg mx-auto mb-3">
                                                                        <div
                                                                            class="avatar-title bg-primary-light rounded-circle text-primary fs-1">
                                                                            <i class="mdi mdi-account-circle"></i>
                                                                        </div>
                                                                    </div>
                                                                    <h6 class="mb-1">
                                                                        <%= child.firstName %>
                                                                            <%= child.lastName %>
                                                                    </h6>
                                                                    <p class="text-muted mb-2">
                                                                        <small><i class="mdi mdi-school"></i>
                                                                            <%= child.className || 'Not Assigned' %>
                                                                        </small>
                                                                    </p>
                                                                    <p class="text-muted mb-0">
                                                                        <small><i
                                                                                class="mdi mdi-card-account-details"></i>
                                                                            <%= child.admission_number %>
                                                                        </small>
                                                                    </p>
                                                                    <span class="badge bg-info mt-2">
                                                                        <i class="mdi mdi-account-check"></i> Linked
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% } } else { %>
                                                            <div class="col-12">
                                                                <div class="alert alert-warning text-center mb-0">
                                                                    <i class="mdi mdi-alert-circle me-2"></i>
                                                                    No children linked to your account. Please contact
                                                                    the school administrator.
                                                                </div>
                                                            </div>
                                                            <% } %>
                                            </div>
                                        </div>
                                    </div>
                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduAdmin - School
                            Management System
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end footer-links d-none d-md-block">
                                <a href="javascript: void(0);"><i class="mdi mdi-help-circle"></i> Help</a>
                                <a href="javascript: void(0);"><i class="mdi mdi-email"></i> Support</a>
                                <a href="javascript: void(0);"><i class="mdi mdi-information"></i> About</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        function viewChild(childId) {
            window.location.href = '/student-profile/' + childId;
        }

        function markNotificationRead(notificationId) {
            fetch('/api/parent-notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function (response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function (error) {
                console.error('Error:', error);
            });
        }

        function markAllNotificationsRead() {
            fetch('/api/parent-notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function (response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function (error) {
                console.error('Error:', error);
            });
        }

        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function (alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>

</html>
