        <script>
// Auto-fill student details when selected
document.getElementById('studentSelect').addEventListener('change', function() {
    const selectedOption = this.options[this.selectedIndex];
    document.getElementById('firstName').value = selectedOption.dataset.firstname || '';
    document.getElementById('lastName').value = selectedOption.dataset.lastname || '';
    document.getElementById('rollNo').value = selectedOption.dataset.rollno || 'N/A';
    document.getElementById('studentClass').value = selectedOption.dataset.class || 'N/A';
