                        <div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Basic Info</h5>
                <form action="/add-fees" method="post" class="needs-validation" novalidate>
    
    <div class="row">
        <div class="col-xl-6">
            <div class="mb-3">
                <label class="form-label">Student*</label>
                <select class="form-select" name="studentId" id="studentSelect" required>
                    <option value="">-- Select Student --</option>
                    <% students.forEach(student => { %>
                        <option value="<%= student.id %>" 
                            data-firstname="<%= student.firstName %>"
                            data-middlename="<%= student.middleName %>"
                            data-lastname="<%= student.lastName %>"
                            data-class="<%= student.className || 'N/A' %>"
                            data-department="<%= student.classDepartment || '' %>"
                            data-classid="<%= student.classId || '' %>"
                            data-email="<%= student.email || '' %>">
                            <%= student.firstName %> <%= student.middleName %> <%= student.lastName %>
                            - <%= student.className || 'Not assigned' %>
                            <% if (student.classDepartment) { %> 
                                (<%= student.classDepartment %>) 
                            <% } %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select a student</div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" id="firstName" readonly>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Middle Name</label>
                    <input type="text" class="form-control" id="middleName" readonly>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="lastName" readonly>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Class</label>
                    <input type="text" class="form-control" id="studentClass" readonly>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Department</label>
                    <input type="text" class="form-control" id="studentDepartment" readonly>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" id="studentEmail" readonly>
            </div>

            <!-- Class Bill Template Section -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">Class Bill Templates</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Select Fee Type from Bill</label>
                        <select class="form-select" id="billFeeType">
                            <option value="">-- Select Fee Type --</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Bill Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₦</span>
                            <input type="text" class="form-control" id="billAmountDisplay" readonly>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-primary" onclick="applyBillTemplate()">
                            <i class="fas fa-check me-1"></i> Apply Bill Template
                        </button>
                    </div>
                    <small class="text-muted d-block mt-2">Select a fee type to load the standardized amount from class bill</small>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="mb-3">
                <label class="form-label">Fee Type*</label>
                <select class="form-select" name="feeType" id="feeType" required>
                    <option value="">-- Select Fee Type --</option>
                    <% feeTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= (formData.feeType === type) ? 'selected' : '' %>>
                            <%= type %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select a fee type</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Type*</label>
                <select class="form-select" name="paymentType" required>
                    <option value="">-- Select Payment Type --</option>
                    <% paymentTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= (formData.paymentType === type) ? 'selected' : '' %>>
                            <%= type %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select a payment type</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Amount (₦)*</label>
                <div class="input-group">
                    <span class="input-group-text">₦</span>
                    <input type="number" class="form-control" name="amount" id="amountInput"
                        value="<%= formData.amount || '' %>" step="0.01" min="0" required
                        placeholder="0.00">
                </div>
                <div class="invalid-feedback">Please enter a valid amount</div>
                <div id="amountStatus" class="form-text"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Date*</label>
                <input type="date" class="form-control" name="paymentDate" 
                    value="<%= formData.paymentDate || new Date().toISOString().split('T')[0] %>" required>
                <div class="invalid-feedback">Please select a payment date</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Academic Year*</label>
                <select class="form-select" name="academicYear" id="academicYear" required>
                    <option value="">-- Select Academic Year --</option>
                    <% academicYears.forEach(year => { %>
                        <option value="<%= year.year_name %>" 
                            data-id="<%= year.id %>"
                            <%= (formData.academicYear === year.year_name || year.is_current) ? 'selected' : '' %>>
                            <%= year.year_name %>
                            <% if (year.is_current) { %> (Current) <% } %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select an academic year</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Term*</label>
                <select class="form-select" name="term" id="term" required>
                    <option value="">-- Select Term --</option>
                    <% if (typeof terms !== 'undefined' && terms.length > 0) { %>
                        <% terms.forEach(term => { %>
                            <option value="<%= term.term_name %>" 
                                <%= (formData.term === term.term_name || term.is_current) ? 'selected' : '' %>>
                                <%= term.term_name %>
                                <% if (term.is_current) { %> (Current) <% } %>
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option value="First Term" <%= (formData.term === 'First Term') ? 'selected' : '' %>>First Term</option>
                        <option value="Second Term" <%= (formData.term === 'Second Term') ? 'selected' : '' %>>Second Term</option>
                        <option value="Third Term" <%= (formData.term === 'Third Term') ? 'selected' : '' %>>Third Term</option>
                    <% } %>
                </select>
                <div class="invalid-feedback">Please select a term</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Notes (Optional)</label>
                <textarea class="form-control" name="notes" rows="2" placeholder="Any additional notes about this payment"><%= formData.notes || '' %></textarea>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-money-bill-wave me-1"></i> Submit Payment
            </button>
            <button type="reset" class="btn btn-outline-secondary ms-2" onclick="resetForm()">
                <i class="fas fa-times me-1"></i> Cancel
            </button>
        </div>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const studentSelect = document.getElementById('studentSelect');
    const firstNameInput = document.getElementById('firstName');
    const middleNameInput = document.getElementById('middleName');
    const lastNameInput = document.getElementById('lastName');
    const studentClassInput = document.getElementById('studentClass');
    const studentDepartmentInput = document.getElementById('studentDepartment');
    const studentEmailInput = document.getElementById('studentEmail');
    const academicYearSelect = document.getElementById('academicYear');
    const termSelect = document.getElementById('term');
    const billFeeTypeSelect = document.getElementById('billFeeType');
    const billAmountDisplay = document.getElementById('billAmountDisplay');
    const feeTypeSelect = document.getElementById('feeType');
    const amountInput = document.getElementById('amountInput');
    const amountStatus = document.getElementById('amountStatus');

    let currentBillAmount = 0;
    let currentStudentClassId = '';

    // Update student details when a student is selected
    studentSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        
        if (selectedOption.value) {
            firstNameInput.value = selectedOption.getAttribute('data-firstname') || '';
            middleNameInput.value = selectedOption.getAttribute('data-middlename') || '';
            lastNameInput.value = selectedOption.getAttribute('data-lastname') || '';
            studentClassInput.value = selectedOption.getAttribute('data-class') || 'N/A';
            studentDepartmentInput.value = selectedOption.getAttribute('data-department') || 'N/A';
            studentEmailInput.value = selectedOption.getAttribute('data-email') || '';
            
            currentStudentClassId = selectedOption.getAttribute('data-classid') || '';
            
            // Load class bills for the selected student's class
            if (currentStudentClassId) {
                loadClassBills(currentStudentClassId);
            } else {
                resetBillSection();
            }
        } else {
            resetStudentDetails();
            resetBillSection();
        }
    });

    // Load class bills for a specific class
    async function loadClassBills(classId) {
        billFeeTypeSelect.innerHTML = '<option value="">Loading fee types...</option>';
        billFeeTypeSelect.disabled = true;
        billAmountDisplay.value = '';
        currentBillAmount = 0;
        
        try {
            const response = await fetch(`/get-class-bills?classId=${classId}`);
            const result = await response.json();
            
            billFeeTypeSelect.innerHTML = '<option value="">-- Select Fee Type --</option>';
            
            if (result.success && result.bills.length > 0) {
                result.bills.forEach(bill => {
                    const option = document.createElement('option');
                    option.value = bill.fee_type;
                    option.textContent = `${bill.fee_type}`;
                    option.setAttribute('data-amount', bill.amount);
                    billFeeTypeSelect.appendChild(option);
                });
                billFeeTypeSelect.disabled = false;
                showToast('Class bills loaded successfully!', 'success');
            } else {
                billFeeTypeSelect.innerHTML = '<option value="">No class bills found</option>';
                billFeeTypeSelect.disabled = true;
                showToast('No class bills found for this student\'s class', 'info');
            }
        } catch (error) {
            console.error('Error loading class bills:', error);
            billFeeTypeSelect.innerHTML = '<option value="">Error loading bills</option>';
            billFeeTypeSelect.disabled = true;
            showToast('Error loading class bills', 'danger');
        }
    }

    // Update bill amount display when fee type is selected
    billFeeTypeSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        
        if (selectedOption.value) {
            currentBillAmount = parseFloat(selectedOption.getAttribute('data-amount')) || 0;
            billAmountDisplay.value = currentBillAmount.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            
            // Also set the fee type in the main fee type select
            for (let i = 0; i < feeTypeSelect.options.length; i++) {
                if (feeTypeSelect.options[i].value === selectedOption.value) {
                    feeTypeSelect.selectedIndex = i;
                    break;
                }
            }
        } else {
            currentBillAmount = 0;
            billAmountDisplay.value = '';
        }
        
        updateAmountStatus();
    });

    // Update amount status when amount changes
    amountInput.addEventListener('input', updateAmountStatus);

    function updateAmountStatus() {
        const enteredAmount = parseFloat(amountInput.value) || 0;
        
        if (currentBillAmount > 0) {
            if (enteredAmount === 0) {
                amountStatus.textContent = `Bill amount: ₦${currentBillAmount.toLocaleString()}`;
                amountStatus.className = 'form-text text-info';
            } else if (enteredAmount < currentBillAmount) {
                const balance = currentBillAmount - enteredAmount;
                amountStatus.textContent = `Partial payment. Balance: ₦${balance.toLocaleString()}`;
                amountStatus.className = 'form-text text-warning';
            } else if (enteredAmount === currentBillAmount) {
                amountStatus.textContent = 'Full payment received';
                amountStatus.className = 'form-text text-success';
            } else {
                const overpayment = enteredAmount - currentBillAmount;
                amountStatus.textContent = `Overpayment: ₦${overpayment.toLocaleString()}`;
                amountStatus.className = 'form-text text-info';
            }
        } else {
            amountStatus.textContent = '';
        }
    }

    // Apply bill template to form
    window.applyBillTemplate = function() {
        if (billFeeTypeSelect.value && currentBillAmount > 0) {
            amountInput.value = currentBillAmount;
            updateAmountStatus();
            showToast('Bill template applied successfully!', 'success');
        } else {
            showToast('Please select a fee type from the bill template', 'warning');
        }
    };

    // Function to load terms for selected academic year
    function loadTermsForAcademicYear(academicYearId) {
        if (!academicYearId) return;
        
        // Show loading state
        termSelect.innerHTML = '<option value="">Loading terms...</option>';
        termSelect.disabled = true;
        
        fetch(`/api/terms/${academicYearId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to fetch terms');
                }
                return response.json();
            })
            .then(terms => {
                termSelect.innerHTML = '<option value="">-- Select Term --</option>';
                terms.forEach(term => {
                    const isCurrent = term.is_current ? ' (Current)' : '';
                    termSelect.innerHTML += `
                        <option value="${term.term_name}" ${term.is_current ? 'selected' : ''}>
                            ${term.term_name}${isCurrent}
                        </option>
                    `;
                });
                termSelect.disabled = false;
            })
            .catch(error => {
                console.error('Error loading terms:', error);
                termSelect.innerHTML = `
                    <option value="">-- Select Term --</option>
                    <option value="First Term">First Term</option>
                    <option value="Second Term">Second Term</option>
                    <option value="Third Term">Third Term</option>
                `;
                termSelect.disabled = false;
            });
    }
    
    academicYearSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const academicYearId = selectedOption.getAttribute('data-id');
        
        if (academicYearId) {
            loadTermsForAcademicYear(academicYearId);
        } else {
            termSelect.innerHTML = '<option value="">-- Select Term --</option>';
        }
        
        // Reload class bills if academic year changes and we have a student selected
        if (currentStudentClassId && studentSelect.value) {
            loadClassBills(currentStudentClassId);
        }
    });

    termSelect.addEventListener('change', function() {
        // Reload class bills if term changes and we have a student selected
        if (currentStudentClassId && studentSelect.value) {
            loadClassBills(currentStudentClassId);
        }
    });
    
    // Initialize if there's a preselected academic year
    if (academicYearSelect.value) {
        const selectedOption = academicYearSelect.options[academicYearSelect.selectedIndex];
        const academicYearId = selectedOption.getAttribute('data-id');
        
        if (academicYearId) {
            loadTermsForAcademicYear(academicYearId);
        }
    }

    // Initialize form validation
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    });

    // Set default payment date to today if empty
    const paymentDateInput = document.querySelector('input[name="paymentDate"]');
    if (!paymentDateInput.value) {
        paymentDateInput.value = new Date().toISOString().split('T')[0];
    }

    // Reset functions
    function resetStudentDetails() {
        firstNameInput.value = '';
        middleNameInput.value = '';
        lastNameInput.value = '';
        studentClassInput.value = '';
        studentDepartmentInput.value = '';
        studentEmailInput.value = '';
        currentStudentClassId = '';
    }

    function resetBillSection() {
        billFeeTypeSelect.innerHTML = '<option value="">-- Select Fee Type --</option>';
        billFeeTypeSelect.disabled = true;
        billAmountDisplay.value = '';
        currentBillAmount = 0;
        amountStatus.textContent = '';
    }

    window.resetForm = function() {
        const form = document.querySelector('form');
        form.classList.remove('was-validated');
        form.reset();
        resetStudentDetails();
        resetBillSection();
        paymentDateInput.value = new Date().toISOString().split('T')[0];
    };

    // Toast notification function
    function showToast(message, type = 'info') {
        // Create toast element
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type} border-0`;
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;
        
        // Add to page
        document.body.appendChild(toast);
        
        // Show toast
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
        
        // Remove after hidden
        toast.addEventListener('hidden.bs.toast', function() {
            document.body.removeChild(toast);
        });
    }

    // Trigger change event for student select if there's a preselected value
    if (studentSelect.value) {
        studentSelect.dispatchEvent(new Event('change'));
    }
});
</script>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
                         
