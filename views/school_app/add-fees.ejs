<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>edu admin</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
        <meta content="Coderthemes" name="author">
        <!-- App favicon -->
        <link rel="shortcut icon" href="/images/favicon.png">

        <!-- App css -->
        <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
        <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
        <link rel="stylesheet" href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
        <link rel="stylesheet" href="/vendor/bootstrap-datepicker/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    </head>

    <body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <!-- Begin page -->
        <div class="wrapper">
            <!-- ========== Left Sidebar Start ========== -->
<!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->
            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->

            <div class="content-page">
                <div class="content">
                    <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->
                    <!-- Start Content-->
                <div class="container-fluid">
                        
                        <!-- start page title -->
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <div class="page-title-right">
                                        <ol class="breadcrumb m-0">
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Home</a></li>
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Fees Collection</a></li>
                                            <li class="breadcrumb-item active">Create Fees</li>
                                        </ol>
                                    </div>
                                    <h4 class="page-title">Create Fees</h4>
                                </div>
                            </div>
                        </div>     
                        <!-- end page title --> 

                        <div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <% var lockedStudent = typeof selectedStudent !== 'undefined' && selectedStudent; %>
                <h5 class="card-title">Basic Info</h5>
                <form action="/add-fees" method="post" class="needs-validation" novalidate>
    
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success mb-3" role="alert"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger mb-3" role="alert"><%= error %></div>
    <% } %>

    <div class="row">
        <div class="col-xl-6">
            <% if (lockedStudent) { %>
            <input type="hidden" name="studentId" value="<%= selectedStudent.id %>">
            <div id="lockedStudentContext" class="d-none" data-classid="<%= selectedStudent.classId || '' %>"></div>
            <div class="mb-3">
                <label class="form-label">Student</label>
                <div class="p-3 bg-light rounded border">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <span class="fw-semibold"><%= selectedStudent.firstName %> <%= selectedStudent.middleName %> <%= selectedStudent.lastName %></span>
                            <% if (selectedStudent.email) { %><span class="text-muted ms-2"><%= selectedStudent.email %></span><% } %>
                        </div>
                        <a href="/all-students" class="btn btn-sm btn-outline-secondary">All students</a>
                    </div>
                    <div class="small text-muted mt-2">
                        Class: <%= selectedStudent.className || 'Not assigned' %>
                        <% if (selectedStudent.classDepartment) { %><span class="ms-1">(<%= selectedStudent.classDepartment %>)</span><% } %>
                    </div>
                </div>
            </div>
            <% } else { %>
            <div class="alert alert-warning mb-3">
                No student is linked to this page. Open <a href="/all-students" class="alert-link">All Students</a> and use the fee action for a student.
            </div>
            <% } %>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" id="firstName" readonly value="<%= lockedStudent ? selectedStudent.firstName : '' %>">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Middle Name</label>
                    <input type="text" class="form-control" id="middleName" readonly value="<%= lockedStudent ? (selectedStudent.middleName || '') : '' %>">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" id="lastName" readonly value="<%= lockedStudent ? selectedStudent.lastName : '' %>">
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Class</label>
                    <input type="text" class="form-control" id="studentClass" readonly value="<%= lockedStudent ? (selectedStudent.className || 'N/A') : '' %>">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Department</label>
                    <input type="text" class="form-control" id="studentDepartment" readonly value="<%= lockedStudent ? (selectedStudent.classDepartment || 'N/A') : '' %>">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" id="studentEmail" readonly value="<%= lockedStudent ? (selectedStudent.email || '') : '' %>">
            </div>

            <!-- Class Bill Template Section -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="card-title mb-0">Class Bill Templates</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Select Fee Type from Bill</label>
                        <select class="form-select" id="billFeeType">
                            <option value="">-- Select Fee Type --</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Bill Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₦</span>
                            <input type="text" class="form-control" id="billAmountDisplay" readonly>
                        </div>
                    </div>
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-primary" onclick="applyBillTemplate()">
                            <i class="fas fa-check me-1"></i> Apply Bill Template
                        </button>
                    </div>
                    <small class="text-muted d-block mt-2">Select a fee type to load the standardized amount from class bill</small>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="mb-3">
                <label class="form-label">Fee Type*</label>
                <select class="form-select" name="feeType" id="feeType" required>
                    <option value="">-- Select Fee Type --</option>
                    <% feeTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= (formData.feeType === type) ? 'selected' : '' %>>
                            <%= type %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select a fee type</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Type*</label>
                <select class="form-select" name="paymentType" required>
                    <option value="">-- Select Payment Type --</option>
                    <% paymentTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= (formData.paymentType === type) ? 'selected' : '' %>>
                            <%= type %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select a payment type</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Amount (₦)*</label>
                <div class="input-group">
                    <span class="input-group-text">₦</span>
                    <input type="number" class="form-control" name="amount" id="amountInput"
                        value="<%= formData.amount || '' %>" step="0.01" min="0" required
                        placeholder="0.00">
                </div>
                <div class="invalid-feedback">Please enter a valid amount</div>
                <div id="amountStatus" class="form-text"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Date*</label>
                <input type="date" class="form-control" name="paymentDate" 
                    value="<%= formData.paymentDate || new Date().toISOString().split('T')[0] %>" required>
                <div class="invalid-feedback">Please select a payment date</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Academic Year*</label>
                <select class="form-select" name="academicYear" id="academicYear" required>
                    <option value="">-- Select Academic Year --</option>
                    <% academicYears.forEach(year => { %>
                        <option value="<%= year.year_name %>" 
                            data-id="<%= year.id %>"
                            <%= (formData.academicYear === year.year_name || year.is_current) ? 'selected' : '' %>>
                            <%= year.year_name %>
                            <% if (year.is_current) { %> (Current) <% } %>
                        </option>
                    <% }); %>
                </select>
                <div class="invalid-feedback">Please select an academic year</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Term*</label>
                <select class="form-select" name="term" id="term" required>
                    <option value="">-- Select Term --</option>
                    <% if (typeof terms !== 'undefined' && terms.length > 0) { %>
                        <% terms.forEach(term => { %>
                            <option value="<%= term.term_name %>" 
                                <%= (formData.term === term.term_name || term.is_current) ? 'selected' : '' %>>
                                <%= term.term_name %>
                                <% if (term.is_current) { %> (Current) <% } %>
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option value="First Term" <%= (formData.term === 'First Term') ? 'selected' : '' %>>First Term</option>
                        <option value="Second Term" <%= (formData.term === 'Second Term') ? 'selected' : '' %>>Second Term</option>
                        <option value="Third Term" <%= (formData.term === 'Third Term') ? 'selected' : '' %>>Third Term</option>
                    <% } %>
                </select>
                <div class="invalid-feedback">Please select a term</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Notes (Optional)</label>
                <textarea class="form-control" name="notes" rows="2" placeholder="Any additional notes about this payment"><%= formData.notes || '' %></textarea>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary" <%= lockedStudent ? '' : 'disabled' %>>
                <i class="fas fa-money-bill-wave me-1"></i> Submit Payment
            </button>
            <% if (lockedStudent) { %>
            <button type="button" class="btn btn-outline-secondary ms-2" onclick="window.location.href='/add-fees/<%= selectedStudent.id %>'">
                <i class="fas fa-times me-1"></i> Reset form
            </button>
            <% } else { %>
            <a href="/all-students" class="btn btn-outline-secondary ms-2">Back</a>
            <% } %>
        </div>
    </div>
</form>

            </div><!-- end card-body -->
        </div><!-- end card -->
    </div><!-- end col-12 -->
</div><!-- end row -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    const studentSelect = document.getElementById('studentSelect');
    const lockedCtx = document.getElementById('lockedStudentContext');
    const firstNameInput = document.getElementById('firstName');
    const middleNameInput = document.getElementById('middleName');
    const lastNameInput = document.getElementById('lastName');
    const studentClassInput = document.getElementById('studentClass');
    const studentDepartmentInput = document.getElementById('studentDepartment');
    const studentEmailInput = document.getElementById('studentEmail');
    const academicYearSelect = document.getElementById('academicYear');
    const termSelect = document.getElementById('term');
    const billFeeTypeSelect = document.getElementById('billFeeType');
    const billAmountDisplay = document.getElementById('billAmountDisplay');
    const feeTypeSelect = document.getElementById('feeType');
    const amountInput = document.getElementById('amountInput');
    const amountStatus = document.getElementById('amountStatus');

    let currentBillAmount = 0;
    let currentStudentClassId = '';

    if (lockedCtx && lockedCtx.dataset.classid) {
        currentStudentClassId = String(lockedCtx.dataset.classid);
    }

    // Update student details when a student is selected (legacy dropdown — unused when opened from All Students)
    if (studentSelect) studentSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        
        if (selectedOption.value) {
            firstNameInput.value = selectedOption.getAttribute('data-firstname') || '';
            middleNameInput.value = selectedOption.getAttribute('data-middlename') || '';
            lastNameInput.value = selectedOption.getAttribute('data-lastname') || '';
            studentClassInput.value = selectedOption.getAttribute('data-class') || 'N/A';
            studentDepartmentInput.value = selectedOption.getAttribute('data-department') || 'N/A';
            studentEmailInput.value = selectedOption.getAttribute('data-email') || '';
            
            currentStudentClassId = selectedOption.getAttribute('data-classid') || '';
            
            // Load class bills for the selected student's class
            if (currentStudentClassId) {
                loadClassBills(currentStudentClassId);
            } else {
                resetBillSection();
            }
        } else {
            resetStudentDetails();
            resetBillSection();
        }
    });

    // Load class bills for a specific class
    async function loadClassBills(classId) {
        billFeeTypeSelect.innerHTML = '<option value="">Loading fee types...</option>';
        billFeeTypeSelect.disabled = true;
        billAmountDisplay.value = '';
        currentBillAmount = 0;
        
        try {
            const response = await fetch(`/get-class-bills?classId=${classId}`);
            const result = await response.json();
            
            billFeeTypeSelect.innerHTML = '<option value="">-- Select Fee Type --</option>';
            
            if (result.success && result.bills.length > 0) {
                result.bills.forEach(bill => {
                    const option = document.createElement('option');
                    option.value = bill.fee_type;
                    option.textContent = `${bill.fee_type}`;
                    option.setAttribute('data-amount', bill.amount);
                    billFeeTypeSelect.appendChild(option);
                });
                billFeeTypeSelect.disabled = false;
                showToast('Class bills loaded successfully!', 'success');
            } else {
                billFeeTypeSelect.innerHTML = '<option value="">No class bills found</option>';
                billFeeTypeSelect.disabled = true;
                showToast('No class bills found for this student\'s class', 'info');
            }
        } catch (error) {
            console.error('Error loading class bills:', error);
            billFeeTypeSelect.innerHTML = '<option value="">Error loading bills</option>';
            billFeeTypeSelect.disabled = true;
            showToast('Error loading class bills', 'danger');
        }
    }

    // Update bill amount display when fee type is selected
    billFeeTypeSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        
        if (selectedOption.value) {
            currentBillAmount = parseFloat(selectedOption.getAttribute('data-amount')) || 0;
            billAmountDisplay.value = currentBillAmount.toLocaleString('en-NG', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            
            // Also set the fee type in the main fee type select
            for (let i = 0; i < feeTypeSelect.options.length; i++) {
                if (feeTypeSelect.options[i].value === selectedOption.value) {
                    feeTypeSelect.selectedIndex = i;
                    break;
                }
            }
        } else {
            currentBillAmount = 0;
            billAmountDisplay.value = '';
        }
        
        updateAmountStatus();
    });

    // Update amount status when amount changes
    amountInput.addEventListener('input', updateAmountStatus);

    function updateAmountStatus() {
        const enteredAmount = parseFloat(amountInput.value) || 0;
        
        if (currentBillAmount > 0) {
            if (enteredAmount === 0) {
                amountStatus.textContent = `Bill amount: ₦${currentBillAmount.toLocaleString()}`;
                amountStatus.className = 'form-text text-info';
            } else if (enteredAmount < currentBillAmount) {
                const balance = currentBillAmount - enteredAmount;
                amountStatus.textContent = `Partial payment. Balance: ₦${balance.toLocaleString()}`;
                amountStatus.className = 'form-text text-warning';
            } else if (enteredAmount === currentBillAmount) {
                amountStatus.textContent = 'Full payment received';
                amountStatus.className = 'form-text text-success';
            } else {
                const overpayment = enteredAmount - currentBillAmount;
                amountStatus.textContent = `Overpayment: ₦${overpayment.toLocaleString()}`;
                amountStatus.className = 'form-text text-info';
            }
        } else {
            amountStatus.textContent = '';
        }
    }

    // Apply bill template to form
    window.applyBillTemplate = function() {
        if (billFeeTypeSelect.value && currentBillAmount > 0) {
            amountInput.value = currentBillAmount;
            updateAmountStatus();
            showToast('Bill template applied successfully!', 'success');
        } else {
            showToast('Please select a fee type from the bill template', 'warning');
        }
    };

    // Function to load terms for selected academic year
    function loadTermsForAcademicYear(academicYearId) {
        if (!academicYearId) return;
        
        // Show loading state
        termSelect.innerHTML = '<option value="">Loading terms...</option>';
        termSelect.disabled = true;
        
        fetch(`/api/terms/${academicYearId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to fetch terms');
                }
                return response.json();
            })
            .then(terms => {
                termSelect.innerHTML = '<option value="">-- Select Term --</option>';
                terms.forEach(term => {
                    const isCurrent = term.is_current ? ' (Current)' : '';
                    termSelect.innerHTML += `
                        <option value="${term.term_name}" ${term.is_current ? 'selected' : ''}>
                            ${term.term_name}${isCurrent}
                        </option>
                    `;
                });
                termSelect.disabled = false;
            })
            .catch(error => {
                console.error('Error loading terms:', error);
                termSelect.innerHTML = `
                    <option value="">-- Select Term --</option>
                    <option value="First Term">First Term</option>
                    <option value="Second Term">Second Term</option>
                    <option value="Third Term">Third Term</option>
                `;
                termSelect.disabled = false;
            });
    }
    
    academicYearSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const academicYearId = selectedOption.getAttribute('data-id');
        
        if (academicYearId) {
            loadTermsForAcademicYear(academicYearId);
        } else {
            termSelect.innerHTML = '<option value="">-- Select Term --</option>';
        }
        
        // Reload class bills if academic year changes and class bills depend on year/term server-side
        if (currentStudentClassId) {
            loadClassBills(currentStudentClassId);
        }
    });

    termSelect.addEventListener('change', function() {
        if (currentStudentClassId) {
            loadClassBills(currentStudentClassId);
        }
    });
    
    // Initialize if there's a preselected academic year
    if (academicYearSelect.value) {
        const selectedOption = academicYearSelect.options[academicYearSelect.selectedIndex];
        const academicYearId = selectedOption.getAttribute('data-id');
        
        if (academicYearId) {
            loadTermsForAcademicYear(academicYearId);
        }
    }

    // Initialize form validation
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            }
            form.classList.add('was-validated');
        }, false);
    });

    // Set default payment date to today if empty
    const paymentDateInput = document.querySelector('input[name="paymentDate"]');
    if (!paymentDateInput.value) {
        paymentDateInput.value = new Date().toISOString().split('T')[0];
    }

    // Reset functions
    function resetStudentDetails() {
        firstNameInput.value = '';
        middleNameInput.value = '';
        lastNameInput.value = '';
        studentClassInput.value = '';
        studentDepartmentInput.value = '';
        studentEmailInput.value = '';
        currentStudentClassId = '';
    }

    function resetBillSection() {
        billFeeTypeSelect.innerHTML = '<option value="">-- Select Fee Type --</option>';
        billFeeTypeSelect.disabled = true;
        billAmountDisplay.value = '';
        currentBillAmount = 0;
        amountStatus.textContent = '';
    }

    window.resetForm = function() {
        const form = document.querySelector('form');
        form.classList.remove('was-validated');
        form.reset();
        resetStudentDetails();
        resetBillSection();
        paymentDateInput.value = new Date().toISOString().split('T')[0];
    };

    // Toast notification function
    function showToast(message, type = 'info') {
        const toastType = type === 'danger' ? 'danger' : type === 'warning' ? 'warning' : type === 'success' ? 'success' : 'info';
        if (window.showFormFeedbackToast) {
            window.showFormFeedbackToast(message, toastType);
            return;
        }

        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type} border-0`;
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        `;
        
        document.body.appendChild(toast);
        
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
        
        toast.addEventListener('hidden.bs.toast', function() {
            document.body.removeChild(toast);
        });
    }

    if (studentSelect && studentSelect.value) {
        studentSelect.dispatchEvent(new Event('change'));
    } else if (currentStudentClassId) {
        loadClassBills(currentStudentClassId);
    }
});
</script>

                    </div> <!-- container -->

                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © Hyper - Coderthemes.com
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->


        </div>
        <!-- END wrapper -->


        <!-- Right Sidebar -->
        <div class="end-bar">

            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>

            <div class="rightbar-content h-100" data-simplebar="">

                <div class="p-3">
                    <div class="alert alert-warning" role="alert">
                        <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                    </div>

                    <!-- Settings -->
                    <h5 class="mt-3">Color Scheme</h5>
                    <hr class="mt-1">

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                        <label class="form-check-label" for="light-mode-check">Light Mode</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                        <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                    </div>
       

                    <!-- Width -->
                    <h5 class="mt-4">Width</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                        <label class="form-check-label" for="fluid-check">Fluid</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                        <label class="form-check-label" for="boxed-check">Boxed</label>
                    </div>
        

                    <!-- Left Sidebar-->
                    <h5 class="mt-4">Left Sidebar</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                        <label class="form-check-label" for="default-check">Default</label>
                    </div>

                    <div class="form-check form-switch mb-1">
