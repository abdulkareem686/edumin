<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Parent Payment Approvals - Admin Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="Review and approve parent fee payments submitted through the parent portal" name="description" />
    <link rel="shortcut icon" href="/images/favicon.png">

    <!-- App css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/assets/css/school-dashboard.css">

    <style>
        .status-pill-pending {
            background-color: #fff8e1;
            color: #b78103;
            border: 1px solid #ffe082;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .status-pill-approved {
            background-color: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .status-pill-rejected {
            background-color: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #f59e0b;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
            animation: pulse-orange 1.6s infinite;
        }
        @keyframes pulse-orange {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(245, 158, 11, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
            }
        }
        .table > :not(caption) > * > * {
            padding: 0.85rem 0.75rem;
            vertical-align: middle;
        }
        .proof-thumbnail {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            transition: transform 0.15s ease;
        }
        .proof-thumbnail:hover {
            transform: scale(1.1);
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Admin Sidebar -->
        <%- include('partials/admin-sidebar') %>

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>

                <div class="container-fluid">
                    <!-- Page Header -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <a href="/admin/payment-settings" class="btn btn-outline-primary btn-sm me-2">
                                        <i class="bi bi-bank me-1"></i> School Bank Details
                                    </a>
                                    <a href="/fees-collection" class="btn btn-primary btn-sm">
                                        <i class="bi bi-wallet2 me-1"></i> Fee Ledger
                                    </a>
                                </div>
                                <h4 class="page-title"><i class="bi bi-shield-check me-2 text-primary"></i>Parent Payment Approvals</h4>
                            </div>
                        </div>
                    </div>

                    <!-- Alerts -->
                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                            <strong>Success:</strong> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                            <strong>Error:</strong> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Summary Stats Row -->
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small">Pending Review</span>
                                            <h3 class="my-1 text-warning fw-bold"><%= stats.pendingCount || 0 %></h3>
                                            <span class="text-muted small">₦<%= (parseFloat(stats.pendingAmount) || 0).toLocaleString() %> awaiting review</span>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-warning-light text-warning rounded-circle fs-3 p-2">
                                                <i class="bi bi-hourglass-split"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small">Approved Payments</span>
                                            <h3 class="my-1 text-success fw-bold"><%= stats.approvedCount || 0 %></h3>
                                            <span class="text-muted small">₦<%= (parseFloat(stats.approvedAmount) || 0).toLocaleString() %> verified</span>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-success-light text-success rounded-circle fs-3 p-2">
                                                <i class="bi bi-check2-circle"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small">Declined / Rejected</span>
                                            <h3 class="my-1 text-danger fw-bold"><%= stats.rejectedCount || 0 %></h3>
                                            <span class="text-muted small">Declined submissions</span>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-danger-light text-danger rounded-circle fs-3 p-2">
                                                <i class="bi bi-x-circle"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small">Term Policy</span>
                                            <h4 class="my-1 text-primary fw-bold">Max 2 / Term</h4>
                                            <span class="text-muted small">Strictly enforced per student</span>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-primary-light text-primary rounded-circle fs-3 p-2">
                                                <i class="bi bi-shield-lock"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filters and Search Bar -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <form action="/admin/pending-payments" method="GET" class="row g-2 align-items-center">
                                <div class="col-lg-3 col-md-4">
                                    <div class="btn-group w-100" role="group">
                                        <a href="/admin/pending-payments?status=all" class="btn btn-sm <%= filters.status === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>">All</a>
                                        <a href="/admin/pending-payments?status=pending" class="btn btn-sm <%= filters.status === 'pending' ? 'btn-warning text-dark' : 'btn-outline-warning' %>">
                                            Pending <% if (stats.pendingCount > 0) { %><span class="badge bg-danger rounded-pill"><%= stats.pendingCount %></span><% } %>
                                        </a>
                                        <a href="/admin/pending-payments?status=approved" class="btn btn-sm <%= filters.status === 'approved' ? 'btn-success' : 'btn-outline-success' %>">Approved</a>
                                        <a href="/admin/pending-payments?status=rejected" class="btn btn-sm <%= filters.status === 'rejected' ? 'btn-danger' : 'btn-outline-danger' %>">Declined</a>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3">
                                    <select class="form-select form-select-sm" name="academicYear" onchange="this.form.submit()">
                                        <option value="">All Academic Years</option>
                                        <% if (academicYears && academicYears.length > 0) { %>
                                            <% academicYears.forEach(function(y) { %>
                                                <option value="<%= y.year_name %>" <%= filters.academicYear === y.year_name ? 'selected' : '' %>><%= y.year_name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-2">
                                    <select class="form-select form-select-sm" name="term" onchange="this.form.submit()">
                                        <option value="">All Terms</option>
                                        <option value="First Term" <%= filters.term === 'First Term' ? 'selected' : '' %>>First Term</option>
                                        <option value="Second Term" <%= filters.term === 'Second Term' ? 'selected' : '' %>>Second Term</option>
                                        <option value="Third Term" <%= filters.term === 'Third Term' ? 'selected' : '' %>>Third Term</option>
                                    </select>
                                </div>

                                <div class="col-lg-4 col-md-3">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" name="search" placeholder="Search student, ref, parent..." value="<%= filters.search || '' %>">
                                        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
                                        <% if (filters.search || filters.academicYear || filters.term || filters.status !== 'all') { %>
                                            <a href="/admin/pending-payments" class="btn btn-light" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                                        <% } %>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Payments Table Card -->
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-dark">
                                <i class="bi bi-list-check me-2 text-primary"></i>Fee Payment Submissions
                            </h5>
                            <span class="text-muted small">Showing <%= payments.length %> record(s)</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Submission Date</th>
                                            <th>Student</th>
                                            <th>Parent</th>
                                            <th>Session & Term</th>
                                            <th class="text-center">Term Tally</th>
                                            <th class="text-end">Amount</th>
                                            <th>Bank & Reference</th>
                                            <th class="text-center">Proof Document</th>
                                            <th class="text-center">Status</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (payments && payments.length > 0) { %>
                                            <% payments.forEach(function(p) { 
                                                const sName = [p.firstName, p.middleName, p.lastName].filter(Boolean).join(' ');
                                                const pName = [p.parent_first, p.parent_last].filter(Boolean).join(' ') || 'Parent';
                                                const formattedDate = moment(p.created_at).format('MMM D, YYYY');
                                            %>
                                                <tr>
                                                    <td>
                                                        <div class="fw-semibold"><%= formattedDate %></div>
                                                        <small class="text-muted font-monospace">#<%= p.id %></small>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold text-dark"><%= sName %></div>
                                                        <small class="text-muted"><%= p.className || 'No Class' %> • <%= p.admission_number || 'N/A' %></small>
                                                    </td>
                                                    <td>
                                                        <div><%= pName %></div>
                                                        <small class="text-muted"><%= p.parent_phone || p.parent_email || '-' %></small>
                                                    </td>
                                                    <td>
                                                        <div><strong><%= p.term %></strong></div>
                                                        <small class="text-muted"><%= p.academic_year %></small>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (p.payment_number == 1) { %>
                                                            <span class="badge bg-info-light text-info border border-info rounded-pill px-2">Payment 1 of 2</span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning-light text-warning border border-warning rounded-pill px-2">Payment 2 of 2 (Final)</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-end">
                                                        <h5 class="mb-0 text-primary fw-bold">₦<%= parseFloat(p.amount).toLocaleString() %></h5>
                                                        <small class="text-muted"><%= p.payment_method || 'Transfer' %></small>
                                                    </td>
                                                    <td>
                                                        <div><%= p.bank_name || 'Bank Transfer' %></div>
                                                        <small class="text-muted font-monospace"><%= p.transaction_reference || 'N/A' %></small>
                                                        <% if (p.notes) { %>
                                                            <div class="small text-muted fst-italic text-truncate" style="max-width: 150px;" title="<%= p.notes %>">"<%= p.notes %>"</div>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (p.proof_document) { 
                                                            const isPdf = p.proof_document.toLowerCase().endsWith('.pdf');
                                                        %>
                                                            <% if (isPdf) { %>
                                                                <a href="<%= p.proof_document %>" target="_blank" class="btn btn-sm btn-outline-danger">
                                                                    <i class="bi bi-file-earmark-pdf"></i> View PDF
                                                                </a>
                                                            <% } else { %>
                                                                <img src="<%= p.proof_document %>" class="proof-thumbnail" alt="Payment Proof" 
                                                                     onclick="showProofModal('<%= p.proof_document %>', '<%= sName %>', '₦<%= parseFloat(p.amount).toLocaleString() %>')">
                                                            <% } %>
                                                        <% } else { %>
                                                            <span class="text-muted small">No file</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (p.status === 'pending') { %>
                                                            <span class="status-pill-pending">
                                                                <span class="pulse-dot"></span> Pending Review
                                                            </span>
                                                        <% } else if (p.status === 'approved') { %>
                                                            <span class="status-pill-approved">
                                                                <i class="bi bi-check-circle-fill"></i> Approved
                                                            </span>
                                                        <% } else { %>
                                                            <span class="status-pill-rejected" title="<%= p.rejection_reason || 'Declined' %>">
                                                                <i class="bi bi-x-circle-fill"></i> Declined
                                                            </span>
                                                            <% if (p.rejection_reason) { %>
                                                                <div class="small text-danger text-truncate" style="max-width: 120px;" title="<%= p.rejection_reason %>">
                                                                    <%= p.rejection_reason %>
                                                                </div>
                                                            <% } %>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-center">
                                                        <% if (p.status === 'pending') { %>
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <button type="button" class="btn btn-success" 
                                                                        onclick="openApproveModal(<%= p.id %>, '<%= sName %>', '₦<%= parseFloat(p.amount).toLocaleString() %>', '<%= p.term %> - <%= p.academic_year %>')">
                                                                    <i class="bi bi-check-lg"></i> Approve
                                                                </button>
                                                                <button type="button" class="btn btn-outline-danger" 
                                                                        onclick="openRejectModal(<%= p.id %>, '<%= sName %>')">
                                                                    <i class="bi bi-x-lg"></i> Decline
                                                                </button>
                                                            </div>
                                                        <% } else if (p.status === 'approved' && p.fee_id) { %>
                                                            <a href="/parent/fee-receipt/<%= p.fee_id %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-receipt"></i> Receipt
                                                            </a>
                                                        <% } else { %>
                                                            <span class="text-muted small">—</span>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="10" class="text-center py-5 text-muted">
                                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                                    <h5>No payment submissions found</h5>
                                                    <p class="small mb-0">Payments submitted by parents from their portal will appear here for verification and approval.</p>
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite Management System
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Approve Confirmation Modal -->
    <div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form id="approveForm" method="POST" action="">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title"><i class="bi bi-check2-circle me-2"></i>Approve Fee Payment</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <div class="avatar-lg mx-auto mb-3">
                            <span class="avatar-title bg-success-light text-success rounded-circle fs-1 p-3">
                                <i class="bi bi-wallet2"></i>
                            </span>
                        </div>
                        <h4 class="mb-1 text-dark" id="modalApproveAmount">₦0.00</h4>
                        <p class="text-muted mb-3" id="modalApproveStudent">Student Name</p>
                        
                        <div class="alert alert-info text-start small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Approving this payment will:
                            <ul class="mb-0 ps-3 mt-1">
                                <li>Automatically create an official paid record in the School Fees ledger.</li>
                                <li>Generate an official receipt number for the parent.</li>
                                <li>Send an immediate notification to the parent's portal.</li>
                            </ul>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success px-4">Confirm & Approve</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reject Confirmation Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form id="rejectForm" method="POST" action="">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Decline Payment Submission</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="mb-3">
                            Decline payment submission for <strong id="modalRejectStudent">Student</strong>?
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="rejection_reason" rows="3" required
                                      placeholder="e.g. Transaction reference could not be verified on the bank statement. Please re-check the transaction reference and submit again."></textarea>
                            <div class="form-text small">This reason will be communicated directly to the parent in their portal notification.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4">Decline Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Proof Document Preview Modal -->
    <div class="modal fade" id="proofModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="proofModalTitle">Payment Proof Receipt</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3 text-center bg-dark">
                    <img id="proofModalImage" src="" class="img-fluid rounded" style="max-height: 75vh;" alt="Receipt Preview">
                </div>
                <div class="modal-footer">
                    <a id="proofModalDownload" href="" target="_blank" download class="btn btn-primary btn-sm">
                        <i class="bi bi-download me-1"></i> Open Original
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bundle js -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        function openApproveModal(id, studentName, amount, sessionTerm) {
            document.getElementById('approveForm').action = '/admin/pending-payments/' + id + '/approve';
            document.getElementById('modalApproveStudent').textContent = studentName + ' (' + sessionTerm + ')';
            document.getElementById('modalApproveAmount').textContent = amount;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }

        function openRejectModal(id, studentName) {
            document.getElementById('rejectForm').action = '/admin/pending-payments/' + id + '/reject';
            document.getElementById('modalRejectStudent').textContent = studentName;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function showProofModal(url, studentName, amount) {
            document.getElementById('proofModalImage').src = url;
            document.getElementById('proofModalDownload').href = url;
            document.getElementById('proofModalTitle').textContent = 'Receipt: ' + studentName + ' (' + amount + ')';
            new bootstrap.Modal(document.getElementById('proofModal')).show();
        }
    </script>
</body>
</html>
