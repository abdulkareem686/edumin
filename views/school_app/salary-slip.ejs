<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salary Slip - <%= payment.month %></title>
    <link href="/assets/css/app.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .salary-slip-container {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .salary-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .salary-body {
            padding: 2rem;
        }
        .company-info {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e9ecef;
        }
        .employee-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }
        .info-card {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }
        .salary-breakdown {
            margin-bottom: 2rem;
        }
        .breakdown-item {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e9ecef;
        }
        .breakdown-total {
            font-weight: bold;
            font-size: 1.2rem;
            color: #2c7be5;
            border-top: 2px solid #2c7be5;
            border-bottom: none;
        }
        .signature-area {
            margin-top: 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding-top: 2rem;
            border-top: 2px dashed #e9ecef;
        }
        .signature-line {
            border-top: 1px solid #6c757d;
            padding-top: 2rem;
            text-align: center;
        }
        .print-btn {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 1000;
        }
        @media print {
            .print-btn {
                display: none;
            }
            body {
                background: white;
            }
            .salary-slip-container {
                box-shadow: none;
                margin: 0;
                border-radius: 0;
            }
        }
    </style>
</head>
<body>
    <div class="salary-slip-container">
        <!-- Header -->
        <div class="salary-header">
            <h1 class="mb-1">SALARY SLIP</h1>
            <p class="mb-0">For the month of <%= moment(payment.month + '-01').format('MMMM YYYY') %></p>
        </div>

        <!-- Body -->
        <div class="salary-body">
            <!-- Company Information -->
            <div class="company-info">
                <h2 class="text-primary mb-1"><%= payment.school_name %></h2>
                <p class="text-muted mb-1"><%= payment.school_address %></p>
                <p class="text-muted">Phone: <%= payment.school_phone %></p>
            </div>

            <!-- Employee Information -->
            <div class="employee-info">
                <div class="info-card">
                    <h5 class="text-primary">Employee Details</h5>
                    <p class="mb-1"><strong>Name:</strong> <%= payment.first_name %> <%= payment.last_name %></p>
                    <p class="mb-1"><strong>Position:</strong> <%= payment.position %></p>
                    <p class="mb-1"><strong>Employee Type:</strong> <%= payment.employee_type %></p>
                    <p class="mb-0"><strong>Employee ID:</strong> <%= payment.employee_type.toUpperCase() %>-<%= payment.employee_id.toString().padStart(4, '0') %></p>
                </div>

                <div class="info-card">
                    <h5 class="text-primary">Payment Information</h5>
                    <p class="mb-1"><strong>Payment Date:</strong> <%= payment.payment_date ? moment(payment.payment_date).format('MMMM D, YYYY') : 'Pending' %></p>
                    <p class="mb-1"><strong>Payment Status:</strong> 
                        <span class="badge bg-<%= payment.status === 'paid' ? 'success' : payment.status === 'pending' ? 'warning' : 'danger' %>">
                            <%= payment.status %>
                        </span>
                    </p>
                    <p class="mb-1"><strong>Payment Method:</strong> <%= payment.payment_method || 'N/A' %></p>
                    <p class="mb-0"><strong>Processed On:</strong> <%= moment(payment.created_at).format('MMMM D, YYYY') %></p>
                </div>
            </div>

            <!-- Salary Breakdown -->
            <div class="salary-breakdown">
                <h5 class="text-primary mb-3">Salary Breakdown</h5>
                
                <!-- Earnings -->
                <div class="breakdown-item">
                    <span>Basic Salary:</span>
                    <span>₦<%= payment.basic_salary.toLocaleString() %></span>
                </div>
                
                <% if (payment.housing_allowance > 0) { %>
                <div class="breakdown-item">
                    <span>Housing Allowance:</span>
                    <span>₦<%= payment.housing_allowance.toLocaleString() %></span>
                </div>
                <% } %>
                
                <% if (payment.transport_allowance > 0) { %>
                <div class="breakdown-item">
                    <span>Transport Allowance:</span>
                    <span>₦<%= payment.transport_allowance.toLocaleString() %></span>
                </div>
                <% } %>
                
                <% if (payment.medical_allowance > 0) { %>
                <div class="breakdown-item">
                    <span>Medical Allowance:</span>
                    <span>₦<%= payment.medical_allowance.toLocaleString() %></span>
                </div>
                <% } %>
                
                <% if (payment.other_allowance > 0) { %>
                <div class="breakdown-item">
                    <span>Other Allowance:</span>
                    <span>₦<%= payment.other_allowance.toLocaleString() %></span>
                </div>
                <% } %>

                <!-- Gross Salary -->
                <div class="breakdown-item" style="border-top: 2px solid #2c7be5;">
                    <strong>Gross Salary:</strong>
                    <strong>₦<%= payment.gross_salary.toLocaleString() %></strong>
                </div>

                <!-- Deductions -->
                <h6 class="text-muted mt-4 mb-3">Deductions</h6>
                
                <% if (payment.tax_amount > 0) { %>
                <div class="breakdown-item">
                    <span>Tax Deduction:</span>
                    <span class="text-danger">-₦<%= payment.tax_amount.toLocaleString() %></span>
                </div>
                <% } %>
                
                <% if (payment.pension_amount > 0) { %>
                <div class="breakdown-item">
                    <span>Pension Contribution:</span>
                    <span class="text-danger">-₦<%= payment.pension_amount.toLocaleString() %></span>
                </div>
                <% } %>

                <!-- Total Deductions -->
                <div class="breakdown-item">
                    <strong>Total Deductions:</strong>
                    <strong class="text-danger">-₦<%= (payment.tax_amount + payment.pension_amount).toLocaleString() %></strong>
                </div>

                <!-- Net Salary -->
                <div class="breakdown-item breakdown-total">
                    <strong>NET SALARY:</strong>
                    <strong>₦<%= payment.net_salary.toLocaleString() %></strong>
                </div>
            </div>

            <!-- Notes -->
            <% if (payment.notes) { %>
            <div class="mt-4">
                <h6 class="text-primary">Notes</h6>
                <p class="text-muted"><%= payment.notes %></p>
            </div>
            <% } %>

            <!-- Signatures -->
            <div class="signature-area">
                <div class="signature-line">
                    <p class="text-muted mb-1">_________________________</p>
                    <p class="text-muted">Employee's Signature</p>
                </div>
                <div class="signature-line">
                    <p class="text-muted mb-1">_________________________</p>
                    <p class="text-muted">Authorized Signature</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Print Button -->
    <button class="btn btn-primary print-btn" onclick="window.print()">
        <i class="bi bi-printer me-2"></i>Print Salary Slip
    </button>

    <script>
        // Auto-print if needed
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
            window.print();
        }
    </script>
</body>
</html>