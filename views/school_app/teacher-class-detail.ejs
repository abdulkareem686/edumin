<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title><%= classData ? classData.className : 'Class Details' %> - Teacher Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.ico">
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <%- include('partials/teacher-sidebar') %>

        <div class="content-page">
            <div class="content">
                <%- include('partials/teacher-navbar') %>

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/teacher-dashboard">Teacher Portal</a></li>
                                        <li class="breadcrumb-item"><a href="/teacher/my-classes">My Classes</a></li>
                                        <li class="breadcrumb-item active"><%= classData ? classData.className : 'Class' %></li>
                                    </ol>
                                </div>
                                <h4 class="page-title"><i class="bi bi-people-fill text-primary me-2"></i><%= classData ? classData.className : 'Class Details' %></h4>
                            </div>
                        </div>
                    </div>

                    <!-- Class Info Cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-muted text-uppercase mb-2">Class Level</h6>
                                    <h4 class="fw-bold mb-0 text-primary"><%= classData ? classData.level : 'N/A' %></h4>
                                    <% if (classData && classData.department) { %>
                                        <small class="text-muted"><%= classData.department %></small>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-muted text-uppercase mb-2">Enrolled Students</h6>
                                    <h4 class="fw-bold mb-0 text-success"><%= typeof students !== 'undefined' && students ? students.length : 0 %></h4>
                                    <small class="text-muted">Active students in arm</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-muted text-uppercase mb-2">Curriculum Subjects</h6>
                                    <h4 class="fw-bold mb-0 text-info"><%= typeof subjects !== 'undefined' && subjects ? subjects.length : 0 %></h4>
                                    <small class="text-muted">Assigned subjects</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-muted text-uppercase mb-2">Active Session</h6>
                                    <h5 class="fw-bold mb-0 text-dark"><%= typeof academicYear !== 'undefined' ? academicYear : '' %></h5>
                                    <small class="text-primary fw-semibold"><%= typeof term !== 'undefined' ? term : '' %></small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Subjects in this Class -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Class Subjects</h5>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% if (typeof subjects !== 'undefined' && subjects && subjects.length > 0) { %>
                                            <% subjects.forEach(function(sub) { %>
                                                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                                                    <i class="bi bi-book text-primary"></i>
                                                    <span class="fw-semibold"><%= sub.subjectName || sub.name %></span>
                                                    <% if (sub.subjectCode || sub.code) { %>
                                                        <span class="text-muted small">(<%= sub.subjectCode || sub.code %>)</span>
                                                    <% } %>
                                                    <a href="/teacher/enter-scores/<%= classData.id %>/<%= sub.id %>" class="btn btn-xs btn-outline-primary ms-1" title="Enter Scores">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                </div>
                                            <% }); %>
                                        <% } else { %>
                                            <p class="text-muted mb-0">No subjects assigned.</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Students Roster -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="card-title mb-0">Class Roster</h5>
                                        <a href="/mark-attendance" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-calendar-check me-1"></i>Mark Attendance
                                        </a>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-centered table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Admission No.</th>
                                                    <th>Student Name</th>
                                                    <th>Gender</th>
                                                    <th>Department</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof students !== 'undefined' && students && students.length > 0) { %>
                                                    <% students.forEach(function(st, idx) { 
                                                        var name = [st.firstName, st.middleName, st.lastName].filter(Boolean).join(' ');
                                                    %>
                                                    <tr>
                                                        <td><%= idx + 1 %></td>
                                                        <td><span class="font-monospace text-secondary"><%= st.admission_number || 'N/A' %></span></td>
                                                        <td class="fw-semibold">
                                                            <a href="/student-profile/<%= st.id %>" class="text-body"><%= name %></a>
                                                        </td>
                                                        <td><%= st.gender || 'N/A' %></td>
                                                        <td><%= st.department || 'N/A' %></td>
                                                        <td class="text-center">
                                                            <a href="/student-profile/<%= st.id %>" class="btn btn-sm btn-light" title="View Profile">
                                                                <i class="bi bi-person"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="text-center py-4 text-muted">
                                                            No students enrolled in this class.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            © EduSuite School Management System
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
</body>
</html>
