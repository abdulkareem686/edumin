        <!-- Financial Summary Cards -->
        <!-- In expenses.ejs, update the financial summary section -->
<!-- In expenses.ejs, update the financial summary section -->
<div class="row">
    <div class="col-md-3">
        <div class="card widget-flat bg-success text-white">
            <div class="card-body">
                <h5 class="text-white">Total Fees Collected</h5>
                <h3 class="mt-3 mb-3">₦<%= totalFees.toLocaleString('en-NG') %></h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card widget-flat bg-danger text-white">
            <div class="card-body">
                <h5 class="text-white">Total Expenses</h5>
                <h3 class="mt-3 mb-3">₦<%= totalExpenses.toLocaleString('en-NG') %></h3>
                <small class="text-white-50">Includes all expenses</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card widget-flat bg-info text-white">
            <div class="card-body">
                <h5 class="text-white">Salary Expenses</h5>
                <h3 class="mt-3 mb-3">₦<%= totalSalaryExpenses.toLocaleString('en-NG') %></h3>
                <small class="text-white-50">Part of total expenses</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card widget-flat bg-<%= balance >= 0 ? 'primary' : 'warning' %> text-white">
            <div class="card-body">
                <h5 class="text-white">Net Balance</h5>
                <h3 class="mt-3 mb-3">₦<%= balance.toLocaleString('en-NG') %></h3>
            </div>
        </div>
    </div>
</div>

<!-- Add a breakdown section -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Expense Breakdown</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between">
                            <span>Regular Expenses:</span>
                            <strong>₦<%= totalRegularExpenses.toLocaleString('en-NG') %></strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between">
                            <span>Salary Expenses:</span>
                            <strong>₦<%= totalSalaryExpenses.toLocaleString('en-NG') %></strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between">
                            <span>Total Expenses:</span>
                            <strong>₦<%= totalExpenses.toLocaleString('en-NG') %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
        <!-- Expenses Table and Filters -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="header-title">Expenses List</h4>
                        
                        <!-- Filters Form -->
                        <form method="GET" class="row g-2 mb-3">
                            <div class="col-md-3">
                                <input type="date" class="form-control" name="startDate" 
                                       value="<%= filters.startDate %>" placeholder="Start Date">
                            </div>
                            <div class="col-md-3">
                                <input type="date" class="form-control" name="endDate" 
                                       value="<%= filters.endDate %>" placeholder="End Date">
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" name="category">
                                    <option value="all">All Categories</option>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.name %>" <%= filters.category === cat.name ? 'selected' : '' %>>
                                            <%= cat.name %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select" name="status">
                                    <option value="all">All Status</option>
                                    <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Filter</button>
                            </div>
                        </form>

                        <!-- Expenses Table -->
                        <div class="table-responsive">
                            <table class="table table-centered table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Category</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Payment Method</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% expenses.forEach(expense => { %>
                                    <tr>
                                        <td><%= moment(expense.expense_date).format('DD MMM YYYY') %></td>
                                        <td><%= expense.category %></td>
                                        <td><%= expense.description %></td>
                                        <td>₦<%= expense.amount.toLocaleString('en-NG') %></td>
                                        <td>
                                            <span class="badge bg-<%= 
                                                expense.status === 'approved' ? 'success' : 
                                                expense.status === 'rejected' ? 'danger' : 'warning' 
                                            %>">
                                                <%= expense.status %>
                                            </span>
                                        </td>
                                        <td><%= expense.payment_method %></td>
                                        <td>
                                            <% if (expense.status === 'pending') { %>
                                                <a href="/update-expense-status/<%= expense.id %>/approved" 
                                                   class="btn btn-success btn-sm">Approve</a>
                                                <a href="/update-expense-status/<%= expense.id %>/rejected" 
                                                   class="btn btn-danger btn-sm">Reject</a>
                                            <% } %>
                                            <a href="/delete-expense/<%= expense.id %>" 
                                               class="btn btn-outline-danger btn-sm"
                                               onclick="return confirm('Are you sure you want to delete this expense?')">
                                                Delete
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages > 1) { %>
                        <div class="row mt-3">
                            <div class="col-12">
                                <ul class="pagination justify-content-center">
                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= i %><%= filters.startDate ? '&startDate=' + filters.startDate : '' %><%= filters.endDate ? '&endDate=' + filters.endDate : '' %><%= filters.category ? '&category=' + filters.category : '' %><%= filters.status ? '&status=' + filters.status : '' %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                    <% } %>
                                </ul>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<!-- Footer Start -->
