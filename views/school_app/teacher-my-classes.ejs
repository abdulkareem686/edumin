<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>My Classes - Teacher Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .class-card {
            transition: all 0.3s ease;
            border-radius: 15px;
            overflow: hidden;
            height: 100%;
        }
        .class-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .stat-card {
            background: #3b5de7;
            color: white;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }
        .notification-unread {
            background-color: #e8f0fe;
            border-left: 3px solid #3b5de7;
        }
        .subject-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            margin: 2px;
        }
        .btn-action {
            transition: all 0.2s;
            border-radius: 8px;
        }
        .btn-action:hover {
            transform: translateX(3px);
        }
        .progress {
            height: 8px;
            border-radius: 4px;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/teacher-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/teacher-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-school me-2"></i>My Classes
                                    <span class="badge bg-primary ms-2"><%= classes.length %> Classes</span>
                                </h4>
                                <div class="page-title-right">
                                    <span class="badge bg-info p-2">
                                        <i class="mdi mdi-calendar"></i> <%= academicYear %>
                                    </span>
                                    <span class="badge bg-success p-2 ms-1">
                                        <i class="mdi mdi-book-open"></i> <%= term %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Success Message -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Teacher Info Card -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card bg-gradient-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="text-white mb-1"><%= teacherName %></h5>
                                            <p class="mb-0 text-white-50">
                                                <i class="mdi mdi-briefcase me-1"></i> <%= teacher.designation || 'Teacher' %>
                                                <% if (teacher.department) { %>
                                                    | <i class="mdi mdi-domain me-1"></i> <%= teacher.department %>
                                                <% } %>
                                            </p>
                                        </div>
                                        <div class="d-none d-md-block">
                                            <i class="mdi mdi-school fs-1 text-white-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="stat-number"><%= classes.length %></div>
                                <div>Total Classes</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card" style="background: #10b981;">
                                <div class="stat-number">
                                    <%= classes.reduce(function(sum, c) { return sum + (c.enrolled_students || 0); }, 0) %>
                                </div>
                                <div>Total Students</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card" style="background: #f59e0b;">
                                <div class="stat-number">
                                    <%= classes.reduce(function(sum, c) { return sum + (c.subject_count || 0); }, 0) %>
                                </div>
                                <div>Subjects Taught</div>
                            </div>
                        </div>
                    </div>

                    <!-- Classes Grid -->
                    <div class="row">
                        <% if (classes && classes.length > 0) { 
                            for(var i = 0; i < classes.length; i++) { 
                                var cls = classes[i];
                                var progressPercentage = cls.scores_entered && cls.subject_count && cls.enrolled_students 
                                    ? Math.round((cls.scores_entered / (cls.subject_count * cls.enrolled_students)) * 100) 
                                    : 0;
                        %>
                            <div class="col-xl-6 col-lg-6 mb-4">
                                <div class="card class-card">
                                    <div class="card-header bg-white">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="mb-0">
                                                    <i class="mdi mdi-school text-primary me-2"></i>
                                                    <%= cls.className %>
                                                </h5>
                                                <small class="text-muted">
                                                    Code: <%= cls.classCode || 'N/A' %> | Level: <%= cls.level || 'N/A' %>
                                                    <% if (cls.department) { %> | Dept: <%= cls.department %><% } %>
                                                </small>
                                            </div>
                                            <span class="badge bg-primary">
                                                <%= cls.enrolled_students || 0 %> Students
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Subjects -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="small text-muted">Subjects</span>
                                                <span class="small fw-bold"><%= cls.subject_count || 0 %> Subjects</span>
                                            </div>
                                            <div class="d-flex flex-wrap">
                                                <% if (subjectsMap[cls.id] && subjectsMap[cls.id].length > 0) { 
                                                    for(var j = 0; j < Math.min(subjectsMap[cls.id].length, 5); j++) { 
                                                        var subj = subjectsMap[cls.id][j]; %>
                                                        <span class="subject-badge bg-light text-dark me-1 mb-1">
                                                            <i class="mdi mdi-book-open-variant me-1"></i> <%= subj.name %>
                                                        </span>
                                                <% } 
                                                    if (subjectsMap[cls.id].length > 5) { %>
                                                        <span class="subject-badge bg-light text-muted">+<%= subjectsMap[cls.id].length - 5 %> more</span>
                                                <% } 
                                                } else { %>
                                                    <span class="text-muted small">No subjects assigned</span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Score Entry Progress -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="small text-muted">Score Entry Progress</span>
                                                <span class="small fw-bold"><%= progressPercentage %>%</span>
                                            </div>
                                            <div class="progress">
                                                <div class="progress-bar bg-success" style="width: <%= progressPercentage %>%"></div>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="d-grid gap-2">
                                            <a href="/teacher/class/<%= cls.id %>" class="btn btn-outline-primary btn-sm">
                                                <i class="mdi mdi-eye me-1"></i> View Class Details
                                            </a>
                                            <div class="btn-group">
                                                <a href="/enter-scores?classId=<%= cls.id %>" class="btn btn-outline-success btn-sm">
                                                    <i class="mdi mdi-clipboard-list me-1"></i> Enter Scores
                                                </a>
                                                <a href="/teacher/attendance?classId=<%= cls.id %>" class="btn btn-outline-info btn-sm">
                                                    <i class="mdi mdi-calendar-check me-1"></i> Mark Attendance
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white">
                                        <div class="row text-center">
                                            <div class="col-6">
                                                <small class="text-muted">Max Capacity</small>
                                                <div class="fw-semibold"><%= cls.maximumStudents || 'Unlimited' %></div>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted">Class Teacher</small>
                                                <div class="fw-semibold"><%= cls.professorName || 'Not Assigned' %></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } 
                        } else { %>
                            <div class="col-12">
                                <div class="alert alert-info text-center">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    <h5>No Classes Assigned</h5>
                                    <p>You are not assigned to any classes yet. Please contact the school administrator.</p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Teacher Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        // Mark notification as read
        function markNotificationRead(notificationId) {
            fetch('/teacher/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Mark all notifications as read
        function markAllNotificationsRead() {
            fetch('/teacher/notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>
</html>