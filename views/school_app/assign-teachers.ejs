<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Assign Teachers - School Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="A fully featured admin theme" name="description">
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- App css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .assignment-card {
            transition: all 0.3s ease;
            border-radius: 12px;
        }
        .assignment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .teacher-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b5de7, #2a4cd0);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: bold;
        }
        .assignment-item {
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }
        .assignment-item:hover {
            background-color: #f8fafd;
            border-left-color: #3b5de7;
        }
        .btn-assign {
            background: linear-gradient(135deg, #3b5de7, #2a4cd0);
            border: none;
            border-radius: 25px;
            padding: 8px 25px;
            font-weight: 500;
        }
        .btn-assign:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(59,93,231,0.3);
        }
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
        }
        .filter-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- ========== Left Sidebar Start ========== -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-account-plus me-2"></i>Teacher Assignment
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Success Message -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <div class="row">
                        <!-- Assignment Form -->
                        <div class="col-lg-5">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">
                                        <i class="bi bi-plus-circle me-2 text-primary"></i>
                                        New Assignment
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <form id="assignmentForm">
                                        <div class="mb-3">
                                            <label class="form-label">Select Teacher</label>
                                            <select class="form-select" id="teacherId" name="teacherId" required>
                                                <option value="">-- Select Teacher --</option>
                                                <% if (teachers && teachers.length > 0) { 
                                                    for(var i = 0; i < teachers.length; i++) { 
                                                        var teacher = teachers[i]; %>
                                                        <option value="<%= teacher.id %>">
                                                            <%= teacher.firstName %> <%= teacher.lastName %> (<%= teacher.email %>)
                                                        </option>
                                                <% } 
                                                } else { %>
                                                    <option value="">No teachers available</option>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Select Class</label>
                                            <select class="form-select" id="classId" name="classId" required>
                                                <option value="">-- Select Class --</option>
                                                <% if (classes && classes.length > 0) { 
                                                    for(var i = 0; i < classes.length; i++) { 
                                                        var cls = classes[i]; %>
                                                        <option value="<%= cls.id %>">
                                                            <%= cls.className %> <%= cls.department ? '(' + cls.department + ')' : '' %> - <%= cls.level || '' %>
                                                        </option>
                                                <% } 
                                                } else { %>
                                                    <option value="">No classes available</option>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Select Subject</label>
                                            <select class="form-select" id="subjectId" name="subjectId" required>
                                                <option value="">-- Select Subject --</option>
                                                <% if (subjects && subjects.length > 0) { 
                                                    for(var i = 0; i < subjects.length; i++) { 
                                                        var subject = subjects[i]; %>
                                                        <option value="<%= subject.id %>">
                                                            <%= subject.name %> (<%= subject.subject_code %>)
                                                        </option>
                                                <% } 
                                                } else { %>
                                                    <option value="">No subjects available</option>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Academic Year</label>
                                            <select class="form-select" id="academicYear" name="academicYear" required>
                                                <option value="">-- Select Academic Year --</option>
                                                <% if (academicYears && academicYears.length > 0) { 
                                                    for(var i = 0; i < academicYears.length; i++) { 
                                                        var year = academicYears[i]; %>
                                                        <option value="<%= year %>"><%= year %></option>
                                                <% } 
                                                } else { %>
                                                    <option value="2023-2024">2023-2024</option>
                                                    <option value="2024-2025">2024-2025</option>
                                                <% } %>
                                            </select>
                                        </div>

                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-assign text-white" id="assignBtn">
                                                <i class="bi bi-check-circle me-2"></i> Assign Teacher
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Info Card -->
                            <div class="card mt-3">
                                <div class="card-body">
                                    <h6 class="text-primary"><i class="bi bi-info-circle me-2"></i>Information</h6>
                                    <p class="text-muted small mb-0">
                                        Assign teachers to specific classes and subjects for an academic year. 
                                        Teachers will be able to enter scores and manage attendance for their assigned classes.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Assignments List -->
                        <div class="col-lg-7">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">
                                        <i class="bi bi-list-check me-2 text-primary"></i>
                                        Current Assignments
                                        <span class="badge bg-primary ms-2"><%= assignments ? assignments.length : 0 %></span>
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Teacher</th>
                                                    <th>Class</th>
                                                    <th>Subject</th>
                                                    <th>Academic Year</th>
                                                    <th class="text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (assignments && assignments.length > 0) { 
                                                    for(var i = 0; i < assignments.length; i++) { 
                                                        var assignment = assignments[i]; %>
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <div class="teacher-avatar me-2">
                                                                        <%= assignment.firstName ? assignment.firstName.charAt(0) : 'T' %>
                                                                    </div>
                                                                    <div>
                                                                        <strong><%= assignment.firstName %> <%= assignment.lastName %></strong>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td><%= assignment.className %></td>
                                                            <td><%= assignment.subjectName %> (<%= assignment.subject_code || 'N/A' %>)</td>
                                                            <td><%= assignment.academic_year %></td>
                                                            <td class="text-center">
                                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteAssignment(<%= assignment.id %>)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                <% } 
                                                } else { %>
                                                    <tr>
                                                        <td colspan="5" class="text-center text-muted py-4">
                                                            <i class="bi bi-inbox fs-1"></i>
                                                            <p class="mt-2 mb-0">No assignments found</p>
                                                            <small>Use the form to assign teachers to classes and subjects</small>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - School Management System
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container"></div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script>
        $(document).ready(function() {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow', function() {
                    $(this).remove();
                });
            }, 5000);

            // Load subjects when class is selected
            $('#classId').change(function() {
                var classId = $(this).val();
                var subjectSelect = $('#subjectId');
                
                if (classId) {
                    subjectSelect.prop('disabled', true);
                    subjectSelect.html('<option value="">Loading subjects...</option>');
                    
                    $.ajax({
                        url: '/api/subjects-by-class',
                        method: 'GET',
                        data: { classId: classId },
                        success: function(response) {
                            if (response.success && response.subjects.length > 0) {
                                subjectSelect.html('<option value="">-- Select Subject --</option>');
                                for (var i = 0; i < response.subjects.length; i++) {
                                    subjectSelect.append('<option value="' + response.subjects[i].id + '">' + 
                                        response.subjects[i].name + ' (' + response.subjects[i].subject_code + ')</option>');
                                }
                                subjectSelect.prop('disabled', false);
                                showToast('Subjects loaded successfully', 'success');
                            } else {
                                subjectSelect.html('<option value="">No subjects available for this class</option>');
                                subjectSelect.prop('disabled', true);
                                showToast('No subjects found for this class', 'warning');
                            }
                        },
                        error: function() {
                            subjectSelect.html('<option value="">Error loading subjects</option>');
                            subjectSelect.prop('disabled', true);
                            showToast('Failed to load subjects', 'danger');
                        }
                    });
                } else {
                    subjectSelect.html('<option value="">-- Select Subject --</option>');
                    subjectSelect.prop('disabled', true);
                }
            });

            // Handle form submission
            $('#assignmentForm').on('submit', function(e) {
                e.preventDefault();
                
                var teacherId = $('#teacherId').val();
                var classId = $('#classId').val();
                var subjectId = $('#subjectId').val();
                var academicYear = $('#academicYear').val();
                
                if (!teacherId || !classId || !subjectId || !academicYear) {
                    showToast('Please fill in all fields', 'warning');
                    return;
                }
                
                var submitBtn = $('#assignBtn');
                var originalText = submitBtn.html();
                submitBtn.prop('disabled', true);
                submitBtn.html('<span class="spinner-border spinner-border-sm me-2"></span> Assigning...');
                
                $.ajax({
                    url: '/assign-teacher',
                    method: 'POST',
                    data: {
                        teacherId: teacherId,
                        classId: classId,
                        subjectId: subjectId,
                        academicYear: academicYear
                    },
                    success: function(response) {
                        if (response.success) {
                            showToast(response.message || 'Teacher assigned successfully', 'success');
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            showToast(response.error || 'Failed to assign teacher', 'danger');
                            submitBtn.prop('disabled', false);
                            submitBtn.html(originalText);
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = xhr.responseJSON ? xhr.responseJSON.error : 'Failed to assign teacher';
                        showToast(errorMsg, 'danger');
                        submitBtn.prop('disabled', false);
                        submitBtn.html(originalText);
                    }
                });
            });
        });
        
        // Delete assignment
        function deleteAssignment(assignmentId) {
            if (confirm('Are you sure you want to remove this assignment?')) {
                showLoading('Deleting assignment...');
                
                $.ajax({
                    url: '/delete-teacher-assignment/' + assignmentId,
                    method: 'DELETE',
                    success: function(response) {
                        hideLoading();
                        if (response.success) {
                            showToast('Assignment removed successfully', 'success');
                            setTimeout(function() {
                                location.reload();
                            }, 1000);
                        } else {
                            showToast(response.error || 'Failed to remove assignment', 'danger');
                        }
                    },
                    error: function() {
                        hideLoading();
                        showToast('Failed to remove assignment', 'danger');
                    }
                });
            }
        }
        
        // Show loading indicator
        function showLoading(message) {
            var overlay = document.createElement('div');
            overlay.id = 'loadingOverlay';
            overlay.style.position = 'fixed';
            overlay.style.top = '0';
            overlay.style.left = '0';
            overlay.style.width = '100%';
            overlay.style.height = '100%';
            overlay.style.backgroundColor = 'rgba(0,0,0,0.6)';
            overlay.style.zIndex = '9999';
            overlay.style.display = 'flex';
            overlay.style.alignItems = 'center';
            overlay.style.justifyContent = 'center';
            overlay.style.flexDirection = 'column';
            overlay.innerHTML = `
                <div class="spinner-border text-light" style="width: 50px; height: 50px;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="text-light mt-3" style="font-weight: 500;">${message}</div>
            `;
            document.body.appendChild(overlay);
        }
        
        function hideLoading() {
            var overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.remove();
        }
        
        // Show toast notification
        function showToast(message, type) {
            var container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-' + type + ' border-0 fade show';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            
            container.appendChild(toast);
            setTimeout(function() { toast.remove(); }, 5000);
        }
    </script>
</body>
</html>