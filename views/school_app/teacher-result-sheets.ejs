<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Result Sheets - Teacher Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .result-card {
            transition: all 0.3s ease;
            border-radius: 15px;
        }
        .stat-card {
            background: #3b5de7;
            color: white;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }
        .notification-unread {
            background-color: #e8f0fe;
            border-left: 3px solid #3b5de7;
        }
        .grade-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .grade-A { background: #10b981; color: white; }
        .grade-B { background: #34d399; color: white; }
        .grade-C { background: #fbbf24; color: #1e293b; }
        .grade-D { background: #f59e0b; color: white; }
        .grade-E { background: #f97316; color: white; }
        .grade-F { background: #ef4444; color: white; }
        .btn-print {
            background: #10b981;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            color: white;
            font-weight: 500;
        }
        .btn-print:hover {
            background: #059669;
        }
        .rank-badge {
            display: inline-block;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #e9ecef;
            text-align: center;
            line-height: 30px;
            font-weight: bold;
            font-size: 0.8rem;
        }
        .rank-1 { background: #fbbf24; color: #1e293b; }
        .rank-2 { background: #d1d5db; color: #1e293b; }
        .rank-3 { background: #fcd34d; color: #1e293b; }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/teacher-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/teacher-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-file-document me-2"></i>Result Sheets
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Selection Form -->
                    <div class="card mb-4">
                        <div class="card-header bg-white">
                            <h6 class="mb-0"><i class="mdi mdi-filter me-2 text-primary"></i>Generate Result Sheet</h6>
                        </div>
                        <div class="card-body">
                            <form method="GET" action="/teacher/result-sheets" class="row g-3" id="resultForm">
                                <div class="col-md-3">
                                    <label class="form-label">Class <span class="text-danger">*</span></label>
                                    <select name="classId" class="form-select" required onchange="this.form.submit()">
                                        <option value="">Select Class</option>
                                        <% if (teacherClasses && teacherClasses.length > 0) { 
                                            for(var i = 0; i < teacherClasses.length; i++) { 
                                                var cls = teacherClasses[i]; %>
                                                <option value="<%= cls.id %>" <%= selectedClassId == cls.id ? 'selected' : '' %>>
                                                    <%= cls.className %> <%= cls.department ? '(' + cls.department + ')' : '' %>
                                                </option>
                                        <% } 
                                        } else { %>
                                            <option value="">No classes assigned</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Subject <span class="text-danger">*</span></label>
                                    <select name="subjectId" class="form-select" required onchange="this.form.submit()" <%= !selectedClassId ? 'disabled' : '' %>>
                                        <option value="">Select Subject</option>
                                        <% if (classSubjects && classSubjects.length > 0) { 
                                            for(var i = 0; i < classSubjects.length; i++) { 
                                                var subj = classSubjects[i]; %>
                                                <option value="<%= subj.id %>" <%= selectedSubjectId == subj.id ? 'selected' : '' %>>
                                                    <%= subj.name %> (<%= subj.subject_code %>)
                                                </option>
                                        <% } 
                                        } else if (selectedClassId) { %>
                                            <option value="">No subjects assigned to this class</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Term</label>
                                    <select name="term" class="form-select" onchange="this.form.submit()">
                                        <% if (terms && terms.length > 0) { 
                                            for(var i = 0; i < terms.length; i++) { 
                                                var termItem = terms[i]; %>
                                                <option value="<%= termItem.term_name %>" <%= selectedTerm === termItem.term_name ? 'selected' : '' %>>
                                                    <%= termItem.term_name %>
                                                </option>
                                        <% } 
                                        } else { %>
                                            <option value="First Term">First Term</option>
                                            <option value="Second Term">Second Term</option>
                                            <option value="Third Term">Third Term</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Academic Year</label>
                                    <select name="academicYear" class="form-select" onchange="this.form.submit()">
                                        <% if (academicYears && academicYears.length > 0) { 
                                            for(var i = 0; i < academicYears.length; i++) { 
                                                var year = academicYears[i]; %>
                                                <option value="<%= year.year_name %>" <%= selectedAcademicYear === year.year_name ? 'selected' : '' %>>
                                                    <%= year.year_name %>
                                                </option>
                                        <% } 
                                        } else { %>
                                            <option value="2023-2024">2023-2024</option>
                                            <option value="2024-2025">2024-2025</option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">&nbsp;</label>
                                    <div>
                                        <button type="button" class="btn btn-print w-100" onclick="printResultSheet()">
                                            <i class="mdi mdi-printer me-1"></i> Print
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <% if (selectedClassId && selectedSubjectId && resultData && resultData.length > 0) { %>
                        <!-- School Header -->
                        <div class="text-center mb-4">
                            <h3><%= schoolInfo ? schoolInfo.name : 'School Name' %></h3>
                            <p><%= schoolInfo ? schoolInfo.address : '' %></p>
                            <p><%= schoolInfo ? schoolInfo.email + ' | ' + schoolInfo.phone : '' %></p>
                            <hr>
                            <h4>Result Sheet</h4>
                            <h5><%= subjectInfo ? subjectInfo.name : '' %> - <%= classInfo ? classInfo.className : '' %></h5>
                            <p><%= selectedTerm %> | <%= selectedAcademicYear %></p>
                        </div>

                        <!-- Statistics Summary -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-number"><%= statistics.totalStudents %></div>
                                    <div>Total Students</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card" style="background: #10b981;">
                                    <div class="stat-number"><%= statistics.averageScore %>%</div>
                                    <div>Average Score</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card" style="background: #f59e0b;">
                                    <div class="stat-number"><%= statistics.passRate %>%</div>
                                    <div>Pass Rate</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card" style="background: #8b5cf6;">
                                    <div class="stat-number"><%= statistics.highestScore %>%</div>
                                    <div>Highest Score</div>
                                </div>
                            </div>
                        </div>

                        <!-- Gender Performance -->
                        <div class="card mb-4">
                            <div class="card-header bg-white">
                                <h6 class="mb-0"><i class="mdi mdi-gender-male-female me-2 text-primary"></i>Performance by Gender</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6 text-center">
                                        <div class="p-3 border rounded">
                                            <h5>Male Students</h5>
                                            <div class="display-4"><%= statistics.performanceByGender.male.average %>%</div>
                                            <p>Average Score</p>
                                            <small>Count: <%= statistics.performanceByGender.male.count %> students</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-center">
                                        <div class="p-3 border rounded">
                                            <h5>Female Students</h5>
                                            <div class="display-4"><%= statistics.performanceByGender.female.average %>%</div>
                                            <p>Average Score</p>
                                            <small>Count: <%= statistics.performanceByGender.female.count %> students</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Result Table -->
                        <div class="card">
                            <div class="card-header bg-white">
                                <h6 class="mb-0"><i class="mdi mdi-table me-2 text-primary"></i>Student Results</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>S/N</th>
                                                <th>Admission No.</th>
                                                <th>Student Name</th>
                                                <th>Gender</th>
                                                <th class="text-center">Test (40)</th>
                                                <th class="text-center">Exam (60)</th>
                                                <th class="text-center">Total (100)</th>
                                                <th class="text-center">Grade</th>
                                                <th>Remark</th>
                                                <th class="text-center">Position</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% for(var i = 0; i < resultData.length; i++) { 
                                                var student = resultData[i];
                                                var rankClass = '';
                                                if (student.rank === 1) rankClass = 'rank-1';
                                                else if (student.rank === 2) rankClass = 'rank-2';
                                                else if (student.rank === 3) rankClass = 'rank-3';
                                            %>
                                                <tr>
                                                    <td><%= i + 1 %></td>
                                                    <td><%= student.admissionNumber || 'N/A' %></td>
                                                    <td><strong><%= student.fullName %></strong></td>
                                                    <td><%= student.gender || 'N/A' %></td>
                                                    <td class="text-center"><%= student.testScore %></td>
                                                    <td class="text-center"><%= student.examScore %></td>
                                                    <td class="text-center"><strong><%= student.totalScore %></strong></td>
                                                    <td class="text-center">
                                                        <span class="grade-badge <%= student.gradeClass %>">
                                                            <%= student.grade %>
                                                        </span>
                                                    </td>
                                                    <td><%= student.performance %></td>
                                                    <td class="text-center"><span class="rank-badge <%= rankClass %>"><%= student.rank %></span></td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="text-muted small">
                                            <i class="mdi mdi-information-outline me-1"></i>
                                            Grade Scale: A (80-100), B (70-79), C (60-69), D (50-59), E (40-49), F (0-39)
                                        </div>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <div class="text-muted small">
                                            Generated on: <%= moment().format('MMMM D, YYYY h:mm A') %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else if (selectedClassId && selectedSubjectId && (!resultData || resultData.length === 0)) { %>
                        <div class="alert alert-info text-center">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            <h5>No Results Found</h5>
                            <p>No scores have been entered for this class and subject yet.</p>
                            <a href="/teacher/manage-scores?classId=<%= selectedClassId %>&subjectId=<%= selectedSubjectId %>" class="btn btn-primary mt-2">
                                <i class="mdi mdi-clipboard-list"></i> Enter Scores
                            </a>
                        </div>
                    <% } else if (selectedClassId && !selectedSubjectId) { %>
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
                            <h5>Select a Subject</h5>
                            <p>Please select a subject to generate the result sheet.</p>
                        </div>
                    <% } else if (!selectedClassId) { %>
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
                            <h5>Select a Class</h5>
                            <p>Please select a class and subject to generate the result sheet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Teacher Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        function markNotificationRead(notificationId) {
            fetch('/teacher/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        function markAllNotificationsRead() {
            fetch('/teacher/notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        function printResultSheet() {
            var classId = '<%= selectedClassId %>';
            var subjectId = '<%= selectedSubjectId %>';
            var term = '<%= selectedTerm %>';
            var academicYear = '<%= selectedAcademicYear %>';
            
            if (!classId || !subjectId) {
                showToast('Please select class and subject first', 'warning');
                return;
            }
            
            window.open('/teacher/result-sheets/print?classId=' + classId + '&subjectId=' + subjectId + '&term=' + term + '&academicYear=' + academicYear, '_blank');
        }
        
        function showToast(message, type) {
            var container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-' + type + ' border-0 fade show';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'info' ? 'info-circle' : 'exclamation-triangle'} me-2"></i>
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            
            container.appendChild(toast);
            setTimeout(function() { toast.remove(); }, 3000);
        }
        
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>
</html>