    <!-- bundle -->
    <script src="assets/js/vendor.min.js"></script>
    <script src="assets/js/app.min.js"></script>

    <script>
        function calculateTotal(input, index) {
            const row = input.closest('tr');
            const testScore = parseFloat(row.querySelector('input[name="testScores"]').value) || 0;
            const examScore = parseFloat(row.querySelector('input[name="examScores"]').value) || 0;
            const totalElement = document.getElementById('total-' + index);
            const gradeElement = document.getElementById('grade-' + index);
            
            const totalScore = testScore + examScore;
            totalElement.textContent = totalScore.toFixed(1);
            
            // Update grade
            let grade = 'F';
            let gradeClass = 'low-score';
            if (totalScore >= 80) {
                grade = 'A';
                gradeClass = 'high-score';
            } else if (totalScore >= 70) {
                grade = 'B';
                gradeClass = 'high-score';
            } else if (totalScore >= 60) {
                grade = 'C';
                gradeClass = 'medium-score';
            } else if (totalScore >= 50) {
                grade = 'D';
                gradeClass = 'medium-score';
            } else if (totalScore >= 40) {
                grade = 'E';
                gradeClass = 'low-score';
            }
            
            gradeElement.textContent = grade;
            gradeElement.className = `fw-bold ${gradeClass}`;
            
            // Update color of total score
            if (totalScore >= 80) {
                totalElement.className = 'total-score high-score';
            } else if (totalScore >= 60) {
                totalElement.className = 'total-score medium-score';
            } else {
                totalElement.className = 'total-score low-score';
            }
        }
        
        function validateScore(input, max) {
            let value = parseFloat(input.value);
            if (isNaN(value)) {
                input.value = 0;
            } else if (value > max) {
                input.value = max;
            } else if (value < 0) {
                input.value = 0;
            }
            
            // Round to nearest 0.5
            if (value % 1 !== 0 && value % 1 !== 0.5) {
                input.value = Math.round(value * 2) / 2;
            }
        }
        
        function clearAllScores() {
            if (confirm('Are you sure you want to clear all scores?')) {
                document.querySelectorAll('input[type="number"]').forEach(input => {
                    input.value = 0;
                    const index = input.name === 'testScores' ? 
                        Array.from(document.querySelectorAll('input[name="testScores"]')).indexOf(input) : 
                        Array.from(document.querySelectorAll('input[name="examScores"]')).indexOf(input);
                    calculateTotal(input, index);
                });
            }
        }
        
        // Auto-calculate all totals on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[type="number"]').forEach(input => {
                const index = input.name === 'testScores' ? 
                    Array.from(document.querySelectorAll('input[name="testScores"]')).indexOf(input) : 
                    Array.from(document.querySelectorAll('input[name="examScores"]')).indexOf(input);
                calculateTotal(input, index);
            });
            
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
</body>
