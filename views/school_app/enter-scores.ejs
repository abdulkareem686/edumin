    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        .required-field::after {
            content: " *";
            color: red;
        }
        .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
        }
        .form-section-title {
            color: #3b5de7;
            border-bottom: 2px solid #3b5de7;
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
        }
        .score-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .info-item {
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
        }
        .info-label {
            font-weight: 600;
            color: #495057;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        .info-value {
            color: #6c757d;
            font-size: 1rem;
        }
        .badge-department {
            background: linear-gradient(135deg, #6f42c1 0%, #8b5cf6 100%);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        .badge-subject {
            background: linear-gradient(135deg, #3b5de7 0%, #4e54c8 100%);
            color: white;
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
        }
        .score-input {
            text-align: center;
            font-weight: 600;
            width: 100px;
            margin: 0 auto;
        }
        .total-score {
            font-weight: 700;
            font-size: 1.1rem;
            color: #3b5de7;
            background: #f8f9fa;
            padding: 0.5rem;
            border-radius: 8px;
            min-width: 70px;
            display: inline-block;
            text-align: center;
        }
        .high-score {
            color: #10b981 !important;
        }
        .medium-score {
            color: #f59e0b !important;
        }
        .low-score {
            color: #ef4444 !important;
        }
        .score-status {
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 0.25rem;
        }
        .table-container {
            overflow-x: auto;
            border-radius: 0.5rem;
            margin: 1.5rem 0;
        }
        .table th {
            background-color: #f8f9fa;
            color: #495057;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
        }
        .table td {
            text-align: center;
            vertical-align: middle;
        }
        .table-hover tbody tr:hover {
            background-color: rgba(59, 93, 231, 0.05);
        }
        .student-info {
            text-align: left;
        }
        .student-name {
            font-weight: 600;
            color: #2d3748;
        }
        .student-id {
            font-size: 0.75rem;
            color: #6b7280;
        }
        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
            flex-wrap: wrap;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            .table {
                font-size: 11px;
            }
        }
    </style>
</head>

