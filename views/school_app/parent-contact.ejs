<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Contact School - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .contact-card {
            transition: all 0.3s ease;
            border-radius: 15px;
            height: 100%;
        }
        .contact-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
        .info-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }
        .info-icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        .social-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            cursor: pointer;
        }
        .social-icon:hover {
            transform: translateY(-3px);
        }
        .notification-unread {
            background-color: #e8f0fe;
            border-left: 3px solid #3b5de7;
        }
        .btn-send {
            background: linear-gradient(135deg, #3b5de7, #2a4cd0);
            border: none;
            padding: 10px 30px;
            border-radius: 25px;
            font-weight: 500;
        }
        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(59,93,231,0.3);
        }
        .form-control:focus, .form-select:focus {
            border-color: #3b5de7;
            box-shadow: 0 0 0 0.2rem rgba(59,93,231,0.25);
        }
        .child-card {
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .child-card:hover {
            background: #f8fafd;
            border-color: #3b5de7;
        }
        .child-name {
            font-weight: 600;
            color: #1e293b;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/parent-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-email me-2"></i>Contact School
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Success Message -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Error Message -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <div class="row">
                        <!-- Left Column - Contact Form -->
                        <div class="col-lg-7">
                            <div class="card contact-card">
                                <div class="card-header bg-white">
                                    <h5 class="mb-0">
                                        <i class="bi bi-chat-text me-2 text-primary"></i>
                                        Send us a Message
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <form action="/parent/contact/send" method="POST">
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="bi bi-person me-1"></i> Your Name
                                            </label>
                                            <input type="text" class="form-control" value="<%= parentName %>" readonly disabled>
                                            <small class="text-muted">Your name is automatically included</small>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="bi bi-envelope me-1"></i> Your Email
                                            </label>
                                            <input type="email" class="form-control" value="<%= parentEmail %>" readonly disabled>
                                            <small class="text-muted">We'll respond to this email address</small>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="bi bi-tag me-1"></i> Subject <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" name="subject" placeholder="e.g., Fee Payment Inquiry, Academic Concerns, etc." required>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="bi bi-folder me-1"></i> Category
                                            </label>
                                            <select class="form-select" name="category">
                                                <option value="general">General Inquiry</option>
                                                <option value="academic">Academic Concerns</option>
                                                <option value="fees">Fee Payment</option>
                                                <option value="attendance">Attendance Issues</option>
                                                <option value="complaint">Complaint</option>
                                                <option value="suggestion">Suggestion</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label">
                                                <i class="bi bi-chat-dots me-1"></i> Message <span class="text-danger">*</span>
                                            </label>
                                            <textarea class="form-control" name="message" rows="6" placeholder="Please provide detailed information about your inquiry..." required></textarea>
                                            <small class="text-muted">Maximum 2000 characters</small>
                                        </div>
                                        
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-send text-white">
                                                <i class="bi bi-send me-2"></i> Send Message
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Contact Information -->
                        <div class="col-lg-5">
                            <!-- School Information Card -->
                            <div class="info-card">
                                <div class="text-center">
                                    <i class="bi bi-building info-icon"></i>
                                    <h4 class="text-white mb-2"><%= school.name %></h4>
                                    <p class="mb-3 text-white-50"><%= school.address %></p>
                                    <hr class="bg-white opacity-25">
                                    <div class="row mt-3">
                                        <div class="col-12 mb-2">
                                            <i class="bi bi-telephone-fill me-2"></i> 
                                            <a href="tel:<%= school.phone %>" class="text-white text-decoration-none"><%= school.phone %></a>
                                        </div>
                                        <div class="col-12 mb-2">
                                            <i class="bi bi-envelope-fill me-2"></i> 
                                            <a href="mailto:<%= school.email %>" class="text-white text-decoration-none"><%= school.email %></a>
                                        </div>
                                        <div class="col-12 mb-2">
                                            <i class="bi bi-globe me-2"></i> 
                                            <a href="https://<%= school.website %>" target="_blank" class="text-white text-decoration-none"><%= school.website %></a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Office Hours Card -->
                            <div class="card contact-card mt-4">
                                <div class="card-body">
                                    <h6 class="mb-3">
                                        <i class="bi bi-clock-history me-2 text-primary"></i>
                                        Office Hours
                                    </h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Monday - Friday:</span>
                                        <strong>8:00 AM - 4:00 PM</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Saturday:</span>
                                        <strong>9:00 AM - 12:00 PM</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Sunday:</span>
                                        <strong>Closed</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Emergency Contact Card -->
                            <div class="card contact-card mt-4 border-danger">
                                <div class="card-body">
                                    <h6 class="mb-3 text-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        Emergency Contact
                                    </h6>
                                    <div class="text-center">
                                        <p class="mb-2">For urgent matters outside office hours:</p>
                                        <h5 class="text-danger mb-0">
                                            <i class="bi bi-telephone-fill me-2"></i>
                                            +234 812 345 6789
                                        </h5>
                                    </div>
                                </div>
                            </div>

                            <!-- Response Time Card -->
                            <div class="card contact-card mt-4 bg-light">
                                <div class="card-body text-center">
                                    <i class="bi bi-clock fs-1 text-primary mb-2 d-block"></i>
                                    <h6>Response Time</h6>
                                    <p class="small text-muted mb-0">
                                        We typically respond to messages within 24-48 business hours.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Parent Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        // Mark notification as read
        function markNotificationRead(notificationId) {
            fetch('/parent/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Mark all notifications as read
        function markAllNotificationsRead() {
            fetch('/parent/notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>
</html>