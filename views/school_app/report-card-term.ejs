<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report Card - <%= student.firstName %> <%= student.lastName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            .container { max-width: 100% !important; }
            body { font-size: 12px; }
            .bill-notice { page-break-inside: avoid; }
            .progress-container { display: none; }
        }
        
        /* Import styling from bills page */
        .progress-container {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .academic-progress {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .progress-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 20px 0;
        }
        .progress-step {
            text-align: center;
            position: relative;
            z-index: 2;
        }
        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-weight: bold;
            border: 3px solid #fff;
        }
        .step-active .step-number {
            background: #0d6efd;
            color: white;
        }
        .step-completed .step-number {
            background: #198754;
            color: white;
        }
        .progress-bar-line {
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            height: 3px;
            background: #e9ecef;
            z-index: 1;
        }
        .status-badge {
            font-size: 0.85em;
            padding: 0.4em 0.8em;
        }
        
        /* Report card specific styling */
        .report-card { 
            border: 2px solid #000; 
            padding: 20px; 
            margin: 20px auto; 
            max-width: 1000px; 
            border-radius: 10px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .school-header { 
            text-align: center; 
            margin-bottom: 30px; 
            border-bottom: 2px solid #000; 
            padding-bottom: 20px; 
        }
        .school-logo { 
            max-width: 100px; 
            margin-bottom: 10px; 
        }
        .student-info { 
            margin-bottom: 30px; 
        }
        .info-table { 
            width: 100%; 
            margin-bottom: 20px; 
        }
        .info-table td { 
            padding: 5px; 
            vertical-align: top; 
        }
        .scores-table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-bottom: 30px; 
            font-size: 12px; 
        }
        .scores-table th, .scores-table td { 
            border: 1px solid #000; 
            padding: 8px; 
            text-align: center; 
        }
        .scores-table th { 
            background-color: #f8f9fa; 
            font-weight: bold; 
        }
        .summary-section { 
            margin-bottom: 30px; 
        }
        .summary-box { 
            border: 1px solid #000; 
            padding: 15px; 
            margin-bottom: 20px; 
            border-radius: 5px;
        }
        .comments-section { 
            margin-bottom: 30px; 
        }
        .signatures { 
            display: flex; 
            justify-content: space-between; 
            margin-top: 50px; 
        }
        .signature-box { 
            text-align: center; 
            width: 30%; 
        }
        .signature-line { 
            border-top: 1px solid #000; 
            margin-top: 40px; 
            padding-top: 5px; 
        }
        .grade-A { background-color: #d4edda; }
        .grade-B { background-color: #c3e6cb; }
        .grade-C { background-color: #fff3cd; }
        .grade-D { background-color: #ffeaa7; }
        .grade-E { background-color: #f8d7da; }
        .grade-F { background-color: #f5c6cb; }
        .bill-notice { 
            background-color: #e3f2fd; 
            border-left: 4px solid #2196f3; 
            padding: 15px; 
            margin: 20px 0; 
            border-radius: 5px;
        }
        .next-term-info { 
            background-color: #f3e5f5; 
            border-left: 4px solid #9c27b0; 
            padding: 15px; 
            margin: 20px 0; 
            border-radius: 5px;
        }
        .book-list { 
            font-size: 11px; 
        }
        .card-header {
            background-color: rgba(0, 0, 0, 0.03);
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        }
        .page-title-box {
            padding: 10px 0;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <div class="page-title-right">
                        <a href="/student-profile/<%= student.id %>" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Profile
                        </a>
                    </div>
                    <h4 class="page-title">
                        <i class="bi bi-file-text"></i> Report Card - <%= student.firstName %> <%= student.lastName %>
                    </h4>
                </div>
            </div>
        </div>

        <!-- Academic Progress Visualization -->
        <div class="row">
            <div class="col-12">
                <div class="progress-container">
                    <div class="academic-progress">
                        <div>
                            <h5 class="mb-1">Academic Progress</h5>
                            <p class="text-muted mb-0">Current: <%= term %> <%= academicYear %></p>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-1">
                                <% if (term === 'First Term') { %>
                                    Next: Second Term <%= academicYear %>
                                <% } else if (term === 'Second Term') { %>
                                    Next: Third Term <%= academicYear %>
                                <% } else if (term === 'Third Term') { %>
                                    <% 
                                    const yearParts = academicYear.split('-');
                                    const nextYear = yearParts.length === 2 ? `${yearParts[1]}-${parseInt(yearParts[1]) + 1}` : 'Next Academic Year';
                                    %>
                                    Next: First Term <%= nextYear %>
                                <% } else { %>
                                    Next Term
                                <% } %>
                            </h5>
                            <span class="badge bg-info">
                                <%= term %> Report
                            </span>
                        </div>
                    </div>
                    
                    <div class="progress-steps">
                        <div class="progress-bar-line"></div>
                        <div class="progress-step <%= term === 'First Term' ? 'step-active' : 'step-completed' %>">
                            <div class="step-number">1</div>
                            <small>First Term<br><%= academicYear %></small>
                        </div>
                        <div class="progress-step <%= term === 'Second Term' ? 'step-active' : (term === 'Third Term' ? 'step-completed' : '') %>">
                            <div class="step-number">2</div>
                            <small>Second Term<br><%= academicYear %></small>
                        </div>
                        <div class="progress-step <%= term === 'Third Term' ? 'step-active' : '' %>">
                            <div class="step-number">3</div>
                            <small>Third Term<br><%= academicYear %></small>
                        </div>
                        <div class="progress-step">
                            <div class="step-number">4</div>
                            <small>First Term<br>
                                <% 
                                const yearParts = academicYear.split('-');
                                if (yearParts.length === 2) {
                                    const nextYear = `${yearParts[1]}-${parseInt(yearParts[1]) + 1}`;
                                %>
                                    <%= nextYear %>
                                <% } else { %>
                                    Next Year
                                <% } %>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Student Information Card -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-badge"></i> Student Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-grow-1">
                                <h6 class="mb-1"><%= student.firstName %> <%= student.middleName || '' %> <%= student.lastName %></h6>
                                <p class="text-muted mb-0">Admission: <%= student.admission_number %></p>
                            </div>
                        </div>
                        
                        <div class="student-details">
                            <div class="mb-2">
                                <small class="text-muted">Class:</small>
                                <p class="mb-0"><%= student.className %></p>
                            </div>
                            <% if (student.classDepartment) { %>
                            <div class="mb-2">
                                <small class="text-muted">Department:</small>
                                <p class="mb-0"><%= student.classDepartment %></p>
                            </div>
                            <% } %>
                            <div class="mb-2">
                                <small class="text-muted">Term:</small>
                                <p class="mb-0">
                                    <span class="badge bg-success"><%= term %></span>
                                    <%= academicYear %>
                                </p>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Gender:</small>
                                <p class="mb-0"><%= student.gender || 'N/A' %></p>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">Date of Birth:</small>
                                <p class="mb-0"><%= student.dateOfBirth ? moment(student.dateOfBirth).format('MMMM D, YYYY') : 'N/A' %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Academic Summary Card -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-graph-up"></i> Academic Summary
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="border-start border-4 border-primary ps-3 mb-3">
                            <small class="text-muted">Average Score</small>
                            <h3 class="text-primary"><%= termAverage %></h3>
                        </div>
                        <div class="border-start border-4 border-success ps-3 mb-3">
                            <small class="text-muted">Overall Grade</small>
                            <h4 class="text-success"><%= termGrade %></h4>
                            <p class="mb-0"><%= gradeRemark %></p>
                        </div>
                        <div class="border-start border-4 border-info ps-3">
                            <small class="text-muted">Attendance Rate</small>
                            <h4 class="text-info">
                                <%= attendance.total_days > 0 ? ((attendance.present_days / attendance.total_days) * 100).toFixed(1) : 0 %>%
                            </h4>
                        </div>
                    </div>
                </div>

                
            </div>

            <!-- Main Content Area -->
            <div class="col-md-8">
                <!-- Report Card Content -->
                <div class="report-card">
                    <!-- School Header -->
                    <div class="school-header">
                        <% if (school.logo) { %>
                        <img src="<%= school.logo %>" alt="School Logo" class="school-logo">
                        <% } %>
                        <h1 class="mb-1"><%= school.name %></h1>
                        <p class="mb-1"><%= school.address %></p>
                        <p class="mb-1">Phone: <%= school.phone %> | Email: <%= school.email %></p>
                        <% if (school.motto) { %>
                        <p class="mb-0 fst-italic">"<%= school.motto %>"</p>
                        <% } %>
                        <h2 class="mt-3">STUDENT REPORT CARD</h2>
                        <h3><%= term %> - <%= academicYear %></h3>
                    </div>
                    
                    <!-- Student Information -->
                    <div class="student-info">
                        <table class="info-table">
                            <tr>
                                <td width="25%"><strong>Student Name:</strong></td>
                                <td width="25%"><%= student.firstName %> <%= student.middleName %> <%= student.lastName %></td>
                                <td width="25%"><strong>Admission Number:</strong></td>
                                <td width="25%"><%= student.admission_number %></td>
                            </tr>
                            <tr>
                                <td><strong>Class:</strong></td>
                                <td><%= student.className %></td>
                                <td><strong>Department:</strong></td>
                                <td><%= student.classDepartment || 'N/A' %></td>
                            </tr>
                            <tr>
                                <td><strong>Gender:</strong></td>
                                <td><%= student.gender || 'N/A' %></td>
                                <td><strong>Date of Birth:</strong></td>
                                <td><%= student.dateOfBirth ? moment(student.dateOfBirth).format('MMMM D, YYYY') : 'N/A' %></td>
                            </tr>
                        </table>
                    </div>
                    
                    <!-- Academic Performance -->
                    <h4>ACADEMIC PERFORMANCE</h4>
                    <table class="scores-table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Code</th>
                                <th>Test (40%)</th>
                                <th>Exam (60%)</th>
                                <th>Total (100%)</th>
                                <th>Grade</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% scores.forEach(score => { %>
                            <tr class="grade-<%= score.grade %>">
                                <td class="text-start"><%= score.subject_name %></td>
                                <td><%= score.subject_code %></td>
                                <td><%= score.test_score || '-' %></td>
                                <td><%= score.exam_score || '-' %></td>
                                <td><strong><%= score.formattedTotal %></strong></td>
                                <td><strong><%= score.grade %></strong></td>
                                <td class="text-start"><%= score.remark %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                    
                    <!-- Summary Section -->
                    <div class="row summary-section">
                        <div class="col-md-6">
                            <div class="summary-box">
                                <h5>ACADEMIC SUMMARY</h5>
                                <table class="info-table">
                                    <tr>
                                        <td><strong>Total Subjects:</strong></td>
                                        <td><%= subjectCount %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Score:</strong></td>
                                        <td><%= termTotal %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Average Score:</strong></td>
                                        <td><%= termAverage %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Percentage:</strong></td>
                                        <td><%= termPercentage %>%</td>
                                    </tr>
                                    <tr>
                                        <td><strong>Overall Grade:</strong></td>
                                        <td><strong><%= termGrade %> - <%= gradeRemark %></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="summary-box">
                                <h5>ATTENDANCE SUMMARY</h5>
                                <table class="info-table">
                                    <tr>
                                        <td><strong>Days Present:</strong></td>
                                        <td><%= attendance.present_days %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Days Absent:</strong></td>
                                        <td><%= attendance.absent_days %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Days Late:</strong></td>
                                        <td><%= attendance.late_days %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Days Excused:</strong></td>
                                        <td><%= attendance.excused_days %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total School Days:</strong></td>
                                        <td><%= attendance.total_days %></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Attendance Rate:</strong></td>
                                        <td><%= attendance.total_days > 0 ? ((attendance.present_days / attendance.total_days) * 100).toFixed(1) : 0 %>%</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Next Term Information -->
                    <div class="next-term-info">
                        <h5><i class="bi bi-info-circle"></i> NEXT TERM INFORMATION</h5>
                        <p><strong>Next Academic Term:</strong> 
                            <% if (term === 'First Term') { %>
                                Second Term <%= academicYear %>
                            <% } else if (term === 'Second Term') { %>
                                Third Term <%= academicYear %>
                            <% } else if (term === 'Third Term') { %>
                                <% 
                                // Calculate next academic year
                                const yearParts = academicYear.split('-');
                                const nextYear = yearParts.length === 2 ? `${yearParts[1]}-${parseInt(yearParts[1]) + 1}` : 'Next Academic Year';
                                %>
                                First Term <%= nextYear %>
                            <% } else { %>
                                To be determined
                            <% } %>
                        </p>
                        
                        <p><strong>Resumption Date:</strong> 
                            <% if (term === 'First Term') { %>
                                January 15, <%= academicYear.split('-')[1] %>
                            <% } else if (term === 'Second Term') { %>
                                April 15, <%= academicYear.split('-')[1] %>
                            <% } else if (term === 'Third Term') { %>
                                <% 
                                const yearParts = academicYear.split('-');
                                const nextYear = yearParts.length === 2 ? parseInt(yearParts[1]) + 1 : new Date().getFullYear() + 1;
                                %>
                                September 15, <%= nextYear %>
                            <% } else { %>
                                To be announced
                            <% } %>
                        </p>
                    </div>

                    <!-- Comments Section -->
                    <div class="comments-section">
                        <h4>COMMENTS</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="summary-box">
                                    <h5>CLASS TEACHER'S REMARK</h5>
                                    <p class="fst-italic">"<%= teacherComment.comment %>"</p>
                                    <p class="text-end mb-0"><strong><%= teacherComment.comment_by %></strong></p>
                                    <p class="text-end"><%= moment(teacherComment.comment_date).format('MMMM D, YYYY') %></p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="summary-box">
                                    <h5>PRINCIPAL'S REMARK</h5>
                                    <p class="fst-italic">"<%= principalComment.comment %>"</p>
                                    <p class="text-end mb-0"><strong><%= principalComment.comment_by %></strong></p>
                                    <p class="text-end"><%= moment(principalComment.comment_date).format('MMMM D, YYYY') %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Signatures -->
                    <div class="signatures">
                        <div class="signature-box">
                            <div class="signature-line"></div>
                            <p>Class Teacher's Signature</p>
                        </div>
                        <div class="signature-box">
                            <div class="signature-line"></div>
                            <p>Principal's Signature</p>
                        </div>
                        <div class="signature-box">
                            <div class="signature-line"></div>
                            <p>Parent's/Guardian's Signature</p>
                        </div>
                    </div>
                    
                    <!-- Footer -->
                    <div class="text-center mt-4">
                        <p class="text-muted">Generated on: <%= moment().format('MMMM D, YYYY h:mm A') %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    function generateNextTermBill() {
        // Get values from EJS template
        const currentTerm = '<%= term %>';
        const currentAcademicYear = '<%= academicYear %>';
        const studentId = '<%= student.id %>';
        
        // Determine next term and academic year
        let nextTerm = '';
        let nextAcademicYear = currentAcademicYear;
        
        switch(currentTerm) {
            case 'First Term':
                nextTerm = 'Second Term';
                break;
            case 'Second Term':
                nextTerm = 'Third Term';
                break;
            case 'Third Term':
                nextTerm = 'First Term';
                // Calculate next academic year
                const yearParts = currentAcademicYear.split('-');
                if (yearParts.length === 2) {
                    nextAcademicYear = `${yearParts[1]}-${parseInt(yearParts[1]) + 1}`;
                }
                break;
            default:
                alert('Cannot determine next term');
                return;
        }
        
        if (confirm(`Generate ${nextTerm} ${nextAcademicYear} bill for this student?`)) {
            fetch('/generate-student-bills', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    studentId: studentId,
                    term: nextTerm,
                    academicYear: nextAcademicYear
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`Bill generated successfully for ${nextTerm} ${nextAcademicYear}!`);
                    // Redirect to view the generated bill
                    window.location.href = `/student-bills/${studentId}`;
                } else {
                    alert('Error: ' + data.error);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to generate bill');
            });
        }
    }
    </script>
</body>
</html>