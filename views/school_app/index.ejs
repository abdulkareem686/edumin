<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Admin Dashboard | EduSuite</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Core Icons & Styles -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link href="/assets/css/school-dashboard.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Left Sidebar -->
        <%- include('partials/admin-sidebar') %>
        
        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid edu-dashboard pt-3 pb-4">
                    <!-- Page Header Breadcrumb -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="page-title-box d-flex align-items-center justify-content-between">
                                <h4 class="page-title mb-0" style="font-family: 'Outfit', sans-serif; font-weight: 700;">
                                    <i class="mdi mdi-view-dashboard-outline me-2 text-primary"></i> Executive Dashboard
                                </h4>
                                <div class="page-title-right d-none d-md-block">
                                    <span class="text-muted small">
                                        <i class="mdi mdi-clock-outline me-1"></i>
                                        <%= moment().format('dddd, MMMM D, YYYY') %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Hero Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="edu-dash-hero-inner p-4 rounded-4 text-white shadow-sm"
                                style="background: linear-gradient(#4338ca 100%);">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                <i class="mdi mdi-shield-crown-outline me-1"></i> ADMINISTRATOR PORTAL
                                            </span>
                                        </div>
                                        <h2 class="text-white mb-2 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                            Welcome back, <%= typeof username !== 'undefined' && username ? username : 'Administrator' %>!
                                        </h2>
                                        <p class="mb-0 text-white-50" style="max-width: 620px; font-size: 0.95rem;">
                                            Here is your real-time academic pulse, term progress calculation, staff activities, and financial metrics.
                                        </p>
                                    </div>

                                    <!-- Top Hero Badges with Current School Week -->
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <!-- Current School Week Live Badge -->
                                        <div class="school-week-hero-pill shadow-sm">
                                            <span class="pulse-indicator"></span>
                                            <i class="mdi mdi-calendar-clock text-warning"></i>
                                            <span class="fw-bold"><%= typeof weekLabel !== 'undefined' && weekLabel ? weekLabel : 'Week 1' %></span>
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill ms-1" style="font-size: 0.725rem;">
                                                <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                            </span>
                                        </div>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-calendar-range me-1 text-info"></i>
                                            <%= currentAcademicYear %>
                                        </span>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-book-open-page-variant me-1 text-success"></i>
                                            <%= currentTerm %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current School Week & Term Calculation Widget -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="school-week-card">
                                <div class="school-week-header">
                                    <h5 class="school-week-header-title">
                                        <i class="mdi mdi-calculator-variant-outline"></i>
                                        Academic Term & School Week Engine
                                    </h5>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (typeof weekStartDate !== 'undefined' && weekStartDate) { %>
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill border">
                                                <i class="mdi mdi-calendar-check text-primary me-1"></i>
                                                This Week: <strong><%= weekStartDate %> – <%= typeof weekEndDate !== 'undefined' ? weekEndDate : '' %></strong>
                                            </span>
                                        <% } %>
                                        <span class="week-status-badge">
                                            <i class="mdi mdi-check-circle"></i> <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                        </span>
                                    </div>
                                </div>

                                <div class="school-week-body">
                                    <div class="row align-items-center g-4">
                                        <!-- Week Main Highlight -->
                                        <div class="col-lg-5">
                                            <div class="week-display-banner m-0">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="week-display-label text-uppercase">Current Term Progress</div>
                                                        <div class="week-display-number">
                                                            <%= typeof shortWeekLabel !== 'undefined' && shortWeekLabel ? shortWeekLabel : ('Week ' + (typeof currentWeek !== 'undefined' ? currentWeek : 1)) %>
                                                        </div>
                                                        <div class="text-white-50 small">
                                                            Out of <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %> academic weeks in <%= currentTerm %>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="fs-1 fw-bold text-white"><%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%</span>
                                                        <div class="text-white-50 small">Elapsed</div>
                                                    </div>
                                                </div>

                                                <!-- Term Progress Bar inside Widget -->
                                                <div class="school-week-progress-wrap mt-3 mb-0">
                                                    <div class="school-week-progress-bar">
                                                        <div class="school-week-progress-fill" style="width: <%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%;"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 4 Quick Term Breakdown Metric Tiles -->
                                        <div class="col-lg-7">
                                            <div class="school-week-metrics-grid">
                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-primary">
                                                        <%= typeof daysPassed !== 'undefined' ? daysPassed : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Passed</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-success">
                                                        <%= typeof daysRemaining !== 'undefined' ? daysRemaining : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Remaining</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-info">
                                                        <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Total Term Weeks</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-warning">
                                                        <%= typeof totalDays !== 'undefined' ? totalDays : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Total Term Days</div>
                                                </div>
                                            </div>

                                            <div class="mt-3 px-2 d-flex justify-content-between align-items-center text-muted small">
                                                <span>
                                                    <i class="mdi mdi-calendar-start me-1"></i> Term Start: 
                                                    <strong><%= typeof termStartDate !== 'undefined' && termStartDate ? moment(termStartDate).format('MMM D, YYYY') : 'Configured in Settings' %></strong>
                                                </span>
                                                <span>
                                                    <i class="mdi mdi-calendar-end me-1"></i> Term End: 
                                                    <strong><%= typeof termEndDate !== 'undefined' && termEndDate ? moment(termEndDate).format('MMM D, YYYY') : 'Configured in Settings' %></strong>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Core KPI Stat Cards -->
                    <div class="row g-3 mb-4">
                        <!-- Total Students -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-blue h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Total Students</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= studentCount.toLocaleString() %>
                                        </h2>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-school-outline me-1"></i> Active Roster
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-account-group-outline"></i>
                                    </div>
                                </div>
                                <% if (typeof graduatedStudentCount !== 'undefined' && graduatedStudentCount > 0) { %>
                                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                        <a href="/graduated-students" class="small text-decoration-none text-muted" title="View graduated students list">
                                            <i class="bi bi-award-fill text-success me-1"></i><strong><%= graduatedStudentCount.toLocaleString() %></strong> Graduated (Alumni) &rarr;
                                        </a>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Teaching Staff -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-green h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Teaching Staff</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= teacherCount.toLocaleString() %>
                                        </h2>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-check-circle-outline me-1"></i> Active Teachers
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-teach"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Active Classes -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-amber h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Active Classes</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= classCount.toLocaleString() %>
                                        </h2>
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-book-open-outline me-1"></i> All Grade Levels
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-google-classroom"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fee Collection -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-rose h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Fee Collection</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            ₦<%= revenue.toLocaleString() %>
                                        </h2>
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-cash-check me-1"></i> <%= currentTerm %>
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-cash-multiple"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Academic Performance & Operations Pulse -->
                    <div class="row g-3">
                        <div class="col-xl-8">
                            <!-- Academic Overview Card -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 pb-2 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-chart-box-outline me-2 text-primary"></i> Academic Operations Overview
                                    </h5>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                                        <i class="mdi mdi-calendar-check me-1"></i> <%= currentAcademicYear %> · <%= currentTerm %>
                                    </span>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-4" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle p-3" style="background: rgba(16, 185, 129, 0.2);">
                                                        <i class="mdi mdi-clipboard-check-outline fs-2 text-success"></i>
                                                    </div>
                                                    <div>
                                                        <h2 class="mb-0 fw-bold text-success" style="font-family: 'Outfit', sans-serif;">
                                                            <%= examsConducted %>
                                                        </h2>
                                                        <p class="text-muted mb-0 small fw-semibold">Exam Subjects Evaluated</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-4" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle p-3" style="background: rgba(79, 70, 229, 0.2);">
                                                        <i class="mdi mdi-bookmark-check-outline fs-2 text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h2 class="mb-0 fw-bold text-primary" style="font-family: 'Outfit', sans-serif;">
                                                            <%= assignmentsSubmitted %>
                                                        </h2>
                                                        <p class="text-muted mb-0 small fw-semibold">Student Submissions Logged</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                
                            <!-- Recent Activity Card -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-history me-2 text-info"></i> Recent System Activity
                                    </h5>
                                    <span class="badge bg-light text-muted border px-2 py-1 small">Live Feed</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="border-0 ps-4 py-3"><i class="mdi mdi-text me-1 text-muted"></i> Activity Description</th>
                                                    <th class="border-0 text-end pe-4 py-3"><i class="mdi mdi-calendar me-1 text-muted"></i> Date & Time</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (recentActivities && recentActivities.length > 0) {
                                                    for (var i = 0; i < recentActivities.length; i++) { 
                                                        var activity = recentActivities[i]; %>
                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <i class="mdi mdi-check-circle text-success me-2 fs-5 align-middle"></i>
                                                                <span class="align-middle fw-medium"><%= activity.description %></span>
                                                            </td>
                                                            <td class="text-end text-muted pe-4 py-3 small">
                                                                <i class="mdi mdi-clock-outline me-1"></i>
                                                                <%= moment(activity.created_at).format('MMM D, YYYY · h:mm A') %>
                                                            </td>
                                                        </tr>
                                                    <% } 
                                                } else { %>
                                                    <tr>
                                                        <td colspan="2" class="text-center text-muted py-5">
                                                            <i class="mdi mdi-text-box-outline d-block fs-1 mb-2 opacity-50"></i>
                                                            <p class="mb-0 fw-medium">No system activities recorded yet</p>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                
                        <!-- Sidebar: Term Operational Metrics & Upcoming Events -->
                        <div class="col-xl-4">
                            <!-- Term Operational Metrics Card -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                            <i class="mdi mdi-speedometer me-2 text-warning"></i> Operational Pulse
                                        </h5>
                                        <small class="text-muted"><%= currentTerm %> Metrics</small>
                                    </div>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                                        <%= typeof shortWeekLabel !== 'undefined' ? shortWeekLabel : 'Week 1' %>
                                    </span>
                                </div>
                                <div class="card-body px-4 pt-1">
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-calendar-check me-2 text-success"></i> Scheduled Sessions</span>
                                        <span class="fw-bold bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small">
                                            <%= classesScheduled %> Sessions
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-clipboard-list me-2 text-warning"></i> Assignments Due</span>
                                        <span class="fw-bold bg-warning bg-opacity-10 text-warning px-3 py-1 rounded-pill small">
                                            <%= assignmentsDue %> Active
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-percent me-2 text-info"></i> School Attendance Rate</span>
                                        <span class="fw-bold bg-info bg-opacity-10 text-info px-3 py-1 rounded-pill small">
                                            <%= averageAttendance %>%
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <span class="text-muted"><i class="mdi mdi-cash me-2 text-danger"></i> Term Fee Inflow</span>
                                        <span class="fw-bold bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill small">
                                            ₦<%= feesCollected.toLocaleString() %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                
                            <!-- Upcoming Events Card -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-calendar-star me-2 text-danger"></i> Upcoming Events
                                    </h5>
                                    <a href="/school-calendar" class="small text-primary fw-semibold text-decoration-none">View All</a>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <% if (upcomingEvents && upcomingEvents.length > 0) {
                                        for (var i = 0; i < upcomingEvents.length; i++) { 
                                            var event = upcomingEvents[i]; %>
                                            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                                <div class="text-center rounded-3 p-2 text-white shadow-sm"
                                                    style="min-width: 54px; background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);">
                                                    <div class="fw-bold fs-4 line-height-1">
                                                        <%= moment(event.eventDate).format('DD') %>
                                                    </div>
                                                    <div class="small text-white-50 text-uppercase" style="font-size: 0.7rem;">
                                                        <%= moment(event.eventDate).format('MMM') %>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-1 fw-bold text-dark">
                                                        <%= event.title %>
                                                    </h6>
                                                    <small class="text-muted">
                                                        <i class="mdi mdi-clock-outline me-1"></i>
                                                        <%= event.startTime ? moment(event.startTime, 'HH:mm:ss').format('h:mm A') : 'All Day' %>
                                                    </small>
                                                </div>
                                                <i class="mdi mdi-chevron-right text-muted fs-4"></i>
                                            </div>
                                        <% } 
                                    } else { %>
                                        <div class="text-center text-muted py-4">
                                            <i class="mdi mdi-calendar-blank-outline fs-1 mb-2 d-block opacity-50"></i>
                                            <p class="mb-0 small fw-medium">No events currently scheduled for this term</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- Quick Actions Grid -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 pb-1 px-4">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-lightning-bolt me-2 text-warning"></i> Operational Quick Actions
                                    </h5>
                                    <small class="text-muted">Fast shortcuts to everyday school management workflows</small>
                                </div>
                                <div class="card-body px-4 pt-2 pb-4">
                                    <div class="row g-3">
                                        <div class="col-lg-3 col-md-6">
                                            <a href="/enter-scores" class="modern-action-tile">
                                                <div class="modern-action-icon" style="background: rgba(79, 70, 229, 0.12); color: #4f46e5;">
                                                    <i class="mdi mdi-pencil-box-outline"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Enter Scores</div>
