    <script>
        function markNotificationRead(id) {
            fetch('/api/admin/notifications/mark-read/' + id, { method: 'POST' }).then(function (r) { if (r.ok) location.reload(); });
        }
        function markAllNotificationsRead() {
            fetch('/api/admin/notifications/mark-all-read', { method: 'POST' }).then(function (r) { if (r.ok) location.reload(); });
        }
        function markRead(id) { markNotificationRead(id); }
        function markAllRead() { markAllNotificationsRead(); }
