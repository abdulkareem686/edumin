<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Admin Dashboard | Alhamdulillahi Academy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Core Icons & Styles -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link href="/assets/css/school-dashboard.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Alhamdulillahi Academy - Heritage 2027 UI -->
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="/assets/css/theme-2027.css" rel="stylesheet" type="text/css">
    <script src="/assets/js/theme-2027.js"></script>

    <!-- Page-scoped additions for the Heritage 2027 dashboard layout -->
    <style>
        /* --- KPI strip (reference: the three pastel cards across the top) --- */
        .aa-kpi-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
        @media (max-width: 1199.98px) { .aa-kpi-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 575.98px)  { .aa-kpi-strip { grid-template-columns: 1fr; } }

        .aa-kpi {
            display: flex; align-items: center; gap: 0.9rem;
            padding: 1.15rem 1.25rem;
            background: var(--aa-surface);
            border: 1px solid var(--aa-border);
            border-radius: var(--aa-radius-lg);
            box-shadow: var(--aa-shadow-sm);
            transition: border-color var(--aa-dur) var(--aa-ease);
        }
        .aa-kpi:hover { border-color: var(--aa-border-strong); }
        .aa-kpi__icon {
            flex: 0 0 auto; width: 46px; height: 46px;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 14px; font-size: 1.35rem;
        }
        .aa-kpi__icon--rose   { background: var(--aa-danger-soft);  color: var(--aa-danger); }
        .aa-kpi__icon--green  { background: var(--aa-success-soft); color: var(--aa-success); }
        .aa-kpi__icon--amber  { background: var(--aa-warning-soft); color: var(--aa-warning); }
        .aa-kpi__icon--brand  { background: var(--aa-brand-soft);   color: var(--aa-brand-ink); }
        .aa-kpi__label {
            font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em;
            text-transform: uppercase; color: var(--aa-text-soft); margin-bottom: 0.2rem;
        }
        .aa-kpi__value {
            font-family: var(--aa-font-display);
            font-size: 1.55rem; font-weight: 600; line-height: 1.1;
            letter-spacing: -0.02em; color: var(--aa-text);
        }
        .aa-kpi__value small { font-family: var(--aa-font-body); font-size: 0.72rem; font-weight: 600; color: var(--aa-text-muted); letter-spacing: 0; margin-left: 0.15rem; }

        /* --- Row-action menu (reference: the "…" at the end of each table row) --- */
        .aa-row-menu { position: relative; display: inline-block; }
        .aa-row-menu > button {
            border: 0; background: transparent; color: var(--aa-text-soft);
            padding: 0.2rem 0.4rem; border-radius: 6px; line-height: 1;
        }
        .aa-row-menu > button:hover { background: var(--aa-surface-2); color: var(--aa-text); }
        .aa-row-menu .dropdown-menu { min-width: 9.5rem; }

        /* --- Table polish to match the reference's airy rows --- */
        .aa-table th {
            font-size: 0.7rem !important; font-weight: 700 !important;
            letter-spacing: 0.08em !important; text-transform: uppercase !important;
        }
        .aa-table td { padding-top: 1.05rem !important; padding-bottom: 1.05rem !important; }
        .aa-table .aa-primary { font-weight: 650; color: var(--aa-text); }
        .aa-table .aa-secondary { font-size: 0.8rem; color: var(--aa-text-muted); }

        /* Status pill — reference "Taken" / "Missed" */
        .aa-status {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.35em 0.8em; border-radius: var(--aa-radius-pill);
            font-size: 0.74rem; font-weight: 650; white-space: nowrap;
        }
        .aa-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
        .aa-status--ok   { background: var(--aa-success-soft); color: var(--aa-success); }
        .aa-status--warn { background: var(--aa-warning-soft); color: var(--aa-warning); }
        .aa-status--bad  { background: var(--aa-danger-soft);  color: var(--aa-danger); }
        .aa-status--info { background: var(--aa-info-soft);    color: var(--aa-info); }

        /* Chart panel head: title + segmented control (reference "Heart rate | Weekdays") */
        .aa-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 1.1rem 1.35rem 0.4rem; }
        .aa-seg { display: inline-flex; background: var(--aa-surface-2); border: 1px solid var(--aa-border); border-radius: var(--aa-radius-pill); padding: 3px; }
        .aa-seg button {
            border: 0; background: transparent; color: var(--aa-text-muted);
            font-size: 0.74rem; font-weight: 650; padding: 0.3rem 0.8rem;
            border-radius: var(--aa-radius-pill); line-height: 1.3;
        }
        .aa-seg button.is-active { background: var(--aa-surface); color: var(--aa-text); box-shadow: var(--aa-shadow-sm); }

        /* Greeting row */
        .aa-greeting-title { font-family: var(--aa-font-display); font-size: 1.6rem; font-weight: 600; letter-spacing: -0.025em; margin: 0; color: var(--aa-text); }
        .aa-search { position: relative; min-width: 230px; }
        .aa-search .mdi { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--aa-text-soft); font-size: 1rem; }
        .aa-search input { padding-left: 2.35rem !important; min-height: 38px !important; border-radius: var(--aa-radius-pill) !important; background: var(--aa-surface-2) !important; }
    </style>
</head>

<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Left Sidebar -->
        <%- include('partials/admin-sidebar') %>

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid edu-dashboard pt-3 pb-4">

                    <!-- ══ Greeting row (reference: "Welcome, Diana!" + search + actions) ══ -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                        <div>
                            <h1 class="aa-greeting-title">
                                Welcome back, <%= typeof username !== 'undefined' && username ? username : 'Administrator' %>!
                            </h1>
                            <p class="text-muted mb-0 small">
                                <i class="mdi mdi-clock-outline me-1"></i>
                                <%= moment().format('dddd, MMMM D, YYYY') %>
                                <span class="mx-1">·</span>
                                <%= currentAcademicYear %> &middot; <%= currentTerm %>
                            </p>
                        </div>

                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="aa-search d-none d-lg-block">
                                <i class="mdi mdi-magnify"></i>
                                <input type="search" class="form-control form-control-sm" placeholder="Search students, staff, records…" aria-label="Search">
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">
                                <span class="pulse-indicator d-inline-block me-1" style="width:6px;height:6px;border-radius:50%;background:currentColor;"></span>
                                <strong><%= typeof weekLabel !== 'undefined' && weekLabel ? weekLabel : 'Week 1' %></strong>
                                &middot; <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                            </span>
                            <a href="/add-student" class="btn btn-primary btn-sm">
                                <i class="mdi mdi-account-plus-outline me-1"></i> Admit Student
                            </a>
                        </div>
                    </div>

                    <!-- ══ KPI strip (reference: three pastel cards) ══ -->
                    <div class="aa-kpi-strip mb-4">
                        <div class="aa-kpi">
                            <span class="aa-kpi__icon aa-kpi__icon--rose"><i class="mdi mdi-account-group-outline"></i></span>
                            <div>
                                <div class="aa-kpi__label">Total Students</div>
                                <div class="aa-kpi__value">
                                    <%= studentCount.toLocaleString() %>
                                    <% if (typeof graduatedStudentCount !== 'undefined' && graduatedStudentCount > 0) { %>
                                        <small><%= graduatedStudentCount.toLocaleString() %> alumni</small>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="aa-kpi">
                            <span class="aa-kpi__icon aa-kpi__icon--green"><i class="mdi mdi-teach"></i></span>
                            <div>
                                <div class="aa-kpi__label">Teaching Staff</div>
                                <div class="aa-kpi__value"><%= teacherCount.toLocaleString() %></div>
                            </div>
                        </div>

                        <div class="aa-kpi">
                            <span class="aa-kpi__icon aa-kpi__icon--amber"><i class="mdi mdi-google-classroom"></i></span>
                            <div>
                                <div class="aa-kpi__label">Active Classes</div>
                                <div class="aa-kpi__value"><%= classCount.toLocaleString() %></div>
                            </div>
                        </div>

                        <div class="aa-kpi">
                            <span class="aa-kpi__icon aa-kpi__icon--brand"><i class="mdi mdi-cash-multiple"></i></span>
                            <div>
                                <div class="aa-kpi__label">Fee Collection</div>
                                <div class="aa-kpi__value">₦<%= revenue.toLocaleString() %><small><%= currentTerm %></small></div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ Primary row: chart + side panel (reference: Heart rate + Care team) ══ -->
                    <div class="row g-3 mb-4">
                        <!-- Chart panel -->
                        <div class="col-xl-8">
                            <div class="card h-100">
                                <div class="aa-panel-head">
                                    <div class="d-flex align-items-center gap-3 flex-wrap">
                                        <h5 class="card-title mb-0">
                                            <i class="mdi mdi-chart-box-outline text-primary me-1"></i> Academic Operations
                                        </h5>
                                        <div class="aa-seg" role="group" aria-label="Chart range">
                                            <button type="button" class="is-active">This term</button>
                                            <button type="button">Weekly</button>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="aa-kpi__value" style="font-size:1.3rem;"><%= termProgress %>%</div>
                                        <div class="aa-kpi__label mb-0">Term Elapsed</div>
                                    </div>
                                </div>

                                <div class="card-body pt-2">
                                    <!-- Replacement for the reference's bar chart:
                                         the term/week engine, rendered with the Heritage ring + strip. -->
                                    <div class="week-engine border-0" style="box-shadow:none;">
                                        <div class="week-engine__body pb-0">
                                            <div class="week-ring">
                                                <svg viewBox="0 0 120 120" role="img" aria-label="Term progress ring">
                                                    <circle class="week-ring__track" cx="60" cy="60" r="52"></circle>
                                                    <circle class="week-ring__bar" cx="60" cy="60" r="52"
                                                        stroke-dasharray="326.7"
                                                        stroke-dashoffset="<%= 326.7 - (326.7 * (typeof termProgress !== 'undefined' ? termProgress : 0) / 100) %>"></circle>
                                                </svg>
                                                <div class="week-ring__center">
                                                    <strong><%= typeof currentWeek !== 'undefined' ? currentWeek : 1 %></strong>
                                                    <span>of <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %> weeks</span>
                                                </div>
                                            </div>

                                            <div class="week-engine__main">
                                                <div class="week-engine__headline">
                                                    <h3>
                                                        <%= typeof shortWeekLabel !== 'undefined' && shortWeekLabel ? shortWeekLabel : ('Week ' + (typeof currentWeek !== 'undefined' ? currentWeek : 1)) %>
                                                        <span><%= currentTerm %> · <%= currentAcademicYear %></span>
                                                    </h3>
                                                    <p><i class="mdi mdi-calendar-check me-1"></i>
                                                        <%= typeof weekStartDate !== 'undefined' ? weekStartDate : '' %> – <%= typeof weekEndDate !== 'undefined' ? weekEndDate : '' %>
                                                    </p>
                                                </div>

                                                <div class="week-track">
                                                    <% for (var w = 1; w <= (typeof totalWeeks !== 'undefined' ? totalWeeks : 12); w++) {
                                                        var cls = w < (typeof currentWeek !== 'undefined' ? currentWeek : 1) ? 'is-done'
                                                                : w === (typeof currentWeek !== 'undefined' ? currentWeek : 1) ? 'is-current' : ''; %>
                                                        <div class="week-track__tick <%= cls %>"></div>
                                                    <% } %>
                                                </div>

                                                <div class="week-engine__stats">
                                                    <div class="week-stat"><strong><%= typeof daysPassed !== 'undefined' ? daysPassed : 0 %></strong><span>Days passed</span></div>
                                                    <div class="week-stat"><strong><%= typeof daysRemaining !== 'undefined' ? daysRemaining : 0 %></strong><span>Days remaining</span></div>
                                                    <div class="week-stat"><strong><%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %></strong><span>Term weeks</span></div>
                                                    <div class="week-stat"><strong><%= typeof totalDays !== 'undefined' ? totalDays : 0 %></strong><span>Term days</span></div>
                                                </div>

                                                <div class="week-engine__dates">
                                                    <span><i class="mdi mdi-calendar-start me-1"></i> Start <strong><%= typeof termStartDate !== 'undefined' && termStartDate ? moment(termStartDate).format('MMM D, YYYY') : '—' %></strong></span>
                                                    <span><i class="mdi mdi-calendar-end me-1"></i> End <strong><%= typeof termEndDate !== 'undefined' && termEndDate ? moment(termEndDate).format('MMM D, YYYY') : '—' %></strong></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="my-3">
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="p-3 rounded-3" style="background: var(--aa-success-soft);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <i class="mdi mdi-clipboard-check-outline fs-3 text-success"></i>
                                                    <div>
                                                        <div class="aa-kpi__value" style="font-size:1.35rem;"><%= examsConducted %></div>
                                                        <div class="aa-kpi__label mb-0">Exam subjects evaluated</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="p-3 rounded-3" style="background: var(--aa-brand-soft);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <i class="mdi mdi-bookmark-check-outline fs-3 text-primary"></i>
                                                    <div>
                                                        <div class="aa-kpi__value" style="font-size:1.35rem;"><%= assignmentsSubmitted %></div>
                                                        <div class="aa-kpi__label mb-0">Submissions logged</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Side panel: Operational pulse + Upcoming events (reference: Care team) -->
                        <div class="col-xl-4">
                            <div class="card h-100">
                                <div class="d-flex align-items-center justify-content-between px-4 pt-3 pb-2">
                                    <h5 class="card-title mb-0"><i class="mdi mdi-speedometer text-warning me-1"></i> Operational Pulse</h5>
                                    <a href="/school-calendar" class="small text-primary fw-semibold text-decoration-none">View all</a>
                                </div>

                                <div class="card-body pt-1 px-4">
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted small"><i class="mdi mdi-calendar-check text-success me-2"></i> Scheduled Sessions</span>
                                        <span class="fw-bold small"><%= classesScheduled %></span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted small"><i class="mdi mdi-clipboard-list text-warning me-2"></i> Assignments Due</span>
                                        <span class="fw-bold small"><%= assignmentsDue %></span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted small"><i class="mdi mdi-percent text-info me-2"></i> Attendance Rate</span>
                                        <span class="fw-bold small"><%= averageAttendance %>%</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <span class="text-muted small"><i class="mdi mdi-cash text-danger me-2"></i> Term Fee Inflow</span>
                                        <span class="fw-bold small">₦<%= feesCollected.toLocaleString() %></span>
                                    </div>

                                    <hr class="my-3">
                                    <div class="aa-kpi__label mb-2">Upcoming events</div>

                                    <% if (upcomingEvents && upcomingEvents.length > 0) {
                                        for (var i = 0; i < upcomingEvents.length; i++) {
                                            var event = upcomingEvents[i]; %>
                                            <div class="d-flex align-items-center gap-3 py-2 <%= i < upcomingEvents.length - 1 ? 'border-bottom' : '' %>">
                                                <div class="text-center rounded-3 px-2 py-1" style="min-width: 46px; background: var(--aa-surface-2); border: 1px solid var(--aa-border);">
                                                    <div class="fw-bold" style="font-family: var(--aa-font-display); line-height:1;"><%= moment(event.eventDate).format('DD') %></div>
                                                    <div class="aa-kpi__label mb-0" style="font-size:.58rem;"><%= moment(event.eventDate).format('MMM') %></div>
                                                </div>
                                                <div class="flex-grow-1 min-width-0">
                                                    <div class="fw-semibold small text-truncate"><%= event.title %></div>
                                                    <small class="text-muted">
                                                        <i class="mdi mdi-clock-outline me-1"></i>
                                                        <%= event.startTime ? moment(event.startTime, 'HH:mm:ss').format('h:mm A') : 'All day' %>
                                                    </small>
                                                </div>
                                            </div>
                                        <% }
                                    } else { %>
                                        <div class="text-center text-muted py-3">
                                            <i class="mdi mdi-calendar-blank-outline fs-3 d-block mb-1 opacity-50"></i>
                                            <p class="mb-0 small">No events scheduled for this term</p>
                                        </div>
                                    <% } %>

                                    <a href="/school-calendar" class="btn btn-outline-primary btn-sm w-100 mt-3">
                                        <i class="mdi mdi-plus me-1"></i> Schedule event
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ Full-width table (reference: Medication tracker) ══ -->
                    <div class="card">
                        <div class="aa-panel-head">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h5 class="card-title mb-0"><i class="mdi mdi-history text-info me-1"></i> Recent System Activity</h5>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1" style="font-size:.68rem;">Live feed</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="aa-search d-none d-md-block" style="min-width:190px;">
                                    <i class="mdi mdi-magnify"></i>
                                    <input type="search" class="form-control form-control-sm" placeholder="Search activity…" aria-label="Search activity">
                                </div>
                                <div class="aa-seg" role="group" aria-label="Activity range">
                                    <button type="button" class="is-active">This term</button>
                                    <button type="button">All</button>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive mt-2">
                            <table class="table table-hover aa-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Activity</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Date &amp; time</th>
                                        <th class="text-end pe-4" aria-label="Row actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentActivities && recentActivities.length > 0) {
                                        for (var i = 0; i < recentActivities.length; i++) {
                                            var activity = recentActivities[i]; %>
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="aa-primary"><%= activity.description %></div>
                                                </td>
                                                <td><span class="aa-secondary">System</span></td>
                                                <td><span class="aa-status aa-status--ok">Logged</span></td>
                                                <td class="text-end pe-4">
                                                    <span class="aa-secondary"><%= moment(activity.created_at).format('MMM D, YYYY · h:mm A') %></span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <div class="aa-row-menu dropdown">
                                                        <button type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Row actions">
                                                            <i class="mdi mdi-dots-horizontal"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li><a class="dropdown-item" href="#"><i class="mdi mdi-eye-outline me-2"></i>View details</a></li>
                                                            <li><a class="dropdown-item" href="#"><i class="mdi mdi-content-copy me-2"></i>Copy reference</a></li>
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }
                                    } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-5">
                                                <i class="mdi mdi-text-box-outline d-block fs-1 mb-2 opacity-50"></i>
                                                <p class="mb-0 fw-medium">No system activities recorded yet</p>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ══ Quick actions (kept from your original; restyled to the new language) ══ -->
                    <div class="card mt-4">
                        <div class="d-flex align-items-center justify-content-between px-4 pt-3 pb-1">
                            <div>
                                <h5 class="card-title mb-0"><i class="mdi mdi-lightning-bolt text-warning me-1"></i> Quick Actions</h5>
                                <small class="text-muted">Fast shortcuts to everyday workflows</small>
                            </div>
                        </div>
                        <div class="card-body px-4 pt-2 pb-4">
                            <div class="row g-3">
                                <div class="col-lg-3 col-md-6">
                                    <a href="/enter-scores" class="modern-action-tile">
                                        <div class="modern-action-icon" style="background: var(--aa-brand-soft); color: var(--aa-brand-ink);"><i class="mdi mdi-pencil-box-outline"></i></div>
                                        <div><div class="fw-bold">Enter Scores</div><small class="text-muted">Assessment &amp; exams</small></div>
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <a href="/add-student" class="modern-action-tile">
                                        <div class="modern-action-icon" style="background: var(--aa-success-soft); color: var(--aa-success);"><i class="mdi mdi-account-plus-outline"></i></div>
                                        <div><div class="fw-bold">Admit Student</div><small class="text-muted">Register new student</small></div>
                                    </a>
                                </div>
                                <div class="col-lg-3 col-md-6">
                                    <a href="/fees-collection" class="modern-action-tile">
