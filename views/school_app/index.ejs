                            <thead>
                                <tr>
                                    <th>Activity</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof recentActivities !== 'undefined' && recentActivities.length > 0) { %>
                                    <% recentActivities.forEach(activity => { %>
                                        <tr>
                                            <td><%= activity.description %></td>
                                            <td><%= moment(activity.created_at).format('MMM D, YYYY') %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">
                                            No recent activities found
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Summary & Events -->
        <div class="col-xl-4 col-lg-5">
            <!-- Term Summary -->
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mb-3">
                        <%= typeof currentTerm !== 'undefined' ? currentTerm : 'Current Term' %> Summary
                        <span class="badge bg-primary float-end">
                            <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : '2023-2024' %>
                        </span>
                    </h4>
                    
                    <!-- Term Progress -->
                    <div class="term-progress mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Term Progress</span>
                            <span><%= typeof termProgress !== 'undefined' ? termProgress : '0' %>%</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" role="progressbar" 
                                 style="width: <%= typeof termProgress !== 'undefined' ? termProgress : '0' %>%;" 
                                 aria-valuenow="<%= typeof termProgress !== 'undefined' ? termProgress : '0' %>" 
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">
                            <%= typeof daysRemaining !== 'undefined' ? daysRemaining : '0' %> days remaining
                        </small>
                    </div>

                    <!-- Performance Indicators -->
                    <div class="quick-stats">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <i class="mdi mdi-calendar-check text-success fs-4"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="mb-0"><%= typeof classesScheduled !== 'undefined' ? classesScheduled : '0' %></h5>
                                <p class="text-muted mb-0">Classes Scheduled This Week</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <i class="mdi mdi-clipboard-list text-info fs-4"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="mb-0"><%= typeof assignmentsDue !== 'undefined' ? assignmentsDue : '0' %></h5>
                                <p class="text-muted mb-0">Assignments Due This Week</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0">
                                <i class="mdi mdi-chart-line text-warning fs-4"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="mb-0"><%= typeof averageAttendance !== 'undefined' ? averageAttendance : '0' %>%</h5>
                                <p class="text-muted mb-0">Current Attendance Rate</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <i class="mdi mdi-cash-multiple text-primary fs-4"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="mb-0">₦<%= typeof feesCollected !== 'undefined' ? feesCollected.toLocaleString() : '0' %></h5>
                                <p class="text-muted mb-0">Fees Collected This Term</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Upcoming Events -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4 class="header-title mb-3">Upcoming Events</h4>
                    <div class="upcoming-events">
                        <% if (typeof upcomingEvents !== 'undefined' && upcomingEvents.length > 0) { %>
                            <% upcomingEvents.forEach(event => { %>
                                <div class="event-list mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="event-date text-center bg-light rounded p-2">
                                                <span class="d-block fw-bold text-primary">
                                                    <%= moment(event.eventDate).format('DD') %>
                                                </span>
                                                <span class="d-block text-muted">
                                                    <%= moment(event.eventDate).format('MMM') %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="event-title mb-0"><%= event.title %></h6>
                                            <p class="text-muted mb-0">
                                                <small>
                                                    <i class="mdi mdi-clock-time-four-outline"></i>
                                                    <%= event.startTime ? moment(event.startTime, 'HH:mm:ss').format('h:mm A') : 'All day' %>
                                                    <% if (event.endTime) { %>
                                                        - <%= moment(event.endTime, 'HH:mm:ss').format('h:mm A') %>
                                                    <% } %>
                                                </small>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center text-muted py-3">
                                <i class="mdi mdi-calendar-blank-outline fs-1"></i>
                                <p class="mt-2">No upcoming events</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mb-3">Quick Actions</h4>
                    <div class="row">
                        <div class="col-md-3 col-6 mb-3">
                            <a href="/enter-scores" class="btn btn-outline-primary w-100">
                                <i class="mdi mdi-pencil-box-outline me-1"></i>
                                Enter Scores
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="/add-student" class="btn btn-outline-success w-100">
                                <i class="mdi mdi-account-plus me-1"></i>
                                Add Student
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="/fees-collection" class="btn btn-outline-info w-100">
                                <i class="mdi mdi-cash-multiple me-1"></i>
                                Fee Collection
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-3">
                            <a href="/academic-years" class="btn btn-outline-warning w-100">
                                <i class="mdi mdi-calendar-edit me-1"></i>
                                Academic Calendar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- end Content-->
                    
                    
                    
                    <!-- end Content-->
                
                
                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © abdulkareem
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->


        </div>
        <!-- END wrapper -->


        <!-- Right Sidebar -->
        <div class="end-bar">

            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>

            <div class="rightbar-content h-100" data-simplebar="">

                <div class="p-3">
                    <div class="alert alert-warning" role="alert">
                        <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                    </div>

                    <!-- Settings -->
                    <h5 class="mt-3">Color Scheme</h5>
                    <hr class="mt-1">

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                        <label class="form-check-label" for="light-mode-check">Light Mode</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                        <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                    </div>
       

                    <!-- Width -->
                    <h5 class="mt-4">Width</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                        <label class="form-check-label" for="fluid-check">Fluid</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                        <label class="form-check-label" for="boxed-check">Boxed</label>
                    </div>
        

                    <!-- Left Sidebar-->
                    <h5 class="mt-4">Left Sidebar</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                        <label class="form-check-label" for="default-check">Default</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked="">
                        <label class="form-check-label" for="light-check">Light</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                        <label class="form-check-label" for="dark-check">Dark</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked="">
                        <label class="form-check-label" for="fixed-check">Fixed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                        <label class="form-check-label" for="condensed-check">Condensed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                        <label class="form-check-label" for="scrollable-check">Scrollable</label>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
            
                        <a href="../../product/hyper-responsive-admin-dashboard-template/index.htm" class="btn btn-danger mt-3" target="_blank"><i class="mdi mdi-basket me-1"></i> Purchase Now</a>
                    </div>
                </div> <!-- end padding-->

            </div>
        </div>

        <div class="rightbar-overlay"></div>
        <!-- /End-bar -->

        <!-- bundle -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>

        <!-- third party js -->
        <script src="/assets/js/vendor/Chart.bundle.min.js"></script>
        <!-- third party js ends -->

        <!-- demo app -->
        <script src="/assets/js/pages/demo.dashboard-projects.js"></script>
        <!-- end demo js-->

    </body>
</html>
