<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>Notifications</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="shortcut icon" href="/images/favicon.png">

        <!-- App css -->
        <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
        <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    </head>

    <body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <div class="wrapper">
            <!-- Left Sidebar -->
            <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->

            <div class="content-page">
                <div class="content">
                    <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                    <!-- Start Content-->
                    <div class="container-fluid">
                        <!-- start page title -->
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <div class="page-title-right">
                                        <div class="btn-group">
                                            <button class="btn btn-secondary btn-sm" onclick="markAllRead()">
                                                <i class="mdi mdi-check-all me-1"></i> Mark All Read
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteAllRead()">
                                                <i class="mdi mdi-delete me-1"></i> Delete Read
                                            </button>
                                        </div>
                                    </div>
                                    <h4 class="page-title">Notifications</h4>
                                </div>
                            </div>
                        </div>
                        <!-- end page title -->

                        <!-- Alert Messages -->
                        <% if (error) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="mdi mdi-alert-circle me-1"></i> <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <% if (success) { %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="mdi mdi-check-circle me-1"></i> <%= success %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <!-- Filter Tabs -->
                        <div class="row">
                            <div class="col-12">
                                <ul class="nav nav-pills mb-3">
                                    <li class="nav-item">
                                        <a href="/admin/notifications?filter=all" class="nav-link <%= currentFilter === 'all' ? 'active' : '' %>">
                                            All <span class="badge bg-secondary"><%= totalCount %></span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="/admin/notifications?filter=unread" class="nav-link <%= currentFilter === 'unread' ? 'active' : '' %>">
                                            Unread <span class="badge bg-primary"><%= unreadCount %></span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="/admin/notifications?filter=read" class="nav-link <%= currentFilter === 'read' ? 'active' : '' %>">
                                            Read <span class="badge bg-secondary"><%= totalCount - unreadCount %></span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Notifications List -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <% if (notifications && notifications.length > 0) { %>
                                            <div class="list-group">
                                                <% notifications.forEach(function(notification) { %>
                                                    <div class="list-group-item list-group-item-action <%= !notification.is_read ? 'bg-light' : '' %>">
                                                        <div class="d-flex w-100 justify-content-between align-items-center">
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex align-items-center">
                                                                    <% if (!notification.is_read) { %>
                                                                        <span class="badge bg-primary me-2">New</span>
                                                                    <% } %>
                                                                    <h5 class="mb-1"><%= notification.title || 'Notification' %></h5>
                                                                </div>
                                                                <p class="mb-1"><%= notification.message %></p>
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <small class="text-muted">
                                                                        <i class="mdi mdi-clock-outline me-1"></i>
                                                                        <%= notification.formatted_date %>
                                                                    </small>
                                                                    <% if (notification.read_date) { %>
                                                                        <small class="text-muted">
                                                                            <i class="mdi mdi-check-circle me-1 text-success"></i>
                                                                            Read: <%= notification.read_date %>
                                                                        </small>
                                                                    <% } %>
                                                                    <% if (notification.type) { %>
                                                                        <span class="badge bg-secondary"><%= notification.type %></span>
                                                                    <% } %>
                                                                </div>
                                                            </div>
                                                            <div class="ms-3">
                                                                <% if (!notification.is_read) { %>
                                                                    <button class="btn btn-sm btn-outline-primary" onclick="markRead(<%= notification.id %>)">
                                                                        <i class="mdi mdi-check"></i>
                                                                    </button>
                                                                <% } %>
                                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteNotification(<%= notification.id %>)">
                                                                    <i class="mdi mdi-delete"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>

                                            <!-- Pagination -->
                                            <% if (totalPages > 1) { %>
                                                <nav class="mt-3">
                                                    <ul class="pagination justify-content-center">
                                                        <% if (currentPage > 1) { %>
                                                            <li class="page-item">
                                                                <a class="page-link" href="?filter=<%= currentFilter %>&page=<%= currentPage - 1 %>">
                                                                    <i class="mdi mdi-chevron-left"></i>
                                                                </a>
                                                            </li>
                                                        <% } %>

                                                        <% for (var i = 1; i <= totalPages; i++) { %>
                                                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                                <a class="page-link" href="?filter=<%= currentFilter %>&page=<%= i %>">
                                                                    <%= i %>
                                                                </a>
                                                            </li>
                                                        <% } %>

                                                        <% if (currentPage < totalPages) { %>
                                                            <li class="page-item">
                                                                <a class="page-link" href="?filter=<%= currentFilter %>&page=<%= currentPage + 1 %>">
                                                                    <i class="mdi mdi-chevron-right"></i>
                                                                </a>
                                                            </li>
                                                        <% } %>
                                                    </ul>
                                                </nav>
                                            <% } %>
                                        <% } else { %>
                                            <div class="text-center py-5">
                                                <i class="mdi mdi-bell-off-outline fs-1 text-muted"></i>
                                                <h5 class="mt-3">No notifications found</h5>
                                                <p class="text-muted">You're all caught up! Check back later for new notifications.</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end container-fluid -->

                    <!-- Footer -->
                    <footer class="footer">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-md-6">
                                    <script>document.write(new Date().getFullYear())</script> © School Management System
                                </div>
                                <div class="col-md-6">
                                    <div class="text-md-end footer-links d-none d-md-block">
                                        <a href="javascript: void(0);">About</a>
                                        <a href="javascript: void(0);">Support</a>
                                        <a href="javascript: void(0);">Contact Us</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </footer>
                </div>
            </div>
        </div>

        <!-- bundle -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>

        <script>
            // Mark a single notification as read
            function markRead(notificationId) {
                fetch('/api/admin/notifications/mark-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: notificationId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to mark notification as read');
                    }
                })
                .catch(error => console.error('Error:', error));
            }

            // Mark all notifications as read
            function markAllRead() {
                if (!confirm('Mark all notifications as read?')) return;

                fetch('/api/admin/notifications/mark-all-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to mark all notifications as read');
                    }
                })
                .catch(error => console.error('Error:', error));
            }

            // Delete a single notification
            function deleteNotification(notificationId) {
                if (!confirm('Delete this notification?')) return;

                fetch('/api/admin/notifications/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: notificationId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to delete notification');
                    }
                })
                .catch(error => console.error('Error:', error));
            }

            // Delete all read notifications
            function deleteAllRead() {
                if (!confirm('Delete all read notifications?')) return;

                fetch('/api/admin/notifications/delete-all-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to delete read notifications');
                    }
                })
                .catch(error => console.error('Error:', error));
            }

            // Update notification count in real-time
            function updateNotificationCount() {
                fetch('/api/admin/notifications/unread-count')
                .then(response => response.json())
                .then(data => {
                    const countElement = document.getElementById('notificationCount');
                    if (countElement) {
                        countElement.textContent = data.count || 0;
                    }
                })
                .catch(error => console.error('Error:', error));
            }

            // Auto-refresh notification count every 30 seconds
            setInterval(updateNotificationCount, 30000);
        </script>
    </body>
</html>