<script>
// Function to show the add book list modal
function showAddBookListModal() {
    // Reset the form
    document.getElementById('bookListForm').reset();
    document.getElementById('bookListId').value = '';
    
    // Show the modal
    const modal = new bootstrap.Modal(document.getElementById('addBookListModal'));
    modal.show();
}

// Function to edit a book list
async function editBookList(id) {
    try {
        // Fetch book list data
        const response = await fetch(`/api/book-list/${id}`);
        const result = await response.json();
        
        if (result.success) {
            const book = result.data;
            
            // Fill the form with book data
            document.getElementById('bookListId').value = book.id;
            document.querySelector('select[name="academic_year"]').value = book.academic_year;
            document.querySelector('select[name="class_level"]').value = book.class_level;
            document.querySelector('select[name="department"]').value = book.department || '';
            document.querySelector('input[name="subject"]').value = book.subject;
            document.querySelector('input[name="title"]').value = book.title;
            document.querySelector('input[name="author"]').value = book.author || '';
            document.querySelector('input[name="publisher"]').value = book.publisher || '';
            document.querySelector('input[name="isbn"]').value = book.isbn || '';
            document.querySelector('input[name="price"]').value = book.price || '';
            document.querySelector('select[name="is_required"]').value = book.is_required;
            
            // Update modal title
            document.getElementById('addBookListModalLabel').textContent = 'Edit Book List';
            
            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('addBookListModal'));
            modal.show();
        } else {
            alert('Error loading book list: ' + result.error);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error loading book list');
    }
}

// Handle form submission
document.getElementById('bookListForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    try {
        const response = await fetch('/save-book-list', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams(formData)
        });
        
        const result = await response.json();
        
        if (result.success) {
            alert(result.message);
            // Close the modal and refresh the page
            const modal = bootstrap.Modal.getInstance(document.getElementById('addBookListModal'));
            modal.hide();
            window.location.reload();
        } else {
            alert('Error: ' + result.error);
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error saving book list');
    }
});

// Initialize the modal when the page loads
document.addEventListener('DOMContentLoaded', function() {
    // Add event listener to the "Add New Book List" button
    const addButton = document.querySelector('[data-bs-target="#addBookListModal"]');
    if (addButton) {
        addButton.addEventListener('click', function() {
            document.getElementById('addBookListModalLabel').textContent = 'Add New Book List';
            document.getElementById('bookListForm').reset();
            document.getElementById('bookListId').value = '';
        });
    }
    
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>         </div>
