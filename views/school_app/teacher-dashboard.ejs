<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Teacher Dashboard | EduSuite</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Core Styles & Icons -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link href="/assets/css/school-dashboard.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/teacher-sidebar') %>
        <!-- Left Sidebar End -->

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/teacher-navbar') %>
                <!-- end Topbar -->

                <!-- Start Content-->
                <div class="container-fluid edu-dashboard pt-3 pb-4">
                    <!-- Page Header Breadcrumb -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="page-title-box d-flex align-items-center justify-content-between">
                                <h4 class="page-title mb-0" style="font-family: 'Outfit', sans-serif; font-weight: 700;">
                                    <i class="mdi mdi-teach me-2 text-primary"></i> Instructor Dashboard
                                </h4>
                                <div class="page-title-right d-none d-md-block">
                                    <span class="text-muted small">
                                        <i class="mdi mdi-calendar-today me-1"></i>
                                        <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hero Welcome Banner -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="edu-dash-hero-inner p-4 rounded-4 text-white shadow-sm"
                                style="background: linear-gradient(135deg, #1e1b4b 0%, #3730a3 45%, #4f46e5 100%);">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                <i class="mdi mdi-certificate-outline me-1"></i> FACULTY & TEACHING WORKSPACE
                                            </span>
                                        </div>
                                        <h2 class="text-white mb-2 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                            Welcome back, <%= teacherData ? teacherData.firstName : 'Teacher' %>!
                                        </h2>
                                        <p class="mb-0 text-white-50" style="max-width: 620px; font-size: 0.95rem;">
                                            <%= teacherData && teacherData.designation ? teacherData.designation : 'Instructor' %> · Manage classroom attendance, input term scores, and track school week timelines.
                                        </p>
                                    </div>

                                    <!-- Hero Header Badges with Current School Week -->
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <!-- School Week Live Badge -->
                                        <div class="school-week-hero-pill shadow-sm">
                                            <span class="pulse-indicator"></span>
                                            <i class="mdi mdi-calendar-clock text-warning"></i>
                                            <span class="fw-bold"><%= typeof weekLabel !== 'undefined' && weekLabel ? weekLabel : 'Week 1' %></span>
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill ms-1" style="font-size: 0.725rem;">
                                                <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                            </span>
                                        </div>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-calendar-range me-1 text-info"></i>
                                            <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : '2026/2027' %>
                                        </span>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-book-open-page-variant me-1 text-success"></i>
                                            <%= typeof currentTerm !== 'undefined' ? currentTerm : 'First Term' %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current School Week & Term Tracker Widget -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="school-week-card">
                                <div class="school-week-header">
                                    <h5 class="school-week-header-title">
                                        <i class="mdi mdi-calendar-clock-outline"></i>
                                        Academic Term & Current School Week Tracker
                                    </h5>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (typeof weekStartDate !== 'undefined' && weekStartDate) { %>
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill border">
                                                <i class="mdi mdi-calendar-today text-primary me-1"></i>
                                                Active Week: <strong><%= weekStartDate %> – <%= typeof weekEndDate !== 'undefined' ? weekEndDate : '' %></strong>
                                            </span>
                                        <% } %>
                                        <span class="week-status-badge">
                                            <i class="mdi mdi-check-circle"></i> <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                        </span>
                                    </div>
                                </div>

                                <div class="school-week-body">
                                    <div class="row align-items-center g-4">
                                        <!-- Week Main Highlight -->
                                        <div class="col-lg-5">
                                            <div class="week-display-banner m-0">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="week-display-label text-uppercase">Academic Calendar Pulse</div>
                                                        <div class="week-display-number">
                                                            <%= typeof shortWeekLabel !== 'undefined' && shortWeekLabel ? shortWeekLabel : ('Week ' + (typeof currentWeek !== 'undefined' ? currentWeek : 1)) %>
                                                        </div>
                                                        <div class="text-white-50 small">
                                                            Week <%= typeof currentWeek !== 'undefined' ? currentWeek : 1 %> of <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %> · <%= typeof currentTerm !== 'undefined' ? currentTerm : 'Term' %>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="fs-1 fw-bold text-white"><%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%</span>
                                                        <div class="text-white-50 small">Completed</div>
                                                    </div>
                                                </div>

                                                <div class="school-week-progress-wrap mt-3 mb-0">
                                                    <div class="school-week-progress-bar">
                                                        <div class="school-week-progress-fill" style="width: <%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%;"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- 4 Quick Metric Tiles -->
                                        <div class="col-lg-7">
                                            <div class="school-week-metrics-grid">
                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-primary">
                                                        <%= typeof daysPassed !== 'undefined' ? daysPassed : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Elapsed</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-success">
                                                        <%= typeof daysRemaining !== 'undefined' ? daysRemaining : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Remaining</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-info">
                                                        <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Total Weeks</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-warning">
                                                        <%= typeof totalDays !== 'undefined' ? totalDays : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Term Span (Days)</div>
                                                </div>
                                            </div>

                                            <div class="mt-3 px-2 d-flex justify-content-between align-items-center text-muted small">
                                                <span>
                                                    <i class="mdi mdi-calendar-check me-1"></i> Term Start: 
                                                    <strong><%= typeof termStartDate !== 'undefined' && termStartDate ? moment(termStartDate).format('MMM D, YYYY') : 'In Session' %></strong>
                                                </span>
                                                <span>
                                                    <i class="mdi mdi-flag-checkered me-1"></i> Term Concludes: 
                                                    <strong><%= typeof termEndDate !== 'undefined' && termEndDate ? moment(termEndDate).format('MMM D, YYYY') : 'Scheduled' %></strong>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Teacher KPI Metrics Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-blue h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Assigned Students</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof totalStudents !== 'undefined' ? totalStudents.toLocaleString() : 0 %>
                                        </h2>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-account-multiple me-1"></i> Across All Classes
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-account-group-outline"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-green h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Teaching Subjects</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof totalSubjects !== 'undefined' ? totalSubjects : 0 %>
                                        </h2>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-book-open-page-variant me-1"></i> Assigned Curriculum
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-book-open-variant"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-amber h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Scores Logged</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof scoresEntered !== 'undefined' ? scoresEntered.toLocaleString() : 0 %>
                                        </h2>
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-pencil-box-outline me-1"></i> Assessment Records
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-clipboard-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-rose h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Today's Attendance</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof todayAttendance !== 'undefined' ? todayAttendance.toLocaleString() : 0 %>
                                        </h2>
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-account-check-outline me-1"></i> Students Present
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-calendar-clock"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Area: Class Schedule & Activities -->
                    <div class="row g-3">
                        <div class="col-xl-8 col-lg-7">
                            <!-- Today's Schedule -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-calendar-clock me-2 text-primary"></i> Today's Class Schedule
                                    </h5>
                                    <a href="/teacher/class-schedule" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Full Schedule <i class="mdi mdi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                                <div class="card-body p-0">
                                    <% if (typeof todaysSchedule !== 'undefined' && todaysSchedule && todaysSchedule.length > 0) { %>
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="ps-4 py-3"><i class="mdi mdi-clock-outline me-1"></i> Session Time</th>
                                                        <th class="py-3"><i class="mdi mdi-google-classroom me-1"></i> Class</th>
                                                        <th class="py-3"><i class="mdi mdi-book-open-outline me-1"></i> Subject</th>
                                                        <th class="pe-4 py-3 text-end">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% todaysSchedule.forEach(function(schedule) { %>
                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill">
                                                                    <%= schedule.startTime ? new Date(schedule.startTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : 'N/A' %>
                                                                    –
                                                                    <%= schedule.endTime ? new Date(schedule.endTime).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : 'N/A' %>
                                                                </span>
                                                            </td>
                                                            <td class="py-3 fw-bold text-dark">
                                                                <%= schedule.className || 'N/A' %>
                                                            </td>
                                                            <td class="py-3">
                                                                <span class="badge bg-light text-dark border px-2 py-1">
                                                                    <%= schedule.subjectName || 'N/A' %>
                                                                </span>
                                                            </td>
                                                            <td class="pe-4 py-3 text-end">
                                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Upcoming</span>
                                                            </td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } else { %>
                                        <div class="text-center text-muted py-5">
                                            <i class="mdi mdi-calendar-blank-outline fs-1 d-block mb-2 opacity-50"></i>
                                            <p class="mb-1 fw-medium">No class sessions scheduled for today</p>
                                            <small class="text-muted">Review upcoming deadlines or prepare lesson notes.</small>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Recent Teacher Activities -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-history me-2 text-info"></i> Recent Instructional Logs
                                    </h5>
                                    <span class="badge bg-light text-muted border px-2 py-1 small">Activity History</span>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <% if (typeof recentActivities !== 'undefined' && recentActivities && recentActivities.length > 0) { %>
                                        <div class="timeline-alt">
                                            <% recentActivities.forEach(function(activity) { %>
                                                <div class="timeline-item mb-3 pb-2 border-bottom">
                                                    <div class="d-flex align-items-start gap-3">
                                                        <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary">
                                                            <i class="mdi mdi-pencil-outline fs-4"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1 fw-bold text-dark">
                                                                <%= activity.activity_type || 'Instructional Update' %>
                                                            </h6>
                                                            <p class="text-muted small mb-0">
                                                                <i class="mdi mdi-clock-outline me-1"></i>
                                                                <%= activity.activity_date ? new Date(activity.activity_date).toLocaleDateString() : 'Recent' %>
                                                                <span class="badge bg-light text-primary border ms-2">
                                                                    <%= activity.count || 1 %> entries recorded
                                                                </span>
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div class="text-center text-muted py-4">
                                            <i class="mdi mdi-inbox-outline fs-1 d-block mb-2 opacity-50"></i>
                                            <p class="mb-0 small fw-medium">No recent instructional activities logged yet</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Shortcuts & Deadlines -->
                        <div class="col-xl-4 col-lg-5">
                            <!-- Quick Instructor Actions -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 pb-1 px-4">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-lightning-bolt me-2 text-warning"></i> Faculty Quick Actions
                                    </h5>
                                    <small class="text-muted">Instant tools for daily academic duties</small>
                                </div>
                                <div class="card-body px-4 pt-2 pb-4">
                                    <div class="d-grid gap-2">
                                        <a href="/enter-scores" class="modern-action-tile">
                                            <div class="modern-action-icon" style="background: rgba(79, 70, 229, 0.12); color: #4f46e5;">
                                                <i class="mdi mdi-pencil-box-outline"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Enter Student Scores</div>
                                                <small class="text-muted">Assessments, Tests & Exams</small>
                                            </div>
                                        </a>

                                        <a href="/mark-attendance" class="modern-action-tile">
                                            <div class="modern-action-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                                                <i class="mdi mdi-check-circle-outline"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Mark Daily Attendance</div>
                                                <small class="text-muted">Morning / Afternoon roll call</small>
                                            </div>
                                        </a>

                                        <a href="/teacher/lesson-notes" class="modern-action-tile">
                                            <div class="modern-action-icon" style="background: rgba(6, 182, 212, 0.12); color: #06b6d4;">
                                                <i class="mdi mdi-notebook-edit-outline"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">Lesson Notes & Plans</div>
                                                <small class="text-muted">Prepare & submit curriculums</small>
                                            </div>
                                        </a>

                                        <a href="/teacher/my-classes" class="modern-action-tile">
                                            <div class="modern-action-icon" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                                                <i class="mdi mdi-account-group-outline"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">My Assigned Classes</div>
                                                <small class="text-muted">Student list & grade books</small>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Upcoming Academic Deadlines -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-alert-circle-outline me-2 text-danger"></i> Term Deadlines
                                    </h5>
                                    <span class="badge bg-light text-muted border px-2 py-1 small"><%= typeof shortWeekLabel !== 'undefined' ? shortWeekLabel : 'Week 1' %></span>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <% if (typeof upcomingDeadlines !== 'undefined' && upcomingDeadlines && upcomingDeadlines.length > 0) { %>
                                        <div class="list-group list-group-flush">
                                            <% upcomingDeadlines.forEach(function(deadline) { %>
                                                <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                                                    <div>
                                                        <i class="mdi mdi-clock-alert text-danger me-2"></i>
                                                        <span class="fw-semibold text-dark"><%= deadline.title || 'Task' %></span>
                                                    </div>
                                                    <% if (deadline.deadline) { %>
                                                        <span class="badge bg-warning bg-opacity-20 text-dark rounded-pill px-3 py-1">
                                                            <%= new Date(deadline.deadline).toLocaleDateString() %>
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary bg-opacity-20 text-muted rounded-pill">Open</span>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div class="text-center text-muted py-4">
                                            <i class="mdi mdi-check-circle-outline fs-1 d-block mb-2 text-success opacity-75"></i>
                                            <p class="mb-0 small fw-medium">All grading and report submissions up to date!</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end Content-->

                <!-- Footer -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6 text-muted">
                                &copy; <%= new Date().getFullYear() %> EduSuite Teacher Workspace
                            </div>
                            <div class="col-md-6 text-md-end text-muted">
                                Academic Year <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : '2026/2027' %> · <%= typeof currentTerm !== 'undefined' ? currentTerm : 'First Term' %>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- Vendor Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        function markRead(notificationId) {
            fetch('/api/teacher/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }
        function markAllRead() {
            fetch('/api/teacher/notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }
    </script>
</body>
</html>