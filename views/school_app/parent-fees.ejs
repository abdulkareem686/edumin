<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Fees - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .fee-card {
            transition: all 0.3s ease;
            border-radius: 15px;
        }
        .stat-card {
            background: #3b5de7;
            color: white;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }
        .status-paid { background: #10b981; color: white; }
        .status-partial { background: #f59e0b; color: white; }
        .status-pending { background: #ef4444; color: white; }
        .status-overpaid { background: #8b5cf6; color: white; }
        .child-card {
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .child-card:hover {
            background: #f8fafd;
            border-color: #3b5de7;
        }
        .child-card.active {
            background: #eef2ff;
            border-color: #3b5de7;
        }
        .child-name {
            font-weight: 600;
            color: #1e293b;
        }
        .notification-unread {
            background-color: #e8f0fe;
            border-left: 3px solid #3b5de7;
        }
        .receipt-btn {
            cursor: pointer;
            transition: all 0.2s;
        }
        .receipt-btn:hover {
            color: #3b5de7;
            text-decoration: underline;
        }
        .progress {
            height: 10px;
            border-radius: 5px;
        }
        .fee-detail-row {
            border-bottom: 1px solid #e9ecef;
            padding: 12px 0;
        }
        .fee-detail-row:last-child {
            border-bottom: none;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/parent-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-wallet me-2"></i>Fee Management
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Back to All Children Navigation & Actions -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <a href="/parent/children" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back to All Children
                        </a>
                        <% if (student) { %>
                        <div class="d-flex gap-2">
                            <a href="/parent/make-payment?studentId=<%= student.id %>" class="btn btn-primary btn-sm">
                                <i class="bi bi-credit-card me-1"></i> Pay School Fees
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <div class="col-12 px-0">
                            <% if (student) { %>
                                <!-- Student Info -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-5">
                                                <small class="text-muted">Student Name</small>
                                                <h5 class="mb-0"><%= student.firstName %> <%= student.middleName ? student.middleName + ' ' : '' %><%= student.lastName %></h5>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">Admission Number</small>
                                                <h6 class="mb-0"><%= student.admission_number || 'N/A' %></h6>
                                            </div>
                                            <div class="col-md-4">
                                                <small class="text-muted">Class</small>
                                                <h6 class="mb-0"><%= student.className || 'Not Assigned' %></h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fee Summary Cards -->
                                <div class="row mb-4">
                                    <div class="col-md-3">
                                        <div class="stat-card">
                                            <div class="stat-number">₦<%= feeSummary.total_due.toLocaleString() %></div>
                                            <div>Total Due</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card" style="background: #10b981;">
                                            <div class="stat-number">₦<%= feeSummary.total_paid.toLocaleString() %></div>
                                            <div>Total Paid</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card" style="background: #ef4444;">
                                            <div class="stat-number">₦<%= feeSummary.total_balance.toLocaleString() %></div>
                                            <div>Balance</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="stat-card" style="background: #8b5cf6;">
                                            <div class="stat-number"><%= feeSummary.paid_percentage %>%</div>
                                            <div>Paid</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Progress Bar -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Payment Progress</span>
                                            <span class="fw-bold"><%= feeSummary.paid_percentage %>% Complete</span>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar bg-success" style="width: <%= feeSummary.paid_percentage %>%"></div>
                                        </div>
                                        <div class="row text-center mt-3">
                                            <div class="col-4">
                                                <div class="small text-muted">Paid Bills</div>
                                                <div class="fw-bold text-success"><%= feeSummary.paid_count %></div>
                                            </div>
                                            <div class="col-4">
                                                <div class="small text-muted">Partial Payments</div>
                                                <div class="fw-bold text-warning"><%= feeSummary.partial_count %></div>
                                            </div>
                                            <div class="col-4">
                                                <div class="small text-muted">Outstanding</div>
                                                <div class="fw-bold text-danger"><%= feeSummary.outstanding_count %></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status Filter -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="btn-group w-100" role="group">
                                            <a href="/parent/fees?studentId=<%= student.id %>&status=all" class="btn btn-outline-primary <%= selectedStatus === 'all' ? 'active' : '' %>">All</a>
                                            <a href="/parent/fees?studentId=<%= student.id %>&status=paid" class="btn btn-outline-success <%= selectedStatus === 'paid' ? 'active' : '' %>">Paid</a>
                                            <a href="/parent/fees?studentId=<%= student.id %>&status=partial" class="btn btn-outline-warning <%= selectedStatus === 'partial' ? 'active' : '' %>">Partial</a>
                                            <a href="/parent/fees?studentId=<%= student.id %>&status=pending" class="btn btn-outline-danger <%= selectedStatus === 'pending' ? 'active' : '' %>">Pending</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fee Details Table -->
                                <div class="card">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Fee Details</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Fee Type</th>
                                                        <th>Academic Year</th>
                                                        <th>Term</th>
                                                        <th class="text-end">Amount Due</th>
                                                        <th class="text-end">Amount Paid</th>
                                                        <th class="text-end">Balance</th>
                                                        <th class="text-center">Status</th>
                                                        <th class="text-center">Receipt</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (fees && fees.length > 0) { 
                                                        for(var i = 0; i < fees.length; i++) { 
                                                            var fee = fees[i];
                                                            var amount = parseFloat(fee.amount) || 0;
                                                            var amountPaid = parseFloat(fee.amountPaid) || 0;
                                                            var balance = amount - amountPaid;
                                                            %>
                                                            <tr>
                                                                <td><strong><%= fee.feeType %></strong></td>
                                                                <td><%= fee.academicYear || '-' %></td>
                                                                <td><%= fee.term || '-' %></td>
                                                                <td class="text-end">₦<%= amount.toLocaleString() %></td>
                                                                <td class="text-end">₦<%= amountPaid.toLocaleString() %></td>
                                                                <td class="text-end <%= balance > 0 ? 'text-danger' : 'text-success' %>">
                                                                    ₦<%= Math.abs(balance).toLocaleString() %>
                                                                    <% if (balance < 0) { %> <span class="small">(Overpaid)</span><% } %>
                                                                </td>
                                                                <td class="text-center">
                                                                    <span class="badge status-<%= fee.status %>"><%= fee.status_display %></span>
                                                                </td>
                                                                <td class="text-center">
                                                                    <% if (fee.amountPaid > 0) { %>
                                                                        <a href="/parent/fee-receipt/<%= fee.id %>" class="btn btn-sm btn-link receipt-btn" target="_blank">
                                                                            <i class="bi bi-receipt"></i> View
                                                                        </a>
                                                                    <% } else { %>
                                                                        <span class="text-muted">-</span>
                                                                    <% } %>
                                                                </td>
                                                            </tr>
                                                    <% } 
                                                    } else { %>
                                                        <tr>
                                                            <td colspan="8" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox fs-1"></i>
                                                                <p class="mt-2 mb-0">No fee records available</p>
                                                                <small>Fee records will appear once generated by the school</small>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Online Fee Payment Submissions -->
                                <% if (typeof submittedPayments !== 'undefined' && submittedPayments && submittedPayments.length > 0) { %>
                                <div class="card mt-4 shadow-sm border-0">
                                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 text-dark"><i class="bi bi-send-check me-2 text-primary"></i>Online Payment Submissions & Approvals</h6>
                                        <span class="badge bg-light text-dark"><%= submittedPayments.length %> Record(s)</span>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Session & Term</th>
                                                        <th>Amount</th>
                                                        <th>Reference / Bank</th>
                                                        <th class="text-center">Term Tally</th>
                                                        <th class="text-center">Status</th>
                                                        <th class="text-center">Receipt</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% submittedPayments.forEach(function(pmt) { %>
                                                        <tr>
                                                            <td><%= moment(pmt.created_at).format('MMM D, YYYY') %></td>
                                                            <td><strong><%= pmt.term %></strong> <small class="text-muted">(<%= pmt.academic_year %>)</small></td>
                                                            <td><strong class="text-primary">₦<%= parseFloat(pmt.amount).toLocaleString() %></strong></td>
                                                            <td>
                                                                <div><%= pmt.bank_name || pmt.payment_method %></div>
                                                                <small class="text-muted font-monospace"><%= pmt.transaction_reference || 'N/A' %></small>
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="badge bg-light text-secondary border">Payment <%= pmt.payment_number || 1 %> of 2</span>
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (pmt.status === 'pending') { %>
                                                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending Approval</span>
                                                                <% } else if (pmt.status === 'approved') { %>
                                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Approved</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-danger" title="<%= pmt.rejection_reason || '' %>"><i class="bi bi-x-circle"></i> Declined</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-center">
                                                                <% if (pmt.status === 'approved' && pmt.fee_id) { %>
                                                                    <a href="/parent/fee-receipt/<%= pmt.fee_id %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                        <i class="bi bi-receipt"></i> View
                                                                    </a>
                                                                <% } else { %>
                                                                    <span class="text-muted">-</span>
                                                                <% } %>
                                                            </td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                <!-- Payment History -->
                                <% if (paymentHistory && paymentHistory.length > 0) { %>
                                <div class="card mt-4">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Payment History</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Amount Paid</th>
                                                        <th>Fee Types</th>
                                                        <th>Transactions</th>
                                                        </tr>
                                                </thead>
                                                <tbody>
                                                    <% for(var i = 0; i < paymentHistory.length; i++) { 
                                                        var payment = paymentHistory[i]; %>
                                                        <tr>
                                                            <td><%= payment.formatted_date %></td>
                                                            <td><strong>₦<%= payment.total_amount.toLocaleString() %></strong></td>
                                                            <td><%= payment.fee_types %></td>
                                                            <td><%= payment.transaction_count %> payment(s)</td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                            <% } else { %>
                                <div class="card p-5 text-center shadow-sm border-0 my-4">
                                    <div class="text-muted mb-3">
                                        <i class="bi bi-people fs-1 text-primary"></i>
                                    </div>
                                    <h4 class="fw-bold">No Child Selected</h4>
                                    <p class="text-muted mb-4">Please select a child from the All Children page to view their fee statement.</p>
                                    <div>
                                        <a href="/parent/children?select=fees" class="btn btn-primary px-4">
                                            <i class="bi bi-arrow-left me-2"></i> Go to All Children
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Parent Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        function markNotificationRead(notificationId) {
            fetch('/api/parent-notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        function markAllNotificationsRead() {
            fetch('/api/parent-notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>
</html>