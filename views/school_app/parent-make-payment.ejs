<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Pay School Fees - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="Make term fee payments directly to school account with verification" name="description" />
    <link rel="shortcut icon" href="/images/favicon.png">

    <!-- App css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/assets/css/school-dashboard.css">

    <style>
        .bank-pay-card {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #0d2346 100%);
            border-radius: 16px;
            padding: 24px 26px;
            color: #ffffff;
            box-shadow: 0 12px 30px rgba(30, 60, 114, 0.25);
            position: relative;
            overflow: hidden;
        }
        .bank-pay-card::after {
            content: '';
            position: absolute;
            right: -30px;
            bottom: -30px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
            border-radius: 50%;
        }
        .account-number-pill {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            padding: 8px 16px;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: 2px;
        }
        .student-active-banner {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        .installment-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
            position: relative;
        }
        .installment-card:hover {
            border-color: #3b5de7;
            transform: translateY(-2px);
        }
        .installment-card.selected {
            border-color: #3b5de7;
            background: #eff6ff;
            box-shadow: 0 4px 12px rgba(59, 93, 231, 0.15);
        }
        .status-pill-pending {
            background-color: #fff8e1;
            color: #b78103;
            border: 1px solid #ffe082;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .status-pill-approved {
            background-color: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .status-pill-rejected {
            background-color: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .term-limit-card {
            border-radius: 12px;
            padding: 16px 20px;
            border-left: 5px solid #3b5de7;
            background: #f8fafc;
        }
        .term-limit-card.limit-reached {
            border-left-color: #ef4444;
            background: #fef2f2;
        }
        .term-limit-card.warning-limit {
            border-left-color: #f59e0b;
            background: #fffbeb;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Parent Sidebar -->
        <%- include('partials/parent-sidebar') %>

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>

                <div class="container-fluid pt-3 pb-4">
                    <!-- Page Header & Title -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="page-title-box d-flex align-items-center justify-content-between">
                                <div>
                                    <h4 class="page-title mb-0 fw-bold">
                                        <i class="bi bi-credit-card-2-front me-2 text-primary"></i>Pay School Fees
                                    </h4>
                                    <p class="text-muted small mb-0">Class Bill Payment Portal · Pay full once or half twice per academic term</p>
                                </div>
                                <div class="page-title-right">
                                    <a href="/parent/children" class="btn btn-outline-secondary btn-sm me-2">
                                        <i class="bi bi-arrow-left me-1"></i> All Children
                                    </a>
                                    <a href="/parent/fees<%= student ? '?studentId=' + student.id : '' %>" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-wallet2 me-1"></i> Fee Statement
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Alerts -->
                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill me-2 fs-4 text-success"></i>
                                <div>
                                    <strong>Payment Submitted:</strong> <%= success %>
                                    <div class="small">The school administrator will verify your transaction reference and credit your child's ledger.</div>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-4 text-danger"></i>
                                <div>
                                    <strong>Notice:</strong> <%= error %>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Active Student Banner (The only student shown on this page!) -->
                    <% if (student) { 
                        const sFullName = [student.firstName, student.middleName, student.lastName].filter(Boolean).join(' ');
                    %>
                        <div class="student-active-banner mb-4">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-md bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fs-2 fw-bold" style="width: 52px; height: 52px;">
                                        <%= student.firstName ? student.firstName.charAt(0).toUpperCase() : 'S' %>
                                    </div>
                                    <div>
                                        <span class="badge bg-primary text-uppercase px-2 py-1 mb-1">Paying Fees For</span>
                                        <h4 class="mb-0 fw-bold text-dark"><%= sFullName %></h4>
                                        <div class="text-muted small mt-1">
                                            Class: <strong class="text-dark"><%= student.className || 'Not Assigned' %></strong> · 
                                            Adm No: <strong class="text-dark"><%= student.admission_number || 'N/A' %></strong> · 
                                            Active Term: <span class="badge bg-light text-dark border"><%= activeTerm %> (<%= activeYear %>)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-sm-end">
                                    <a href="/parent/children" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-people me-1"></i> Switch to Another Child
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Official School Bank Account Details Card -->
                    <div class="bank-pay-card mb-4">
                        <div class="row align-items-center">
                            <div class="col-lg-7 mb-3 mb-lg-0">
                                <span class="badge bg-warning text-dark text-uppercase px-2 py-1 mb-2">
                                    <i class="bi bi-bank"></i> Official School Payment Account
                                </span>
                                <h3 class="text-white fw-bold mb-1"><%= schoolAccount.bank_name || 'School Fee Account' %></h3>
                                <div class="text-white-50 mb-3 small">Account Name: <strong class="text-white"><%= schoolAccount.account_name || school.name %></strong></div>
                                
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <div class="account-number-pill">
                                        <span id="schoolAccNumDisplay"><%= schoolAccount.account_number || 'Contact School' %></span>
                                        <button type="button" class="btn btn-sm btn-light py-1 px-2 border-0" onclick="copySchoolAccount()" title="Copy Account Number">
                                            <i class="bi bi-clipboard"></i> Copy
                                        </button>
                                    </div>
                                    <span class="text-white-50 small ms-2"><i class="bi bi-info-circle"></i> Direct Bank Transfer / Teller</span>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="bg-white bg-opacity-10 p-3 rounded-3 border border-white border-opacity-25">
                                    <h6 class="text-white fw-bold mb-1"><i class="bi bi-journal-text me-1"></i> Transfer Instructions:</h6>
                                    <p class="text-white small mb-0 opacity-90">
                                        <%= schoolAccount.instructions || "Please use your child's Admission Number as payment remarks. Upload your bank receipt screenshot below for prompt approval." %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Left Column: Payment Form & Installment Selector -->
                        <div class="col-lg-7">
                            <div class="card shadow-sm border-0 mb-4">
                                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 text-dark fw-bold">
                                        <i class="bi bi-send-check me-2 text-primary"></i>Fee Payment Form
                                    </h5>
                                    <span id="termTallyHeaderBadge" class="badge <%= termPaymentCount == 0 ? 'bg-success' : (termPaymentCount == 1 ? 'bg-warning text-dark' : 'bg-danger') %>">
                                        <%= termPaymentCount == 0 ? 'Payment 1 of 2 Allowed' : (termPaymentCount == 1 ? 'Payment 2 of 2 (Final)' : 'Term Limit Reached (2/2)') %>
                                    </span>
                                </div>
                                <div class="card-body p-4">
                                    <!-- Term Payment Limit Status Alert -->
                                    <div id="termLimitAlertBox" class="term-limit-card mb-4 <%= termPaymentCount >= 2 ? 'limit-reached' : (termPaymentCount == 1 ? 'warning-limit' : '') %>">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 fw-bold <%= termPaymentCount >= 2 ? 'text-danger' : (termPaymentCount == 1 ? 'text-warning' : 'text-primary') %>" id="termLimitTitle">
                                                <% if (termPaymentCount >= 2) { %>
                                                    <i class="bi bi-exclamation-octagon-fill me-1"></i> Term Payment Limit Reached (2 of 2 Used)
                                                <% } else if (termPaymentCount == 1) { %>
                                                    <i class="bi bi-info-circle-fill me-1"></i> Second & Final Allowed Payment for Term
                                                <% } else { %>
                                                    <i class="bi bi-check-circle-fill me-1"></i> First Payment of the Term (2 Payments Allowed)
                                                <% } %>
                                            </h6>
                                            <span class="small fw-bold text-muted" id="termRemainingText">
                                                <%= remainingPayments %> payment(s) remaining
                                            </span>
                                        </div>
                                        <p class="small text-muted mb-2" id="termLimitDescription">
                                            <% if (termPaymentCount >= 2) { %>
                                                You have already submitted the maximum allowed <strong>2 payments</strong> for <strong><%= activeTerm %> (<%= activeYear %>)</strong> for this student. No additional payments can be submitted for this term.
                                            <% } else if (termPaymentCount == 1) { %>
                                                You have previously submitted 1 payment this term. This submission is recorded as your <strong>second and final payment</strong> for <%= activeTerm %>.
                                            <% } else { %>
                                                Under school fee policy, parents can pay the fixed class bill <strong>either full once (100%) or half installment twice (50% each)</strong> in a term.
                                            <% } %>
                                        </p>
                                        <div class="progress" style="height: 6px;">
                                            <div id="termProgressBar" class="progress-bar <%= termPaymentCount >= 2 ? 'bg-danger' : (termPaymentCount == 1 ? 'bg-warning' : 'bg-success') %>" 
                                                 style="width: <%= (termPaymentCount / 2) * 100 %>%;"></div>
                                        </div>
                                    </div>

                                    <!-- Class Bill & Balance Breakdown Card -->
                                    <div class="card bg-light border mb-4">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="mb-0 fw-bold text-dark">
                                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Fixed Class Bill & Ledger
                                                </h6>
                                                <span class="badge bg-primary bg-opacity-10 text-primary" id="classDisplayBadge">
                                                    <%= student ? (student.className || 'Class Bill') : 'Class Bill' %>
                                                </span>
                                            </div>

                                            <div class="row g-2 text-center my-2">
                                                <div class="col-4">
                                                    <div class="p-2 bg-white rounded border">
                                                        <small class="text-muted d-block small">Fixed Class Bill</small>
                                                        <span class="fw-bold text-dark fs-6" id="totalBillDisplay">
                                                            ₦<%= (typeof totalClassBill !== 'undefined' ? totalClassBill : 0).toLocaleString() %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-2 bg-white rounded border">
                                                        <small class="text-muted d-block small">Amount Paid</small>
                                                        <span class="fw-bold text-success fs-6" id="totalPaidDisplay">
                                                            ₦<%= (typeof totalPaidSoFar !== 'undefined' ? totalPaidSoFar : 0).toLocaleString() %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-2 bg-white rounded border border-warning">
                                                        <small class="text-muted d-block small">Balance Due</small>
                                                        <span class="fw-bold text-danger fs-6" id="balanceDisplay">
                                                            ₦<%= (typeof outstandingBalance !== 'undefined' ? outstandingBalance : 0).toLocaleString() %>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Fee Line Items Breakdown -->
                                            <div class="mt-2" id="billBreakdownContainer">
                                                <% if (typeof classBills !== 'undefined' && classBills && classBills.length > 0) { %>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-borderless mb-0 small">
                                                            <tbody>
                                                                <% classBills.forEach(function(b) { %>
                                                                    <tr class="border-bottom border-light">
                                                                        <td class="text-muted py-1"><i class="bi bi-dot"></i> <%= b.fee_type %></td>
                                                                        <td class="text-end fw-semibold py-1">₦<%= parseFloat(b.amount).toLocaleString() %></td>
                                                                    </tr>
                                                                <% }); %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <% if (outstandingBalance <= 0 && totalClassBill > 0) { %>
                                        <!-- Fees Fully Cleared Notice -->
                                        <div class="alert alert-success text-center py-4 mb-0 rounded-3">
                                            <i class="bi bi-check-circle-fill fs-1 text-success d-block mb-2"></i>
                                            <h5 class="text-success fw-bold">Class Bill Fully Settled!</h5>
                                            <p class="small text-muted mb-3">
                                                All fees for <strong><%= student ? [student.firstName, student.lastName].join(' ') : 'student' %></strong> for <strong><%= activeTerm %> (<%= activeYear %>)</strong> have been paid in full.
                                            </p>
                                            <a href="/parent/fees<%= student ? '?studentId=' + student.id : '' %>" class="btn btn-outline-success btn-sm">
                                                <i class="bi bi-receipt me-1"></i> View Official Receipt & Statements
                                            </a>
                                        </div>
                                    <% } else if (termPaymentCount >= 2) { %>
                                        <!-- Term Limit Reached Notice -->
                                        <div class="alert alert-secondary text-center py-4 mb-0 rounded-3">
                                            <i class="bi bi-lock-fill fs-1 d-block mb-2 text-danger"></i>
                                            <h5 class="text-danger fw-bold">Payment Form Locked</h5>
                                            <p class="small text-muted mb-3">
                                                Maximum 2 payments per term limit reached for <strong><%= student ? [student.firstName, student.lastName].join(' ') : 'student' %></strong> in <strong><%= activeTerm %> (<%= activeYear %>)</strong>.
                                            </p>
                                            <a href="/parent/fees<%= student ? '?studentId=' + student.id : '' %>" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-wallet2 me-1"></i> View Fee Statement & History
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <!-- Payment Submission Form -->
                                        <form action="/parent/make-payment" method="POST" enctype="multipart/form-data" id="paymentForm">
                                            <input type="hidden" name="studentId" id="formStudentId" value="<%= selectedStudentId %>">

                                            <!-- Session & Term Selection -->
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Academic Session <span class="text-danger">*</span></label>
                                                    <select class="form-select" name="academicYear" id="academicYearSelect" onchange="onTermOrYearChanged()" required>
                                                        <% if (academicYears && academicYears.length > 0) { %>
                                                            <% academicYears.forEach(function(y) { %>
                                                                <option value="<%= y.year_name %>" <%= activeYear === y.year_name ? 'selected' : '' %>><%= y.year_name %></option>
                                                            <% }); %>
                                                        <% } else { %>
                                                            <option value="<%= activeYear %>" selected><%= activeYear %></option>
                                                        <% } %>
                                                    </select>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Academic Term <span class="text-danger">*</span></label>
                                                    <select class="form-select" name="term" id="termSelect" onchange="onTermOrYearChanged()" required>
                                                        <option value="First Term" <%= activeTerm === 'First Term' ? 'selected' : '' %>>First Term</option>
                                                        <option value="Second Term" <%= activeTerm === 'Second Term' ? 'selected' : '' %>>Second Term</option>
                                                        <option value="Third Term" <%= activeTerm === 'Third Term' ? 'selected' : '' %>>Third Term</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- ========================================================================= -->
                                            <!-- FIXED CLASS BILL INSTALLMENT SELECTOR (FULL ONCE OR HALF TWICE) -->
                                            <!-- ========================================================================= -->
                                            <div class="mb-3">
                                                <label class="form-label fw-bold text-dark">
                                                    Select Payment Option <span class="text-danger">*</span>
                                                </label>
                                                <div class="form-text small mb-2 text-muted">
                                                    Under school policy, the fixed class bill can be paid in full once, or in two equal half installments (50% each).
                                                </div>

                                                <div id="installmentOptionsContainer">
                                                    <% if (termPaymentCount === 0) { %>
                                                        <!-- First Payment: Choose Full Once or Half First Installment -->
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <div class="installment-card selected" id="optFullCard" onclick="selectInstallmentOption('full', <%= totalClassBill %>)">
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio" name="installmentOption" id="optFullRadio" value="full" checked>
                                                                        <label class="form-check-label fw-bold text-dark" for="optFullRadio">
                                                                            Pay Full Bill Once
                                                                        </label>
                                                                    </div>
                                                                    <div class="mt-2">
                                                                        <span class="fs-4 fw-bold text-primary">₦<%= totalClassBill.toLocaleString() %></span>
                                                                        <div class="small text-muted mt-1">Single payment (100% of class bill) clears the entire term.</div>
                                                                    </div>
                                                                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Full (1/1)</span>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-6">
                                                                <div class="installment-card" id="optHalfCard" onclick="selectInstallmentOption('half', <%= halfAmount %>)">
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio" name="installmentOption" id="optHalfRadio" value="half">
                                                                        <label class="form-check-label fw-bold text-dark" for="optHalfRadio">
                                                                            Pay Half Bill (1st of 2)
                                                                        </label>
                                                                    </div>
                                                                    <div class="mt-2">
                                                                        <span class="fs-4 fw-bold text-warning text-dark">₦<%= halfAmount.toLocaleString() %></span>
                                                                        <div class="small text-muted mt-1">Pay 50% now. Remaining 50% will be paid in your 2nd installment.</div>
                                                                    </div>
                                                                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Half (1/2)</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    <% } else if (termPaymentCount === 1) { %>
                                                        <!-- Second Payment: Must pay remaining half balance -->
                                                        <div class="installment-card selected">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="radio" name="installmentOption" id="optSecondRadio" value="second_half" checked>
                                                                <label class="form-check-label fw-bold text-dark" for="optSecondRadio">
                                                                    Pay Remaining Half (2nd & Final Installment)
                                                                </label>
                                                            </div>
                                                            <div class="mt-2">
                                                                <span class="fs-4 fw-bold text-success">₦<%= outstandingBalance.toLocaleString() %></span>
                                                                <div class="small text-muted mt-1">This payment clears your remaining 50% balance for <%= activeTerm %>.</div>
                                                            </div>
                                                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Final (2/2)</span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <!-- Amount Input Field (Strictly locked to the selected fixed installment) -->
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Amount to Pay (₦) <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <span class="input-group-text fw-bold bg-light">₦</span>
                                                    <input type="number" step="0.01" class="form-control fs-5 fw-bold bg-white" name="amount" id="amount" 
                                                           value="<%= termPaymentCount === 0 ? totalClassBill : outstandingBalance %>" readonly required>
                                                </div>
                                                <div class="form-text small text-muted">
                                                    <i class="bi bi-lock-fill me-1 text-primary"></i> Fixed per school class bill schedule.
                                                </div>
                                            </div>

                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Payment Method <span class="text-danger">*</span></label>
                                                    <select class="form-select" name="paymentMethod" required>
                                                        <option value="Bank Transfer" selected>Direct Bank Transfer (Mobile App / Online)</option>
                                                        <option value="Bank Deposit">Bank Branch Cash Deposit (Teller)</option>
                                                        <option value="USSD">USSD Transfer</option>
                                                        <option value="POS">POS Transfer</option>
                                                    </select>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Your Bank (Paid From)</label>
                                                    <input type="text" class="form-control" name="bankName" 
                                                           placeholder="e.g. GTBank, Zenith, OPay">
                                                </div>
                                            </div>

                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Transaction Reference / Teller No. <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" name="transactionReference" 
                                                           placeholder="e.g. TXN10982390 or Teller #1234" required>
                                                    <div class="form-text small">Found on your bank receipt or transfer slip.</div>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Date of Payment <span class="text-danger">*</span></label>
                                                    <input type="date" class="form-control" name="paymentDate" 
                                                           value="<%= moment().format('YYYY-MM-DD') %>" required>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Upload Payment Proof / Bank Slip</label>
                                                <input type="file" class="form-control" name="proofDocument" id="proofDocument" 
                                                       accept="image/jpeg,image/png,image/webp,application/pdf">
                                                <div class="form-text small">Upload transfer screenshot or scanned teller (JPG, PNG, WEBP, or PDF, max 10MB).</div>
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label fw-bold">Notes / Description (Optional)</label>
                                                <textarea class="form-control" name="notes" rows="2" 
                                                          placeholder="Any additional notes for the school bursar..."></textarea>
                                            </div>

                                            <div class="d-grid">
                                                <button type="submit" class="btn btn-primary btn-lg fw-bold" id="submitBtn">
                                                    <i class="bi bi-shield-check me-1"></i> Submit Payment for School Verification
                                                </button>
                                            </div>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Payment History & Help -->
                        <div class="col-lg-5">
                            <!-- Submitted Payment History for this Student -->
                            <div class="card shadow-sm border-0 mb-4">
                                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 text-dark fw-bold">
                                        <i class="bi bi-clock-history me-1 text-primary"></i>Submission History
                                    </h6>
                                    <span class="badge bg-light text-dark border">
                                        <%= myPayments ? myPayments.length : 0 %> record(s)
                                    </span>
                                </div>
                                <div class="card-body p-0">
                                    <% if (myPayments && myPayments.length > 0) { %>
                                        <div class="list-group list-group-flush">
                                            <% myPayments.forEach(function(pmt) { %>
                                                <div class="list-group-item p-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                        <div>
                                                            <strong class="text-dark">₦<%= parseFloat(pmt.amount).toLocaleString() %></strong>
                                                            <div class="small text-muted">
                                                                <%= pmt.term %> (<%= pmt.academic_year %>)
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <% if (pmt.status === 'approved') { %>
                                                                <span class="status-pill-approved">
                                                                    <i class="bi bi-check-circle-fill"></i> Approved
                                                                </span>
                                                            <% } else if (pmt.status === 'rejected') { %>
                                                                <span class="status-pill-rejected" title="<%= pmt.rejection_reason || 'Declined' %>">
                                                                    <i class="bi bi-x-circle-fill"></i> Declined
                                                                </span>
                                                            <% } else { %>
                                                                <span class="status-pill-pending">
                                                                    <i class="bi bi-hourglass-split"></i> Pending Verification
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <div class="small text-muted d-flex justify-content-between">
                                                        <span>Ref: <%= pmt.transaction_reference || 'N/A' %></span>
                                                        <span><%= moment(pmt.payment_date).format('MMM D, YYYY') %></span>
                                                    </div>

                                                    <% if (pmt.status === 'rejected' && pmt.rejection_reason) { %>
                                                        <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small rounded-2">
                                                            <strong>Declined Reason:</strong> <%= pmt.rejection_reason %>
                                                            <div class="text-muted" style="font-size: 0.72rem;">* Note: Declined payments do not count against your 2-payment limit and are not added to your dashboard.</div>
                                                        </div>
                                                    <% } %>

                                                    <% if (pmt.status === 'approved' && pmt.fee_id) { %>
                                                        <div class="mt-2 text-end">
                                                            <a href="/parent/fee-receipt/<%= pmt.fee_id %>" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2 small">
                                                                <i class="bi bi-receipt"></i> Official Receipt
                                                            </a>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } else { %>
                                        <div class="p-4 text-center text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 text-muted opacity-50"></i>
                                            <p class="small mb-0">No payment submissions recorded for this student yet.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Policy Card -->
                            <div class="card shadow-sm border-0 border-start border-4 border-primary">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-primary mb-1"><i class="bi bi-shield-check me-1"></i> School Fee Policy</h6>
                                    <p class="small text-muted mb-0">
                                        • Every class bill has a fixed schedule set by the school.<br>
                                        • Parents may pay either <strong>Full once (100%)</strong> or <strong>Half twice (50% each)</strong> in a term.<br>
                                        • Any payment declined during review does not count towards the 2-payment limit and is excluded from dashboards.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6 text-muted">
                            &copy; <%= new Date().getFullYear() %> EduSuite Parent Portal
                        </div>
                        <div class="col-md-6 text-md-end text-muted">
                            Session: <%= activeYear %> · <%= activeTerm %>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        function selectInstallmentOption(type, amount) {
            const amountInput = document.getElementById('amount');
            if (amountInput) amountInput.value = amount;

            const fullCard = document.getElementById('optFullCard');
            const halfCard = document.getElementById('optHalfCard');
            const fullRadio = document.getElementById('optFullRadio');
            const halfRadio = document.getElementById('optHalfRadio');

            if (type === 'full') {
                if (fullCard) fullCard.classList.add('selected');
                if (halfCard) halfCard.classList.remove('selected');
                if (fullRadio) fullRadio.checked = true;
            } else {
                if (halfCard) halfCard.classList.add('selected');
                if (fullCard) fullCard.classList.remove('selected');
                if (halfRadio) halfRadio.checked = true;
            }
        }

        function onTermOrYearChanged() {
            const studentId = document.getElementById('formStudentId') ? document.getElementById('formStudentId').value : '<%= selectedStudentId %>';
            const yr = document.getElementById('academicYearSelect').value;
            const trm = document.getElementById('termSelect').value;

            // Check dynamically via AJAX
            fetch(`/api/parent/payment-count?studentId=${studentId}&academicYear=${encodeURIComponent(yr)}&term=${encodeURIComponent(trm)}`)
                .then(r => r.json())
                .then(data => {
                    const count = data.count || 0;
                    const canPay = data.canPay;
                    const remaining = data.remaining;
                    const fullAmt = data.fullAmount || 0;
                    const halfAmt = data.halfAmount || 0;
                    const secondHalfAmt = data.secondHalfAmount || 0;

                    // Update UI elements
                    const badge = document.getElementById('termTallyHeaderBadge');
                    const title = document.getElementById('termLimitTitle');
                    const desc = document.getElementById('termLimitDescription');
                    const remText = document.getElementById('termRemainingText');
                    const pBar = document.getElementById('termProgressBar');
                    const box = document.getElementById('termLimitAlertBox');
                    const submitBtn = document.getElementById('submitBtn');
                    const amountInput = document.getElementById('amount');

                    if (remText) remText.textContent = remaining + ' payment(s) remaining';
                    if (pBar) pBar.style.width = ((count / 2) * 100) + '%';

                    // Update bill figures
                    const billEl = document.getElementById('totalBillDisplay');
                    const paidEl = document.getElementById('totalPaidDisplay');
                    const balEl = document.getElementById('balanceDisplay');
                    if (billEl) billEl.textContent = '₦' + (data.totalClassBill || 0).toLocaleString();
                    if (paidEl) paidEl.textContent = '₦' + (data.totalPaidSoFar || 0).toLocaleString();
                    if (balEl) balEl.textContent = '₦' + (data.outstandingBalance || 0).toLocaleString();

                    // Update breakdown table
                    const bContainer = document.getElementById('billBreakdownContainer');
                    if (bContainer && data.classBills && data.classBills.length > 0) {
                        let rows = '<div class="table-responsive"><table class="table table-sm table-borderless mb-0 small"><tbody>';
                        data.classBills.forEach(b => {
                            rows += `<tr class="border-bottom border-light"><td class="text-muted py-1"><i class="bi bi-dot"></i> ${b.fee_type}</td><td class="text-end fw-semibold py-1">₦${parseFloat(b.amount).toLocaleString()}</td></tr>`;
                        });
                        rows += '</tbody></table></div>';
                        bContainer.innerHTML = rows;
                    }

                    // Update installment options container
                    const optContainer = document.getElementById('installmentOptionsContainer');
                    if (optContainer) {
                        if (count === 0 && data.totalClassBill > 0) {
                            optContainer.innerHTML = `
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="installment-card selected" id="optFullCard" onclick="selectInstallmentOption('full', ${fullAmt})">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="installmentOption" id="optFullRadio" value="full" checked>
                                                <label class="form-check-label fw-bold text-dark" for="optFullRadio">Pay Full Bill Once</label>
                                            </div>
                                            <div class="mt-2">
                                                <span class="fs-4 fw-bold text-primary">₦${fullAmt.toLocaleString()}</span>
                                                <div class="small text-muted mt-1">Single payment (100% of class bill) clears the entire term.</div>
                                            </div>
                                            <span class="badge bg-success position-absolute top-0 end-0 m-2">Full (1/1)</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="installment-card" id="optHalfCard" onclick="selectInstallmentOption('half', ${halfAmt})">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="installmentOption" id="optHalfRadio" value="half">
                                                <label class="form-check-label fw-bold text-dark" for="optHalfRadio">Pay Half Bill (1st of 2)</label>
                                            </div>
                                            <div class="mt-2">
                                                <span class="fs-4 fw-bold text-warning text-dark">₦${halfAmt.toLocaleString()}</span>
                                                <div class="small text-muted mt-1">Pay 50% now. Remaining 50% will be paid in your 2nd installment.</div>
                                            </div>
                                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Half (1/2)</span>
                                        </div>
                                    </div>
                                </div>
                            `;
                            if (amountInput) amountInput.value = fullAmt;
                        } else if (count === 1 && data.outstandingBalance > 0) {
                            optContainer.innerHTML = `
                                <div class="installment-card selected">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="installmentOption" id="optSecondRadio" value="second_half" checked>
                                        <label class="form-check-label fw-bold text-dark" for="optSecondRadio">Pay Remaining Half (2nd & Final Installment)</label>
                                    </div>
                                    <div class="mt-2">
                                        <span class="fs-4 fw-bold text-success">₦${secondHalfAmt.toLocaleString()}</span>
                                        <div class="small text-muted mt-1">This payment clears your remaining 50% balance for ${trm}.</div>
                                    </div>
                                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Final (2/2)</span>
                                </div>
                            `;
                            if (amountInput) amountInput.value = secondHalfAmt;
                        }
                    }

                    if (data.outstandingBalance <= 0 && data.totalClassBill > 0) {
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Class Bill Fully Settled for this Term';
                        }
                    } else if (count >= 2) {
                        if (badge) {
                            badge.className = 'badge bg-danger';
                            badge.textContent = 'Term Limit Reached (2/2)';
                        }
                        if (box) box.className = 'term-limit-card mb-4 limit-reached';
                        if (title) {
                            title.className = 'mb-0 fw-bold text-danger';
                            title.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-1"></i> Term Payment Limit Reached (2 of 2 Used)';
                        }
                        if (desc) {
                            desc.innerHTML = `You have already submitted the maximum allowed <strong>2 payments</strong> for <strong>${trm} (${yr})</strong>.`;
                        }
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.innerHTML = '<i class="bi bi-lock-fill me-1"></i> Payment Limit Reached for this Term';
                        }
                    } else if (count == 1) {
                        if (badge) {
                            badge.className = 'badge bg-warning text-dark';
                            badge.textContent = 'Payment 2 of 2 (Final)';
                        }
                        if (box) box.className = 'term-limit-card mb-4 warning-limit';
                        if (title) {
                            title.className = 'mb-0 fw-bold text-warning';
                            title.innerHTML = '<i class="bi bi-info-circle-fill me-1"></i> Second & Final Allowed Payment for Term';
                        }
                        if (desc) {
                            desc.innerHTML = `You have previously made 1 payment this term. This will be your <strong>2nd and final payment</strong> for ${trm}.`;
                        }
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-shield-check me-1"></i> Submit 2nd (Final) Payment for Approval';
                        }
                    } else {
                        if (badge) {
                            badge.className = 'badge bg-success';
                            badge.textContent = 'Payment 1 of 2 Allowed';
                        }
                        if (box) box.className = 'term-limit-card mb-4';
                        if (title) {
                            title.className = 'mb-0 fw-bold text-primary';
                            title.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> First Payment of the Term (2 Payments Allowed)';
                        }
                        if (desc) {
                            desc.innerHTML = `School policy allows a maximum of <strong>2 fee payments per academic term</strong> per student. You may pay full once or half twice.`;
                        }
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-shield-check me-1"></i> Submit Payment for School Verification';
                        }
                    }
                })
                .catch(err => console.error('Error checking payment count:', err));
        }

        function copySchoolAccount() {
            const acc = document.getElementById('schoolAccNumDisplay').textContent.trim();
            if (acc && acc !== 'Contact School') {
                navigator.clipboard.writeText(acc).then(() => {
                    alert('School account number copied to clipboard: ' + acc);
                });
            } else {
                alert('Account number not available. Please contact the school.');
            }
        }
    </script>
</body>
</html>
