<!-- Processing Overlay -->
<div id="processingOverlay" class="processing-overlay" style="display: none;">
    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
        <span class="visually-hidden">Processing...</span>
    </div>
    <h4 id="processingText">Processing Salaries...</h4>
    <p class="text-muted" id="processingSubtext">Please wait while we process the salaries</p>
</div>

<script>
    // Show processing overlay
    function showProcessing(message, submessage) {
        document.getElementById('processingText').textContent = message;
        document.getElementById('processingSubtext').textContent = submessage;
        document.getElementById('processingOverlay').style.display = 'flex';
    }

    // Hide processing overlay
    function hideProcessing() {
        document.getElementById('processingOverlay').style.display = 'none';
    }

    // Process individual salary
    async function processSalary(employeeId, employeeType, employeeName) {
        if (!confirm(`Process salary for ${employeeName}?`)) {
            return;
        }

        showProcessing(`Processing ${employeeName}`, 'Please wait...');

        try {
            const response = await fetch('/process-salary', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    employee_id: employeeId,
                    employee_type: employeeType,
                    month: '<%= currentMonth %>'
                })
            });

            const result = await response.json();

            if (result.success) {
                hideProcessing();
                alert(`Salary processed successfully for ${employeeName}!`);
                location.reload();
            } else {
                hideProcessing();
                alert('Error: ' + result.error);
            }
        } catch (error) {
            hideProcessing();
            alert('Failed to process salary. Please try again.');
            console.error('Error:', error);
        }
    }

    // Process all salaries
    async function processAll() {
        const unprocessedCount = <%= (teachers.length + staff.length) - Object.keys(processedMap).length %>;
        
        if (unprocessedCount === 0) {
            alert('All salaries have already been processed for this month!');
            return;
        }

        if (!confirm(`Process salaries for ${unprocessedCount} employees?`)) {
            return;
        }

        showProcessing('Processing All Salaries', `Processing ${unprocessedCount} employees...`);

        try {
            // Process teachers
            <% teachers.forEach(teacher => { %>
                <% if (!processedMap[`teacher_${teacher.id}`]) { %>
                    await processSalary(<%= teacher.id %>, 'teacher', '<%= teacher.firstName %> <%= teacher.lastName %>');
                <% } %>
            <% }); %>

            // Process staff
            <% staff.forEach(staffMember => { %>
                <% if (!processedMap[`staff_${staffMember.id}`]) { %>
                    await processSalary(<%= staffMember.id %>, 'staff', '<%= staffMember.firstName %> <%= staffMember.lastName %>');
                <% } %>
            <% }); %>

            hideProcessing();
            alert('All salaries processed successfully!');
            location.reload();
        } catch (error) {
            hideProcessing();
            alert('Some salaries failed to process. Please check the processed ones and try again.');
            console.error('Error:', error);
        }
    }

    // Export to Excel function
    function exportToExcel() {
        alert('Export feature would be implemented here. This would export the salary data to Excel format.');
        // Implementation would use libraries like SheetJS or server-side generation
    }

    // Auto-refresh page every 30 seconds to check for updates
    setInterval(() => {
        console.log('Auto-refreshing salary page...');
        location.reload();
    }, 30000);
</script>
        <!-- Vendor JS -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>
    </body>
