    <!-- Success/Error Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- Month Selector and Controls -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="GET" class="row align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Select Month</label>
                            <input type="month" class="form-control" name="month" 
                                   value="<%= currentMonth %>" onchange="this.form.submit()">
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" id="showProcessed" 
                                       <%= showProcessed ? 'checked' : '' %> onchange="this.form.submit()">
                                <label class="form-check-label" for="showProcessed">
                                    Show Processed Salaries
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="btn-group">
                                <button type="button" class="btn btn-primary" onclick="processAll()">
                                    <i class="bi bi-lightning-fill me-1"></i> Process All
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="exportToExcel()">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Export
                                </button>
                                <a href="/salary-payments?month=<%= currentMonth %>" class="btn btn-outline-info">
                                    <i class="bi bi-list-check me-1"></i> View Payments
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stats-card total-employees">
                <div class="card-body text-center">
                    <h2 class="text-primary"><%= teachers.length + staff.length %></h2>
                    <p class="text-muted mb-0">Total Employees</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card processed">
                <div class="card-body text-center">
                    <h2 class="text-success"><%= Object.keys(processedMap).length %></h2>
                    <p class="text-muted mb-0">Processed</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card pending">
                <div class="card-body text-center">
                    <h2 class="text-warning"><%= (teachers.length + staff.length) - Object.keys(processedMap).length %></h2>
                    <p class="text-muted mb-0">Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stats-card current-month">
                <div class="card-body text-center">
                    <h2 class="text-secondary"><%= new Date(currentMonth + '-01').toLocaleDateString('en-US', {month: 'long', year: 'numeric'}) %></h2>
                    <p class="text-muted mb-0">Processing Month</p>
