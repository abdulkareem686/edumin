<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>edu admin</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
        <meta content="Coderthemes" name="author">
        <!-- App favicon -->
        <link rel="shortcut icon" href="images/favicon.png">

        <!-- App css -->
        <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
        <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
        <link rel="stylesheet" href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css">
        <link rel="stylesheet" href="/vendor/bootstrap-datepicker/css/bootstrap-datepicker.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    </head>

    <body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <!-- Begin page -->
        <div class="wrapper">
            <!-- ========== Left Sidebar Start ========== -->
<!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->
            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->

            <div class="content-page">
                <div class="content">
                    <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->
                    <!-- Start Content-->
                    <div class="container-fluid">
                        
                        <!-- start page title -->
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <div class="page-title-right">
                                        <ol class="breadcrumb m-0">
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Home</a></li>
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">subjects</a></li>
                                            <li class="breadcrumb-item active">Create Subject</li>
                                        </ol>
                                    </div>
                                    <h4 class="page-title">Create Subject</h4>
                                </div>
                            </div>
                        </div>     
                        <!-- end page title --> 

                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Basic Info</h5>
                               <form action="/register-subjects" method="post">
    <% if (error) { %>
        <div class="alert alert-danger mb-3">
            <%= error %>
        </div>
    <% } %>

    <div class="row">
        <div class="col-xl-4">
            <div class="mb-3">
                <label class="form-label">Select Level*</label>
                <select class="form-control" name="level" required id="level-select">
                    <option value="">Select a level</option>
                    <% if (levels && levels.length) { %>
                        <% levels.forEach(level => { %>
                            <option value="<%= level.name %>" 
                                <%= formData.level === level.name ? 'selected' : '' %>>
                                <%= level.name %>
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option value="" disabled>No levels available</option>
                    <% } %>
                </select>
            </div>
        </div>

        <div class="col-xl-4" id="department-field" style="display: none;">
            <div class="mb-3">
                <label class="form-label">Select Department <span class="text-danger">*</span></label>
                <select class="form-control" name="department" id="department-select">
                    <option value="">Select department</option>
                    <option value="ALL" <%= (formData.department === 'ALL' || formData.autoAllDepartments) ? 'selected' : '' %>>All Departments (Science, Commercial, Art)</option>
                    <% if (departments && departments.length) { %>
                        <% departments.forEach(dept => { %>
                            <option value="<%= dept.name %>" 
                                <%= (formData.department === dept.name && !formData.autoAllDepartments) ? 'selected' : '' %>>
                                <%= dept.name %>
                            </option>
                        <% }); %>
                    <% } else { %>
                        <option value="" disabled>No departments available</option>
                    <% } %>
                </select>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="all-departments-check" name="autoAllDepartments" value="1" <%= (formData.autoAllDepartments || formData.department === 'ALL') ? 'checked' : '' %>>
                    <label class="form-check-label fw-semibold text-primary" for="all-departments-check">
                        <i class="bi bi-diagram-3-fill me-1"></i> Register for all departments automatically
                    </label>
                </div>
                <div class="form-text text-muted mt-1" id="dept-help">
                    <span id="single-dept-help" class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>Required for Senior Secondary subjects.</span>
                    <span id="all-dept-help" class="text-success fw-medium" style="display:none;"><i class="bi bi-check2-circle me-1"></i>Will automatically register subject(s) to all Senior Secondary classes across all departments (Science, Commercial, Art).</span>
                </div>
            </div>
        </div>
    </div>


    <div id="subjects-container">
        <% const subjects = formData.subjects || ['']; %>
        <% const subject_codes = formData.subject_codes || ['']; %>
        <% const descriptions = formData.descriptions || ['']; %>
        
        <% for (let i = 0; i < subjects.length; i++) { %>
            <div class="row subject-row mb-3">
                <div class="col-xl-4">
                    <div class="mb-3">
                        <label class="form-label">Subject Name*</label>
                        <input type="text" class="form-control" name="subjects[]" 
                            value="<%= subjects[i] %>" 
                            placeholder="e.g. Mathematics" required>
                    </div>
                </div>
                
                <div class="col-xl-3">
                    <div class="mb-3">
                        <label class="form-label">Subject Code*</label>
                        <input type="text" class="form-control" name="subject_codes[]" 
                            value="<%= subject_codes[i] %>"
                            placeholder="e.g. MATH101" required>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="descriptions[]" 
                            rows="1" placeholder="Subject description"><%= descriptions[i] %></textarea>
                    </div>
                </div>

                <div class="col-xl-1 d-flex align-items-end mb-3">
                    <% if (i === 0) { %>
                        <button type="button" class="btn btn-secondary w-100" disabled>
                            <i class="fas fa-plus"></i>
                        </button>
                    <% } else { %>
                        <button type="button" class="btn btn-danger remove-subject w-100">
                            <i class="fas fa-times"></i>
                        </button>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>

    <div class="row mt-2">
        <div class="col-md-12">
            <button type="button" id="add-subject" class="btn btn-secondary">
                <i class="fas fa-plus me-1"></i> Add Another Subject
            </button>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Register Subjects</button>
            <button type="reset" class="btn btn-light ms-2">Cancel</button>
        </div>
    </div>
</form>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const levelSelect = document.getElementById('level-select');
    const departmentField = document.getElementById('department-field');
    const departmentSelect = document.getElementById('department-select');
    const classesContainer = document.getElementById('classes-container');
    
    // Store classes data from server
    const classesData = {
        <% Object.keys(classesByLevel || {}).forEach(level => { %>
            '<%= level %>': [
                <% classesByLevel[level].forEach(cls => { %>
                    {
                        id: <%= cls.id %>,
                        className: '<%= cls.className %>',
                        department: '<%= cls.department || '' %>'
                    },
                <% }); %>
            ],
        <% }); %>
    };

    const allDepartmentsCheck = document.getElementById('all-departments-check');
    const singleDeptHelp = document.getElementById('single-dept-help');
    const allDeptHelp = document.getElementById('all-dept-help');
    const registerForm = document.querySelector('form[action="/register-subjects"]');

    function updateDepartmentState() {
        if (!levelSelect) return;
        const isSenior = levelSelect.value === 'SENIOR SECONDARY';
        
        if (!isSenior) {
            if (departmentField) departmentField.style.display = 'none';
            if (departmentSelect) {
                departmentSelect.removeAttribute('required');
                departmentSelect.value = '';
            }
            if (allDepartmentsCheck) allDepartmentsCheck.checked = false;
            if (singleDeptHelp) singleDeptHelp.style.display = 'inline';
            if (allDeptHelp) allDeptHelp.style.display = 'none';
            return;
        }

        if (departmentField) departmentField.style.display = 'block';

        const isAll = (allDepartmentsCheck && allDepartmentsCheck.checked) || (departmentSelect && departmentSelect.value === 'ALL');

        if (isAll) {
            if (departmentSelect && departmentSelect.value !== 'ALL') {
                departmentSelect.value = 'ALL';
            }
            if (allDepartmentsCheck) allDepartmentsCheck.checked = true;
            if (departmentSelect) departmentSelect.removeAttribute('required');
            if (singleDeptHelp) singleDeptHelp.style.display = 'none';
            if (allDeptHelp) allDeptHelp.style.display = 'inline';
        } else {
            if (departmentSelect && departmentSelect.value === 'ALL') {
                departmentSelect.value = '';
            }
            if (allDepartmentsCheck) allDepartmentsCheck.checked = false;
            if (departmentSelect) departmentSelect.setAttribute('required', 'required');
            if (singleDeptHelp) singleDeptHelp.style.display = 'inline';
            if (allDeptHelp) allDeptHelp.style.display = 'none';
        }
    }

    if (levelSelect) {
        levelSelect.addEventListener('change', function() {
            updateDepartmentState();
            if (classesContainer) {
                loadClassesForLevel(this.value, departmentSelect ? departmentSelect.value : '');
            }
        });
    }

    if (allDepartmentsCheck) {
        allDepartmentsCheck.addEventListener('change', function() {
            if (this.checked) {
                if (departmentSelect) departmentSelect.value = 'ALL';
            } else {
                if (departmentSelect && departmentSelect.value === 'ALL') {
                    departmentSelect.value = '';
                }
            }
            updateDepartmentState();
            if (classesContainer && levelSelect) {
                loadClassesForLevel(levelSelect.value, departmentSelect ? departmentSelect.value : '');
            }
        });
    }

    if (departmentSelect) {
        departmentSelect.addEventListener('change', function() {
            if (this.value === 'ALL') {
                if (allDepartmentsCheck) allDepartmentsCheck.checked = true;
            } else {
                if (allDepartmentsCheck) allDepartmentsCheck.checked = false;
            }
            updateDepartmentState();
            if (classesContainer && levelSelect) {
                loadClassesForLevel(levelSelect.value, this.value);
            }
        });
    }

    if (registerForm) {
        registerForm.addEventListener('submit', function(e) {
            const isSenior = levelSelect && levelSelect.value === 'SENIOR SECONDARY';
            const isAll = (allDepartmentsCheck && allDepartmentsCheck.checked) || (departmentSelect && departmentSelect.value === 'ALL');
            if (isSenior && !isAll && (!departmentSelect || !departmentSelect.value)) {
                e.preventDefault();
                alert('Please select a department or choose to register for all departments for Senior Secondary.');
                if (departmentSelect) departmentSelect.focus();
            }
        });
    }

    // Initialize state on load
    updateDepartmentState();
    if (levelSelect && levelSelect.value && classesContainer) {
        loadClassesForLevel(levelSelect.value, departmentSelect ? departmentSelect.value : '');
    } else if (classesContainer) {
        loadClassesForLevel('');
    }

    function loadClassesForLevel(level, department = '') {
        if (!classesContainer) return;
        
        classesContainer.innerHTML = '';
        
        if (!level) {
            const select = document.createElement('select');
            select.className = 'form-control';
            select.multiple = true;
            select.name = 'classIds';
            select.innerHTML = '<option value="">Select a level first</option>';
            classesContainer.appendChild(select);
            return;
        }

        const select = document.createElement('select');
        select.className = 'form-control';
        select.multiple = true;
        select.name = 'classIds';
        select.required = true;
        select.size = 5; // Show 5 options at once

        // Add default option
        const defaultOption = document.createElement('option');
        defaultOption.value = '';
        defaultOption.textContent = 'Select classes (' + level + (department ? ' - ' + department : '') + ')';
        defaultOption.disabled = true;
        select.appendChild(defaultOption);

        // Filter classes by level and department
        const filteredClasses = classesData[level] || [];
        const classesToShow = (department && department !== 'ALL') ? 
            filteredClasses.filter(cls => cls.department === department) : 
            filteredClasses;

        if (classesToShow.length === 0) {
            const noClassesOption = document.createElement('option');
            noClassesOption.value = '';
            noClassesOption.textContent = 'No classes available for this selection';
            noClassesOption.disabled = true;
            select.appendChild(noClassesOption);
        } else {
            classesToShow.forEach(cls => {
                const option = document.createElement('option');
                option.value = cls.id;
                option.textContent = cls.className + (cls.department ? ' (' + cls.department + ')' : '');
                // Pre-select if previously selected
                if (typeof formData !== 'undefined' && Array.isArray(formData.classIds) && formData.classIds.includes(cls.id.toString())) {
                    option.selected = true;
                }
                select.appendChild(option);
            });
        }

        classesContainer.appendChild(select);
    }

    // Add subject row - This is the main fix
    const addSubjectBtn = document.getElementById('add-subject');
    if (addSubjectBtn) {
        addSubjectBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const container = document.getElementById('subjects-container');
            if (!container) {
                console.error('subjects-container not found');
                return;
            }
            const newRow = document.createElement('div');
            newRow.className = 'row subject-row mb-3';
            newRow.innerHTML = `
                <div class="col-xl-4">
                    <div class="mb-3">
                        <label class="form-label">Subject Name*</label>
                        <input type="text" class="form-control" name="subjects[]" placeholder="e.g. Mathematics" required>
                    </div>
                </div>
                
                <div class="col-xl-3">
                    <div class="mb-3">
                        <label class="form-label">Subject Code*</label>
                        <input type="text" class="form-control" name="subject_codes[]" placeholder="e.g. MATH101" required>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="descriptions[]" rows="1" placeholder="Subject description"></textarea>
                    </div>
                </div>

                <div class="col-xl-1 d-flex align-items-end mb-3">
                    <button type="button" class="btn btn-danger remove-subject w-100">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            container.appendChild(newRow);
        });
    } else {
        console.error('add-subject button not found');
    }

    // Remove subject row
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('remove-subject') || e.target.closest('.remove-subject')) {
            e.preventDefault();
            e.stopPropagation();
            const row = e.target.closest('.subject-row');
            if (row) {
                if (document.querySelectorAll('.subject-row').length > 1) {
                    row.remove();
                } else {
                    // Reset the first row instead of removing it
                    const inputs = row.querySelectorAll('input, textarea');
                    inputs.forEach(input => {
                        input.value = '';
                    });
                }
            }
        }
    });
});
</script>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
                         
                    </div> <!-- container -->

                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © Hyper - Coderthemes.com
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->


        </div>
        <!-- END wrapper -->


        <!-- Right Sidebar -->
        <div class="end-bar">

            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>

            <div class="rightbar-content h-100" data-simplebar="">

                <div class="p-3">
                    <div class="alert alert-warning" role="alert">
                        <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                    </div>

                    <!-- Settings -->
                    <h5 class="mt-3">Color Scheme</h5>
                    <hr class="mt-1">

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                        <label class="form-check-label" for="light-mode-check">Light Mode</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                        <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                    </div>
       

                    <!-- Width -->
                    <h5 class="mt-4">Width</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                        <label class="form-check-label" for="fluid-check">Fluid</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                        <label class="form-check-label" for="boxed-check">Boxed</label>
                    </div>
        

                    <!-- Left Sidebar-->
                    <h5 class="mt-4">Left Sidebar</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                        <label class="form-check-label" for="default-check">Default</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked="">
                        <label class="form-check-label" for="light-check">Light</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                        <label class="form-check-label" for="dark-check">Dark</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked="">
                        <label class="form-check-label" for="fixed-check">Fixed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                        <label class="form-check-label" for="condensed-check">Condensed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                        <label class="form-check-label" for="scrollable-check">Scrollable</label>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
            
                        <a href="../../product/hyper-responsive-admin-dashboard-template/index.htm" class="btn btn-danger mt-3" target="_blank"><i class="mdi mdi-basket me-1"></i> Purchase Now</a>
                    </div>
                </div> <!-- end padding-->

            </div>
        </div>

        <div class="rightbar-overlay"></div>
        <!-- /End-bar -->

        <!-- bundle -->
         
        <script src="assets/js/vendor.min.js"></script>
        <script src="assets/js/app.min.js"></script>

        <!-- plugin js -->
        <script src="assets/js/vendor/dropzone.min.js"></script>
        <!-- init js -->
        <script src="assets/js/ui/component.fileupload.js"></script>
    </body>
</html>
