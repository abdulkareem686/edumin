                                                            <% subjects.forEach(function(subject) { %>
                                                                <th colspan="4" class="text-center subject-header fixed-header">
                                                                    <%= subject.name %>
                                                                </th>
                                                            <% }); %>
                                                        <% } %>
                                                        
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Total</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Avg</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">%</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Grade</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Status</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header action-column no-print">Action</th>
                                                    </tr>
                                                    <tr>
                                                        <% if (subjects && subjects.length > 0) { %>
                                                            <% subjects.forEach(function() { %>
                                                                <th class="text-center fixed-header">1st</th>
                                                                <th class="text-center fixed-header">2nd</th>
                                                                <th class="text-center fixed-header">3rd</th>
                                                                <th class="text-center fixed-header">Avg</th>
                                                            <% }); %>
                                                        <% } %>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (results && results.length > 0) { %>
                                                        <% results.forEach(function(student) { %>
                                                            <tr>
                                                                <td class="text-center fw-bold"><%= student.position %></td>
                                                                <td class="fw-bold">
                                                                    <%= student.firstName %> <%= student.middleName || '' %> <%= student.lastName %>
                                                                    <% if (student.department) { %>
                                                                        <span class="badge bg-secondary ms-1"><%= student.department %></span>
                                                                    <% } %>
                                                                </td>
                                                                
                                                                <% let subjectTotal = 0; %>
                                                                <% if (student.subjectAverages && student.subjectAverages.length > 0) { %>
                                                                    <% student.subjectAverages.forEach(function(subject) { %>
                                                                        <td class="text-center"><%= subject.firstTerm %></td>
                                                                        <td class="text-center"><%= subject.secondTerm %></td>
                                                                        <td class="text-center"><%= subject.thirdTerm %></td>
                                                                        <td class="text-center fw-bold"><%= subject.average %></td>
                                                                        <% subjectTotal += parseFloat(subject.average); %>
                                                                    <% }); %>
                                                                <% } else { %>
                                                                    <% for (let i = 0; i < (subjects ? subjects.length : 0); i++) { %>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                    <% } %>
                                                                <% } %>
                                                                
                                                                <td class="text-center fw-bold"><%= student.total.toFixed(2) %></td>
                                                                <td class="text-center fw-bold"><%= student.overallAverage %></td>
                                                                <td class="text-center fw-bold"><%= student.percentage %>%</td>
                                                                <td class="text-center fw-bold grade-<%= student.grade %>"><%= student.grade %></td>
                                                                
                                                                <!-- Promotion Status -->
                                                                <td class="text-center">
                                                                    <span class="promotion-status bg-<%= student.promotionClass %>">
                                                                        <%= student.promotionStatus %>
                                                                    </span>
                                                                </td>
                                                                
                                                                <!-- Action Buttons -->
                                                                <td class="text-center action-column no-print">
                                                                    <div class="action-buttons">
                                                                        <% if (student.promotionStatus === 'Promote') { %>
                                                                            <button class="btn btn-promote promote-btn" 
                                                                                data-student-id="<%= student.id %>"
                                                                                data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                data-academic-year="<%= academicYear %>">
                                                                                <i class="bi bi-mortarboard me-1"></i>Promote
                                                                            </button>
                                                                        <% } else { %>
                                                                            <button class="btn btn-repeat repeat-btn" 
                                                                                    data-student-id="<%= student.id %>"
                                                                                    data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                    data-academic-year="<%= academicYear %>">
                                                                                <i class="bi bi-arrow-clockwise me-1"></i>Repeat
                                                                            </button>
                                                                        <% } %>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                        
                                                        <!-- Summary Row -->
                                                        <tr class="summary-row">
                                                            <td colspan="<%= (subjects ? subjects.length * 4 : 0) + 5 %>" class="text-end fw-bold">Class Average:</td>
                                                            <td class="text-center fw-bold">
                                                                <% 
                                                                    const classAvg = results.reduce((sum, student) => sum + parseFloat(student.overallAverage), 0) / results.length;
                                                                %>
                                                                <%= classAvg.toFixed(2) %>
                                                            </td>
                                                            <td class="text-center fw-bold">
                                                                <%= ((classAvg / 100) * 100).toFixed(2) %>%
                                                            </td>
                                                            <td colspan="3" class="text-center fw-bold">
                                                                <% 
                                                                    let classGrade = 'F';
                                                                    if (classAvg >= 80) classGrade = 'A';
                                                                    else if (classAvg >= 70) classGrade = 'B';
                                                                    else if (classAvg >= 60) classGrade = 'C';
                                                                    else if (classAvg >= 50) classGrade = 'D';
                                                                    else if (classAvg >= 40) classGrade = 'E';
                                                                %>
                                                                <span class="grade-<%= classGrade %>"><%= classGrade %></span>
                                                            </td>
                                                        </tr>
                                                        
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="<%= (subjects ? subjects.length * 4 : 0) + 8 %>" class="text-center text-muted py-4">
                                                                No student data available
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Promotion Summary -->
                        <div class="row mt-4 no-print">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">
                                            <i class="bi bi-pie-chart me-2"></i>Promotion Summary
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4 text-center">
                                                <div class="bg-success rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-mortarboard text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-success">
                                                    <% 
                                                        const promoteCount = results ? results.filter(s => s.promotionStatus === 'Promote').length : 0;
                                                    %>
                                                    <%= promoteCount %>
                                                </h4>
                                                <p class="text-muted">Students to Promote</p>
                                            </div>
                                            <div class="col-md-4 text-center">
                                                <div class="bg-warning rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-arrow-clockwise text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-warning">
                                                    <% 
                                                        const repeatCount = results ? results.filter(s => s.promotionStatus === 'Repeat').length : 0;
                                                    %>
                                                    <%= repeatCount %>
                                                </h4>
                                                <p class="text-muted">Students to Repeat</p>
                                            </div>
                                            <div class="col-md-4 text-center">
                                                <div class="bg-primary rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-people text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-primary">
                                                    <%= results ? results.length : 0 %>
                                                </h4>
                                                <p class="text-muted">Total Students</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    <% } else { %>
                        <!-- Term Broadsheet -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Position</th>
                                                        <th>Student Name</th>
                                                        <th>Roll No</th>
                                                        <th>Subjects</th>
                                                        <th>Total Score</th>
                                                        <th>Average Score</th>
                                                        <th>Percentage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (results && results.length > 0) { %>
                                                        <% results.forEach(student => { %>
                                                            <tr>
                                                                <td class="text-center fw-bold"><%= student.position %></td>
                                                                <td class="fw-bold">
                                                                    <%= student.first_name %> <%= student.last_name %>
                                                                </td>
                                                                <td class="text-center"><%= student.rollNo || 'N/A' %></td>
                                                                <td class="text-center"><%= student.subject_count || 0 %></td>
                                                                <td class="text-center fw-bold"><%= student.total_score || 0 %></td>
                                                                <td class="text-center fw-bold"><%= student.average_score %></td>
                                                                <td class="text-center fw-bold"><%= student.percentage %>%</td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="7" class="text-center text-muted py-4">
                                                                No student data available
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Grading Key -->
                    <div class="row mt-4 no-print">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="bi bi-info-circle me-2"></i>Grading & Promotion System
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-A p-2">A</span> 80% and above
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-B p-2">B</span> 70% - 79%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-C p-2">C</span> 60% - 69%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-D p-2">D</span> 50% - 59%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-E p-2">E</span> 40% - 49%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-F p-2">F</span> Below 40%
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <span class="badge bg-success p-2">Promote</span> 45% and above
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <span class="badge bg-warning p-2">Repeat</span> Below 45%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- container -->
            </div> <!-- content -->

            <!-- Footer Start -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> © Hyper - Coderthemes.com
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end footer-links d-none d-md-block">
                                <a href="javascript: void(0);">About</a>
                                <a href="javascript: void(0);">Support</a>
                                <a href="javascript: void(0);">Contact Us</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
        </div>
        <!-- ============================================================== -->
        <!-- End Page content -->
        <!-- ============================================================== -->
    </div>
    <!-- END wrapper -->

    <!-- Right Sidebar -->
    <div class="end-bar">
        <div class="rightbar-title">
            <a href="javascript:void(0);" class="end-bar-toggle float-end">
                <i class="dripicons-cross noti-icon"></i>
            </a>
            <h5 class="m-0">Settings</h5>
        </div>
        <div class="rightbar-content h-100" data-simplebar="">
            <div class="p-3">
                <div class="alert alert-warning" role="alert">
                    <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                </div>
                <!-- Settings content -->
                <h5 class="mt-3">Color Scheme</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                    <label class="form-check-label" for="light-mode-check">Light Mode</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                    <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                </div>
                <!-- Width -->
                <h5 class="mt-4">Width</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                    <label class="form-check-label" for="fluid-check">Fluid</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                    <label class="form-check-label" for="boxed-check">Boxed</label>
                </div>
                <!-- Left Sidebar-->
                <h5 class="mt-4">Left Sidebar</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                    <label class="form-check-label" for="default-check">Default</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked="">
                    <label class="form-check-label" for="light-check">Light</label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                    <label class="form-check-label" for="dark-check">Dark</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked="">
                    <label class="form-check-label" for="fixed-check">Fixed</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                    <label class="form-check-label" for="condensed-check">Condensed</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                    <label class="form-check-label" for="scrollable-check">Scrollable</label>
                </div>
                <div class="d-grid mt-4">
                    <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
                    <a href="../../product/hyper-responsive-admin-dashboard-template/index.htm" class="btn btn-danger mt-3" target="_blank"><i class="mdi mdi-basket me-1"></i> Purchase Now</a>
                </div>
            </div>
        </div>
    </div>

    <div class="rightbar-overlay"></div>
    <!-- /End-bar -->

    <!-- Promotion Modal -->
    <div class="modal fade" id="promotionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="promotionModalTitle">Promote Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="promotionModalBody">
                        <!-- Content will be loaded dynamically -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmPromotion">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- bundle -->
    <script src="assets/js/vendor.min.js"></script>
    <script src="assets/js/app.min.js"></script>

    <script>
        $(document).ready(function() {
            const promotionModal = new bootstrap.Modal(document.getElementById('promotionModal'));
            let currentStudentId = null;
            let currentAcademicYear = null;
            
            // Promote student
            $(document).on('click', '.promote-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const academicYear = $(this).data('academic-year');
                
                currentStudentId = studentId;
                currentAcademicYear = academicYear;
                
                // Load ALL classes from database
                loadAllClasses(function(allClasses) {
                    $('#promotionModalTitle').html(`Promote ${studentName}`);
                    
                    if (allClasses.length === 0) {
                        $('#promotionModalBody').html(`
                            <div class="text-center">
                                <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                                <p class="mt-3">No classes found in the database!</p>
                                <p class="text-muted">Please add classes before promoting students.</p>
                            </div>
                        `);
                        $('#confirmPromotion').hide();
                    } else {
                        $('#promotionModalBody').html(`
                            <div class="text-center">
                                <i class="bi bi-mortarboard text-success" style="font-size: 3rem;"></i>
                                <p class="mt-3">Promote <strong>${studentName}</strong> to:</p>
                                <div class="form-group mb-3">
                                    <label class="form-label">Select destination class:</label>
                                    <select class="form-select" id="nextClassSelect">
                                        <option value="">-- Select a class --</option>
                                        ${allClasses.map(cls => 
                                            `<option value="${cls.id}">${cls.className} (${cls.level}${cls.department ? ' - ' + cls.department : ''})</option>`
                                        ).join('')}
                                    </select>
                                </div>
                                <p class="text-muted">This action will move the student to the selected class.</p>
                            </div>
                        `);
                        $('#confirmPromotion').show();
                    }
                    
                    promotionModal.show();
                });
            });
            
            // Repeat student
            $(document).on('click', '.repeat-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const academicYear = $(this).data('academic-year');
                
                currentStudentId = studentId;
                currentAcademicYear = academicYear;
                
                $('#promotionModalTitle').html(`Repeat Student`);
                $('#promotionModalBody').html(`
                    <div class="text-center">
                        <i class="bi bi-arrow-clockwise text-warning" style="font-size: 3rem;"></i>
                        <p class="mt-3">Are you sure you want <strong>${studentName}</strong> to repeat this class?</p>
                        <p class="text-muted">The student will remain in the current class for the next academic year.</p>
                    </div>
                `);
                
                $('#confirmPromotion').off('click').on('click', function() {
                    $.post(`/repeat-student/${currentStudentId}`, {
                        academicYear: currentAcademicYear
                    }, function(response) {
                        if (response.success) {
                            showNotification(`Student marked to repeat`, 'success');
                            promotionModal.hide();
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(response.error, 'error');
                        }
                    }).fail(function() {
                        showNotification('Error marking student to repeat', 'error');
                    });
                });
                
                promotionModal.show();
            });
            
            // Confirm promotion with class selection
            $('#confirmPromotion').on('click', function() {
                const nextClassId = $('#nextClassSelect').val();
                
                if (!nextClassId) {
                    showNotification('Please select a class to promote this student to', 'error');
                    return;
                }
                
                // Get the selected class name for the confirmation message
                const selectedClassName = $('#nextClassSelect option:selected').text();
                
                // Confirm before promoting
                if (confirm(`Are you sure you want to promote this student to ${selectedClassName}?`)) {
                    $.post(`/promote-student/${currentStudentId}`, {
                        academicYear: currentAcademicYear,
                        nextClassId: nextClassId
                    }, function(response) {
                        if (response.success) {
                            showNotification(response.message, 'success');
                            promotionModal.hide();
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showNotification(response.error, 'error');
                        }
                    }).fail(function(error) {
                        console.error('Promotion error:', error);
                        showNotification('Error promoting student: ' + (error.responseJSON?.error || 'Unknown error'), 'error');
                    });
                }
            });
            
            // Load ALL classes from database
            function loadAllClasses(callback) {
                $.get(`/api/all-classes`, function(response) {
                    if (response.success) {
                        callback(response.classes || []);
                    } else {
                        showNotification('Error loading classes: ' + response.error, 'error');
                        callback([]);
                    }
                }).fail(function() {
                    showNotification('Failed to load classes', 'error');
                    callback([]);
                });
            }
            
            function showNotification(message, type = 'info') {
                // Remove any existing notifications
                $('.alert-notification').remove();
                
                const alertClass = type === 'error' ? 'alert-danger' : 
                                  type === 'warning' ? 'alert-warning' : 
                                  type === 'success' ? 'alert-success' : 'alert-info';
                
                const iconClass = type === 'success' ? 'bi-check-circle' : 
                                 type === 'error' ? 'bi-exclamation-circle' : 
                                 type === 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle';
                
                const notification = $(`
                    <div class="alert ${alertClass} alert-notification alert-dismissible fade show" role="alert" 
                         style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                        <i class="bi ${iconClass} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `);
                
                $('body').append(notification);
                
                // Auto-dismiss after 5 seconds
                setTimeout(() => {
                    notification.alert('close');
                }, 5000);
            }
            
            // Close modal when clicking outside
            $('#promotionModal').on('click', function(e) {
                if (e.target === this) {
                    promotionModal.hide();
                }
            });
            
            // Reset modal when hidden
            $('#promotionModal').on('hidden.bs.modal', function() {
                currentStudentId = null;
                currentAcademicYear = null;
                $('#nextClassSelect').val('');
            });
        });
    </script>
</body>
</html>