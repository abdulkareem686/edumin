</div>
    <!-- bundle -->
    <script src="assets/js/vendor.min.js"></script>
    <script src="assets/js/app.min.js"></script>

    <script>
        $(document).ready(function() {
            const promotionModal = new bootstrap.Modal(document.getElementById('promotionModal'));
            const promoteAllModal = new bootstrap.Modal(document.getElementById('promoteAllModal'));
            let currentStudentId = null;
            let currentAcademicYear = null;
            
            // Promote student
            $(document).on('click', '.promote-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const academicYear = $(this).data('academic-year');
                
                currentStudentId = studentId;
                currentAcademicYear = academicYear;
                
                // Load ALL classes from database
                loadAllClasses(function(allClasses) {
                    $('#promotionModalTitle').html(`<i class="bi bi-mortarboard-fill text-primary me-2"></i>Promote ${studentName}`);
                    
                    if (allClasses.length === 0) {
                        $('#promotionModalBody').html(`
                            <div class="text-center">
                                <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                                <p class="mt-3">No classes found in the database!</p>
                                <p class="text-muted">Please add classes before promoting students.</p>
                            </div>
                        `);
                        $('#confirmPromotion').hide();
                    } else {
                        $('#promotionModalBody').html(`
                            <div class="text-center">
                                <i class="bi bi-mortarboard text-success" style="font-size: 3rem;"></i>
                                <p class="mt-3">Promote <strong>${studentName}</strong> to:</p>
                                <div class="form-group mb-3 text-start">
                                    <label class="form-label fw-bold">Select destination class:</label>
                                    <select class="form-select" id="nextClassSelect">
                                        <option value="">-- Select a class --</option>
                                        ${allClasses.map(cls => 
                                            `<option value="${cls.id}">${cls.className} (${cls.level}${cls.department ? ' - ' + cls.department : ''})</option>`
                                        ).join('')}
                                    </select>
                                </div>
                                <p class="text-muted small">This action will move the student to the selected class.</p>
                            </div>
                        `);
                        $('#confirmPromotion')
                            .removeClass('btn-warning btn-success')
                            .addClass('btn-primary')
                            .prop('disabled', false)
                            .html('<i class="bi bi-mortarboard me-1"></i> Confirm Promotion')
                            .show()
                            .off('click')
                            .on('click', function() {
                                const nextClassId = $('#nextClassSelect').val();
                                
                                if (!nextClassId) {
                                    showNotification('Please select a class to promote this student to', 'error');
                                    return;
                                }
                                
                                const selectedClassName = $('#nextClassSelect option:selected').text();
                                
                                if (confirm(`Are you sure you want to promote this student to ${selectedClassName}?`)) {
                                    const btn = $(this);
                                    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Promoting...');
                                    $.post(`/promote-student/${currentStudentId}`, {
                                        academicYear: currentAcademicYear,
                                        nextClassId: nextClassId
                                    }, function(response) {
                                        if (response.success) {
                                            showNotification(response.message, 'success');
                                            promotionModal.hide();
                                            setTimeout(() => location.reload(), 1500);
                                        } else {
                                            btn.prop('disabled', false).html('<i class="bi bi-mortarboard me-1"></i> Confirm Promotion');
                                            showNotification(response.error, 'error');
                                        }
                                    }).fail(function(error) {
                                        btn.prop('disabled', false).html('<i class="bi bi-mortarboard me-1"></i> Confirm Promotion');
                                        console.error('Promotion error:', error);
                                        showNotification('Error promoting student: ' + (error.responseJSON?.error || 'Unknown error'), 'error');
                                    });
                                }
                            });
                    }
                    
                    promotionModal.show();
                });
            });
            
            // Repeat student
            $(document).on('click', '.repeat-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const academicYear = $(this).data('academic-year');
                
                currentStudentId = studentId;
                currentAcademicYear = academicYear;
                
                $('#promotionModalTitle').html(`<i class="bi bi-arrow-clockwise text-warning me-2"></i>Repeat Student`);
                $('#promotionModalBody').html(`
                    <div class="text-center p-2">
                        <i class="bi bi-arrow-clockwise text-warning" style="font-size: 3rem;"></i>
                        <p class="mt-3">Are you sure you want <strong>${studentName}</strong> to repeat this class?</p>
                        <p class="text-muted small">The student will remain in the current class for the next academic year.</p>
                    </div>
                `);
                
                $('#confirmPromotion')
                    .removeClass('btn-primary btn-success')
                    .addClass('btn-warning')
                    .prop('disabled', false)
                    .html('<i class="bi bi-arrow-clockwise me-1"></i> Confirm Repeat')
                    .show()
                    .off('click')
                    .on('click', function() {
                        const btn = $(this);
                        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Processing...');
                        $.post(`/repeat-student/${currentStudentId}`, {
                            academicYear: currentAcademicYear
                        }, function(response) {
                            if (response.success) {
                                showNotification(`Student marked to repeat`, 'success');
                                promotionModal.hide();
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                btn.prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i> Confirm Repeat');
                                showNotification(response.error, 'error');
                            }
                        }).fail(function() {
                            btn.prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i> Confirm Repeat');
                            showNotification('Error marking student to repeat', 'error');
                        });
                    });
                
                promotionModal.show();
            });

            // Single Student Graduate
            $(document).on('click', '.graduate-single-btn', function() {
                const studentId = $(this).data('student-id');
                const studentName = $(this).data('student-name');
                const academicYear = $(this).data('academic-year');
                
                currentStudentId = studentId;
                currentAcademicYear = academicYear;
                
                $('#promotionModalTitle').html('<i class="bi bi-award-fill text-success me-2"></i>Graduate Student');
                $('#promotionModalBody').html(`
                    <div class="text-center p-2">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 70px; height: 70px; background-color: #d1fae5;">
                            <i class="bi bi-award-fill fs-1 text-success"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Mark as Graduated</h5>
                        <p class="mb-3">Are you sure you want to mark <strong>${studentName}</strong> as <strong>GRADUATED</strong> for session <strong>${academicYear}</strong>?</p>
                        <div class="alert alert-info text-start small mb-0">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            <strong>Note:</strong> The student will be archived as a graduate. They will no longer appear in active class rolls, but their academic records and transcripts remain fully preserved.
                        </div>
                    </div>
                `);
                
                $('#confirmPromotion')
                    .removeClass('btn-primary btn-warning')
                    .addClass('btn-success')
                    .prop('disabled', false)
                    .html('<i class="bi bi-award me-1"></i> Confirm Graduation')
                    .show()
                    .off('click')
                    .on('click', function() {
                        const btn = $(this);
                        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Graduating...');
                        
                        $.ajax({
                            url: '/graduate-student/' + currentStudentId,
                            method: 'POST',
                            data: { academicYear: currentAcademicYear },
                            success: function(response) {
                                if (response.success) {
                                    showNotification(response.message || 'Student graduated successfully', 'success');
                                    promotionModal.hide();
                                    setTimeout(() => location.reload(), 1500);
                                } else {
                                    btn.prop('disabled', false).html('<i class="bi bi-award me-1"></i> Confirm Graduation');
                                    showNotification(response.error || 'Failed to graduate student', 'error');
                                }
                            },
                            error: function(xhr) {
                                if (xhr.status === 404) {
                                    // Fallback to bulk graduate endpoint with single student ID
                                    $.ajax({
                                        url: '/graduate-all-students',
                                        method: 'POST',
                                        contentType: 'application/json',
                                        data: JSON.stringify({
                                            studentIds: [currentStudentId],
                                            academicYear: currentAcademicYear
                                        }),
                                        success: function(resp) {
                                            if (resp.success) {
                                                showNotification(resp.message || 'Student graduated successfully', 'success');
                                                promotionModal.hide();
                                                setTimeout(() => location.reload(), 1500);
                                            } else {
                                                btn.prop('disabled', false).html('<i class="bi bi-award me-1"></i> Confirm Graduation');
                                                showNotification(resp.error || 'Failed to graduate student', 'error');
                                            }
                                        },
                                        error: function(errXhr) {
                                            btn.prop('disabled', false).html('<i class="bi bi-award me-1"></i> Confirm Graduation');
                                            const msg = errXhr.responseJSON && errXhr.responseJSON.error ? errXhr.responseJSON.error : 'Error graduating student';
                                            showNotification(msg, 'error');
                                        }
                                    });
                                } else {
                                    btn.prop('disabled', false).html('<i class="bi bi-award me-1"></i> Confirm Graduation');
                                    const msg = xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'Error graduating student';
                                    showNotification(msg, 'error');
                                }
                            }
                        });
                    });
                
                promotionModal.show();
            });

            // ==================== EXPORT TO EXCEL & CSV ====================
            function exportTableToCSV(table, filename) {
                let csv = [];
                const rows = table.querySelectorAll('tr');
                rows.forEach(function(row) {
                    const cols = row.querySelectorAll('td, th');
                    let rowData = [];
                    cols.forEach(function(col) {
                        let text = col.innerText.replace(/"/g, '""').replace(/\\r?\\n|\\r/g, ' ').trim();
                        rowData.push('"' + text + '"');
                    });
                    if (rowData.length) csv.push(rowData.join(','));
                });
                const blob = new Blob(["\\ufeff" + csv.join("\\r\\n")], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            $(document).on('click', '#exportExcelBtn', function() {
                const table = document.getElementById('broadsheetTable');
                if (!table) {
                    showNotification('No broadsheet table available to export', 'error');
                    return;
                }

                const className = ('<%= selectedClass ? selectedClass.name : "Class" %>').replace(/[^a-zA-Z0-9_-]/g, '_');
                const termName = '<%= term %>';
                const yearName = ('<%= academicYear %>').replace(/[^a-zA-Z0-9_-]/g, '_');
                const baseFileName = 'Broadsheet_' + className + '_' + termName + '_' + yearName;

                // Clone table and remove action column and no-print elements
                const clone = table.cloneNode(true);
                clone.querySelectorAll('.no-print, .action-column').forEach(function(el) { el.remove(); });

                if (window.XLSX) {
                    try {
                        const wb = XLSX.utils.table_to_book(clone, { sheet: "Broadsheet" });
                        XLSX.writeFile(wb, baseFileName + '.xlsx');
                        showNotification('Excel spreadsheet exported successfully!', 'success');
                    } catch (e) {
                        console.error('XLSX error, falling back to CSV:', e);
                        exportTableToCSV(clone, baseFileName + '.csv');
                        showNotification('Exported broadsheet as CSV.', 'info');
                    }
                } else {
                    exportTableToCSV(clone, baseFileName + '.csv');
                    showNotification('Exported broadsheet as CSV.', 'info');
                }
            });

            // ==================== EXPORT TO PDF ====================
            $(document).on('click', '#exportPdfBtn', function() {
                const table = document.getElementById('broadsheetTable');
                if (!table) {
                    showNotification('No broadsheet table available to export', 'error');
                    return;
                }

                const className = '<%= selectedClass ? selectedClass.name : "Class" %>';
                const termName = '<%= term === "session" ? "Session" : term.charAt(0).toUpperCase() + term.slice(1) + " Term" %>';
                const yearName = '<%= academicYear %>';
                const fileName = 'Broadsheet_' + className.replace(/[^a-zA-Z0-9_-]/g, '_') + '_' + yearName.replace(/[^a-zA-Z0-9_-]/g, '_') + '.pdf';

                const clone = table.cloneNode(true);
                clone.querySelectorAll('.no-print, .action-column').forEach(function(el) { el.remove(); });
                clone.style.width = '100%';
                clone.style.borderCollapse = 'collapse';
                clone.style.fontSize = '8pt';
                clone.querySelectorAll('th, td').forEach(function(cell) {
                    cell.style.border = '1px solid #cbd5e1';
                    cell.style.padding = '3px 4px';
                });

                const printContainer = document.createElement('div');
                printContainer.className = 'pdf-export-container p-3 bg-white text-dark';
                printContainer.style.background = '#ffffff';
                printContainer.style.fontFamily = 'Arial, sans-serif';
                printContainer.innerHTML = `
                    <div style="text-align: center; margin-bottom: 14px; border-bottom: 2px solid #1e3a8a; padding-bottom: 8px;">
                        <h2 style="margin: 0; font-size: 18pt; font-weight: bold; color: #1e3a8a; letter-spacing: 0.5px;">BROADSHEET REPORT</h2>
                        <h4 style="margin: 4px 0 0; font-size: 13pt; color: #374151;">${className} &bull; ${termName} (${yearName})</h4>
                        <p style="margin: 4px 0 0; font-size: 8.5pt; color: #6b7280;">Generated on: ${new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</p>
                    </div>
                `;
                printContainer.appendChild(clone);

                if (window.html2pdf) {
                    showNotification('Generating PDF, please wait...', 'info');
                    const opt = {
                        margin: [6, 6, 6, 6],
                        filename: fileName,
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2, useCORS: true, logging: false },
                        jsPDF: { unit: 'mm', format: 'a3', orientation: 'landscape' }
                    };
                    html2pdf().set(opt).from(printContainer).save().then(function() {
                        showNotification('PDF downloaded successfully!', 'success');
                    }).catch(function(err) {
                        console.error('html2pdf generation error:', err);
                        window.print();
                    });
                } else {
                    window.print();
                }
            });

            // ==================== PROMOTE ALL / GRADUATE ALL ====================
// Build the eligible-students list safely server-side, then JSON.parse it client-side.
// Using <%- %> (unescaped) with a fully-escaped JSON string avoids breaking the script.
var ELIGIBLE_STUDENTS_JSON = <%- JSON.stringify(
    (term === 'session' && results && results.length > 0)
        ? results
            .filter(function(s) { return s.promotionStatus === 'Promote'; })
            .map(function(s) {
                return {
                    id: s.id,
                    name: (s.firstName + ' ' + (s.middleName || '') + ' ' + s.lastName).replace(/\s+/g, ' ').trim(),
                    average: String(s.overallAverage),
                    percentage: String(s.percentage),
                    grade: String(s.grade)
                };
            })
        : []
) %>;

var eligibleStudents = ELIGIBLE_STUDENTS_JSON || [];

// Open Promote All modal
$(document).on('click', '#promoteAllBtn', function() {
    const academicYear = $(this).data('academic-year');

    if (eligibleStudents.length === 0) {
        showNotification('No eligible students to promote', 'warning');
        return;
    }

    // Reset modal to default state (Promote selected)
    $('#actionPromote').prop('checked', true);
    $('#destinationClassGroup').show();
    $('#graduationNote').addClass('d-none');
    $('#confirmPromoteAll')
        .removeClass('btn-success')
        .addClass('btn-primary')
        .prop('disabled', false)
        .html('<i class="bi bi-check-circle me-1"></i> Confirm Promote All');

    // Populate student preview list
    let rows = '';
    eligibleStudents.forEach(function(st, idx) {
        rows += `
            <tr>
                <td>${idx + 1}</td>
                <td>${st.name}</td>
                <td class="text-center">${st.average}</td>
                <td class="text-center">${st.percentage}%</td>
                <td class="text-center"><span class="grade-${st.grade} px-2 py-1 rounded">${st.grade}</span></td>
            </tr>
        `;
    });
    $('#promoteAllStudentList').html(rows);

    // Load destination class options
    loadAllClasses(function(allClasses) {
        if (allClasses.length === 0) {
            $('#promoteAllNextClassSelect').html('<option value="">No classes available</option>');
        } else {
            let options = '<option value="">-- Select a class --</option>';
            allClasses.forEach(function(cls) {
                options += `<option value="${cls.id}">${cls.className} (${cls.level}${cls.department ? ' - ' + cls.department : ''})</option>`;
            });
            $('#promoteAllNextClassSelect').html(options);
        }
        $('#promoteAllNextClassSelect').data('academic-year', academicYear);
        promoteAllModal.show();
    });
});

// Toggle between "Promote" and "Graduate" views
$(document).on('change', 'input[name="promoteAllAction"]', function() {
    if ($(this).val() === 'graduate') {
        // Graduate mode
        $('#destinationClassGroup').hide();
        $('#graduationNote').removeClass('d-none');
        $('#confirmPromoteAll')
            .removeClass('btn-primary')
            .addClass('btn-success')
            .html('<i class="bi bi-award me-1"></i> Confirm Graduation');
    } else {
        // Promote mode
        $('#destinationClassGroup').show();
        $('#graduationNote').addClass('d-none');
        $('#confirmPromoteAll')
            .removeClass('btn-success')
            .addClass('btn-primary')
            .html('<i class="bi bi-check-circle me-1"></i> Confirm Promote All');
    }
});

// Confirm handler — dispatches to the correct endpoint based on chosen action
$('#confirmPromoteAll').on('click', function() {
    const action = $('input[name="promoteAllAction"]:checked').val() || 'promote';
    const academicYear = $('#promoteAllNextClassSelect').data('academic-year');
    const nextClassId = $('#promoteAllNextClassSelect').val();

    if (eligibleStudents.length === 0) {
        showNotification('No eligible students to process', 'warning');
        return;
    }

    if (!academicYear) {
        showNotification('Academic year is missing', 'error');
        return;
    }

    if (action === 'promote') {
        // ---------- PROMOTE ----------
        if (!nextClassId) {
            showNotification('Please select a destination class', 'error');
            return;
        }

        const selectedClassName = $('#promoteAllNextClassSelect option:selected').text();

        if (!confirm(`Promote ${eligibleStudents.length} student(s) to ${selectedClassName}?\n\nThis action cannot be undone.`)) {
            return;
        }

        submitPromoteAllAction(
            '/promote-all-students',
            {
                studentIds: eligibleStudents.map(s => s.id),
                nextClassId: nextClassId,
                academicYear: academicYear
            },
            'Promoting...'
        );
    } else {
        // ---------- GRADUATE ----------
        if (!confirm(`Mark ${eligibleStudents.length} student(s) as GRADUATED?\n\nThey will no longer appear in class lists. Their records and results will remain accessible for transcripts. This action cannot be undone.`)) {
            return;
        }

        submitPromoteAllAction(
            '/graduate-all-students',
            {
                studentIds: eligibleStudents.map(s => s.id),
                academicYear: academicYear
            },
            'Graduating...'
        );
    }
});

// Shared AJAX submitter for both Promote All and Graduate All
function submitPromoteAllAction(url, payload, loadingText) {
    const btn = $('#confirmPromoteAll');
    const originalHtml = btn.html();

    btn.prop('disabled', true).html(
        `<span class="spinner-border spinner-border-sm me-1"></span>${loadingText}`
    );

    $.ajax({
        url: url,
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function(response) {
            if (response.success) {
                showNotification(response.message, 'success');
                promoteAllModal.hide();
                setTimeout(() => location.reload(), 1800);
            } else {
                showNotification(response.error || 'Operation failed', 'error');
                btn.prop('disabled', false).html(originalHtml);
            }
        },
        error: function(xhr) {
            const err = (xhr.responseJSON && xhr.responseJSON.error) || 'Server error';
            showNotification(err, 'error');
            btn.prop('disabled', false).html(originalHtml);
        }
    });
}

// Reset Promote All modal when hidden
$('#promoteAllModal').on('hidden.bs.modal', function() {
    $('#promoteAllNextClassSelect').val('').removeData('academic-year');
    $('#promoteAllStudentList').html('');
    $('#actionPromote').prop('checked', true);
    $('#destinationClassGroup').show();
    $('#graduationNote').addClass('d-none');
    $('#confirmPromoteAll')
        .removeClass('btn-success')
        .addClass('btn-primary')
        .prop('disabled', false)
        .html('<i class="bi bi-check-circle me-1"></i> Confirm');
});

// Load ALL classes from database
function loadAllClasses(callback) {
    $.get(`/api/all-classes`, function(response) {
        if (response.success) {
            callback(response.classes || []);
        } else {
            showNotification('Error loading classes: ' + response.error, 'error');
            callback([]);
        }
    }).fail(function() {
        showNotification('Failed to load classes', 'error');
        callback([]);
    });
}

function showNotification(message, type = 'info') {
    // Remove any existing notifications
    $('.alert-notification').remove();

    const alertClass = type === 'error' ? 'alert-danger' :
                      type === 'warning' ? 'alert-warning' :
                      type === 'success' ? 'alert-success' : 'alert-info';

    const iconClass = type === 'success' ? 'bi-check-circle' :
                     type === 'error' ? 'bi-exclamation-circle' :
                     type === 'warning' ? 'bi-exclamation-triangle' : 'bi-info-circle';

    const notification = $(`
        <div class="alert ${alertClass} alert-notification alert-dismissible fade show" role="alert"
             style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
            <i class="bi ${iconClass} me-2"></i>
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `);

    $('body').append(notification);

    // Auto-dismiss after 5 seconds
    setTimeout(() => {
        notification.alert('close');
    }, 5000);
}

// Close modal when clicking outside
$('#promotionModal').on('click', function(e) {
    if (e.target === this) {
        promotionModal.hide();
    }
});

$('#promoteAllModal').on('click', function(e) {
    if (e.target === this) {
        promoteAllModal.hide();
    }
});

// Reset single-promotion modal when hidden
$('#promotionModal').on('hidden.bs.modal', function() {
    currentStudentId = null;
    currentAcademicYear = null;
    $('#nextClassSelect').val('');
});
});
