    <!-- Promotion Modal -->
    <div class="modal fade" id="promotionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="promotionModalTitle">Promote Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="promotionModalBody">
                        <!-- Content will be loaded dynamically -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmPromotion">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Promote All Modal -->
<div class="modal fade" id="promoteAllModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-mortarboard-fill me-2"></i>Promote / Graduate Eligible Students
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    Only students with <strong>Promote</strong> status (45% and above) are eligible.
                    Students marked <strong>Repeat</strong> remain in their current class.
                </div>

                <!-- Action Choice -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Choose action:</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="promoteAllAction" id="actionPromote" value="promote" checked>
                        <label class="btn btn-outline-primary" for="actionPromote">
                            <i class="bi bi-mortarboard me-1"></i> Promote to Next Class
                        </label>

                        <input type="radio" class="btn-check" name="promoteAllAction" id="actionGraduate" value="graduate">
                        <label class="btn btn-outline-success" for="actionGraduate">
                            <i class="bi bi-award me-1"></i> Mark as Graduated
                        </label>
                    </div>
                </div>

                <!-- Destination Class (shown only when Promote is selected) -->
                <div class="form-group mb-3" id="destinationClassGroup">
                    <label class="form-label fw-bold">Select destination class:</label>
                    <select class="form-select" id="promoteAllNextClassSelect">
                        <option value="">-- Select a class --</option>
                    </select>
                    <small class="text-muted">All eligible students will be moved to this class.</small>
                </div>

                <!-- Graduation note (shown only when Graduate is selected) -->
                <div class="alert alert-success d-none" id="graduationNote">
                    <i class="bi bi-check-circle me-1"></i>
                    Students will be marked as <strong>Graduated</strong>. They will no longer appear in class lists,
                    but their records and results remain accessible for transcripts.
                </div>

                <h6 class="mt-4 mb-2">Students to be processed:</h6>
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th class="text-center">Avg</th>
                                <th class="text-center">%</th>
                                <th class="text-center">Grade</th>
                            </tr>
                        </thead>
                        <tbody id="promoteAllStudentList">
                            <!-- Filled by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
