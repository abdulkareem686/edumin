<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Broadsheet - <%= selectedClass.name %> - <%= term === 'session' ? 'Session' : term.charAt(0).toUpperCase() + term.slice(1) + ' Term' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="A fully featured school management system" name="description" />
    <meta content="ThemeSelection" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        .session-table th {
            background: linear-gradient(135deg, #3b5de7 0%, #4e54c8 100%);
            color: white;
            position: sticky;
            top: 0;
        }
        
        .subject-header {
            background-color: #e5e7eb;
            font-weight: 600;
        }
        
        .grade-A { background-color: #dcfce7; color: #166534; }
        .grade-B { background-color: #dbeafe; color: #1e40af; }
        .grade-C { background-color: #fef3c7; color: #92400e; }
        .grade-D { background-color: #fee2e2; color: #991b1b; }
        .grade-E { background-color: #f3f4f6; color: #374151; }
        .grade-F { background-color: #fef2f2; color: #991b1b; }
        
        .promotion-status {
            font-weight: 600;
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.85rem;
        }
        
        .btn-promote {
            background: linear-gradient(135deg, #10b981 0%, #22c55e 100%);
            border: none;
            color: white;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        .btn-repeat {
            background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
            border: none;
            color: white;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        
        .btn-graduate {
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            border: none;
            color: white;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        .btn-graduate:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
            color: white;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.35);
        }
        @media print {
            @page {
                size: landscape;
                margin: 6mm;
            }
            body {
                background: #fff !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .session-table, .table {
                font-size: 8pt !important;
                width: 100% !important;
            }
            .session-table th, .session-table td, .table th, .table td {
                padding: 3px 4px !important;
            }
        }

        .action-buttons {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }
        
        @media print {
            body {
                background: white !important;
                padding: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .session-table {
                font-size: 10px;
            }
            .action-column {
                display: none !important;
            }
            .card {
                border: 1px solid #dee2e6 !important;
                box-shadow: none !important;
            }
        }
        
        .summary-row {
            background-color: #f8f9fa;
            font-weight: 700;
        }
        
        .performance-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }
        
        .table-responsive {
            max-height: 600px;
            overflow-y: auto;
        }
        
        .fixed-header {
            position: sticky;
            top: 0;
            z-index: 10;
        }
    </style>
</head>
<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- ========== Left Sidebar Start ========== -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->
 
        <!-- ============================================================== -->
        <!-- Start Page Content here -->
        <!-- ============================================================== -->

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                <!-- Start Content-->                
                <div class="container-fluid">
                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="javascript: void(0);">Home</a></li>
                                        <li class="breadcrumb-item"><a href="javascript: void(0);">Results</a></li>
                                        <li class="breadcrumb-item"><a href="/broadsheet">Broadsheet</a></li>
                                        <li class="breadcrumb-item active">
                                            <%= selectedClass.name %>
                                            <% if (selectedClass.department) { %> - <%= selectedClass.department %><% } %>
                                            (<%= term === 'session' ? 'Session' : term.charAt(0).toUpperCase() + term.slice(1) + ' Term' %>)
                                        </li>
                                    </ol>
                                </div>
                                <h4 class="page-title">
                                    <i class="bi bi-file-earmark-text me-2"></i>
                                    <%= selectedClass.name %>
                                    <% if (selectedClass.department) { %> - <%= selectedClass.department %><% } %>
                                    | <%= term === 'session' ? 'Session Broadsheet' : term.charAt(0).toUpperCase() + term.slice(1) + ' Term Broadsheet' %>
                                </h4>
                            </div>
                        </div>
                    </div>     
                    <!-- end page title -->

                    <!-- Page Header -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <h5 class="card-title mb-1">
                                                <%= selectedClass.name %>
                                                <% if (selectedClass.department) { %> - <%= selectedClass.department %><% } %>
                                            </h5>
                                            <p class="text-muted mb-0">
                                                Academic Year: <strong><%= academicYear %></strong>
                                                <% if (selectedClass.level) { %> | Level: <strong><%= selectedClass.level %></strong><% } %>
                                                | Generated on: <strong><%= new Date().toLocaleDateString() %></strong>
                                            </p>
                                        </div>
                                        <div class="no-print">
                                            <a href="/broadsheet" class="btn btn-outline-secondary">
                                                <i class="bi bi-arrow-left me-1"></i> Back
                                            </a>
                                            <% if (term === 'session' && results && results.length > 0) { %>
                                                <% const eligibleCount = results.filter(s => s.promotionStatus === 'Promote').length; %>
                                                <% if (eligibleCount > 0) { %>
                                                    <button class="btn btn-primary ms-2" id="promoteAllBtn"
                                                        data-eligible-count="<%= eligibleCount %>"
                                                        data-academic-year="<%= academicYear %>">
                                                        <i class="bi bi-mortarboard-fill me-1"></i> Promote All (<%= eligibleCount %>)
                                                    </button>
                                                <% } %>
                                            <% } %>
                                            <button class="btn btn-outline-success ms-2" id="exportExcelBtn" title="Download Excel spreadsheet (.xlsx)">
                                                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                                            </button>
                                            <button class="btn btn-outline-danger ms-2" id="exportPdfBtn" title="Download PDF document">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
                                            </button>
                                            <button class="btn btn-success ms-2" onclick="window.print()" title="Print broadsheet">
                                                <i class="bi bi-printer me-1"></i> Print
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (term === 'session') { %>
                        <!-- Session Broadsheet -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover session-table mb-0" id="broadsheetTable">
                                                <thead>
                                                    <tr>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Pos</th>
                                                        <th rowspan="2" class="text-left align-middle fixed-header">Student Name</th>
                                                        
                                                        <% if (subjects && subjects.length > 0) { %>
                                                            <% subjects.forEach(function(subject) { %>
                                                                <th colspan="4" class="text-center subject-header fixed-header">
                                                                    <%= subject.name %>
                                                                </th>
                                                            <% }); %>
                                                        <% } %>
                                                        
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Total</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Avg</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">%</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Grade</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header">Status</th>
                                                        <th rowspan="2" class="text-center align-middle fixed-header action-column no-print">Action</th>
                                                    </tr>
                                                    <tr>
                                                        <% if (subjects && subjects.length > 0) { %>
                                                            <% subjects.forEach(function() { %>
                                                                <th class="text-center fixed-header">1st</th>
                                                                <th class="text-center fixed-header">2nd</th>
                                                                <th class="text-center fixed-header">3rd</th>
                                                                <th class="text-center fixed-header">Avg</th>
                                                            <% }); %>
                                                        <% } %>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (results && results.length > 0) { %>
                                                        <% results.forEach(function(student) { %>
                                                            <tr>
                                                                <td class="text-center fw-bold"><%= student.position %></td>
                                                                <td class="fw-bold">
                                                                    <%= student.firstName %> <%= student.middleName || '' %> <%= student.lastName %>
                                                                    <% if (student.department) { %>
                                                                        <span class="badge bg-secondary ms-1"><%= student.department %></span>
                                                                    <% } %>
                                                                </td>
                                                                
                                                                <% let subjectTotal = 0; %>
                                                                <% if (student.subjectAverages && student.subjectAverages.length > 0) { %>
                                                                    <% student.subjectAverages.forEach(function(subject) { %>
                                                                        <td class="text-center"><%= subject.firstTerm %></td>
                                                                        <td class="text-center"><%= subject.secondTerm %></td>
                                                                        <td class="text-center"><%= subject.thirdTerm %></td>
                                                                        <td class="text-center fw-bold"><%= subject.average %></td>
                                                                        <% subjectTotal += parseFloat(subject.average); %>
                                                                    <% }); %>
                                                                <% } else { %>
                                                                    <% for (let i = 0; i < (subjects ? subjects.length : 0); i++) { %>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                        <td class="text-center">-</td>
                                                                    <% } %>
                                                                <% } %>
                                                                
                                                                <td class="text-center fw-bold"><%= student.total.toFixed(2) %></td>
                                                                <td class="text-center fw-bold"><%= student.overallAverage %></td>
                                                                <td class="text-center fw-bold"><%= student.percentage %>%</td>
                                                                <td class="text-center fw-bold grade-<%= student.grade %>"><%= student.grade %></td>
                                                                
                                                                <!-- Promotion Status -->
                                                                <td class="text-center">
                                                                    <span class="promotion-status bg-<%= student.promotionClass %>">
                                                                        <%= student.promotionStatus %>
                                                                    </span>
                                                                </td>
                                                                
                                                                <!-- Action Buttons -->
                                                                <td class="text-center action-column no-print">
                                                                    <div class="action-buttons d-flex gap-1 justify-content-center">
                                                                        <% if (student.promotionStatus === 'Promote') { %>
                                                                            <button class="btn btn-promote promote-btn" 
                                                                                data-student-id="<%= student.id %>"
                                                                                data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                data-academic-year="<%= academicYear %>"
                                                                                title="Promote to next class">
                                                                                <i class="bi bi-mortarboard me-1"></i>Promote
                                                                            </button>
                                                                            <button class="btn btn-graduate graduate-single-btn" 
                                                                                data-student-id="<%= student.id %>"
                                                                                data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                data-academic-year="<%= academicYear %>"
                                                                                title="Mark as Graduated">
                                                                                <i class="bi bi-award me-1"></i>Graduate
                                                                            </button>
                                                                        <% } else { %>
                                                                            <button class="btn btn-repeat repeat-btn" 
                                                                                    data-student-id="<%= student.id %>"
                                                                                    data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                    data-academic-year="<%= academicYear %>"
                                                                                    title="Repeat this class">
                                                                                <i class="bi bi-arrow-clockwise me-1"></i>Repeat
                                                                            </button>
                                                                            <button class="btn btn-graduate graduate-single-btn" 
                                                                                data-student-id="<%= student.id %>"
                                                                                data-student-name="<%= student.firstName %> <%= student.middleName %> <%= student.lastName %>"
                                                                                data-academic-year="<%= academicYear %>"
                                                                                title="Mark as Graduated">
                                                                                <i class="bi bi-award me-1"></i>Graduate
                                                                            </button>
                                                                        <% } %>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                        
                                                        <!-- Summary Row -->
                                                        <tr class="summary-row">
                                                            <td colspan="<%= (subjects ? subjects.length * 4 : 0) + 5 %>" class="text-end fw-bold">Class Average:</td>
                                                            <td class="text-center fw-bold">
                                                                <% 
                                                                    const classAvg = results.reduce((sum, student) => sum + parseFloat(student.overallAverage), 0) / results.length;
                                                                %>
                                                                <%= classAvg.toFixed(2) %>
                                                            </td>
                                                            <td class="text-center fw-bold">
                                                                <%= ((classAvg / 100) * 100).toFixed(2) %>%
                                                            </td>
                                                            <td colspan="3" class="text-center fw-bold">
                                                                <% 
                                                                    let classGrade = 'F';
                                                                    if (classAvg >= 80) classGrade = 'A';
                                                                    else if (classAvg >= 70) classGrade = 'B';
                                                                    else if (classAvg >= 60) classGrade = 'C';
                                                                    else if (classAvg >= 50) classGrade = 'D';
                                                                    else if (classAvg >= 40) classGrade = 'E';
                                                                %>
                                                                <span class="grade-<%= classGrade %>"><%= classGrade %></span>
                                                            </td>
                                                        </tr>
                                                        
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="<%= (subjects ? subjects.length * 4 : 0) + 8 %>" class="text-center text-muted py-4">
                                                                No student data available
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Promotion Summary -->
                        <div class="row mt-4 no-print">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">
                                            <i class="bi bi-pie-chart me-2"></i>Promotion Summary
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4 text-center">
                                                <div class="bg-success rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-mortarboard text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-success">
                                                    <% 
                                                        const promoteCount = results ? results.filter(s => s.promotionStatus === 'Promote').length : 0;
                                                    %>
                                                    <%= promoteCount %>
                                                </h4>
                                                <p class="text-muted">Students to Promote</p>
                                            </div>
                                            <div class="col-md-4 text-center">
                                                <div class="bg-warning rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-arrow-clockwise text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-warning">
                                                    <% 
                                                        const repeatCount = results ? results.filter(s => s.promotionStatus === 'Repeat').length : 0;
                                                    %>
                                                    <%= repeatCount %>
                                                </h4>
                                                <p class="text-muted">Students to Repeat</p>
                                            </div>
                                            <div class="col-md-4 text-center">
                                                <div class="bg-primary rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2">
                                                    <i class="bi bi-people text-white" style="font-size: 1.5rem;"></i>
                                                </div>
                                                <h4 class="text-primary">
                                                    <%= results ? results.length : 0 %>
                                                </h4>
                                                <p class="text-muted">Total Students</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    <% } else { %>
                        <!-- Term Broadsheet -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-hover mb-0" id="broadsheetTable">
                                                <thead>
                                                    <tr>
                                                        <th>Position</th>
                                                        <th>Student Name</th>
                                                        <th>Roll No</th>
                                                        <th>Subjects</th>
                                                        <th>Total Score</th>
                                                        <th>Average Score</th>
                                                        <th>Percentage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (results && results.length > 0) { %>
                                                        <% results.forEach(student => { %>
                                                            <tr>
                                                                <td class="text-center fw-bold"><%= student.position %></td>
                                                                <td class="fw-bold">
                                                                    <%= student.first_name %> <%= student.last_name %>
                                                                </td>
                                                                <td class="text-center"><%= student.rollNo || 'N/A' %></td>
                                                                <td class="text-center"><%= student.subject_count || 0 %></td>
                                                                <td class="text-center fw-bold"><%= student.total_score || 0 %></td>
                                                                <td class="text-center fw-bold"><%= student.average_score %></td>
                                                                <td class="text-center fw-bold"><%= student.percentage %>%</td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="7" class="text-center text-muted py-4">
                                                                No student data available
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Grading Key -->
                    <div class="row mt-4 no-print">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="bi bi-info-circle me-2"></i>Grading & Promotion System
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-A p-2">A</span> 80% and above
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-B p-2">B</span> 70% - 79%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-C p-2">C</span> 60% - 69%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-D p-2">D</span> 50% - 59%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-E p-2">E</span> 40% - 49%
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <span class="badge grade-F p-2">F</span> Below 40%
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <span class="badge bg-success p-2">Promote</span> 45% and above
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <span class="badge bg-warning p-2">Repeat</span> Below 45%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- container -->
            </div> <!-- content -->

            <!-- Footer Start -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> © Hyper - Coderthemes.com
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end footer-links d-none d-md-block">
                                <a href="javascript: void(0);">About</a>
                                <a href="javascript: void(0);">Support</a>
                                <a href="javascript: void(0);">Contact Us</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
        </div>
        <!-- ============================================================== -->
        <!-- End Page content -->
        <!-- ============================================================== -->
    </div>
    <!-- END wrapper -->

    <!-- Right Sidebar -->
    <div class="end-bar">
        <div class="rightbar-title">
            <a href="javascript:void(0);" class="end-bar-toggle float-end">
                <i class="dripicons-cross noti-icon"></i>
            </a>
            <h5 class="m-0">Settings</h5>
        </div>
        <div class="rightbar-content h-100" data-simplebar="">
            <div class="p-3">
                <div class="alert alert-warning" role="alert">
                    <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                </div>
                <!-- Settings content -->
                <h5 class="mt-3">Color Scheme</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                    <label class="form-check-label" for="light-mode-check">Light Mode</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                    <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                </div>
                <!-- Width -->
                <h5 class="mt-4">Width</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                    <label class="form-check-label" for="fluid-check">Fluid</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                    <label class="form-check-label" for="boxed-check">Boxed</label>
                </div>
                <!-- Left Sidebar-->
                <h5 class="mt-4">Left Sidebar</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                    <label class="form-check-label" for="default-check">Default</label>
