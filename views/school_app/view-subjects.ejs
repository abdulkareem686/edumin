        <form method="get" class="d-flex">
            <select class="form-select me-2" name="classId" id="class-filter">
                <option value="">All Classes</option>
                <% classes.forEach(cls => { %>
                    <option value="<%= cls.id %>" 
                        <%= selectedClassId == cls.id ? 'selected' : '' %>>
                        <%= cls.className %>
                        <% if (cls.department) { %> (<%= cls.department %>) <% } %>
                    </option>
                <% }); %>
            </select>
            <button type="submit" class="btn btn-primary">Filter</button>
        </form>
    </div>
</div>

<% if (subjects.length > 0) { %>
    <table class="table table-hover" id="subjects-table">
        <thead>
            <tr>
                <th>Class</th>
                <th>Level</th>
                <th>Department</th>
                <th>Subject</th>
                
                <th>Subject Code</th>
                <th>Students</th>
                <th>Last Updated</th>
            </tr>
        </thead>
        <tbody>
            <% subjects.forEach(subject => { %>
                <tr>
                    <td><%= subject.className %></td>
                    <td><%= subject.level %></td>
                    <td><%= subject.department || 'N/A' %></td>
                    <td><%= subject.subjectName %></td>
                    
                    <td><%= subject.subjectCode || 'N/A' %></td>
                    <td><%= subject.studentCount %></td>
                    <td><%= subject.formattedDate %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } else { %>
    <div class="alert alert-info">
        <% if (selectedClassId) { %>
            No subjects found for the selected class.
        <% } else { %>
            No subjects found. Register subjects using the form below.
        <% } %>
    </div>
<% } %>




