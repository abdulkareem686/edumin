        <!-- Statistics Cards -->
        <div class="row mb-4" style="align-content: center;">
            <div class="col-md-3">
                <div class="card stats-card text-center">
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center">
                            <i class="bi bi-receipt-cutoff text-primary display-6 me-3"></i>
                            <div>
                                <h2 class="text-primary mb-0"><%= payments.length %></h2>
                                <p class="text-muted mb-0">Total Payments</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card stats-card text-center">
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center">
                            <i class="bi bi-clock-history text-warning display-6 me-3"></i>
                            <div>
                                <h2 class="text-warning mb-0"><%= payments.filter(p => p.status === 'pending').length %></h2>
                                <p class="text-muted mb-0">Pending</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stats-card text-center">
                    <div class="card-body">
                        <div class="d-flex justify-content-center align-items-center">
                            <i class="bi bi-check-circle text-success display-6 me-3"></i>
                            <div>
                                <h2 class="text-success mb-0"><%= payments.filter(p => p.status === 'paid').length %></h2>
                                <p class="text-muted mb-0">Completed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card filter-card">
                    <div class="card-body">
                        <h5 class="card-title text-white mb-4">Filter Payments</h5>
                        <form method="GET" class="row">
                            <div class="col-md-3 mb-3">
                                <label class="filter-label">Month</label>
                                <select class="form-select filter-select" name="month">
                                    <option value="">All Months</option>
                                    <% months.forEach(month => { %>
                                        <option value="<%= month.month %>" <%= filters.month === month.month ? 'selected' : '' %>>
                                            <%= month.month %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="filter-label">Employee Type</label>
                                <select class="form-select filter-select" name="employee_type">
                                    <option value="">All Types</option>
                                    <option value="teacher" <%= filters.employee_type === 'teacher' ? 'selected' : '' %>>Teachers</option>
                                    <option value="staff" <%= filters.employee_type === 'staff' ? 'selected' : '' %>>Staff</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="filter-label">Status</label>
                                <select class="form-select filter-select" name="status">
                                    <option value="">All Status</option>
                                    <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="paid" <%= filters.status === 'paid' ? 'selected' : '' %>>Paid</option>
                                    <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="filter-label">&nbsp;</label>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-light">
                                        <i class="bi bi-filter me-1"></i> Apply Filters
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Table -->
        <div class="row">
            <div class="col-12">
                <div class="card payment-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="card-title mb-0">Salary Payment Records</h5>
                            <div>
                                <button class="export-btn" onclick="exportToExcel()">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
                                </button>
                            </div>
                        </div>

                        <% if (payments.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover table-centered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Type</th>
                                            <th>Position</th>
                                            <th>Month</th>
                                            <th>Gross Salary</th>
                                            <th>Net Salary</th>
                                            <th>Status</th>
                                            <th>Payment Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% payments.forEach(payment => { %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        
                                                        <div class="flex-grow-1 ms-2">
                                                            <span class="fw-semibold"><%= payment.first_name %> <%= payment.last_name %></span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-<%= payment.employee_type === 'teacher' ? 'info' : 'success' %> status-badge">
                                                        <%= payment.employee_type %>
                                                    </span>
                                                </td>
                                                <td><%= payment.position %></td>
                                                <td><span class="badge bg-light text-dark"><%= payment.month %></span></td>
                                                <td class="salary-amount">₦<%= payment.gross_salary.toLocaleString() %></td>
                                                <td><strong class="text-success">₦<%= payment.net_salary.toLocaleString() %></strong></td>
                                                <td>
                                                    <span class="badge bg-<%= payment.status === 'paid' ? 'success' : payment.status === 'pending' ? 'warning' : 'danger' %> status-badge">
                                                        <i class="bi bi-<%= payment.status === 'paid' ? 'check-circle' : payment.status === 'pending' ? 'clock' : 'x-circle' %> me-1"></i>
                                                        <%= payment.status %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% if (payment.payment_date) { %>
                                                        <span class="text-muted"><%= moment(payment.payment_date).format('MMM D, YYYY') %></span>
                                                    <% } else { %>
                                                        <span class="text-muted">-</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="/salary-slip/<%= payment.id %>" class="btn btn-sm btn-outline-primary action-btn" title="View Salary Slip">
                                                            <i class="bi bi-receipt"></i>
                                                        </a>
                                                        <% if (payment.status === 'pending') { %>
                                                            <button class="btn btn-sm btn-outline-success action-btn" 
                                                                    onclick="markAsPaid(<%= payment.id %>)" title="Mark as Paid">
                                                                <i class="bi bi-check-lg"></i>
                                                            </button>
                                                        <% } %>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination would go here -->
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <h5 class="text-muted">No Payments Found</h5>
                                <p class="text-muted mb-4">No salary payments match your current filters</p>
                                <a href="/process-salaries" class="btn btn-primary">
                                    <i class="bi bi-calculator me-1"></i> Process Salaries
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function markAsPaid(paymentId) {
            if (!confirm('Mark this payment as paid?')) {
                return;
            }

            try {
                const response = await fetch('/update-salary-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        payment_id: paymentId,
                        status: 'paid',
                        payment_date: new Date().toISOString().split('T')[0],
                        payment_method: 'bank_transfer'
                    })
                });

                const result = await response.json();

                if (result.success) {
                    alert('Payment marked as paid successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (error) {
                alert('Failed to update payment status');
                console.error('Error:', error);
            }
        }

        function exportToExcel() {
            // This would trigger Excel export functionality
            alert('Excel export functionality would be implemented here');
        }
    </script>
</div> <!-- content -->

