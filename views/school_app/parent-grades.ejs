<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Grades - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .grade-card {
            transition: all 0.3s ease;
            border-radius: 15px;
        }
        .grade-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .stat-card {
            background: #3b5de7;
            color: white;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }
        .grade-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .grade-A { background: #10b981; color: white; }
        .grade-B { background: #34d399; color: white; }
        .grade-C { background: #fbbf24; color: #1e293b; }
        .grade-D { background: #f59e0b; color: white; }
        .grade-E { background: #f97316; color: white; }
        .grade-F { background: #ef4444; color: white; }
        .child-card {
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .child-card:hover {
            background: #f8fafd;
            border-color: #3b5de7;
        }
        .child-card.active {
            background: #eef2ff;
            border-color: #3b5de7;
        }
        .child-name {
            font-weight: 600;
            color: #1e293b;
        }
        .notification-unread {
            background-color: #e8f0fe;
            border-left: 3px solid #3b5de7;
        }
        .grade-table th {
            background: #f8fafd;
            font-weight: 600;
        }
        .gpa-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
            margin: 0 auto;
        }
        .gpa-excellent { background: #10b981; color: white; }
        .gpa-good { background: #34d399; color: white; }
        .gpa-average { background: #fbbf24; color: #1e293b; }
        .gpa-poor { background: #ef4444; color: white; }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/parent-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-clipboard-notes me-2"></i>Student Grades
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Back to All Children Navigation -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <a href="/parent/children" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Back to All Children
                        </a>
                        <% if (student) { %>
                        <div class="d-flex gap-2">
                            <a href="/parent/reports?studentId=<%= student.id %>" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-file-earmark-text me-1"></i> Full Report Card
                            </a>
                            <a href="/parent/attendance?studentId=<%= student.id %>" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-calendar-check me-1"></i> Attendance
                            </a>
                        </div>
                        <% } %>
                    </div>

                    <div class="col-12 px-0">
                            <!-- Term Selector -->
                            <div class="card mb-4">
                                <div class="card-body">
                                    <form method="GET" action="/parent/grades" class="row g-3 align-items-end">
                                        <input type="hidden" name="studentId" value="<%= student ? student.id : '' %>">
                                        <div class="col-md-5">
                                            <label class="form-label small text-muted">Academic Year</label>
                                            <select name="academicYear" class="form-select" onchange="this.form.submit()">
                                                <option value="">Select Year</option>
                                                <% if (academicYears && academicYears.length > 0) { 
                                                    for(var i = 0; i < academicYears.length; i++) { 
                                                        var year = academicYears[i]; %>
                                                        <option value="<%= year.year_name %>" <%= selectedYear === year.year_name ? 'selected' : '' %>>
                                                            <%= year.year_name %>
                                                        </option>
                                                <% } 
                                                } else { %>
                                                    <option value="2023-2024">2023-2024</option>
                                                    <option value="2024-2025">2024-2025</option>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small text-muted">Term</label>
                                            <select name="term" class="form-select" onchange="this.form.submit()">
                                                <% if (availableTerms && availableTerms.length > 0) { 
                                                    for(var i = 0; i < availableTerms.length; i++) { 
                                                        var termItem = availableTerms[i]; %>
                                                        <option value="<%= termItem.term_name %>" <%= selectedTerm === termItem.term_name ? 'selected' : '' %>>
                                                            <%= termItem.term_name %>
                                                        </option>
                                                <% } 
                                                } else { %>
                                                    <option value="First Term">First Term</option>
                                                    <option value="Second Term">Second Term</option>
                                                    <option value="Third Term">Third Term</option>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-primary w-100" onclick="window.print()">
                                                <i class="bi bi-printer me-1"></i> Print
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <% if (student) { %>
                                <!-- GPA Summary Cards -->
                                <div class="row mb-4">
                                    <div class="col-md-4">
                                        <div class="stat-card">
                                            <div class="stat-number"><%= overallAverage %>%</div>
                                            <div>Average Score</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="stat-card">
                                            <div class="stat-number"><%= gpa %></div>
                                            <div>GPA (5.0 Scale)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="stat-card">
                                            <div class="stat-number"><%= totalCredits %></div>
                                            <div>Subjects Taken</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Student Info -->
                                <div class="card mb-4">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <small class="text-muted">Student Name</small>
                                                <h6 class="mb-0"><%= student.firstName %> <%= student.middleName ? student.middleName + ' ' : '' %><%= student.lastName %></h6>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">Admission Number</small>
                                                <h6 class="mb-0"><%= student.admission_number || 'N/A' %></h6>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted">Class</small>
                                                <h6 class="mb-0"><%= student.className || 'Not Assigned' %></h6>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="gpa-circle gpa-<%= overallAverage >= 70 ? 'excellent' : overallAverage >= 50 ? 'good' : overallAverage >= 40 ? 'average' : 'poor' %>">
                                                    <%= overallGrade %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Grades Table -->
                                <div class="card">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0"><i class="bi bi-table me-2 text-primary"></i>Grade Report - <%= selectedTerm %> <%= selectedYear %></h6>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Subject</th>
                                                        <th>Code</th>
                                                        <th class="text-center">Test (40)</th>
                                                        <th class="text-center">Exam (60)</th>
                                                        <th class="text-center">Total (100)</th>
                                                        <th class="text-center">Grade</th>
                                                        <th>Remark</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (grades && grades.length > 0) { 
                                                        for(var i = 0; i < grades.length; i++) { 
                                                            var grade = grades[i]; %>
                                                            <tr>
                                                                <td><%= i + 1 %></td>
                                                                <td><strong><%= grade.subject_name %></strong></td>
                                                                <td><%= grade.subject_code || 'N/A' %></td>
                                                                <td class="text-center"><%= grade.test_score %></td>
                                                                <td class="text-center"><%= grade.exam_score %></td>
                                                                <td class="text-center"><strong><%= grade.total_score %></strong></td>
                                                                <td class="text-center">
                                                                    <span class="grade-badge grade-<%= grade.letter_grade %>">
                                                                        <%= grade.letter_grade %>
                                                                    </span>
                                                                </td>
                                                                <td><%= grade.remark %></td>
                                                            </tr>
                                                    <% } 
                                                    } else { %>
                                                        <tr>
                                                            <td colspan="8" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox fs-1"></i>
                                                                <p class="mt-2 mb-0">No grades available for the selected period</p>
                                                                <small>Grades will appear once published by the school</small>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Grading Scale Legend -->
                                <div class="card mt-4">
                                    <div class="card-header bg-white">
                                        <h6 class="mb-0"><i class="bi bi-info-circle me-2 text-primary"></i>Grading Scale</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row text-center">
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-A mb-2">A</span>
                                                <small class="d-block">80-100%</small>
                                                <small class="text-muted">Excellent</small>
                                            </div>
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-B mb-2">B</span>
                                                <small class="d-block">70-79%</small>
                                                <small class="text-muted">Very Good</small>
                                            </div>
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-C mb-2">C</span>
                                                <small class="d-block">60-69%</small>
                                                <small class="text-muted">Good</small>
                                            </div>
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-D mb-2">D</span>
                                                <small class="d-block">50-59%</small>
                                                <small class="text-muted">Fair</small>
                                            </div>
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-E mb-2">E</span>
                                                <small class="d-block">40-49%</small>
                                                <small class="text-muted">Pass</small>
                                            </div>
                                            <div class="col-md-2">
                                                <span class="grade-badge grade-F mb-2">F</span>
                                                <small class="d-block">0-39%</small>
                                                <small class="text-muted">Fail</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="card p-5 text-center shadow-sm border-0 my-4">
                                    <div class="text-muted mb-3">
                                        <i class="bi bi-people fs-1 text-primary"></i>
                                    </div>
                                    <h4 class="fw-bold">No Child Selected</h4>
                                    <p class="text-muted mb-4">Please select a child from the All Children page to view their grades and assessment scores.</p>
                                    <div>
                                        <a href="/parent/children?select=grades" class="btn btn-primary px-4">
                                            <i class="bi bi-arrow-left me-2"></i> Go to All Children
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Parent Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        function markNotificationRead(notificationId) {
            fetch('/api/parent-notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        function markAllNotificationsRead() {
            fetch('/api/parent-notifications/mark-all-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                if (response.ok) {
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
    </script>
</body>
</html>