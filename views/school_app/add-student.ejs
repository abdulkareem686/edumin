<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Add Student - Alhamdulillahi Academy</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Alhamdulillahi Academy - a complete school management platform." name="description" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        .required-field::after {
            content: " *";
            color: red;
        }
        .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid var(--aa-surface-3, #e9ecef);
            border-radius: 0.5rem;
            background-color: var(--aa-surface-2, #f8f9fa);
        }
        .form-section-title {
            color: var(--aa-brand-ink, #4a5a34);
            border-bottom: 2px solid #4a5a34;
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <!-- Alhamdulillahi Academy - Heritage 2027 UI -->
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
    <link href="/assets/css/theme-2027.css" rel="stylesheet" type="text/css">
    <script src="/assets/js/theme-2027.js"></script>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <%- include('partials/admin-sidebar') %>

        <div class="content-page">
            <div class="content">
                <%- include('partials/admin-navbar') %>

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                                        <li class="breadcrumb-item"><a href="/all-students">Students</a></li>
                                        <li class="breadcrumb-item active">Add Student</li>
                                    </ol>
                                </div>
                                <h4 class="page-title">Add New Student</h4>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <h5 class="card-title mb-1">Student Registration</h5>
                                            <p class="text-muted small mb-0">Fill in the student details to register a new student.</p>
                                        </div>
                                        <a href="/all-students" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-left me-1"></i>Back to All Students
                                        </a>
                                    </div>

                                    <% if (typeof success !== 'undefined' && success) { %>
                                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                                            <%= success %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    <% } %>

                                    <% if (typeof error !== 'undefined' && error) { %>
                                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                            <%= error %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    <% } %>

                                    <%- include('partials/forms/student-form-fields', {
                                        formData: typeof formData !== 'undefined' ? formData : {},
                                        classes: typeof classes !== 'undefined' ? classes : [],
                                        nigerianStates: typeof nigerianStates !== 'undefined' ? nigerianStates : {},
                                        mode: 'add'
                                    }) %>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            © Alhamdulillahi Academy <span class="aa-credit">Powered by <strong>QuDex Technologies</strong></span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <%- include('partials/forms/student-form-scripts') %>
</body>
</html>
