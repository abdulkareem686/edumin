                                                        Class: <strong><%= selectedClass.name %><% if (selectedClass.department) { %> - <%= selectedClass.department %><% } %></strong>
                                                    <% } %>
                                                    <% if (typeof academicYear !== 'undefined' || (typeof selectedClass !== 'undefined' && selectedClass)) { %> | <% } %>
                                                    Generated on: <strong><%= new Date().toLocaleDateString() %></strong>
                                                </p>
                                            </div>
                                            <div class="no-print">
                                                <a href="/term-reports" class="btn btn-outline-secondary">
                                                    <i class="mdi mdi-arrow-left me-1"></i> Back to Selection
                                                </a>
                                                <button class="btn btn-success ms-2" onclick="window.print()">
                                                    <i class="mdi mdi-printer me-1"></i> Print Report
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Error Message Display -->
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <i class="mdi mdi-alert-circle-outline me-2"></i>
                                        <strong>Error:</strong> <%= error %>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Term Results by Class -->
                        <% if (typeof classReports !== 'undefined' && classReports && classReports.length > 0) { %>
                            <% classReports.forEach((classReport, classIndex) => { %>
                                <% if (classReport.students && classReport.students.length > 0) { %>
                                    <div class="row mb-4">
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-header d-flex justify-content-between align-items-center">
                                                    <h5 class="card-title mb-0">
                                                        <i class="mdi mdi-account-group me-2"></i>
                                                        <%= classReport.classInfo.className %>
                                                        <% if (classReport.classInfo.department) { %>
                                                            - <%= classReport.classInfo.department %>
                                                        <% } %>
                                                        (<%= classReport.classInfo.level %>)
                                                    </h5>
                                                    <span class="class-badge">
                                                        <%= classReport.studentCount || classReport.students.length %> Students
                                                    </span>
                                                </div>
                                                <div class="card-body">
                                                    <div class="table-responsive">
                                                        <table class="table table-centered table-striped dt-responsive nowrap w-100">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-center">Position</th>
                                                                    <th>Student Name</th>
                                                                    <th class="text-center">Roll No</th>
                                                                    <th class="text-center">Subjects</th>
                                                                    <th class="text-center">Total Score</th>
                                                                    <th class="text-center">Average Score</th>
                                                                    <th class="text-center">Percentage</th>
                                                                    <th class="text-center">Performance</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% classReport.students.forEach((student, index) => { 
                                                                    let performanceClass = 'performance-low';
                                                                    let performanceText = 'Needs Improvement';
                                                                    
                                                                    if (student.average_score >= 80) {
                                                                        performanceClass = 'performance-high';
                                                                        performanceText = 'Excellent';
                                                                    } else if (student.average_score >= 70) {
                                                                        performanceClass = 'performance-high';
                                                                        performanceText = 'Very Good';
                                                                    } else if (student.average_score >= 60) {
                                                                        performanceClass = 'performance-medium';
                                                                        performanceText = 'Good';
                                                                    } else if (student.average_score >= 50) {
                                                                        performanceClass = 'performance-medium';
                                                                        performanceText = 'Average';
                                                                    } else if (student.average_score >= 40) {
                                                                        performanceClass = 'performance-low';
                                                                        performanceText = 'Below Average';
                                                                    }
                                                                %>
                                                                    <tr>
                                                                        <td class="text-center">
                                                                            <span class="badge-position"><%= student.position || (index + 1) %></span>
                                                                        </td>
                                                                        <td class="student-name">
                                                                            <i class="mdi mdi-account-school me-2"></i>
                                                                            <%= student.first_name %> <%= student.last_name %>
                                                                        </td>
                                                                        <td class="text-center"><%= student.rollNo || student.roll_number || 'N/A' %></td>
                                                                        <td class="text-center"><%= student.subject_count || 0 %></td>
                                                                        <td class="text-center score-cell"><%= student.total_score || 0 %></td>
                                                                        <td class="text-center score-cell">
                                                                            <span class="badge-average"><%= student.formattedAverage || student.average_score || '0.00' %></span>
                                                                        </td>
                                                                        <td class="text-center score-cell"><%= student.percentage || '0.00' %>%</td>
                                                                        <td class="text-center fw-bold <%= performanceClass %>">
                                                                            <%= performanceText %>
                                                                        </td>
                                                                    </tr>
                                                                <% }); %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            <% }); %>
                        <% } else if (typeof results !== 'undefined' && results && results.length > 0) { %>
                            <!-- Display results data (from selection) -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="card-title mb-0">
                                                <i class="mdi mdi-account-group me-2"></i>
                                                <% if (typeof selectedClass !== 'undefined' && selectedClass) { %>
                                                    <%= selectedClass.name %>
                                                    <% if (selectedClass.department) { %>
                                                        - <%= selectedClass.department %>
                                                    <% } %>
                                                    (<%= selectedClass.level %>)
                                                <% } else { %>
                                                    Class Results
                                                <% } %>
                                            </h5>
                                            <span class="class-badge">
                                                <%= results.length %> Students
                                            </span>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-centered table-striped dt-responsive nowrap w-100">
                                                    <thead>
                                                        <tr>
                                                            <th class="text-center">Position</th>
                                                            <th>Student Name</th>
                                                            <th class="text-center">Roll No</th>
                                                            <th class="text-center">Subjects</th>
                                                            <th class="text-center">Total Score</th>
                                                            <th class="text-center">Average Score</th>
                                                            <th class="text-center">Percentage</th>
                                                            <th class="text-center">Performance</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% results.forEach((student, index) => { 
                                                            let performanceClass = 'performance-low';
                                                            let performanceText = 'Needs Improvement';
                                                            
                                                            if (student.average_score >= 80) {
                                                                performanceClass = 'performance-high';
                                                                performanceText = 'Excellent';
                                                            } else if (student.average_score >= 70) {
                                                                performanceClass = 'performance-high';
                                                                performanceText = 'Very Good';
                                                            } else if (student.average_score >= 60) {
                                                                performanceClass = 'performance-medium';
                                                                performanceText = 'Good';
                                                            } else if (student.average_score >= 50) {
                                                                performanceClass = 'performance-medium';
                                                                performanceText = 'Average';
                                                            } else if (student.average_score >= 40) {
                                                                performanceClass = 'performance-low';
                                                                performanceText = 'Below Average';
                                                            }
                                                        %>
                                                            <tr>
                                                                <td class="text-center">
                                                                    <span class="badge-position"><%= student.position || (index + 1) %></span>
                                                                </td>
                                                                <td class="student-name">
                                                                    <i class="mdi mdi-account-school me-2"></i>
                                                                    <%= student.first_name %> <%= student.last_name %>
                                                                </td>
                                                                <td class="text-center"><%= student.rollNo || student.roll_number || 'N/A' %></td>
                                                                <td class="text-center"><%= student.subject_count || 0 %></td>
                                                                <td class="text-center score-cell"><%= student.total_score || 0 %></td>
                                                                <td class="text-center score-cell">
                                                                    <span class="badge-average"><%= student.formattedAverage || student.average_score || '0.00' %></span>
                                                                </td>
                                                                <td class="text-center score-cell"><%= student.percentage || '0.00' %>%</td>
                                                                <td class="text-center fw-bold <%= performanceClass %>">
                                                                    <%= performanceText %>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- No data available -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body no-data-container text-center py-5">
                                            <i class="mdi mdi-chart-bar no-data-icon" style="font-size: 4rem;"></i>
                                            <h5 class="text-muted mt-3">No data available</h5>
                                            <p class="text-muted">No student records found for this report.</p>
                                            <a href="/enter-scores" class="btn btn-primary mt-3">
                                                <i class="mdi mdi-plus-circle me-2"></i>Enter Scores
                                            </a>
                                            <a href="/term-reports" class="btn btn-outline-secondary mt-3 ms-2">
                                                <i class="mdi mdi-arrow-left me-2"></i>Back to Selection
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        
                    </div> <!-- container -->

                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © abdulkareem
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->


        </div>
        <!-- END wrapper -->


        <!-- Right Sidebar -->
        <div class="end-bar">

            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>

            <div class="rightbar-content h-100" data-simplebar="">

                <div class="p-3">
                    <div class="alert alert-warning" role="alert">
                        <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                    </div>

                    <!-- Settings -->
                    <h5 class="mt-3">Color Scheme</h5>
                    <hr class="mt-1">

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                        <label class="form-check-label" for="light-mode-check">Light Mode</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                        <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                    </div>
       

                    <!-- Width -->
                    <h5 class="mt-4">Width</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                        <label class="form-check-label" for="fluid-check">Fluid</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                        <label class="form-check-label" for="boxed-check">Boxed</label>
                    </div>
        

                    <!-- Left Sidebar-->
                    <h5 class="mt-4">Left Sidebar</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                        <label class="form-check-label" for="default-check">Default</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked="">
                        <label class="form-check-label" for="light-check">Light</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                        <label class="form-check-label" for="dark-check">Dark</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked="">
                        <label class="form-check-label" for="fixed-check">Fixed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                        <label class="form-check-label" for="condensed-check">Condensed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                        <label class="form-check-label" for="scrollable-check">Scrollable</label>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
            
                        <a href="../../product/hyper-responsive-admin-dashboard-template/index.htm" class="btn btn-danger mt-3" target="_blank"><i class="mdi mdi-basket me-1"></i> Purchase Now</a>
                    </div>
                </div> <!-- end padding-->

            </div>
        </div>

        <div class="rightbar-overlay"></div>
        <!-- /End-bar -->

        <!-- bundle -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>

        <!-- third party js -->
        <script src="/assets/js/vendor/jquery.dataTables.min.js"></script>
        <script src="/assets/js/vendor/dataTables.bootstrap5.js"></script>
        <script src="/assets/js/vendor/dataTables.responsive.min.js"></script>
        <script src="/assets/js/vendor/responsive.bootstrap5.min.js"></script>
        <script src="/assets/js/vendor/dataTables.checkboxes.min.js"></script>
        <!-- third party js ends -->

        <script>
            // Initialize DataTable if tables exist
            $(document).ready(function() {
                $('table').each(function() {
                    if ($(this).find('tbody tr').length > 0) {
                        $(this).DataTable({
                            responsive: true,
                            order: [[0, 'asc']],
                            pageLength: 10,
                            language: {
                                paginate: {
                                    previous: "<i class='mdi mdi-chevron-left'>",
                                    next: "<i class='mdi mdi-chevron-right'>"
                                }
                            },
                            drawCallback: function() {
                                $('.dataTables_paginate > .pagination').addClass('pagination-rounded');
                            }
                        });
                    }
                });
                
                // Auto-dismiss alerts after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            });
        </script>

    </body>
</html>