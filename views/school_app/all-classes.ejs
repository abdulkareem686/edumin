<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>edu admin</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
        <meta content="Coderthemes" name="author">
        <!-- App favicon -->
        <link rel="shortcut icon" href="images/favicon.png">

        <!-- third party css -->
        <link href="assets/css/vendor/dataTables.bootstrap5.css" rel="stylesheet" type="text/css">
        <link href="assets/css/vendor/responsive.bootstrap5.css" rel="stylesheet" type="text/css">
        <!-- third party css end -->

        <!-- App css -->
        <link href="assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
        <link href="assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        /* Enable smooth, guaranteed scrolling for all modal dialogs */
        .modal-dialog-scrollable {
            max-height: calc(100vh - 2rem) !important;
        }
        .modal-dialog-scrollable form.modal-content,
        .modal-dialog-scrollable .modal-content {
            max-height: calc(100vh - 2rem) !important;
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }
        .modal-dialog-scrollable .modal-body {
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch !important;
            flex: 1 1 auto !important;
            max-height: calc(100vh - 180px) !important;
        }
        .modal-dialog-scrollable .modal-header,
        .modal-dialog-scrollable .modal-footer {
            flex-shrink: 0 !important;
        }
    </style>

    </head>

    <body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <!-- Begin page -->
        <div class="wrapper">
            <!-- ========== Left Sidebar Start ========== -->
<!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->
            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->

            <div class="content-page">
                <div class="content">
                    <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->
                    <!-- Start Content-->
                    <div class="container-fluid">
                        
                        <!-- start page title -->
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <div class="page-title-right">
                                        <ol class="breadcrumb m-0">
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Home</a></li>
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Classes</a></li>
                                            <li class="breadcrumb-item active">All Class </li>
                                        </ol>
                                    </div>
                                    <h4 class="page-title">All Class</h4>
                                </div>
                            </div>
                        </div>     
                        <!-- end page title --> 

                        <!-- Alert messages -->
                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        <% } %>

                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-sm-4">
                                                <button type="button" class="btn btn-danger mb-2" data-bs-toggle="modal" data-bs-target="#addClassModal">
                                                    <i class="mdi mdi-plus-circle me-2"></i> Add Class
                                                </button>
                                            </div>
                                            <div class="col-sm-8">
                                                <div class="text-sm-end">
                                                    <button type="button" class="btn btn-success mb-2 me-1"><i class="mdi mdi-cog"></i></button>
                                                    <button type="button" class="btn btn-light mb-2 me-1">Import</button>
                                                    <button type="button" class="btn btn-light mb-2">Export</button>
                                                </div>
                                            </div><!-- end col-->
                                        </div>
                
                                        <div class="table-responsive">
                                            <table class="table table-centered table-striped dt-responsive nowrap w-100" id="products-datatable">
    <thead>
        <tr>
            <th style="width: 20px;">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="customCheck1">
                    <label class="form-check-label" for="customCheck1">&nbsp;</label>
                </div>
            </th>
            <th>Class Name</th>
            <th>Level</th>
            <th>Department</th>
            <th>Class Code</th>
            <th>Teacher</th>
            <th>Student No</th>
            <th style="width: 100px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        <% if (typeof classes !== 'undefined' && Array.isArray(classes)) { %>
        <% classes.forEach(function(cls) { %>
        <tr>
            <td>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="class-<%= cls.id %>">
                    <label class="form-check-label" for="class-<%= cls.id %>">&nbsp;</label>
                </div>
            </td>
            <td class="table-user">
                <a href="/about-class/<%= cls.id %>" class="text-body fw-semibold"><%= cls.className %></a>
            </td>
            <td><%= cls.level %></td>
            <td><%= cls.department || 'N/A' %></td>
            <td><%= cls.classCode %></td>
            <td>
                <% if (cls.professorName) { %>
                    <a href="/teacher-profile/<%= cls.professorId %>"><%= cls.professorName %></a>
                <% } else { %>
                    Not assigned
                <% } %>
            </td>
            <td>
                <%= cls.maximumStudents %>
            </td>
            <td>
                <a href="/edit-class/<%= cls.id %>" class="action-icon" title="Edit">
                    <i class="mdi mdi-square-edit-outline"></i>
                </a>
                <a href="/delete-class/<%= cls.id %>" class="action-icon" title="Delete" onclick="return confirm('Are you sure you want to delete this class?')">
                    <i class="mdi mdi-delete"></i>
                </a>
            </td>
        </tr>
        <% }); %> 
        <% } %>
    </tbody>
</table>
                                        </div>

                                       <!-- Enhanced Add Class Modal -->
                                       <div class="modal fade" id="addClassModal" tabindex="-1" aria-labelledby="addClassModalLabel" aria-hidden="true">
                                           <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
<form class="modal-content border-0 shadow" action="/add-class" method="post" id="classModalForm">
                                                       <div class="modal-header bg-light py-3">
                                                           <div>
                                                               <h5 class="modal-title fw-bold text-primary mb-1" id="addClassModalLabel">
                                                                   <i class="bi bi-building-add me-2"></i>Create New Class
                                                               </h5>
                                                               <p class="text-muted small mb-0">Define class level, name, code, assigned class teacher, and student capacity.</p>
                                                           </div>
                                                           <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                       </div>
                                                       <div class="modal-body p-4" style="overflow-y: auto; max-height: calc(85vh - 130px);">
                                                           <div class="row g-3">
                                                               <div class="col-md-6">
                                                                   <label class="form-label fw-medium">Level <span class="text-danger">*</span></label>
                                                                   <select class="form-select" name="level" id="classModalLevel" required>
                                                                       <option value="">-- Select Level --</option>
                                                                       <option value="KG">KG</option>
                                                                       <option value="NURSERY">Nursery</option>
                                                                       <option value="PRIMARY">Primary</option>
                                                                       <option value="JUNIOR SECONDARY">Junior Secondary</option>
                                                                       <option value="SENIOR SECONDARY">Senior Secondary</option>
                                                                   </select>
                                                                   <div class="form-text">Educational division for curriculum & grading.</div>
                                                               </div>
                                                               <div class="col-md-6">
                                                                   <label class="form-label fw-medium">Class Name <span class="text-danger">*</span></label>
                                                                   <input type="text" class="form-control" name="className" placeholder="e.g. JSS 1 Gold or Primary 4 Blue" required>
                                                                   <div class="form-text">Display name of this class/arm.</div>
                                                               </div>
                                                               <div class="col-md-6">
                                                                   <label class="form-label fw-medium">Class Code <span class="text-danger">*</span></label>
                                                                   <input type="text" class="form-control" name="classCode" placeholder="e.g. JSS1-GOLD or PRI4-B" required>
                                                                   <div class="form-text">Unique short identifier for reports and bills.</div>
                                                               </div>
                                                               <div class="col-md-6">
                                                                   <label class="form-label fw-medium">Class Teacher <span class="text-danger">*</span></label>
                                                                   <select class="form-select" name="professorId" required>
                                                                       <option value="">-- Select Class Teacher --</option>
                                                                       <% if (typeof teachers !== 'undefined' && teachers && teachers.length) { %>
                                                                           <% teachers.forEach(function(teacher) { %>
                                                                               <option value="<%= teacher.id %>"><%= teacher.firstName %> <%= teacher.lastName %></option>
                                                                           <% }); %>
                                                                       <% } else { %>
                                                                           <option value="" disabled>No teachers available</option>
                                                                       <% } %>
                                                                   </select>
                                                                   <div class="form-text">Teacher assigned to manage this classroom.</div>
                                                               </div>
                                                               <div class="col-md-6">
                                                                   <label class="form-label fw-medium">Maximum Students</label>
                                                                   <input type="number" class="form-control" name="maximumStudents" placeholder="e.g. 40" min="1">
                                                                   <div class="form-text">Optional maximum capacity.</div>
                                                               </div>
                                                               <div class="col-md-6" id="classModalDepartmentContainer" style="display:none;">
                                                                    <label class="form-label fw-medium">Department <span class="text-danger">*</span></label>
                                                                    <select class="form-select" name="department" id="classModalDepartment">
                                                                        <option value="">-- Select Department --</option>
                                                                        <option value="ALL">All 3 Departments (Science, Commercial, Art)</option>
                                                                        <option value="SCIENCE">Science</option>
                                                                        <option value="COMMERCIAL">Commercial</option>
                                                                        <option value="ART">Art</option>
                                                                    </select>
                                                                    <div class="form-check form-switch mt-2">
                                                                        <input class="form-check-input" type="checkbox" id="classModalAllDepartments" name="autoAllDepartments" value="1">
                                                                        <label class="form-check-label fw-semibold text-primary" for="classModalAllDepartments">
                                                                            <i class="bi bi-diagram-3-fill me-1"></i> Register for all 3 departments automatically
                                                                        </label>
                                                                    </div>
                                                                    <div class="form-text text-muted" id="classModalDeptHelp">
                                                                        <span id="singleDeptHelp" class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>Required for Senior Secondary classes.</span>
                                                                        <span id="allDeptHelp" class="text-success fw-medium" style="display:none;"><i class="bi bi-check2-circle me-1"></i>Will automatically create 3 classes: <strong>[Name] Science</strong>, <strong>[Name] Commercial</strong>, and <strong>[Name] Art</strong>.</span>
                                                                    </div>
                                                                </div>
                                                           </div>
                                                       </div>
                                                       <div class="modal-footer bg-light py-2">
                                                           <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                           <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                                               <i class="bi bi-check-circle me-1"></i> Save Class
                                                           </button>
                                                       </div>
                                                   </form>
                                            </div>
                                        </div>
                                    </div> <!-- end card-body-->
                                </div> <!-- end card-->
                            </div> <!-- end col -->
                        </div>
                        <!-- end row -->
                        
                    </div> <!-- container -->

                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © abdulkareem
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->


        </div>
        <!-- END wrapper -->


        <!-- Right Sidebar -->
        <div class="end-bar">

            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>

            <div class="rightbar-content h-100" data-simplebar="">

                <div class="p-3">
                    <div class="alert alert-warning" role="alert">
                        <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
                    </div>

                    <!-- Settings -->
                    <h5 class="mt-3">Color Scheme</h5>
                    <hr class="mt-1">

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                        <label class="form-check-label" for="light-mode-check">Light Mode</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                        <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                    </div>
       

                    <!-- Width -->
                    <h5 class="mt-4">Width</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked="">
                        <label class="form-check-label" for="fluid-check">Fluid</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                        <label class="form-check-label" for="boxed-check">Boxed</label>
                    </div>
        

                    <!-- Left Sidebar-->
                    <h5 class="mt-4">Left Sidebar</h5>
                    <hr class="mt-1">
                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                        <label class="form-check-label" for="default-check">Default</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked="">
                        <label class="form-check-label" for="light-check">Light</label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                        <label class="form-check-label" for="dark-check">Dark</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked="">
                        <label class="form-check-label" for="fixed-check">Fixed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                        <label class="form-check-label" for="condensed-check">Condensed</label>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                        <label class="form-check-label" for="scrollable-check">Scrollable</label>
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
            
                        <a href="../../product/hyper-responsive-admin-dashboard-template/index.htm" class="btn btn-danger mt-3" target="_blank"><i class="mdi mdi-basket me-1"></i> Purchase Now</a>
                    </div>
                </div> <!-- end padding-->

            </div>
        </div>

        <div class="rightbar-overlay"></div>
        <!-- /End-bar -->


        <script>
            const classModalLevel = document.getElementById('classModalLevel');
            const classModalDepartmentContainer = document.getElementById('classModalDepartmentContainer');
            const classModalDepartment = document.getElementById('classModalDepartment');
            const classModalAllDepartments = document.getElementById('classModalAllDepartments');
            const singleDeptHelp = document.getElementById('singleDeptHelp');
            const allDeptHelp = document.getElementById('allDeptHelp');

            function updateDeptState() {
                const isSeniorSecondary = classModalLevel && classModalLevel.value === 'SENIOR SECONDARY';
                if (!isSeniorSecondary) {
                    if (classModalDepartmentContainer) classModalDepartmentContainer.style.display = 'none';
                    if (classModalDepartment) {
                        classModalDepartment.value = '';
                        classModalDepartment.required = false;
                    }
                    if (classModalAllDepartments) classModalAllDepartments.checked = false;
                    if (singleDeptHelp) singleDeptHelp.style.display = 'inline';
                    if (allDeptHelp) allDeptHelp.style.display = 'none';
                    return;
                }

                classModalDepartmentContainer.style.display = 'block';
                const isAll = (classModalAllDepartments && classModalAllDepartments.checked) || (classModalDepartment && classModalDepartment.value === 'ALL');

                if (isAll) {
                    if (classModalDepartment && classModalDepartment.value !== 'ALL') {
                        classModalDepartment.value = 'ALL';
                    }
                    if (classModalAllDepartments) classModalAllDepartments.checked = true;
                    if (classModalDepartment) classModalDepartment.required = false;
                    if (singleDeptHelp) singleDeptHelp.style.display = 'none';
                    if (allDeptHelp) allDeptHelp.style.display = 'inline';
                } else {
                    if (classModalDepartment && classModalDepartment.value === 'ALL') {
                        classModalDepartment.value = '';
                    }
                    if (classModalAllDepartments) classModalAllDepartments.checked = false;
                    if (classModalDepartment) classModalDepartment.required = true;
                    if (singleDeptHelp) singleDeptHelp.style.display = 'inline';
                    if (allDeptHelp) allDeptHelp.style.display = 'none';
                }
            }

            if (classModalLevel) {
                classModalLevel.addEventListener('change', updateDeptState);
            }
            if (classModalAllDepartments) {
                classModalAllDepartments.addEventListener('change', function() {
                    if (this.checked) {
                        if (classModalDepartment) classModalDepartment.value = 'ALL';
                    } else {
                        if (classModalDepartment && classModalDepartment.value === 'ALL') {
                            classModalDepartment.value = '';
                        }
                    }
                    updateDeptState();
                });
            }
            if (classModalDepartment) {
                classModalDepartment.addEventListener('change', function() {
                    if (this.value === 'ALL') {
                        if (classModalAllDepartments) classModalAllDepartments.checked = true;
                    } else {
                        if (classModalAllDepartments) classModalAllDepartments.checked = false;
                    }
                    updateDeptState();
                });
            }

            const classModalForm = document.getElementById('classModalForm');
            if (classModalForm) {
                classModalForm.addEventListener('submit', function(event) {
                    const isSeniorSecondary = classModalLevel && classModalLevel.value === 'SENIOR SECONDARY';
                    const isAll = (classModalAllDepartments && classModalAllDepartments.checked) || (classModalDepartment && classModalDepartment.value === 'ALL');
                    if (isSeniorSecondary && !isAll && (!classModalDepartment || !classModalDepartment.value)) {
                        event.preventDefault();
                        alert('Please select a department or choose to register for all 3 departments for Senior Secondary.');
                    }
                });
            }
        </script>

        <!-- bundle -->
        <script src="assets/js/vendor.min.js"></script>        <script src="assets/js/app.min.js"></script>

        <!-- third party js -->
        <script src="assets/js/vendor/jquery.dataTables.min.js"></script>
        <script src="assets/js/vendor/dataTables.bootstrap5.js"></script>
        <script src="assets/js/vendor/dataTables.responsive.min.js"></script>
        <script src="assets/js/vendor/responsive.bootstrap5.min.js"></script>
        <script src="assets/js/vendor/dataTables.checkboxes.min.js"></script>
        <!-- third party js ends -->

        <!-- demo app -->
        <script src="assets/js/pages/demo.customers.js"></script>
        <!-- end demo js-->

    </body>
</html>
