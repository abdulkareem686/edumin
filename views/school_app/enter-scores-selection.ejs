        <script>
            $(document).ready(function() {
                // Load subjects when class is selected
                $('#class-select').change(function() {
                    const classId = $(this).val();
                    const subjectSelect = $('#subjectId');
                    const loadingSpinner = $('#subjectLoading');
                    
                    if (classId) {
                        // Show loading spinner
                        loadingSpinner.show();
                        subjectSelect.prop('disabled', true);
                        
                        // Clear existing options except the first one
                        subjectSelect.find('option:not(:first)').remove();
                        
                        // Fetch subjects for the selected class
                        $.ajax({
                            url: '/api/subjects-by-class',
                            method: 'GET',
                            data: { classId: classId },
                            success: function(response) {
                                if (response.success && response.subjects.length > 0) {
                                    // Add new options
                                    response.subjects.forEach(function(subject) {
                                        subjectSelect.append($('<option>', {
                                            value: subject.id,
                                            text: subject.name
                                        }));
                                    });
                                    showNotification('Subjects loaded for selected class');
                                } else {
                                    showNotification('No subjects found for this class', 'warning');
                                }
                            },
                            error: function() {
                                showNotification('Error loading subjects', 'error');
                            },
                            complete: function() {
                                loadingSpinner.hide();
                                subjectSelect.prop('disabled', false);
                            }
                        });
                    } else {
                        // Clear subjects if no class is selected
                        subjectSelect.find('option:not(:first)').remove();
                    }
                });
                
                // Auto-submit when all fields are selected
                $('#class-select, #academicYear, #term, #subjectId').change(function() {
                    const classId = $('#class-select').val();
                    const academicYear = $('#academicYear').val();
                    const term = $('#term').val();
                    const subjectId = $('#subjectId').val();
                    
                    if (classId && academicYear && term && subjectId) {
                        $('#scoreForm').submit();
                    }
                });
                
                // Trigger change event if class is already selected on page load
                if ($('#class-select').val()) {
                    $('#class-select').trigger('change');
                }
                
                // Auto-dismiss alerts after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            });
            
            function fillCurrentAcademicYear() {
                // Set to current academic year (first option after default)
                $('#academicYear option:eq(1)').prop('selected', true);
                showNotification('Academic year set to current year');
            }
            
            function fillCurrentTerm() {
                // Set to current term (first option after default)
                $('#term option:eq(1)').prop('selected', true);
                showNotification('Term set to current term');
            }
            
            function showNotification(message, type = 'info') {
                const alertClass = type === 'error' ? 'alert-danger' : 
                                  type === 'warning' ? 'alert-warning' : 'alert-info';
                
                const notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    '<i class="fas fa-info-circle me-2"></i>' + message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                    '</div>');
                    
                $('.container-fluid').prepend(notification);
                
                // Auto-dismiss after 3 seconds
                setTimeout(function() {
                    notification.alert('close');
                }, 3000);
            }
        </script>
    </body>
</html>