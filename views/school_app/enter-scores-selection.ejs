    <style>
        .required-field::after {
            content: " *";
            color: red;
        }
        .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
        }
        .form-section-title {
            color: #3b5de7;
            border-bottom: 2px solid #3b5de7;
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
        }
        .option-icon {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.5rem;
            font-size: 1.2rem;
        }
        .loading-spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #3b5de7;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-left: 10px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .quick-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .quick-action-btn {
            flex: 1;
            background: #f8f9fa;
            border: 1px dashed #dee2e6;
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .quick-action-btn:hover {
            background: #e9ecef;
            border-color: #3b5de7;
        }
        .quick-action-icon {
            font-size: 1.5rem;
            color: #3b5de7;
            margin-bottom: 0.5rem;
        }
        .form-text {
            color: #6b7280;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
    </style>
</head>

