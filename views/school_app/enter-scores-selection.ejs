<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Enter Scores - School Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="A fully featured school management system" name="description" />
    <meta content="ThemeSelection" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        .required-field::after {
            content: " *";
            color: red;
        }
        .form-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid #e9ecef;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
        }
        .form-section-title {
            color: #3b5de7;
            border-bottom: 2px solid #3b5de7;
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
        }
        .option-icon {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.5rem;
            font-size: 1.2rem;
        }
        .loading-spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #3b5de7;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-left: 10px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .quick-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .quick-action-btn {
            flex: 1;
            background: #f8f9fa;
            border: 1px dashed #dee2e6;
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .quick-action-btn:hover {
            background: #e9ecef;
            border-color: #3b5de7;
        }
        .quick-action-icon {
            font-size: 1.5rem;
            color: #3b5de7;
            margin-bottom: 0.5rem;
        }
        .form-text {
            color: #6b7280;
            font-size: 0.875rem;
            margin-top: 0.25rem;
        }
        .teacher-info-card {
            background: linear-gradient(135deg, #3b5de7 0%, #2a4cd0 100%);
            color: white;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
        .class-badge {
            background: #e9ecef;
            color: #3b5de7;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
            display: inline-block;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <!-- Begin page -->
        <div class="wrapper">
            <!-- ========== Left Sidebar Start ========== -->
            <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/app-sidebar') %>
        <!-- Left Sidebar End -->

            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->

            <div class="content-page">
                <div class="content">
                    <!-- Topbar -->
                <%- include('partials/app-navbar') %>
                <!-- end Topbar -->
                    
                    <!-- Start Content-->
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <h4 class="page-title">
                                        <i class="mdi mdi-clipboard-list me-2"></i>Enter Student Scores
                                    </h4>
                                </div>
                            </div>
                        </div>

                        <% 
                            var isTeacher = (typeof role !== 'undefined' && role === 'teacher');
                            var isAdmin = (typeof role !== 'undefined' && role === 'admin');
                            var classOptions = isTeacher ? (teacherClasses || []) : (classes || []);
                        %>
                        <!-- Teacher / Admin Info Card -->
                        <div class="teacher-info-card">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="text-white mb-1">Welcome, <%= typeof username !== 'undefined' ? username : 'User' %>!</h5>
                                    <% if (isTeacher) { %>
                                    <p class="mb-0 text-white-50">
                                        <i class="mdi mdi-school me-1"></i> You are assigned to 
                                        <strong><%= classOptions.length %> class(es)</strong>
                                    </p>
                                    <% } else { %>
                                    <p class="mb-0 text-white-50">
                                        <i class="mdi mdi-shield-account me-1"></i>
                                        <% if (isAdmin) { %>
                                        You can enter scores for <strong>any class</strong> in this school
                                        (<%= classOptions.length %> class<%= classOptions.length === 1 ? '' : 'es' %> available).
                                        <% } else { %>
                                        Select a class from <strong><%= classOptions.length %> class(es)</strong> in this school.
                                        <% } %>
                                    </p>
                                    <% } %>
                                </div>
                                <div class="d-none d-md-block">
                                    <i class="mdi mdi-clipboard-list fs-1 text-white-50"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Success/Error Messages -->
                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                                <i class="bi bi-check-circle me-2"></i><%= success %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            Select Criteria for Score Entry
                                        </h5>
                                        
                                        <!-- Selection Form -->
                                        <form action="/enter-scores" method="GET" id="scoreForm">
                                            <div class="form-section">
                                                <h5 class="form-section-title"><i class="bi bi-funnel me-2"></i>Selection Criteria</h5>
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="mb-3">
                                                            <label class="form-label required-field">Class</label>
                                                            <select class="form-control" name="classId" id="classSelect" required>
                                                                <option value="">Select a class</option>
                                                                <% if (classOptions && classOptions.length > 0) { 
                                                                    for(var i = 0; i < classOptions.length; i++) { 
                                                                        var cls = classOptions[i]; %>
                                                                        <option value="<%= cls.id %>" 
                                                                            <%= (typeof formData !== 'undefined' && formData.classId == cls.id) ? 'selected' : '' %>>
                                                                            <%= cls.className %><%= cls.department ? ' (' + cls.department + ')' : '' %>
                                                                        </option>
                                                                <% } 
                                                                } else { %>
                                                                    <option value="" disabled><%= isTeacher ? 'No classes assigned to you' : 'No classes in this school' %></option>
                                                                <% } %>
                                                            </select>
                                                            <% if (isTeacher && classOptions.length === 0) { %>
                                                                <div class="form-text text-danger">
                                                                    <i class="bi bi-exclamation-circle me-1"></i>
                                                                    You are not assigned to any classes. Please contact the administrator.
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="col-md-4">
                                                        <div class="mb-3">
                                                            <label class="form-label required-field">Academic Year</label>
                                                            <select class="form-control" name="academicYear" id="academicYear" required>
                                                                <option value="">Select Year</option>
                                                                <% if (academicYears && academicYears.length > 0) { 
                                                                    for(var i = 0; i < academicYears.length; i++) { 
                                                                        var year = academicYears[i]; %>
                                                                        <option value="<%= year.year_name %>" 
                                                                            <%= (formData.academicYear && formData.academicYear == year.year_name) ? 'selected' : (!formData.academicYear && currentAcademicYear && year.year_name == currentAcademicYear) ? 'selected' : '' %>>
                                                                            <%= year.year_name %>
                                                                        </option>
                                                                <% } 
                                                                } else { %>
                                                                    <option value="2023-2024">2023-2024</option>
                                                                    <option value="2024-2025">2024-2025</option>
                                                                <% } %>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="col-md-4">
                                                        <div class="mb-3">
                                                            <label class="form-label required-field">Term</label>
                                                            <select class="form-control" name="term" id="term" required>
                                                                <option value="">Select Term</option>
                                                                <% if (terms && terms.length > 0) { 
                                                                    for(var i = 0; i < terms.length; i++) { 
                                                                        var termItem = terms[i]; %>
                                                                        <option value="<%= termItem.term_name %>" 
                                                                            <%= (formData.term && formData.term == termItem.term_name) ? 'selected' : (!formData.term && currentTerm && termItem.term_name == currentTerm) ? 'selected' : '' %>>
                                                                            <%= termItem.term_name %>
                                                                        </option>
                                                                <% } 
                                                                } else { %>
                                                                    <option value="First Term">First Term</option>
                                                                    <option value="Second Term">Second Term</option>
                                                                    <option value="Third Term">Third Term</option>
                                                                <% } %>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <button type="submit" class="btn btn-primary" id="continueBtn" <%= (classOptions.length === 0) ? 'disabled' : '' %>>
                                                    <i class="bi bi-arrow-right me-2"></i> Continue to Score Entry
                                                </button>
                                            </div>
                                        </form>
                                        
                                        <!-- Quick Actions -->
                                        <div class="quick-actions">
                                            <div class="quick-action-btn" onclick="fillCurrentAcademicYear()">
                                                <div class="quick-action-icon">
                                                    <i class="bi bi-lightning-charge"></i>
                                                </div>
                                                <div class="quick-action-text">Use Current Academic Year</div>
                                            </div>
                                            
                                            <div class="quick-action-btn" onclick="fillCurrentTerm()">
                                                <div class="quick-action-icon">
                                                    <i class="bi bi-lightning-charge"></i>
                                                </div>
                                                <div class="quick-action-text">Use Current Term</div>
                                            </div>
                                        </div>
                                        
                                        <!-- Information Box -->
                                        <div class="mt-4 p-3 bg-light border rounded">
                                            <h6 class="text-primary"><i class="bi bi-info-circle me-2"></i>Information</h6>
                                            <p class="text-muted mb-0">
                                                Select a class, academic year, and term to enter examination scores.
                                                <% if (isTeacher) { %>
                                                You can only select classes you are assigned to as a teacher.
                                                <% } else if (isAdmin) { %>
                                                As an administrator, you may choose any class in the school.
                                                <% } else { %>
                                                Choose a class from the list for this school.
                                                <% } %>
                                            </p>
                                        </div>
                                        
                                        <!-- Assigned / all classes quick reference -->
                                        <% if (classOptions && classOptions.length > 0) { %>
                                        <div class="mt-3 p-3 bg-white border rounded">
                                            <h6 class="text-primary">
                                                <i class="bi bi-book me-2"></i>
                                                <%= isTeacher ? 'Your Assigned Classes' : (isAdmin ? 'All Classes' : 'Classes') %>
                                            </h6>
                                            <div class="mt-2">
                                                <% for(var i = 0; i < classOptions.length; i++) { 
                                                    var cls = classOptions[i]; %>
                                                    <span class="class-badge">
                                                        <i class="bi bi-building me-1"></i> <%= cls.className %>
                                                        <% if (cls.department) { %>(<%= cls.department %>)<% } %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <% } %>
                                        
                                        <!-- Navigation Buttons -->
                                        <div class="row mt-4">
                                            <div class="col-md-12">
                                                <a href="<%= isTeacher ? '/teacher-dashboard' : '/' %>" class="btn btn-light">
                                                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                                                </a>
                                                <% if (isTeacher) { %>
                                                <a href="/teacher/my-classes" class="btn btn-outline-secondary ms-2">
                                                    <i class="bi bi-building me-1"></i> View My Classes
                                                </a>
                                                <a href="/teacher/my-subjects" class="btn btn-outline-info ms-2">
                                                    <i class="bi bi-book me-1"></i> View My Subjects
                                                </a>
                                                <% } else { %>
                                                <a href="/all-classes" class="btn btn-outline-secondary ms-2">
                                                    <i class="bi bi-building me-1"></i> All Classes
                                                </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- container -->
                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - School Management System
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="/parent/contact">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->
            </div>
        </div>
        <!-- END wrapper -->

        <!-- Right Sidebar -->
        <div class="end-bar">
            <div class="rightbar-title">
                <a href="javascript:void(0);" class="end-bar-toggle float-end">
                    <i class="dripicons-cross noti-icon"></i>
                </a>
                <h5 class="m-0">Settings</h5>
            </div>
            <div class="rightbar-content h-100" data-simplebar="">
                <!-- Settings content... -->
            </div>
        </div>
        <div class="rightbar-overlay"></div>
        <!-- /End-bar -->

        <!-- bundle -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>

        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

        <script>

            document.getElementById('scoreForm').addEventListener('submit', function (e) {
                    e.preventDefault();

                    const classId = document.getElementById('classSelect').value;
                    const academicYear = document.getElementById('academicYear').value;
                    const term = document.getElementById('term').value;

                    if (!classId || !academicYear || !term) {
                        showNotification('Please select all required fields', 'error');
                        return false;
                    }

                    // Redirect to the score entry page with the selected values
                    // This assumes you have a route that handles /enter-scores with action=enter
                    window.location.href = `/enter-scores?action=enter&classId=${classId}&term=${term}&academicYear=${academicYear}`;

                    return false;
                });
                
            $(document).ready(function() {
                // Auto-dismiss alerts after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            });
            
            function fillCurrentAcademicYear() {
                var academicYearSelect = document.getElementById('academicYear');
                if (academicYearSelect && academicYearSelect.options.length > 1) {
                    // Select first option after default
                    academicYearSelect.selectedIndex = 1;
                    showNotification('Academic year set to current year', 'info');
                } else {
                    showNotification('No academic years available', 'warning');
                }
            }
            
            function fillCurrentTerm() {
                var termSelect = document.getElementById('term');
                if (termSelect && termSelect.options.length > 1) {
                    // Select first option after default
                    termSelect.selectedIndex = 1;
                    showNotification('Term set to current term', 'info');
                } else {
                    showNotification('No terms available', 'warning');
                }
            }
            
            function showNotification(message, type) {
                type = type || 'info';
                var alertClass = type === 'error' ? 'alert-danger' : 
                                  type === 'warning' ? 'alert-warning' : 'alert-info';
                
                var notification = $('<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                    '<i class="bi bi-info-circle me-2"></i>' + message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                    '</div>');
                    
                $('.container-fluid').prepend(notification);
                
                // Auto-dismiss after 3 seconds
                setTimeout(function() {
                    notification.fadeOut('slow', function() {
                        notification.remove();
                    });
                }, 3000);
            }
        </script>
    </body>
</html>