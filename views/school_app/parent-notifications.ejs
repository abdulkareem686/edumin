<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Notifications - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .notification-card {
            transition: all 0.2s ease;
            border-radius: 12px;
            margin-bottom: 1rem;
            cursor: pointer;
        }
        .notification-card:hover {
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .notification-unread {
            background: linear-gradient(135deg, #eef2ff 0%, #ffffff 100%);
            border-left: 4px solid #3b5de7;
        }
        .notification-read {
            background: white;
            border-left: 4px solid #e9ecef;
            opacity: 0.8;
        }
        .notification-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .notification-title {
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .notification-message {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        .notification-time {
            font-size: 0.75rem;
            color: #adb5bd;
        }
        .filter-btn {
            transition: all 0.2s;
            border-radius: 20px;
            padding: 0.5rem 1.25rem;
        }
        .filter-btn.active {
            background: #3b5de7;
            color: white;
            border-color: #3b5de7;
        }
        .filter-btn:hover:not(.active) {
            background: #e9ecef;
        }
        .pagination .page-link {
            border-radius: 8px;
            margin: 0 3px;
            color: #3b5de7;
        }
        .pagination .page-item.active .page-link {
            background: #3b5de7;
            border-color: #3b5de7;
        }
        .bulk-actions {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }
        .child-card {
            cursor: pointer;
            transition: all 0.2s;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .child-card:hover {
            background: #f8fafd;
            border-color: #3b5de7;
        }
        .child-name {
            font-weight: 600;
            color: #1e293b;
        }
        .notification-unread-badge {
            background: #3b5de7;
            color: white;
            border-radius: 20px;
            padding: 0.25rem 0.75rem;
            font-size: 0.7rem;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- Left Sidebar -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/parent-sidebar') %>
        <!-- Left Sidebar End -->

        

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid">
                    <!-- Page Title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <h4 class="page-title">
                                    <i class="mdi mdi-bell me-2"></i>Notifications
                                    <% if (unreadCount > 0) { %>
                                        <span class="badge bg-danger ms-2"><%= unreadCount %> Unread</span>
                                    <% } %>
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Success Message -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Error Message -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <div class="row">
                        <!-- Sidebar with recent notifications -->
                        <div class="col-lg-3 mb-4">
                            <div class="card">
                                <div class="card-header bg-white">
                                    <h6 class="mb-0"><i class="bi bi-bell me-2 text-primary"></i>Quick Stats</h6>
                                </div>
                                <div class="card-body">
                                    <div class="text-center mb-3">
                                        <div class="display-4 fw-bold text-primary"><%= totalCount %></div>
                                        <div class="text-muted">Total Notifications</div>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Unread</span>
                                        <span class="fw-bold text-primary"><%= unreadCount %></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Read</span>
                                        <span class="fw-bold text-success"><%= totalCount - unreadCount %></span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card mt-3">
                                <div class="card-header bg-white">
                                    <h6 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recent</h6>
                                </div>
                                <div class="card-body p-2">
                                    <% if (recentNotifications && recentNotifications.length > 0) { 
                                        for(var i = 0; i < Math.min(recentNotifications.length, 5); i++) { 
                                            var notif = recentNotifications[i]; %>
                                            <div class="child-card" onclick="viewNotification(<%= notif.id %>)">
                                                <div class="d-flex">
                                                    <div class="me-2">
                                                        <i class="bi bi-bell text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <div class="child-name"><%= notif.message ? notif.message.substring(0, 40) : 'Notification' %>...</div>
                                                        <div class="text-muted small"><%= moment(notif.created_at).fromNow() %></div>
                                                    </div>
                                                </div>
                                            </div>
                                    <% } 
                                    } else { %>
                                        <div class="text-center text-muted py-3">
                                            <i class="bi bi-inbox fs-1"></i>
                                            <p class="mt-2 mb-0">No recent notifications</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Main Notifications List -->
                        <div class="col-lg-9">
                            <!-- Filter Buttons -->
                            <div class="card mb-4">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="btn-group" role="group">
                                            <a href="/parent/notifications?filter=all" class="btn filter-btn <%= currentFilter === 'all' ? 'active' : '' %>">
                                                <i class="bi bi-list-ul"></i> All
                                            </a>
                                            <a href="/parent/notifications?filter=unread" class="btn filter-btn <%= currentFilter === 'unread' ? 'active' : '' %>">
                                                <i class="bi bi-envelope"></i> Unread
                                                <% if (unreadCount > 0 && currentFilter !== 'unread') { %>
                                                    <span class="badge bg-danger ms-1"><%= unreadCount %></span>
                                                <% } %>
                                            </a>
                                            <a href="/parent/notifications?filter=read" class="btn filter-btn <%= currentFilter === 'read' ? 'active' : '' %>">
                                                <i class="bi bi-envelope-open"></i> Read
                                            </a>
                                        </div>
                                        
                                        <div class="bulk-actions">
                                            <button class="btn btn-sm btn-primary me-2" onclick="markAllRead()">
                                                <i class="bi bi-check2-all"></i> Mark All Read
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteAllRead()">
                                                <i class="bi bi-trash"></i> Delete Read
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Notifications List -->
                            <% if (notifications && notifications.length > 0) { 
                                for(var i = 0; i < notifications.length; i++) { 
                                    var notification = notifications[i]; %>
                                    <div class="card notification-card <%= !notification.is_read ? 'notification-unread' : 'notification-read' %>" 
                                         data-id="<%= notification.id %>"
                                         onclick="viewNotification(<%= notification.id %>)">
                                        <div class="card-body">
                                            <div class="d-flex">
                                                <div class="me-3">
                                                    <div class="notification-icon bg-light">
                                                        <i class="bi bi-bell text-primary"></i>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <div class="notification-title">
                                                                <%= notification.title || 'Notification' %>
                                                                <% if (!notification.is_read) { %>
                                                                    <span class="notification-unread-badge ms-2">New</span>
                                                                <% } %>
                                                            </div>
                                                            <div class="notification-message">
                                                                <%= notification.message %>
                                                            </div>
                                                            <div class="notification-time">
                                                                <i class="bi bi-clock me-1"></i>
                                                                <%= moment(notification.created_at).format('MMMM D, YYYY [at] h:mm A') %>
                                                                <span class="mx-2">•</span>
                                                                <i class="bi bi-calendar me-1"></i>
                                                                <%= moment(notification.created_at).fromNow() %>
                                                            </div>
                                                        </div>
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link text-muted" data-bs-toggle="dropdown">
                                                                <i class="bi bi-three-dots-vertical"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <% if (!notification.is_read) { %>
                                                                    <li>
                                                                        <a class="dropdown-item" href="javascript:void(0)" onclick="markRead(event, <%= notification.id %>)">
                                                                            <i class="bi bi-envelope-check me-2"></i> Mark as Read
                                                                        </a>
                                                                    </li>
                                                                <% } %>
                                                                <li>
                                                                    <a class="dropdown-item text-danger" href="javascript:void(0)" onclick="deleteNotification(event, <%= notification.id %>)">
                                                                        <i class="bi bi-trash me-2"></i> Delete
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            <% } 
                            } else { %>
                                <div class="card">
                                    <div class="card-body text-center py-5">
                                        <i class="bi bi-inbox fs-1 text-muted"></i>
                                        <h5 class="mt-3">No Notifications</h5>
                                        <p class="text-muted">You don't have any notifications at this time.</p>
                                        <% if (currentFilter !== 'all') { %>
                                            <a href="/parent/notifications?filter=all" class="btn btn-primary mt-2">
                                                <i class="bi bi-list-ul"></i> View All Notifications
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Pagination -->
                            <% if (totalPages > 1) { %>
                            <div class="d-flex justify-content-center mt-4">
                                <nav>
                                    <ul class="pagination">
                                        <% if (currentPage > 1) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="/parent/notifications?filter=<%= currentFilter %>&page=<%= currentPage - 1 %>">
                                                    <i class="bi bi-chevron-left"></i> Previous
                                                </a>
                                            </li>
                                        <% } %>
                                        
                                        <% for(var i = 1; i <= totalPages; i++) { 
                                            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                    <a class="page-link" href="/parent/notifications?filter=<%= currentFilter %>&page=<%= i %>"><%= i %></a>
                                                </li>
                                            <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                            <% } %>
                                        <% } %>
                                        
                                        <% if (currentPage < totalPages) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="/parent/notifications?filter=<%= currentFilter %>&page=<%= currentPage + 1 %>">
                                                    Next <i class="bi bi-chevron-right"></i>
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite - Parent Portal
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted text-decoration-none small">Support</a>
                            <span class="text-muted mx-1">|</span>
                            <a href="#" class="text-muted text-decoration-none small">Privacy</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <script>
        // View notification (mark as read and redirect if has link)
        function viewNotification(notificationId) {
            fetch('/parent/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                return response.json();
            }).then(function(data) {
                if (data.success) {
                    // Reload page to update counts
                    location.reload();
                }
            }).catch(function(error) {
                console.error('Error:', error);
            });
        }
        
        // Mark single notification as read
        function markRead(event, notificationId) {
            event.stopPropagation();
            
            fetch('/parent/notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            }).then(function(response) {
                return response.json();
            }).then(function(data) {
                if (data.success) {
                    showToast('Notification marked as read', 'success');
                    setTimeout(function() {
                        location.reload();
                    }, 1000);
                }
            }).catch(function(error) {
                showToast('Error marking notification as read', 'danger');
            });
        }
        
        // Mark all notifications as read
        function markAllRead() {
            if (confirm('Mark all notifications as read?')) {
                fetch('/parent/notifications/mark-all-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).then(function(response) {
                    return response.json();
                }).then(function(data) {
                    if (data.success) {
                        showToast('All notifications marked as read', 'success');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    }
                }).catch(function(error) {
                    showToast('Error marking notifications as read', 'danger');
                });
            }
        }
        
        // Delete single notification
        function deleteNotification(event, notificationId) {
            event.stopPropagation();
            
            if (confirm('Delete this notification?')) {
                fetch('/parent/notifications/delete/' + notificationId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).then(function(response) {
                    return response.json();
                }).then(function(data) {
                    if (data.success) {
                        showToast('Notification deleted', 'success');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    }
                }).catch(function(error) {
                    showToast('Error deleting notification', 'danger');
                });
            }
        }
        
        // Delete all read notifications
        function deleteAllRead() {
            if (confirm('Delete all read notifications? This action cannot be undone.')) {
                fetch('/parent/notifications/delete-all-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                }).then(function(response) {
                    return response.json();
                }).then(function(data) {
                    if (data.success) {
                        showToast('Read notifications deleted', 'success');
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    }
                }).catch(function(error) {
                    showToast('Error deleting notifications', 'danger');
                });
            }
        }
        
        // Show toast notification
        function showToast(message, type) {
            // Create toast container if not exists
            var container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                container.style.zIndex = '9999';
                document.body.appendChild(container);
            }
            
            var toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-' + type + ' border-0 fade show';
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            
            container.appendChild(toast);
            
            setTimeout(function() {
                toast.remove();
            }, 3000);
        }
        
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            for (var i = 0; i < alerts.length; i++) {
                setTimeout(function(alert) {
                    if (alert) alert.remove();
                }, 5000, alerts[i]);
            }
        }, 1000);
        
        // Poll for new notifications every 30 seconds
        function pollNewNotifications() {
            fetch('/api/parent/notifications/unread-count')
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    if (data.count > 0) {
                        // Update badge in sidebar
                        var badge = document.querySelector('.side-nav-link.active .badge');
                        if (badge) {
                            badge.textContent = data.count;
                        }
                    }
                })
                .catch(function(error) {
                    console.error('Polling error:', error);
                });
        }
        
        // Start polling every 30 seconds
        setInterval(pollNewNotifications, 30000);
    </script>
</body>
</html>