<div class="card mt-3">
    <div class="card-body">
        <h4 class="header-title mt-0 mb-3">
            <i class="mdi mdi-file-document me-1"></i> Report Card
        </h4>
        
        <hr>
        
        <div class="text-center mb-3">
            <span class="badge bg-primary">Current: <%= currentAcademicYear %> - <%= currentTerm %></span>
        </div>

        <div class="d-grid gap-2">
            <% 
            const academicYear = currentAcademicYear || `${new Date().getFullYear()-1}-${new Date().getFullYear()}`;
            // Show only the current term button
            if (currentTerm) { 
            %>
                <a href="/report-card?studentId=<%= student.id %>&academicYear=<%= academicYear %>&term=<%= currentTerm %>" 
                   class="btn btn-primary btn-sm report-card-link">
                    <i class="mdi mdi-file me-1"></i> 
                    View <%= currentTerm %> Report Card
                    <span class="badge bg-white text-primary ms-1">Current</span>
                </a>
                
                <!-- Show Session Report Card button only if current term is Third Term -->
                <% if (currentTerm === 'Third Term') { %>
                    <a href="/report-card?studentId=<%= student.id %>&academicYear=<%= academicYear %>&term=Session" 
                       class="btn btn-info btn-sm report-card-link">
                        <i class="mdi mdi-file-document me-1"></i> 
                        View <%= academicYear %> Session Report
                        <span class="badge bg-white text-info ms-1">Full Session</span>
                    </a>
                <% } %>
            <% } else { %>
                <div class="alert alert-warning text-center">
                    <i class="mdi mdi-alert-circle-outline me-1"></i>
                    No current term set. Please contact administration.
                </div>
            <% } %>
        </div>

        <!-- Academic Year Selection for other terms -->
        
                    <!-- Academic Year Selection for other terms -->
                    
                </div>
