<!-- JavaScript for Academic Year Selection -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Academic year selector functionality
    const academicYearSelector = document.getElementById('academicYearSelector');
    const otherTermsContainer = document.getElementById('otherTermsContainer');
    const termLinks = document.querySelectorAll('.term-link');

    if (academicYearSelector) {
        academicYearSelector.addEventListener('change', function() {
            const selectedYear = this.value;
            if (selectedYear) {
                // Show other terms container
                otherTermsContainer.style.display = 'block';
                
                // Update all term links with the selected academic year
                termLinks.forEach(link => {
                    const term = link.getAttribute('data-term');
                    const newHref = `/report-card?studentId=<%= student.id %>&academicYear=${selectedYear}&term=${term}`;
                    link.setAttribute('href', newHref);
                });
            } else {
                // Hide other terms container if no year selected
                otherTermsContainer.style.display = 'none';
            }
        });
    }

    // Show other terms if current year is selected on page load
    if (academicYearSelector && academicYearSelector.value) {
        otherTermsContainer.style.display = 'block';
    }
});
</script>
