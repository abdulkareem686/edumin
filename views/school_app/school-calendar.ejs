<!-- Debug information (remove this after testing) -->
<div class="alert alert-info mb-3">
    <strong>Debug Info:</strong><br>
    Total Events: <%= events.length %><br>
    Events with academic_year: <%= events.filter(e => e.academic_year).length %><br>
    Events with term: <%= events.filter(e => e.term).length %>
</div>

<div class="table-responsive">
    <table class="table table-centered table-striped dt-responsive nowrap w-100" id="products-datatable">
        <thead>
            <tr>
                <th>Date</th>
                <th>Event</th>
                <th>Description</th>
                <th>Academic Year</th>
                <th>Term</th>
                <th>Time</th>
                <th style="width: 75px;">Action</th>
            </tr>
        </thead>

        <tbody>
            <% if (events.length === 0) { %>
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No events found
                    </td>
                </tr>
            <% } %>
            
            <% events.forEach(event => { %>
            <tr>
                <td>
                    <% if (event.eventDate) { %>
                        <%= moment(event.eventDate).format('MMM D, YYYY') %>
                    <% } else { %>
                        <span class="text-muted">No date</span>
                    <% } %>
                </td>
                <td>
                    <%= event.title || 'No title' %>
                </td>
                <td>
                    <%= event.description || 'No description' %>
                </td>
                <td>
                    <% if (event.academic_year) { %>
                        <span class="badge bg-primary"><%= event.academic_year %></span>
                    <% } else { %>
                        <span class="text-muted">Not set</span>
                    <% } %>
                </td>
                <td>
                    <% if (event.term) { %>
                        <span class="badge bg-info"><%= event.term %></span>
                    <% } else { %>
                        <span class="text-muted">Not set</span>
                    <% } %>
                </td>
                <td>
                    <% if (event.startTime) { %>
                        <%= event.startTime.substring(0, 5) %>
                        <% if (event.endTime) { %>
                            - <%= event.endTime.substring(0, 5) %>
                        <% } %>
                    <% } else { %>
                        All day
                    <% } %>
                </td>
                <td>
                    <a href="/edit-event/<%= event.id %>" class="action-icon" title="Edit"> 
                        <i class="mdi mdi-square-edit-outline"></i>
                    </a>
                    <a href="/delete-event/<%= event.id %>" class="action-icon" title="Delete" onclick="return confirm('Are you sure you want to delete this event?')"> 
                        <i class="mdi mdi-delete"></i>
                    </a>
                </td>
            </tr>
            <% }); %> 
        </tbody>
    </table>
</div>

<!-- JavaScript for filtering -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const academicYearFilter = document.getElementById('academicYearFilter');
    const termFilter = document.getElementById('termFilter');
    
    function applyFilters() {
        const academicYear = academicYearFilter.value;
        const term = termFilter.value;
        
        let url = '/school-calendar?';
        if (academicYear) url += `academicYear=${encodeURIComponent(academicYear)}&`;
        if (term) url += `term=${encodeURIComponent(term)}`;
        
        // Remove trailing & or ? if no params
        url = url.replace(/[&?]$/, '');
        
        window.location.href = url;
    }
    
    academicYearFilter.addEventListener('change', applyFilters);
    termFilter.addEventListener('change', applyFilters);
});
</script>
