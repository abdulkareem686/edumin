                <select class="form-control" id="academicYearFilter">
                    <option value="">All Academic Years</option>
                    <% academicYears.forEach(year => { %>
                        <option value="<%= year.academic_year %>" 
                            <%= selectedAcademicYear === year.academic_year ? 'selected' : '' %>>
                            <%= year.academic_year %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-6">
                <select class="form-control" id="termFilter">
                    <option value="">All Terms</option>
                    <% terms.forEach(term => { %>
                        <option value="<%= term.term %>" 
                            <%= selectedTerm === term.term ? 'selected' : '' %>>
                            <%= term.term %>
                        </option>
                    <% }); %>
                </select>
            </div>
        </div>
    </div>
    
