<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Student Academic Record - <%= student.firstName %> <%= student.middleName ? student.middleName + ' ' : '' %><%= student.lastName %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="School Management System" name="description">
    <meta content="EduSuite" name="author">
    <link rel="shortcut icon" href="/images/favicon.png">

    <!-- third party css -->
    <link href="/assets/css/vendor/dataTables.bootstrap5.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/vendor/responsive.bootstrap5.css" rel="stylesheet" type="text/css">
    
    <!-- App css -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
        .info-item {
            margin-bottom: 1rem;
            padding: 0.5rem 0;
            border-bottom: 1px solid #e9ecef;
        }
        
        .info-label {
            font-weight: 600;
            color: #6c757d;
            width: 120px;
            display: inline-block;
        }
        
        .info-value {
            color: #2c3e50;
            font-weight: 500;
        }
        
        .badge-level {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }
        
        .badge-department {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
        }
        
        .score-cell {
            text-align: center;
            font-weight: 500;
        }
        
        .high-score {
            color: #28a745;
            font-weight: 700;
        }
        
        .medium-score {
            color: #fd7e14;
            font-weight: 600;
        }
        
        .low-score {
            color: #dc3545;
            font-weight: 600;
        }
        
        .summary-row {
            background-color: #f8f9fa;
            font-weight: 600;
        }
        
        .session-table tfoot tr {
            background-color: #e9ecef;
        }
        
        .action-buttons .btn {
            margin-right: 0.5rem;
        }
        
        .print-btn {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
            color: white;
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .print-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
            color: white;
        }
        
        @media print {
            .sidebar, .navbar-custom, .footer, .action-buttons, .print-btn, .btn-secondary {
                display: none !important;
            }
            .card {
                box-shadow: none;
                border: 1px solid #dee2e6;
            }
            .content-page {
                margin-left: 0 !important;
                padding: 0 !important;
            }
        }
        
        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
        }
        
        .table tfoot td {
            background-color: #f8f9fa;
            font-weight: 600;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <!-- Begin page -->
    <div class="wrapper">
        <!-- ========== Left Sidebar Start ========== -->
        <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/admin-sidebar') %>
        <!-- Left Sidebar End -->

        <!-- ============================================================== -->
        <!-- Start Page Content here -->
        <!-- ============================================================== -->

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/admin-navbar') %>
                <!-- end Topbar -->

                <!-- Start Content-->
                <div class="container-fluid">
                    
                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                                        <li class="breadcrumb-item"><a href="/student-records">Student Records</a></li>
                                        <li class="breadcrumb-item active">Student Record</li>
                                    </ol>
                                </div>
                                <h4 class="page-title">Student Academic Record</h4>
                            </div>
                        </div>
                    </div>     
                    <!-- end page title --> 

                    <!-- Alert Messages -->
                    <% if (success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>
                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-alert-circle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Student Information Card -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="header-title">
                                            <i class="mdi mdi-account-details me-2 text-primary"></i>
                                            Student Information
                                        </h4>
                                        <div class="action-buttons">
                                            <a href="/all-students" class="btn btn-secondary">
                                                <i class="mdi mdi-arrow-left me-1"></i> Back to List
                                            </a>
                                            <button onclick="window.print()" class="btn print-btn">
                                                <i class="mdi mdi-printer me-1"></i> Print Record
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <span class="info-label">Full Name:</span>
                                                <span class="info-value"><strong><%= student.firstName %> <%= student.middleName || '' %> <%= student.lastName %></strong></span>
                                            </div>
                                            <div class="info-item">
                                                <span class="info-label">Admission No:</span>
                                                <span class="info-value"><%= student.admission_number || 'N/A' %></span>
                                            </div>
                                            <div class="info-item">
                                                <span class="info-label">Class:</span>
                                                <span class="info-value"><%= student.className || 'Not Assigned' %></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <span class="info-label">Level:</span>
                                                <span class="info-value"><span class="badge-level"><%= student.level || 'N/A' %></span></span>
                                            </div>
                                            <% if (student.department) { %>
                                                <div class="info-item">
                                                    <span class="info-label">Department:</span>
                                                    <span class="info-value"><span class="badge-department"><%= student.department %></span></span>
                                                </div>
                                            <% } %>
                                            <div class="info-item">
                                                <span class="info-label">Gender:</span>
                                                <span class="info-value"><%= student.gender || 'N/A' %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Term Selection Card -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="header-title mb-3">
                                        <i class="mdi mdi-filter me-2 text-primary"></i>
                                        Select Academic Period
                                    </h4>
                                    
                                    <form action="/student-records/<%= student.id %>" method="GET">
                                        <div class="row g-3">
                                            <div class="col-md-5">
                                                <label class="form-label">Academic Year</label>
                                                <select class="form-select" name="academicYear" required>
                                                    <option value="">Select Academic Year</option>
                                                    <% academicYears.forEach(year => { %>
                                                        <option value="<%= year.year_name %>" <%= selectedYear === year.year_name ? 'selected' : '' %>>
                                                            <%= year.year_name %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-5">
                                                <label class="form-label">Term</label>
                                                <select class="form-select" name="term" required>
                                                    <option value="">Select Term</option>
                                                    <% if (terms && terms.length > 0) { %>
                                                        <% terms.forEach(term => { %>
                                                            <option value="<%= term.term_name %>" <%= selectedTerm === term.term_name ? 'selected' : '' %>>
                                                                <%= term.term_name %>
                                                            </option>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <option value="First Term">First Term</option>
                                                        <option value="Second Term">Second Term</option>
                                                        <option value="Third Term">Third Term</option>
                                                    <% } %>
                                                    <option value="session" <%= selectedTerm === 'session' ? 'selected' : '' %>>Session Summary</option>
                                                </select>
                                            </div>
                                            <div class="col-md-2 d-flex align-items-end">
                                                <button type="submit" class="btn btn-primary w-100">
                                                    <i class="mdi mdi-eye me-1"></i> View
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (selectedTerm === 'session') { %>
                        <!-- Session Summary -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h4 class="header-title">
                                                <i class="mdi mdi-chart-line me-2 text-primary"></i>
                                                Session Summary - <%= selectedYear %>
                                            </h4>
                                            <span class="badge bg-primary fs-6 p-2">Overall Average: <%= totalAverage %>%</span>
                                        </div>
                                        
                                        <div class="table-responsive">
                                            <table class="table table-centered table-bordered table-hover mb-0" id="session-table">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Subject</th>
                                                        <th class="text-center">First Term</th>
                                                        <th class="text-center">Second Term</th>
                                                        <th class="text-center">Third Term</th>
                                                        <th class="text-center">Average</th>
                                                        <th class="text-center">Grade</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (sessionRecord && sessionRecord.length > 0) { 
                                                        sessionRecord.forEach(subject => { %>
                                                        <tr>
                                                            <td><strong><%= subject.subject_name %></strong></td>
                                                            <td class="text-center score-cell <%= subject.firstTerm >= 50 ? 'high-score' : 'low-score' %>"><%= subject.firstTerm %></td>
                                                            <td class="text-center score-cell <%= subject.secondTerm >= 50 ? 'high-score' : 'low-score' %>"><%= subject.secondTerm %></td>
                                                            <td class="text-center score-cell <%= subject.thirdTerm >= 50 ? 'high-score' : 'low-score' %>"><%= subject.thirdTerm %></td>
                                                            <td class="text-center fw-bold <%= subject.average >= 50 ? 'high-score' : 'low-score' %>"><%= subject.average %></td>
                                                            <td class="text-center">
                                                                <% 
                                                                    let grade = 'F';
                                                                    let gradeClass = 'low-score';
                                                                    if (subject.average >= 80) {
                                                                        grade = 'A';
                                                                        gradeClass = 'high-score';
                                                                    } else if (subject.average >= 70) {
                                                                        grade = 'B';
                                                                        gradeClass = 'high-score';
                                                                    } else if (subject.average >= 60) {
                                                                        grade = 'C';
                                                                        gradeClass = 'medium-score';
                                                                    } else if (subject.average >= 50) {
                                                                        grade = 'D';
                                                                        gradeClass = 'medium-score';
                                                                    } else if (subject.average >= 40) {
                                                                        grade = 'E';
                                                                        gradeClass = 'low-score';
                                                                    }
                                                                %>
                                                                <span class="fw-bold <%= gradeClass %>"><%= grade %></span>
                                                            </td>
                                                        </tr>
                                                    <% }); 
                                                    } else { %>
                                                        <tr>
                                                            <td colspan="6" class="text-center text-muted py-4">
                                                                <i class="mdi mdi-file-document-outline fs-1"></i>
                                                                <p class="mt-2 mb-0">No session records available</p>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                                <% if (sessionRecord && sessionRecord.length > 0) { %>
                                                <tfoot>
                                                    <tr class="table-light">
                                                        <td colspan="4" class="text-end fw-bold">Overall Average:</td>
                                                        <td class="text-center fw-bold high-score"><%= totalAverage %>%</td>
                                                        <td class="text-center">
                                                            <% 
                                                                let overallGrade = 'F';
                                                                let overallGradeClass = 'low-score';
                                                                if (totalAverage >= 80) {
                                                                    overallGrade = 'A';
                                                                    overallGradeClass = 'high-score';
                                                                } else if (totalAverage >= 70) {
                                                                    overallGrade = 'B';
                                                                    overallGradeClass = 'high-score';
                                                                } else if (totalAverage >= 60) {
                                                                    overallGrade = 'C';
                                                                    overallGradeClass = 'medium-score';
                                                                } else if (totalAverage >= 50) {
                                                                    overallGrade = 'D';
                                                                    overallGradeClass = 'medium-score';
                                                                } else if (totalAverage >= 40) {
                                                                    overallGrade = 'E';
                                                                    overallGradeClass = 'low-score';
                                                                }
                                                            %>
                                                            <span class="fw-bold <%= overallGradeClass %>"><%= overallGrade %></span>
                                                        </td>
                                                    </tr>
                                                    <tr class="table-light">
                                                        <td colspan="4" class="text-end fw-bold">Percentage:</td>
                                                        <td colspan="2" class="text-center fw-bold"><%= percentage %>%</td>
                                                    </tr>
                                                </tfoot>
                                                <% } %>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Term Scores -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h4 class="header-title mb-3">
                                            <i class="mdi mdi-book-open-variant me-2 text-primary"></i>
                                            <%= selectedTerm %> Scores - <%= selectedYear %>
                                        </h4>
                                        
                                        <div class="table-responsive">
                                            <table class="table table-centered table-bordered table-hover mb-0" id="scores-table">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Subject</th>
                                                        <th class="text-center">Test Score (40%)</th>
                                                        <th class="text-center">Exam Score (60%)</th>
                                                        <th class="text-center">Total Score (100%)</th>
                                                        <th class="text-center">Grade</th>
                                                        <th>Remark</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (scores && scores.length > 0) { 
                                                        scores.forEach(score => { 
                                                            const totalScore = score.total_score || 0;
                                                            let grade = 'F';
                                                            let gradeClass = 'low-score';
                                                            let remark = 'Fail';
                                                            if (totalScore >= 80) {
                                                                grade = 'A';
                                                                gradeClass = 'high-score';
                                                                remark = 'Excellent';
                                                            } else if (totalScore >= 70) {
                                                                grade = 'B';
                                                                gradeClass = 'high-score';
                                                                remark = 'Very Good';
                                                            } else if (totalScore >= 60) {
                                                                grade = 'C';
                                                                gradeClass = 'medium-score';
                                                                remark = 'Good';
                                                            } else if (totalScore >= 50) {
                                                                grade = 'D';
                                                                gradeClass = 'medium-score';
                                                                remark = 'Fair';
                                                            } else if (totalScore >= 40) {
                                                                grade = 'E';
                                                                gradeClass = 'low-score';
                                                                remark = 'Pass';
                                                            }
                                                        %>
                                                        <tr>
                                                            <td><strong><%= score.subject_name %></strong></td>
                                                            <td class="text-center"><%= score.test_score || 0 %></td>
                                                            <td class="text-center"><%= score.exam_score || 0 %></td>
                                                            <td class="text-center fw-bold <%= gradeClass %>"><%= totalScore %></td>
                                                            <td class="text-center">
                                                                <span class="fw-bold <%= gradeClass %>"><%= grade %></span>
                                                            </td>
                                                            <td><%= remark %></td>
                                                        </tr>
                                                    <% }); 
                                                    } else { %>
                                                        <tr>
                                                            <td colspan="6" class="text-center text-muted py-4">
                                                                <i class="mdi mdi-file-document-outline fs-1"></i>
                                                                <p class="mt-2 mb-0">No scores available for <%= selectedTerm %> term</p>
                                                                <small>Scores will appear once entered by the teacher</small>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                                <% if (scores && scores.length > 0) { %>
                                                <tfoot>
                                                    <tr class="table-light">
                                                        <td colspan="3" class="text-end fw-bold">Term Average:</td>
                                                        <td class="text-center fw-bold high-score"><%= termAverage %>%</td>
                                                        <td colspan="2"></td>
                                                    </tr>
                                                    <tr class="table-light">
                                                        <td colspan="3" class="text-end fw-bold">Term Percentage:</td>
                                                        <td colspan="3" class="text-center fw-bold"><%= termPercentage %>%</td>
                                                    </tr>
                                                </tfoot>
                                                <% } %>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    
                </div> <!-- container -->
            </div> <!-- content -->

            <!-- Footer Start -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            <script>document.write(new Date().getFullYear())</script> &copy; EduSuite
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end footer-links d-none d-md-block">
                                <a href="javascript: void(0);">About</a>
                                <a href="javascript: void(0);">Support</a>
                                <a href="javascript: void(0);">Contact</a>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->

        </div>

        <!-- ============================================================== -->
        <!-- End Page content -->
        <!-- ============================================================== -->

    </div>
    <!-- END wrapper -->

    <!-- Right Sidebar -->
    <div class="end-bar">
        <div class="rightbar-title">
            <a href="javascript:void(0);" class="end-bar-toggle float-end">
                <i class="dripicons-cross noti-icon"></i>
            </a>
            <h5 class="m-0">Settings</h5>
        </div>
        <div class="rightbar-content h-100" data-simplebar="">
            <div class="p-3">
                <div class="alert alert-warning" role="alert">
                    <strong>Customize</strong> the overall color scheme, sidebar menu, etc.
                </div>
                <h5 class="mt-3">Color Scheme</h5>
                <hr class="mt-1">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked="">
                    <label class="form-check-label" for="light-mode-check">Light Mode</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                    <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
                </div>
                <div class="d-grid mt-4">
                    <button class="btn btn-primary" id="resetBtn">Reset to Default</button>
                </div>
            </div>
        </div>
    </div>
    <div class="rightbar-overlay"></div>
    <!-- /End-bar -->

    <!-- bundle -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    
    <!-- third party js -->
    <script src="/assets/js/vendor/jquery.dataTables.min.js"></script>
    <script src="/assets/js/vendor/dataTables.bootstrap5.js"></script>
    <script src="/assets/js/vendor/dataTables.responsive.min.js"></script>
    <script src="/assets/js/vendor/responsive.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize DataTables for the tables
            if ($('#session-table').length && $('#session-table tbody tr').length > 1) {
                $('#session-table').DataTable({
                    responsive: true,
                    pageLength: 25,
                    ordering: false,
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    }
                });
            }
            
            if ($('#scores-table').length && $('#scores-table tbody tr').length > 1) {
                $('#scores-table').DataTable({
                    responsive: true,
                    pageLength: 25,
                    ordering: false,
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    }
                });
            }
            
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
</body>
</html>