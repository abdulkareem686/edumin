<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Parent Dashboard | EduSuite</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Core Icons & Styles -->
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link href="/assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
    <link href="/assets/css/school-dashboard.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body class="loading"
    data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <!-- Left Sidebar -->
        <%- include('partials/parent-sidebar') %>

        <div class="content-page">
            <div class="content">
                <!-- Topbar -->
                <%- include('partials/parent-navbar') %>
                <!-- end Topbar -->

                <div class="container-fluid edu-dashboard pt-3 pb-4">

                    <!-- Welcome Message Banner -->
                    <% if (typeof welcomeMessage !== 'undefined' && welcomeMessage) { %>
                        <div class="alert alert-primary alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-start mb-3" role="alert">
                            <i class="mdi mdi-star-circle fs-4 me-2"></i>
                            <div class="flex-grow-1">
                                <strong>Welcome back!</strong> <%= welcomeMessage %>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Alerts -->
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
                            <i class="mdi mdi-check-circle me-2"></i> <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
                            <i class="mdi mdi-alert-circle me-2"></i> <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>

                    <!-- Page Header Breadcrumb -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="page-title-box d-flex align-items-center justify-content-between">
                                <h4 class="page-title mb-0" style="font-family: 'Outfit', sans-serif; font-weight: 700;">
                                    <i class="mdi mdi-account-heart-outline me-2 text-primary"></i> Parent Dashboard
                                </h4>
                                <div class="page-title-right d-none d-md-block">
                                    <span class="text-muted small">
                                        <i class="mdi mdi-clock-outline me-1"></i>
                                        <%= moment().format('dddd, MMMM D, YYYY') %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hero Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="edu-dash-hero-inner p-4 rounded-4 text-white shadow-sm"
                                style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #4338ca 100%);">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                <i class="mdi mdi-account-heart me-1"></i> PARENT PORTAL
                                            </span>
                                        </div>
                                        <h2 class="text-white mb-2 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                            Welcome back, <%= typeof parentName !== 'undefined' && parentName ? parentName : 'Parent' %>!
                                        </h2>
                                        <p class="mb-0 text-white-50" style="max-width: 620px; font-size: 0.95rem;">
                                            Track academic progress, attendance, fees and school communications — all in one place.
                                        </p>
                                    </div>

                                    <!-- Hero Badges -->
                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <div class="school-week-hero-pill shadow-sm">
                                            <span class="pulse-indicator"></span>
                                            <i class="mdi mdi-calendar-clock text-warning"></i>
                                            <span class="fw-bold"><%= typeof weekLabel !== 'undefined' && weekLabel ? weekLabel : 'Week 1' %></span>
                                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill ms-1" style="font-size: 0.725rem;">
                                                <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                            </span>
                                        </div>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-calendar-range me-1 text-info"></i>
                                            <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : 'N/A' %>
                                        </span>

                                        <span class="badge bg-white bg-opacity-15 text-white px-3 py-2 rounded-pill border border-white border-opacity-20 shadow-sm" style="font-size: 0.8125rem;">
                                            <i class="mdi mdi-book-open-page-variant me-1 text-success"></i>
                                            <%= typeof currentTerm !== 'undefined' ? currentTerm : 'N/A' %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current School Week & Term Calculation Widget -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="school-week-card">
                                <div class="school-week-header">
                                    <h5 class="school-week-header-title">
                                        <i class="mdi mdi-calculator-variant-outline"></i>
                                        Academic Term & School Week Engine
                                    </h5>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (typeof weekStartDate !== 'undefined' && weekStartDate) { %>
                                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill border">
                                                <i class="mdi mdi-calendar-check text-primary me-1"></i>
                                                This Week: <strong><%= weekStartDate %> – <%= typeof weekEndDate !== 'undefined' ? weekEndDate : '' %></strong>
                                            </span>
                                        <% } %>
                                        <span class="week-status-badge">
                                            <i class="mdi mdi-check-circle"></i> <%= typeof termWeekStatusBadge !== 'undefined' ? termWeekStatusBadge : 'In Session' %>
                                        </span>
                                    </div>
                                </div>

                                <div class="school-week-body">
                                    <div class="row align-items-center g-4">
                                        <div class="col-lg-5">
                                            <div class="week-display-banner m-0">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <div class="week-display-label text-uppercase">Current Term Progress</div>
                                                        <div class="week-display-number">
                                                            <%= typeof shortWeekLabel !== 'undefined' && shortWeekLabel ? shortWeekLabel : ('Week ' + (typeof currentWeek !== 'undefined' ? currentWeek : 1)) %>
                                                        </div>
                                                        <div class="text-white-50 small">
                                                            Out of <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %> academic weeks in <%= typeof currentTerm !== 'undefined' ? currentTerm : 'Term' %>
                                                        </div>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="fs-1 fw-bold text-white"><%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%</span>
                                                        <div class="text-white-50 small">Elapsed</div>
                                                    </div>
                                                </div>

                                                <div class="school-week-progress-wrap mt-3 mb-0">
                                                    <div class="school-week-progress-bar">
                                                        <div class="school-week-progress-fill" style="width: <%= typeof termProgress !== 'undefined' ? termProgress : 0 %>%;"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-7">
                                            <div class="school-week-metrics-grid">
                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-primary">
                                                        <%= typeof daysPassed !== 'undefined' ? daysPassed : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Passed</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-success">
                                                        <%= typeof daysRemaining !== 'undefined' ? daysRemaining : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Days Remaining</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-info">
                                                        <%= typeof totalWeeks !== 'undefined' ? totalWeeks : 12 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Total Term Weeks</div>
                                                </div>

                                                <div class="school-week-metric-tile">
                                                    <div class="school-week-metric-val text-warning">
                                                        <%= typeof totalDays !== 'undefined' ? totalDays : 0 %>
                                                    </div>
                                                    <div class="school-week-metric-lbl">Total Term Days</div>
                                                </div>
                                            </div>

                                            <div class="mt-3 px-2 d-flex justify-content-between align-items-center text-muted small">
                                                <span>
                                                    <i class="mdi mdi-calendar-start me-1"></i> Term Start:
                                                    <strong><%= typeof termStartDate !== 'undefined' && termStartDate ? moment(termStartDate).format('MMM D, YYYY') : 'Configured in Settings' %></strong>
                                                </span>
                                                <span>
                                                    <i class="mdi mdi-calendar-end me-1"></i> Term End:
                                                    <strong><%= typeof termEndDate !== 'undefined' && termEndDate ? moment(termEndDate).format('MMM D, YYYY') : 'Configured in Settings' %></strong>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Core KPI Stat Cards -->
                    <div class="row g-3 mb-4">
                        <!-- Today's Attendance -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-green h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Today's Attendance</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof todayAttendance !== 'undefined' ? todayAttendance : 0 %>
                                        </h2>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-account-check-outline me-1"></i> Present Today
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-calendar-check-outline"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pending Fees -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-rose h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Pending Fees</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            ₦<%= typeof pendingFees !== 'undefined' ? pendingFees.toLocaleString() : 0 %>
                                        </h2>
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-cash-clock me-1"></i> Outstanding Balance
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-cash-multiple"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Class Average Score -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-blue h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Class Avg. Score</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof overallAverage !== 'undefined' ? overallAverage.toFixed(1) : 0 %>%
                                        </h2>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-chart-line me-1"></i> This Term
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-chart-box-outline"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Unread Notifications -->
                        <div class="col-xl-3 col-md-6">
                            <div class="stat-kpi-modern kpi-amber h-100">
                                <div class="kpi-indicator-bar"></div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <p class="text-muted mb-1 text-uppercase small fw-semibold">Notifications</p>
                                        <h2 class="mb-1 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">
                                            <%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %>
                                        </h2>
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-2 py-1 small">
                                            <i class="mdi mdi-bell-ring-outline me-1"></i> Unread Alerts
                                        </span>
                                    </div>
                                    <div class="kpi-icon-chip">
                                        <i class="mdi mdi-bell-outline"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Summary & Operations -->
                    <div class="row g-3">
                        <div class="col-xl-8">
                            <!-- Academic & Fee Summary -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 pb-2 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-chart-box-outline me-2 text-primary"></i> Academic & Fee Summary
                                    </h5>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                                        <i class="mdi mdi-calendar-check me-1"></i> <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : 'N/A' %> · <%= typeof currentTerm !== 'undefined' ? currentTerm : 'N/A' %>
                                    </span>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-4" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle p-3" style="background: rgba(16, 185, 129, 0.2);">
                                                        <i class="mdi mdi-account-check-outline fs-2 text-success"></i>
                                                    </div>
                                                    <div>
                                                        <h2 class="mb-0 fw-bold text-success" style="font-family: 'Outfit', sans-serif;">
                                                            <%= typeof totalPresent !== 'undefined' ? totalPresent : 0 %>
                                                        </h2>
                                                        <p class="text-muted mb-0 small fw-semibold">
                                                            Present · <span class="text-danger"><%= typeof totalAbsent !== 'undefined' ? totalAbsent : 0 %></span> Absent · <span class="text-warning"><%= typeof totalLate !== 'undefined' ? totalLate : 0 %></span> Late
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-4" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle p-3" style="background: rgba(79, 70, 229, 0.2);">
                                                        <i class="mdi mdi-cash-check fs-2 text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h2 class="mb-0 fw-bold text-primary" style="font-family: 'Outfit', sans-serif;">
                                                            ₦<%= typeof totalPaid !== 'undefined' ? totalPaid.toLocaleString() : 0 %>
                                                        </h2>
                                                        <p class="text-muted mb-0 small fw-semibold">
                                                            Paid · <span class="text-danger">₦<%= typeof totalDue !== 'undefined' ? totalDue.toLocaleString() : 0 %></span> Due
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Recent Activity Card -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-history me-2 text-info"></i> Recent Activities
                                    </h5>
                                    <span class="badge bg-light text-muted border px-2 py-1 small">Live Feed</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="border-0 ps-4 py-3"><i class="mdi mdi-text me-1 text-muted"></i> Activity Description</th>
                                                    <th class="border-0 text-end pe-4 py-3"><i class="mdi mdi-clock me-1 text-muted"></i> When</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof activities !== 'undefined' && activities && activities.length > 0) {
                                                    for (var i = 0; i < activities.length; i++) {
                                                        var activity = activities[i]; %>
                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <i class="mdi mdi-<%= activity.icon || 'check-circle' %> text-success me-2 fs-5 align-middle"></i>
                                                                <span class="align-middle fw-medium"><%= activity.description || 'Activity' %></span>
                                                            </td>
                                                            <td class="text-end text-muted pe-4 py-3 small">
                                                                <i class="mdi mdi-clock-outline me-1"></i>
                                                                <%= activity.time || 'Just now' %>
                                                            </td>
                                                        </tr>
                                                    <% }
                                                } else { %>
                                                    <tr>
                                                        <td colspan="2" class="text-center text-muted py-5">
                                                            <i class="mdi mdi-inbox-outline d-block fs-1 mb-2 opacity-50"></i>
                                                            <p class="mb-0 fw-medium">No recent activities recorded yet</p>
                                                            <small>Activities will appear here as they happen</small>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar Column -->
                        <div class="col-xl-4">
                            <!-- Operational Pulse -->
                            <div class="card edu-card-modern mb-3">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                            <i class="mdi mdi-speedometer me-2 text-warning"></i> Operational Pulse
                                        </h5>
                                        <small class="text-muted"><%= typeof currentTerm !== 'undefined' ? currentTerm : 'Term' %> Metrics</small>
                                    </div>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                                        <%= typeof shortWeekLabel !== 'undefined' ? shortWeekLabel : 'Week 1' %>
                                    </span>
                                </div>
                                <div class="card-body px-4 pt-1">
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-calendar-check me-2 text-success"></i> Attendance Rate</span>
                                        <span class="fw-bold bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small">
                                            <%= typeof attendanceRate !== 'undefined' ? attendanceRate : 0 %>%
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-chart-line me-2 text-info"></i> Average Score</span>
                                        <span class="fw-bold bg-info bg-opacity-10 text-info px-3 py-1 rounded-pill small">
                                            <%= typeof overallAverage !== 'undefined' ? overallAverage.toFixed(1) : 0 %>%
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="text-muted"><i class="mdi mdi-cash me-2 text-danger"></i> Outstanding Fees</span>
                                        <span class="fw-bold bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill small">
                                            ₦<%= typeof pendingFees !== 'undefined' ? pendingFees.toLocaleString() : 0 %>
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <span class="text-muted"><i class="mdi mdi-bell-outline me-2 text-primary"></i> Unread Alerts</span>
                                        <span class="fw-bold bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small">
                                            <%= typeof unreadCount !== 'undefined' ? unreadCount : 0 %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Notifications Card -->
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-bell me-2 text-danger"></i> Notifications
                                    </h5>
                                    <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                                        <span class="badge bg-danger rounded-pill px-3 py-1 small"><%= unreadCount %> new</span>
                                    <% } %>
                                </div>
                                <div class="card-body px-4 pt-2">
                                    <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) {
                                        var notifLimit = Math.min(notifications.length, 5);
                                        for (var i = 0; i < notifLimit; i++) {
                                            var notification = notifications[i]; %>
                                            <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom <%= !notification.is_read ? '' : 'opacity-75' %>">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center <%= !notification.is_read ? 'text-primary' : 'text-muted' %>"
                                                     style="width: 40px; height: 40px; background: <%= !notification.is_read ? 'rgba(79,70,229,0.12)' : 'rgba(100,116,139,0.1)' %>; flex-shrink: 0;">
                                                    <i class="mdi mdi-bell-outline"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <p class="mb-1 small fw-medium text-dark">
                                                        <%= notification.message || 'Notification' %>
                                                    </p>
                                                    <small class="text-muted">
                                                        <i class="mdi mdi-clock-outline me-1"></i>
                                                        <%= notification.formatted_date || 'Just now' %>
                                                    </small>
                                                </div>
                                                <% if (!notification.is_read) { %>
                                                    <button class="btn btn-sm btn-link text-primary p-0" onclick="markRead(<%= notification.id %>)" title="Mark as read">
                                                        <i class="mdi mdi-check-circle-outline fs-5"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        <% }
                                    } else { %>
                                        <div class="text-center text-muted py-4">
                                            <i class="mdi mdi-bell-off-outline fs-1 mb-2 d-block opacity-50"></i>
                                            <p class="mb-0 small fw-medium">No notifications yet</p>
                                        </div>
                                    <% } %>
                                    <a href="/parent/notifications" class="btn btn-sm btn-outline-primary w-100 mt-1">
                                        <i class="mdi mdi-arrow-right me-1"></i> View All Notifications
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions Grid -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card edu-card-modern">
                                <div class="card-header bg-white border-0 pt-3 pb-1 px-4">
                                    <h5 class="mb-0 fw-bold" style="font-family: 'Outfit', sans-serif;">
                                        <i class="mdi mdi-lightning-bolt me-2 text-warning"></i> Quick Actions
                                    </h5>
                                    <small class="text-muted">Fast shortcuts to your most common tasks</small>
                                </div>
                                <div class="card-body px-4 pt-2 pb-4">
                                    <div class="row g-3">
                                        <div class="col-lg-3 col-md-6">
                                            <a href="/parent/children" class="modern-action-tile">
                                                <div class="modern-action-icon" style="background: rgba(79, 70, 229, 0.12); color: #4f46e5;">
                                                    <i class="mdi mdi-account-child-circle"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">All Children</div>
                                                    <small class="text-muted">Hub for All Child Operations</small>
                                                </div>
                                            </a>
                                        </div>

                                        <div class="col-lg-3 col-md-6">
                                            <a href="/parent/children?select=payment" class="modern-action-tile">
                                                <div class="modern-action-icon" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;">
                                                    <i class="mdi mdi-credit-card-outline"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Pay School Fees</div>
                                                    <small class="text-muted">Full (1x) or Half (2x)</small>
                                                </div>
                                            </a>
                                        </div>

                                        <div class="col-lg-3 col-md-6">
                                            <a href="/parent/children?select=reports" class="modern-action-tile">
                                                <div class="modern-action-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                                                    <i class="mdi mdi-file-document-outline"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Report Cards</div>
                                                    <small class="text-muted">Term Results & Analytics</small>
                                                </div>
                                            </a>
                                        </div>

                                        <div class="col-lg-3 col-md-6">
                                            <a href="/parent/children?select=attendance" class="modern-action-tile">
                                                <div class="modern-action-icon" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
                                                    <i class="mdi mdi-calendar-month"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Attendance</div>
                                                    <small class="text-muted">Daily & Term Overview</small>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Main Content End -->

                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6 text-muted">
                                &copy; <%= new Date().getFullYear() %> EduSuite School Management Platform
                            </div>
                            <div class="col-md-6 text-md-end text-muted">
                                Academic Year <%= typeof currentAcademicYear !== 'undefined' ? currentAcademicYear : 'N/A' %> · <%= typeof currentTerm !== 'undefined' ? currentTerm : 'N/A' %>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    </div>
    <!-- End wrapper -->

    <!-- Vendor Scripts -->
    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
    <script>
        function markRead(notificationId) {
            fetch('/api/parent-notifications/mark-read/' + notificationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (data.success) location.reload();
                })
                .catch(function (error) { console.error('Error:', error); });
        }

        function markAllRead() {
            if (confirm('Mark all notifications as read?')) {
                fetch('/api/parent-notifications/mark-all-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                    .then(function (response) { return response.json(); })
                    .then(function (data) { if (data.success) location.reload(); })
                    .catch(function (error) { console.error('Error:', error); });
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            for (var i = 0; i < tooltips.length; i++) {
                new bootstrap.Tooltip(tooltips[i]);
            }
        });
    </script>
</body>

</html>