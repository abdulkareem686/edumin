                    "Yobe": ["Bade", "Bursari", "Damaturu", "Fika", "Fune", "Geidam", "Gujba", "Gulani", "Jakusko", "Karasuwa", "Machina", "Nangere", "Nguru", "Potiskum", "Tarmuwa", "Yunusari", "Yusufari"],
                    "Zamfara": ["Anka", "Bakura", "Birnin Magaji/Kiyaw", "Bukkuyum", "Bungudu", "Gummi", "Gusau", "Kaura Namoda", "Maradun", "Maru", "Shinkafi", "Talata Mafara", "Chafe", "Zurmi"]
                };

                const stateOriginSelect    = document.getElementById('studentModalStateOfOrigin');
                const lgaOriginSelect      = document.getElementById('studentModalLocalGovernment');
                const stateResidenceSelect = document.getElementById('studentModalResidentialState');
                const lgaResidenceSelect   = document.getElementById('studentModalResidentialLGA');

                function populateStates() {
                    const sortedStates = Object.keys(nigerianStates).sort();
                    sortedStates.forEach(function (state) {
                        if (stateOriginSelect) {
                            const opt1 = document.createElement('option');
                            opt1.value = state;
                            opt1.textContent = state;
                            stateOriginSelect.appendChild(opt1);
                        }
                        if (stateResidenceSelect) {
                            const opt2 = document.createElement('option');
                            opt2.value = state;
                            opt2.textContent = state;
                            stateResidenceSelect.appendChild(opt2);
                        }
                    });
                }

                function updateLgas(stateSelect, lgaSelect) {
                    if (!stateSelect || !lgaSelect) return;
                    while (lgaSelect.options.length > 1) {
                        lgaSelect.remove(1);
                    }
                    const state = stateSelect.value;
                    if (state && nigerianStates[state]) {
                        nigerianStates[state].slice().sort().forEach(function (lga) {
                            const opt = document.createElement('option');
                            opt.value = lga;
                            opt.textContent = lga;
                            lgaSelect.appendChild(opt);
                        });
                    }
                }

                if (stateOriginSelect) {
                    stateOriginSelect.addEventListener('change', function () {
                        updateLgas(stateOriginSelect, lgaOriginSelect);
                    });
                }
                if (stateResidenceSelect) {
                    stateResidenceSelect.addEventListener('change', function () {
                        updateLgas(stateResidenceSelect, lgaResidenceSelect);
                    });
                }
                populateStates();

                /* ---------- Class → department hint ---------- */
                const classSelect = document.getElementById('studentModalClassSelect');
                const deptDisplay = document.getElementById('studentModalDepartmentDisplay');

                function refreshDepartmentHint() {
                    if (!classSelect || !deptDisplay) return;
                    const opt = classSelect.options[classSelect.selectedIndex];
                    const dept = opt ? opt.getAttribute('data-department') : '';
                    deptDisplay.textContent = dept ? ('Department: ' + dept) : '';
                }

                if (classSelect) {
                    classSelect.addEventListener('change', refreshDepartmentHint);
                }

                /* ---------- Parent typeahead search ---------- */
                const searchInput = document.getElementById('studentModalParentSearch');
                const resultsDiv  = document.getElementById('studentModalParentResults');
                const loadingDiv  = document.getElementById('studentModalParentLoading');
                let debounceTimer;

                function hideResults() {
                    if (resultsDiv) {
                        resultsDiv.style.display = 'none';
                        resultsDiv.innerHTML = '';
                    }
                }

                function selectParent(id, name, email, phone) {
                    const idInput     = document.getElementById('studentModalExistingParentId');
                    const badgeDisplay = document.getElementById('studentModalSelectedParentDisplay');

                    if (idInput) idInput.value = id;
                    if (badgeDisplay) {
                        const span = badgeDisplay.querySelector('.selected-info span');
                        if (span) span.textContent = name + ' (' + (email || phone || 'Selected') + ')';
                        badgeDisplay.style.display = 'flex';
                    }
                    if (searchInput) searchInput.value = name;
                    hideResults();
                }

                function clearParentSelection() {
                    const idInput      = document.getElementById('studentModalExistingParentId');
                    const badgeDisplay = document.getElementById('studentModalSelectedParentDisplay');

                    if (idInput) idInput.value = '';
                    if (badgeDisplay) badgeDisplay.style.display = 'none';
                    if (searchInput) searchInput.value = '';
                    hideResults();
                }

                /* Expose for inline handlers (kept for backwards compatibility) */
                window.clearStudentModalParentSelection = clearParentSelection;
                window.selectStudentModalParent = selectParent;

                /* Bind the "Clear" / "Remove" buttons the safe way */
                const clearBtn = document.getElementById('studentModalClearSearchBtn');
                if (clearBtn) clearBtn.addEventListener('click', clearParentSelection);

                document.querySelectorAll('.js-clear-parent').forEach(function (btn) {
                    btn.addEventListener('click', clearParentSelection);
                });

                if (searchInput) {
                    searchInput.addEventListener('input', function () {
                        clearTimeout(debounceTimer);
                        const query = this.value.trim();

                        if (query.length < 2) {
                            hideResults();
                            return;
                        }

                        debounceTimer = setTimeout(function () {
                            if (loadingDiv) loadingDiv.style.display = 'inline-block';

                            fetch('/api/search-parents?search=' + encodeURIComponent(query))
                                .then(function (res) { return res.json(); })
                                .then(function (data) {
                                    if (loadingDiv) loadingDiv.style.display = 'none';
                                    if (!resultsDiv) return;

                                    if (data.success && data.results && data.results.length > 0) {
                                        let html = '';
                                        data.results.forEach(function (parent) {
                                            const fullName = ((parent.first_name || '') + ' ' + (parent.last_name || '')).trim();
                                            html += ''
                                                + '<div class="search-result-item p-2 border-bottom" '
                                                +      'data-id="' + parent.id + '" '
                                                +      'data-name="' + fullName.replace(/"/g, '&quot;') + '" '
                                                +      'data-email="' + (parent.email || '') + '" '
                                                +      'data-phone="' + (parent.phone || '') + '">'
                                                +   '<div class="d-flex justify-content-between align-items-center">'
                                                +     '<div>'
                                                +       '<strong class="text-dark">' + fullName + '</strong>'
                                                +       '<div class="small text-muted">' + (parent.email || '') + ' | ' + (parent.phone || 'No phone') + '</div>'
                                                +     '</div>'
                                                +     '<button type="button" class="btn btn-sm btn-outline-primary select-parent-btn">Select</button>'
                                                +   '</div>'
                                                + '</div>';
                                        });
                                        resultsDiv.innerHTML = html;
                                        resultsDiv.style.display = 'block';

                                        resultsDiv.querySelectorAll('.search-result-item').forEach(function (item) {
                                            item.addEventListener('click', function () {
                                                selectParent(this.dataset.id, this.dataset.name, this.dataset.email, this.dataset.phone);
                                            });
                                        });
                                    } else {
                                        resultsDiv.innerHTML = '<div class="p-3 text-center text-muted small">No parents found. Switch to "Register New Parent" tab to create one.</div>';
                                        resultsDiv.style.display = 'block';
                                    }
                                })
                                .catch(function () {
                                    if (loadingDiv) loadingDiv.style.display = 'none';
                                    if (resultsDiv) {
                                        resultsDiv.innerHTML = '<div class="p-3 text-center text-danger small">Error searching parents.</div>';
                                        resultsDiv.style.display = 'block';
                                    }
                                });
                        }, 300);
                    });

                    /* Close the dropdown when clicking outside the pane */
                    document.addEventListener('click', function (e) {
                        if (resultsDiv && !e.target.closest('#studentModalExistingParentPane')) {
                            resultsDiv.style.display = 'none';
                        }
                    });
                }

                /* ---------- Password generator ---------- */
                function generateParentPassword() {
                    const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
                    let pass = '';
                    for (let i = 0; i < 10; i++) {
                        pass += chars.charAt(Math.floor(Math.random() * chars.length));
                    }
                    const pwdInput = document.getElementById('studentModalParentPassword');
                    if (pwdInput) pwdInput.value = pass;
                }

                window.generateStudentModalParentPassword = generateParentPassword;
                const genBtn = document.getElementById('studentModalGeneratePasswordBtn');
                if (genBtn) genBtn.addEventListener('click', generateParentPassword);

                /* ---------- Tab switching clears the opposite selection ---------- */
                const existingTab = document.getElementById('student-modal-existing-tab');
                const newTab      = document.getElementById('student-modal-new-tab');

                if (existingTab) {
                    existingTab.addEventListener('shown.bs.tab', function () {
                        /* Switching to "link existing" → clear the new-parent form */
                        const pane = document.getElementById('studentModalNewParentPane');
                        if (pane) {
                            pane.querySelectorAll('input, select, textarea').forEach(function (el) {
                                if (el.type === 'checkbox') {
                                    el.checked = el.id === 'studentModalSetAsPrimary';
                                } else if (el.id === 'studentModalParentPassword') {
                                    el.value = 'password123';
                                } else if (el.tagName === 'SELECT') {
                                    el.selectedIndex = 0;
                                } else {
                                    el.value = '';
                                }
                            });
                        }
                    });
                }

                if (newTab) {
                    newTab.addEventListener('shown.bs.tab', function () {
                        /* Switching to "register new" → clear the linked parent */
                        clearParentSelection();
                    });
                }

                /* ---------- Modal submit validation ---------- */
                const studentModalForm = document.getElementById('addStudentModalForm');
                if (studentModalForm) {
                    studentModalForm.addEventListener('submit', function (e) {
                        const isNewTabActive = newTab && newTab.classList.contains('active');
                        const existingIdInput = document.getElementById('studentModalExistingParentId');
                        const existingId = existingIdInput ? existingIdInput.value : '';

                        if (isNewTabActive) {
                            const pFirst = (document.getElementById('studentModalParentFirstName') || {}).value || '';
                            const pLast  = (document.getElementById('studentModalParentLastName')  || {}).value || '';
                            const pEmail = (document.getElementById('studentModalParentEmail')   || {}).value || '';
                            const pPhone = (document.getElementById('studentModalParentPhone')   || {}).value || '';

                            const anyFilled = pFirst.trim() || pLast.trim() || pEmail.trim() || pPhone.trim();

                            if (anyFilled) {
                                if (!pFirst.trim() || !pLast.trim() || !pEmail.trim() || !pPhone.trim()) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    alert('Please fill in all required parent details (First Name, Last Name, Email and Phone), or switch to "Link Existing Parent".');
                                    return false;
                                }
                            }
                        } else {
                            /* Existing-parent tab: if nothing selected and nothing typed, that's fine (no parent linked) */
                            if (!existingId) {
                                /* optional: warn the user, but allow submission */
                            }
                        }
                        return true;
                    });
                }

                /* ---------- Reset modal state when it closes ---------- */
                const modalEl = document.getElementById('addStudentModal');
                if (modalEl) {
                    modalEl.addEventListener('hidden.bs.modal', function () {
                        if (studentModalForm) studentModalForm.reset();

                        clearParentSelection();
                        hideResults();

                        /* Reset state/LGA dropdowns */
                        if (stateOriginSelect) stateOriginSelect.value = '';
                        if (stateResidenceSelect) stateResidenceSelect.value = '';
                        if (lgaOriginSelect) {
                            while (lgaOriginSelect.options.length > 1) lgaOriginSelect.remove(1);
                            lgaOriginSelect.selectedIndex = 0;
                        }
                        if (lgaResidenceSelect) {
                            while (lgaResidenceSelect.options.length > 1) lgaResidenceSelect.remove(1);
                            lgaResidenceSelect.selectedIndex = 0;
                        }

                        /* Reset the password field to its default */
                        const pwdInput = document.getElementById('studentModalParentPassword');
                        if (pwdInput) pwdInput.value = 'password123';

                        /* Return to the "Link Existing Parent" tab */
                        if (existingTab && window.bootstrap && bootstrap.Tab) {
                            bootstrap.Tab.getOrCreateInstance(existingTab).show();
                        }

                        refreshDepartmentHint();
                    });

                    /* Ensure the department hint reflects the current class on open */
                    modalEl.addEventListener('shown.bs.modal', function () {
                        refreshDepartmentHint();
                    });
                }

                /* Make sure the table checkbox header toggles all row checkboxes */
                const checkAll = document.getElementById('customCheck1');
                if (checkAll) {
                    checkAll.addEventListener('change', function () {
                        document.querySelectorAll('#products-datatable tbody .form-check-input').forEach(function (cb) {
                            cb.checked = checkAll.checked;
                        });
                    });
                }
            });
        </script>
    </body>
</html>