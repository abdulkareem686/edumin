        <script>
            /* ---------------------------------------------------------
             * DataTable init (must run AFTER jQuery + DataTables load)
             * --------------------------------------------------------- */
            $(document).ready(function () {
                var $table = $('#products-datatable');
                if (!$table.length) return;

                var dt = null;
                try {
                    dt = $table.DataTable({
                        paging: false,
                        searching: true, // Enable search across all columns!
                        dom: 'rt', // Hide default search input, use our top bar
                        info: false,
                        columnDefs: [
                            { orderable: false, targets: [0, 7] },
                            { searchable: false, targets: [0, 7] }, // skip checkbox & actions
                            { searchable: true, targets: [1, 2, 3, 4, 5, 6] }
                        ],
                        order: [[1, 'asc']],
                        language: {
                            zeroRecords: '<div class="text-center py-4 text-muted">' +
                                         '<i class="mdi mdi-account-search-outline fs-1 d-block mb-1 text-secondary"></i>' +
                                         '<p class="mb-0 fw-semibold">No matching students found on this page</p>' +
                                         '<small class="text-muted">Press Search or Enter to search the entire database</small>' +
                                         '</div>'
                        }
                    });
                } catch (e) {
                    console.warn('DataTables init warning, using fallback live filter:', e);
                }

                var $searchInput = $('#studentTableSearch');
                var $searchClear = $('#studentSearchClear');
                var $searchStatus = $('#liveSearchStatus');
                var totalInitialRows = $table.find('tbody tr:not(#noStudentSearchMatchRow)').length;

                function updateClearBtn() {
                    if ($searchInput.val().trim().length > 0) {
                        $searchClear.show();
                    } else {
                        $searchClear.hide();
                    }
                }

                function filterRowsManually(val) {
                    var terms = val.toLowerCase().trim().split(/\s+/).filter(Boolean);
                    var matched = 0;
                    $table.find('tbody tr:not(#noStudentSearchMatchRow)').each(function () {
                        var $tr = $(this);
                        var rowText = '';
                        $tr.find('td').each(function (idx) {
                            if (idx > 0 && idx < 7) {
                                rowText += ' ' + $(this).text();
                            }
                        });
                        rowText = rowText.toLowerCase();
                        var isMatch = terms.every(function (t) {
                            return rowText.indexOf(t) !== -1;
                        });
                        if (isMatch) {
                            $tr.show();
                            matched++;
                        } else {
                            $tr.hide();
                        }
                    });

                    var $noMatch = $('#noStudentSearchMatchRow');
                    if (terms.length > 0 && matched === 0) {
                        if (!$noMatch.length) {
                            $table.find('tbody').append(
                                '<tr id="noStudentSearchMatchRow">' +
                                '<td colspan="8" class="text-center py-4 text-muted">' +
                                '<i class="mdi mdi-account-search-outline fs-1 d-block mb-1 text-secondary"></i>' +
                                '<p class="mb-0 fw-semibold">No matching students found on this page</p>' +
                                '<small class="text-muted">Press Search or Enter to search the entire database</small>' +
                                '</td></tr>'
                            );
                        } else {
                            $noMatch.show();
                        }
                    } else if ($noMatch.length) {
                        $noMatch.hide();
                    }
                    return matched;
                }

                function performSearch() {
                    var val = $searchInput.val();
                    updateClearBtn();

                    var matchedCount = 0;
                    if (dt) {
                        dt.search(val).draw();
                        var info = dt.page.info();
                        matchedCount = info.recordsDisplay;
                    } else {
                        matchedCount = filterRowsManually(val);
                    }

                    if (val.trim().length > 0) {
                        $searchStatus.html(
                            '<i class="mdi mdi-filter-check-outline me-1 text-primary"></i>' +
                            'Showing <strong>' + matchedCount + '</strong> of <strong>' + totalInitialRows + '</strong> students on this page'
                        ).show();
                    } else {
                        $searchStatus.hide();
                    }
                }

                // Instant live filtering as user types
                $searchInput.on('input keyup search paste', performSearch);

                $searchClear.on('click', function () {
                    $searchInput.val('').focus();
                    performSearch();
                });

                if ($searchInput.val().trim().length > 0) {
                    performSearch();
                }
            });
        </script>

