<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>edu admin</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description">
        <meta content="Coderthemes" name="author">
        <!-- App favicon -->
        <link rel="shortcut icon" href="images/favicon.png">

        <!-- third party css -->
        <link href="assets/css/vendor/dataTables.bootstrap5.css" rel="stylesheet" type="text/css">
        <link href="assets/css/vendor/responsive.bootstrap5.css" rel="stylesheet" type="text/css">
        <!-- third party css end -->

        <!-- App css -->
        <link href="assets/css/icons.min.css" rel="stylesheet" type="text/css">
        <link href="assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
        <link href="assets/css/app-dark.min.css" rel="stylesheet" type="text/css" id="dark-style">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

        <style>
            /* ---------- Modal scrolling (guaranteed) ---------- */
            .modal-dialog-scrollable {
                max-height: calc(100vh - 2rem) !important;
            }
            .modal-dialog-scrollable form.modal-content,
            .modal-dialog-scrollable .modal-content {
                max-height: calc(100vh - 2rem) !important;
                display: flex !important;
                flex-direction: column !important;
                overflow: hidden !important;
            }
            .modal-dialog-scrollable .modal-body {
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch !important;
                flex: 1 1 auto !important;
                max-height: calc(100vh - 180px) !important;
            }
            .modal-dialog-scrollable .modal-header,
            .modal-dialog-scrollable .modal-footer {
                flex-shrink: 0 !important;
            }

            /* ---------- Student table ---------- */
            .class-display {
                font-weight: 500;
                color: #3f51b5;
            }
            .department-badge {
                font-size: 0.85em;
                background-color: #e3f2fd;
                color: #1976d2;
                padding: 2px 6px;
                border-radius: 4px;
                margin-left: 4px;
            }
            .action-icon {
                font-size: 1.2rem;
                text-decoration: none;
            }
            .table-user a {
                text-decoration: none;
                color: #3f51b5;
            }
            .table-user a:hover {
                text-decoration: underline;
            }

            /* ---------- Add Student modal ---------- */
            .required-field::after {
                content: " *";
                color: #e63946;
            }
            #addStudentModal .modal-body {
                background-color: #f8fafc;
            }
            #addStudentModal .card-header .card-title {
                font-size: 1rem;
                letter-spacing: .2px;
            }
            .typeahead-results {
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            }
            .search-result-item {
                border-bottom: 1px solid #f1f5f9;
                transition: background-color 0.15s ease-in-out;
            }
            .search-result-item:last-child {
                border-bottom: none;
            }
            .search-result-item:hover {
                background-color: #f8fafc;
                cursor: pointer;
            }
            .selected-badge {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #e0f2fe;
                color: #0369a1;
                padding: 0.5rem 0.75rem;
                border-radius: 0.375rem;
                border: 1px solid #bae6fd;
                font-weight: 500;
            }
        </style>
    </head>

    <body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
        <!-- Begin page -->
        <div class="wrapper">

            <!-- ========== Left Sidebar Start ========== -->
            <%- include('partials/admin-sidebar') %>
            <!-- Left Sidebar End -->

            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->
            <div class="content-page">
                <div class="content">

                    <!-- Topbar -->
                    <%- include('partials/admin-navbar') %>
                    <!-- end Topbar -->

                    <!-- Start Content-->
                    <div class="container-fluid">

                        <!-- start page title -->
                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box">
                                    <div class="page-title-right">
                                        <ol class="breadcrumb m-0">
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Home</a></li>
                                            <li class="breadcrumb-item"><a href="javascript: void(0);">Students</a></li>
                                            <li class="breadcrumb-item active">All Students</li>
                                        </ol>
                                    </div>
                                    <h4 class="page-title">All Students</h4>
                                </div>
                            </div>
                        </div>
                        <!-- end page title -->

                        <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        <% } %>

                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">

                                        <div class="row mb-2">
                                            <div class="col-sm-4">
                                                <button type="button" class="btn btn-danger mb-2" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                                                    <i class="mdi mdi-plus-circle me-2"></i> Add Student
                                                </button>
                                            </div>
                                            <div class="col-sm-8">
                                                <form class="d-flex justify-content-sm-end gap-2 mb-2" id="studentSearchForm" method="get" action="/all-students">
                                                    <div class="position-relative" style="max-width:340px; width:100%;">
                                                        <input type="search" id="studentTableSearch" name="q" class="form-control pe-4" 
                                                               placeholder="Type to search anything on table..." 
                                                               value="<%= typeof searchQ !== 'undefined' ? searchQ : '' %>"
                                                               autocomplete="off">
                                                        <span id="studentSearchClear" class="position-absolute end-0 top-50 translate-middle-y me-2 text-muted" 
                                                              style="cursor: pointer; display: none;" title="Clear search">
                                                            <i class="mdi mdi-close-circle font-16"></i>
                                                        </span>
                                                    </div>
                                                    <button type="submit" class="btn btn-primary" title="Search all database records">
                                                        <i class="mdi mdi-magnify me-1"></i>Search
                                                    </button>
                                                </form>
                                                <div id="liveSearchStatus" class="text-end text-muted small mt-1" style="display: none;"></div>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-centered table-striped dt-responsive nowrap w-100" id="products-datatable">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 20px;">
                                                            <div class="form-check">
                                                                <input type="checkbox" class="form-check-input" id="customCheck1">
                                                                <label class="form-check-label" for="customCheck1">&nbsp;</label>
                                                            </div>
                                                        </th>
                                                        <th>Admission No.</th>
                                                        <th>Name</th>
                                                        <th>Email</th>
                                                        <th>Gender</th>
                                                        <th>Date of birth</th>
                                                        <th>Class</th>
                                                        <th style="width: 130px;">Action</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    <% students.forEach(function(student) { %>
                                                    <tr>
                                                        <td>
                                                            <div class="form-check">
                                                                <input type="checkbox" class="form-check-input" id="customCheck<%= student.id %>">
                                                                <label class="form-check-label" for="customCheck<%= student.id %>">&nbsp;</label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <a href="/student-profile/<%= student.id %>" class="text-body fw-semibold">
                                                                <%= student.admission_number %>
                                                            </a>
                                                        </td>
                                                        <td class="table-user">
                                                            <a href="/student-profile/<%= student.id %>" class="text-body fw-semibold">
                                                                <%= student.firstName %> <%= student.middleName %> <%= student.lastName %>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <a href="mailto:<%= student.email %>"><strong><%= student.email %></strong></a>
                                                        </td>
                                                        <td>
                                                            <%= student.gender || 'N/A' %>
                                                        </td>
                                                        <td>
                                                            <%= student.dateOfBirth ? new Date(student.dateOfBirth).toLocaleDateString() : 'N/A' %>
                                                        </td>
                                                        <td>
                                                            <% if (student.className) { %>
                                                                <span class="class-display">
                                                                    <%= student.className %>
                                                                    <% if (student.classDepartment) { %>
                                                                        <span class="department-badge">(<%= student.classDepartment %>)</span>
                                                                    <% } %>
                                                                </span>
                                                            <% } else { %>
                                                                <span class="text-muted">N/A</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-nowrap">
                                                            <a href="/add-fees/<%= student.id %>" class="action-icon text-success me-2" title="Record fee payment">
                                                                <i class="mdi mdi-cash-multiple"></i>
                                                            </a>
                                                            <a href="/edit-student/<%= student.id %>" class="action-icon text-primary me-2" title="Edit student">
                                                                <i class="mdi mdi-square-edit-outline"></i>
                                                            </a>
                                                            <a href="/delete-student/<%= student.id %>" class="action-icon text-danger" title="Delete student"
                                                               onclick="return confirm('Are you sure you want to delete this student?')">
                                                                <i class="mdi mdi-delete"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <!-- end table-responsive -->

                                        <%- include('partials/pager') %>

                                        <!-- ============================================================= -->
                                        <!-- Add Student Modal                                             -->
                                        <!-- ============================================================= -->
                                        <div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
                                            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                                <form class="modal-content border-0 shadow-lg" action="/save-student" method="post" id="addStudentModalForm" autocomplete="off">

                                                    <!-- Modal header -->
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title d-flex align-items-center text-white" id="addStudentModalLabel">
                                                            <i class="bi bi-person-plus-fill me-2 fs-4"></i> Add New Student
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>

                                                    <!-- Modal body -->
                                                    <div class="modal-body p-4">

                                                        <div class="alert alert-info d-flex align-items-center mb-4 py-2 px-3 border-0 shadow-sm" style="background:#e0f2fe;color:#0369a1;">
                                                            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                                                            <div><strong>Notice:</strong> Admission Number will be generated automatically upon successful registration.</div>
                                                        </div>

                                                        <!-- ============ Section 1: Personal Information ============ -->
                                                        <div class="card border-0 shadow-sm mb-4">
                                                            <div class="card-header bg-white py-3 border-bottom">
                                                                <h5 class="card-title mb-0 text-primary d-flex align-items-center">
                                                                    <i class="bi bi-person-circle me-2"></i> Personal Information
                                                                </h5>
                                                            </div>
                                                            <div class="card-body">
                                                                <div class="row g-3">
                                                                    <div class="col-md-4">
                                                                        <label class="form-label required-field fw-semibold">Surname</label>
                                                                        <input type="text" class="form-control" name="firstName" required placeholder="Student's Surname">
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <label class="form-label fw-semibold">Middle Name</label>
                                                                        <input type="text" class="form-control" name="middleName" placeholder="Middle Name (Optional)">
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <label class="form-label required-field fw-semibold">Last Name</label>
                                                                        <input type="text" class="form-control" name="lastName" required placeholder="Last Name">
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <label class="form-label required-field fw-semibold">Email</label>
                                                                        <input type="email" class="form-control" name="email" required placeholder="student@example.com">
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label fw-semibold">Gender</label>
                                                                        <select class="form-select" name="gender">
                                                                            <option value="">-- Select Gender --</option>
                                                                            <option value="Male">Male</option>
                                                                            <option value="Female">Female</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label class="form-label fw-semibold">Date of Birth</label>
                                                                        <input type="date" class="form-control" name="dateOfBirth">
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Nationality</label>
                                                                        <select class="form-select" name="nationality">
                                                                            <option value="">-- Select Nationality --</option>
                                                                            <option value="Nigerian" selected>Nigerian</option>
                                                                            <option value="Other">Other</option>
                                                                        </select>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Mobile Number</label>
                                                                        <input type="tel" class="form-control" name="mobileNumber" placeholder="e.g. 08012345678">
                                                                    </div>

                                                                    <div class="col-12">
                                                                        <label class="form-label fw-semibold">Residential Address</label>
                                                                        <textarea class="form-control" name="address" rows="2" placeholder="Full residential address"></textarea>
                                                                    </div>
                                                                </div>

                                                                <!-- Origin & Residence Geography -->
                                                                <div class="row g-3 mt-2">
                                                                    <div class="col-md-6">
                                                                        <div class="p-3 bg-light rounded border h-100">
                                                                            <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-geo-alt me-1"></i> State of Origin</h6>
                                                                            <div class="row g-2">
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label small text-muted">State</label>
                                                                                    <select class="form-select student-state-origin" name="stateOfOrigin" id="studentModalStateOfOrigin">
                                                                                        <option value="">-- Select State --</option>
                                                                                    </select>
                                                                                </div>
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label small text-muted">LGA</label>
                                                                                    <select class="form-select student-lga-origin" name="localGovernment" id="studentModalLocalGovernment">
                                                                                        <option value="">-- Select LGA --</option>
                                                                                    </select>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <div class="p-3 bg-light rounded border h-100">
                                                                            <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-house me-1"></i> Residential Information</h6>
                                                                            <div class="row g-2">
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label small text-muted">State</label>
                                                                                    <select class="form-select student-state-residence" name="residentialState" id="studentModalResidentialState">
                                                                                        <option value="">-- Select State --</option>
                                                                                    </select>
                                                                                </div>
                                                                                <div class="col-md-6">
                                                                                    <label class="form-label small text-muted">LGA</label>
                                                                                    <select class="form-select student-lga-residence" name="residentialLGA" id="studentModalResidentialLGA">
                                                                                        <option value="">-- Select LGA --</option>
                                                                                    </select>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- ============ Section 2: Academic Information ============ -->
                                                        <div class="card border-0 shadow-sm mb-4">
                                                            <div class="card-header bg-white py-3 border-bottom">
                                                                <h5 class="card-title mb-0 text-primary d-flex align-items-center">
                                                                    <i class="bi bi-book me-2"></i> Academic Information
                                                                </h5>
                                                            </div>
                                                            <div class="card-body">
                                                                <div class="row g-3">
                                                                    <div class="col-md-6">
                                                                        <label class="form-label required-field fw-semibold">Select Class</label>
                                                                        <select class="form-select" name="classId" id="studentModalClassSelect" required>
                                                                            <option value="">-- Select Class --</option>
                                                                            <% if (typeof classes !== 'undefined' && classes.length) { %>
                                                                                <% classes.forEach(function(cls) { %>
                                                                                    <option value="<%= cls.id %>"
                                                                                            data-level="<%= cls.level %>"
                                                                                            data-department="<%= cls.department || '' %>">
                                                                                        <%= cls.className %><% if (cls.department) { %> (<%= cls.department %>)<% } else if (cls.level) { %> - <%= cls.level %><% } %>
                                                                                    </option>
                                                                                <% }); %>
                                                                            <% } else { %>
                                                                                <option value="" disabled>No classes available</option>
                                                                            <% } %>
                                                                        </select>
                                                                        <small id="studentModalDepartmentDisplay" class="text-primary mt-1 d-block fw-semibold"></small>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label class="form-label fw-semibold">Admission Number</label>
                                                                        <input type="text" class="form-control bg-light" value="Auto-generated on submission" disabled readonly>
                                                                        <small class="text-muted">A unique admission number is created automatically</small>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- ============ Section 3: Parent / Guardian ============ -->
                                                        <div class="card border-0 shadow-sm mb-2">
                                                            <div class="card-header bg-white py-3 border-bottom">
                                                                <h5 class="card-title mb-0 text-primary d-flex align-items-center">
                                                                    <i class="bi bi-people me-2"></i> Parent / Guardian Information
                                                                </h5>
                                                            </div>
                                                            <div class="card-body">
                                                                <div class="alert alert-light border d-flex align-items-center mb-3 py-2 px-3">
                                                                    <i class="bi bi-info-circle text-primary me-2"></i>
                                                                    <span class="small text-muted">You can either link the student to an already registered parent or register a new parent right now.</span>
                                                                </div>

                                                                <ul class="nav nav-pills nav-justified mb-3" id="studentModalParentTab" role="tablist">
                                                                    <li class="nav-item" role="presentation">
                                                                        <button class="nav-link active py-2" id="student-modal-existing-tab" data-bs-toggle="pill" data-bs-target="#studentModalExistingParentPane" type="button" role="tab" aria-controls="studentModalExistingParentPane" aria-selected="true">
                                                                            <i class="bi bi-search me-1"></i> Link Existing Parent
                                                                        </button>
                                                                    </li>
                                                                    <li class="nav-item" role="presentation">
                                                                        <button class="nav-link py-2" id="student-modal-new-tab" data-bs-toggle="pill" data-bs-target="#studentModalNewParentPane" type="button" role="tab" aria-controls="studentModalNewParentPane" aria-selected="false">
                                                                            <i class="bi bi-person-plus me-1"></i> Register New Parent
                                                                        </button>
                                                                    </li>
                                                                </ul>

                                                                <div class="tab-content" id="studentModalParentTabContent">

                                                                    <!-- Tab 1: Link Existing Parent -->
                                                                    <div class="tab-pane fade show active p-3 bg-light rounded border" id="studentModalExistingParentPane" role="tabpanel" aria-labelledby="student-modal-existing-tab">
                                                                        <label class="form-label fw-semibold">Search Existing Parent</label>
                                                                        <div class="position-relative">
                                                                            <div class="input-group">
                                                                                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                                                                                <input type="text" class="form-control" id="studentModalParentSearch" placeholder="Type parent name, email, or phone number..." autocomplete="off">
                                                                                <button class="btn btn-outline-secondary" type="button" id="studentModalClearSearchBtn">Clear</button>
                                                                            </div>
                                                                            <div class="spinner-border spinner-border-sm text-primary position-absolute top-50 end-0 translate-middle-y me-3" id="studentModalParentLoading" style="display:none; z-index:10;"></div>
                                                                            <div class="typeahead-results mt-1 shadow rounded border bg-white" id="studentModalParentResults" style="display:none; position:absolute; width:100%; z-index:1055; max-height:200px; overflow-y:auto;"></div>
                                                                        </div>
                                                                        <small class="text-muted d-block mt-1">Type at least 2 characters to search</small>

                                                                        <div id="studentModalSelectedParentDisplay" class="selected-badge mt-3" style="display:none;">
                                                                            <span class="selected-info"><i class="bi bi-person-check-fill me-1"></i> <span></span></span>
                                                                            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 ms-2 js-clear-parent">
                                                                                <i class="bi bi-x-circle me-1"></i> Remove
                                                                            </button>
                                                                        </div>
                                                                        <input type="hidden" name="existingParentId" id="studentModalExistingParentId" value="">
                                                                    </div>

                                                                    <!-- Tab 2: Register New Parent -->
                                                                    <div class="tab-pane fade p-3 bg-white rounded border border-primary-subtle" id="studentModalNewParentPane" role="tabpanel" aria-labelledby="student-modal-new-tab">
                                                                        <div class="row g-3">
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Parent First Name</label>
                                                                                <input type="text" class="form-control" name="parentFirstName" id="studentModalParentFirstName" placeholder="First Name">
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Parent Last Name</label>
                                                                                <input type="text" class="form-control" name="parentLastName" id="studentModalParentLastName" placeholder="Last Name">
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Parent Email</label>
                                                                                <input type="email" class="form-control" name="parentEmail" id="studentModalParentEmail" placeholder="parent@example.com">
                                                                                <small class="text-muted">Parent will use this email to log in</small>
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Parent Phone Number</label>
                                                                                <input type="tel" class="form-control" name="parentPhone" id="studentModalParentPhone" placeholder="08012345678">
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Password</label>
                                                                                <div class="input-group">
                                                                                    <input type="text" class="form-control" name="parentPassword" id="studentModalParentPassword" value="password123">
                                                                                    <button class="btn btn-outline-secondary" type="button" id="studentModalGeneratePasswordBtn">
                                                                                        <i class="bi bi-shuffle"></i> Generate
                                                                                    </button>
                                                                                </div>
                                                                                <small class="text-muted">Default: password123</small>
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Relationship to Student</label>
                                                                                <select class="form-select" name="parentRelationship" id="studentModalParentRelationship">
                                                                                    <option value="Father">Father</option>
                                                                                    <option value="Mother">Mother</option>
                                                                                    <option value="Guardian">Guardian</option>
                                                                                    <option value="Grandparent">Grandparent</option>
                                                                                    <option value="Other">Other</option>
                                                                                </select>
                                                                            </div>
                                                                            <div class="col-md-6">
                                                                                <label class="form-label fw-semibold">Occupation</label>
                                                                                <input type="text" class="form-control" name="parentOccupation" placeholder="e.g. Engineer, Business">
                                                                            </div>
                                                                            <div class="col-md-6">
