<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Class Subjects - <%= classInfo ? (classInfo.displayName || classInfo.className) : 'Class' %> - EduSuite</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.ico">
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .subject-badge {
            display: inline-flex;
            align-items: center;
            background-color: #e0f2fe;
            color: #0369a1;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.85rem;
            margin: 2px;
            border: 1px solid #bae6fd;
        }
        .subject-badge .remove-btn {
            background: none;
            border: none;
            color: #ef4444;
            padding: 0 0 0 5px;
            font-size: 1rem;
            line-height: 1;
            cursor: pointer;
        }
        .subject-badge .remove-btn:hover {
            color: #b91c1c;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <%- include('partials/admin-sidebar') %>

        <div class="content-page">
            <div class="content">
                <%- include('partials/admin-navbar') %>

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                                        <li class="breadcrumb-item"><a href="/all-classes">Classes</a></li>
                                        <li class="breadcrumb-item active">Class Subjects</li>
                                    </ol>
                                </div>
                                <h4 class="page-title">
                                    <i class="bi bi-book-half text-primary me-2"></i><%= classInfo ? (classInfo.displayName || classInfo.className) : 'Class' %> - Subjects & Enrollments
                                </h4>
                            </div>
                        </div>
                    </div>

                    <!-- Class Info Cards -->
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-uppercase text-muted mb-2">Class Level</h6>
                                    <h4 class="text-primary fw-bold mb-0"><%= classInfo ? classInfo.level : 'N/A' %></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-uppercase text-muted mb-2">Total Subjects</h6>
                                    <h4 class="text-info fw-bold mb-0"><%= typeof subjects !== 'undefined' && subjects ? subjects.length : 0 %></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h6 class="text-uppercase text-muted mb-2">Enrolled Students</h6>
                                    <h4 class="text-success fw-bold mb-0"><%= typeof students !== 'undefined' && students ? students.length : 0 %></h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Subjects in Class -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="card-title mb-0">Curriculum Subjects</h5>
                                        <div>
                                            <a href="/register-subjects" class="btn btn-sm btn-primary">
                                                <i class="bi bi-plus-lg me-1"></i>Register New Subject
                                            </a>
                                            <a href="/assign-teachers" class="btn btn-sm btn-outline-info ms-1">
                                                <i class="bi bi-person-check me-1"></i>Assign Teachers
                                            </a>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <% if (typeof subjects !== 'undefined' && subjects && subjects.length > 0) { %>
                                            <% subjects.forEach(function(sub) { %>
                                                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                                                    <i class="bi bi-journal-bookmark-fill text-primary"></i>
                                                    <span class="fw-semibold"><%= sub.subjectName %></span>
                                                    <% if (sub.subjectCode) { %>
                                                        <span class="text-muted small">(<%= sub.subjectCode %>)</span>
                                                    <% } %>
                                                </div>
                                            <% }); %>
                                        <% } else { %>
                                            <p class="text-muted mb-0">No subjects currently assigned to this class.</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Students Subject Enrollment -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Student Subject Enrollments</h5>

                                    <div class="table-responsive">
                                        <table class="table table-centered table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Student Name</th>
                                                    <th>Department</th>
                                                    <th>Enrolled Subjects</th>
                                                    <th style="width: 120px;" class="text-center">Count</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof students !== 'undefined' && students && students.length > 0) { %>
                                                    <% students.forEach(function(student) { %>
                                                    <tr>
                                                        <td class="fw-semibold">
                                                            <a href="/student-profile/<%= student.id %>" class="text-body">
                                                                <%= student.displayName || (student.firstName + ' ' + (student.lastName || '')) %>
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-secondary-subtle text-secondary">
                                                                <%= student.department || 'General' %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <% if (student.enrollments && student.enrollments.length > 0) { %>
                                                                <% student.enrollments.forEach(function(enr) { %>
                                                                    <span class="subject-badge" id="badge-<%= student.id %>-<%= enr.subjectId %>">
                                                                        <%= enr.subjectName %>
                                                                        <button type="button" class="remove-btn" title="Unenroll" 
                                                                                onclick="unenrollSubject('<%= student.id %>', '<%= enr.subjectId %>')">&times;</button>
                                                                    </span>
                                                                <% }); %>
                                                            <% } else { %>
                                                                <span class="text-muted small">No subjects enrolled</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-primary rounded-pill">
                                                                <%= (student.enrollments ? student.enrollments.length : 0) %>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="4" class="text-center py-4 text-muted">
                                                            No students found in this class.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            © EduSuite School Management System
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>

    <script>
        async function unenrollSubject(studentId, subjectId) {
            if (!confirm('Are you sure you want to unenroll this student from this subject?')) return;
            try {
                const res = await fetch(`/unenroll-student-subject?studentId=${studentId}&subjectId=${subjectId}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    const badge = document.getElementById(`badge-${studentId}-${subjectId}`);
                    if (badge) badge.remove();
                } else {
                    alert(data.error || 'Failed to unenroll');
                }
            } catch (err) {
                alert('Network error: ' + err.message);
            }
        }
    </script>
</body>
</html>
