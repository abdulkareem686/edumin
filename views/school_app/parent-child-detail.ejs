<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title><%= child.fullName || 'Child Details' %> - Parent Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/images/favicon.ico">
    <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" id="light-style">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .child-header {
            background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
            border-radius: 12px;
            color: white;
            padding: 1.75rem 2rem;
            margin-bottom: 1.5rem;
        }
        .child-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            color: white;
        }
    </style>
</head>

<body class="loading" data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
    <div class="wrapper">
        <%- include('partials/parent-sidebar') %>

        <div class="content-page">
            <div class="content">
                <%- include('partials/parent-navbar') %>

                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="/parent/dashboard">Parent Portal</a></li>
                                        <li class="breadcrumb-item"><a href="/parent/children">My Children</a></li>
                                        <li class="breadcrumb-item active"><%= child.fullName %></li>
                                    </ol>
                                </div>
                                <h4 class="page-title">Child Performance & Details</h4>
                            </div>
                        </div>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <% } %>

                    <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    <% } %>

                    <!-- Child Profile Banner -->
                    <div class="row">
                        <div class="col-12">
                            <div class="child-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="child-avatar">
                                        <%= (child.firstName ? child.firstName[0] : 'C').toUpperCase() %>
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-1 text-white"><%= child.fullName %></h3>
                                        <p class="mb-0 text-white-50">
                                            <span><i class="bi bi-building me-1"></i>Class: <strong><%= child.className || 'Unassigned' %></strong></span>
                                            <span class="mx-2">•</span>
                                            <span><i class="bi bi-card-text me-1"></i>Admission No: <strong><%= child.admission_number || 'N/A' %></strong></span>
                                            <% if (child.gender) { %>
                                                <span class="mx-2">•</span>
                                                <span>Gender: <strong><%= child.gender %></strong></span>
                                            <% } %>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    <a href="/parent/children" class="btn btn-light btn-sm me-1">
                                        <i class="bi bi-arrow-left me-1"></i>All Children
                                    </a>
                                    <a href="/parent/make-payment?studentId=<%= child.id %>" class="btn btn-warning btn-sm">
                                        <i class="bi bi-credit-card me-1"></i>Pay School Fees
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Metrics Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted text-uppercase mb-2">Attendance Record</h6>
                                            <h3 class="fw-bold mb-0 text-success">
                                                <%= attendanceSummary ? attendanceSummary.percentage : 0 %>%
                                            </h3>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-success-subtle text-success rounded-circle fs-3">
                                                <i class="bi bi-calendar-check"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <%= attendanceSummary ? attendanceSummary.present_days : 0 %> / <%= attendanceSummary ? attendanceSummary.total_days : 0 %> days present
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted text-uppercase mb-2">Total Fees Due</h6>
                                            <h3 class="fw-bold mb-0 text-primary">
                                                &#8358;<%= Number(feeSummary ? feeSummary.total_due : 0).toLocaleString() %>
                                            </h3>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-3">
                                                <i class="bi bi-cash-stack"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        Paid: &#8358;<%= Number(feeSummary ? feeSummary.total_paid : 0).toLocaleString() %> | 
                                        Balance: <strong class="text-danger">&#8358;<%= Number((feeSummary ? feeSummary.total_due : 0) - (feeSummary ? feeSummary.total_paid : 0)).toLocaleString() %></strong>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="text-muted text-uppercase mb-2">Subjects Evaluated</h6>
                                            <h3 class="fw-bold mb-0 text-info">
                                                <%= typeof recentResults !== 'undefined' && recentResults ? recentResults.length : 0 %>
                                            </h3>
                                        </div>
                                        <div class="avatar-sm">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-3">
                                                <i class="bi bi-journal-check"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">Assessments recorded</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Results and Events -->
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Academic Results</h5>
                                    <div class="table-responsive">
                                        <table class="table table-centered table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Subject</th>
                                                    <th>C.A.</th>
                                                    <th>Exam</th>
                                                    <th>Total</th>
                                                    <th>Grade</th>
                                                    <th>Remark</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof recentResults !== 'undefined' && recentResults && recentResults.length > 0) { %>
                                                    <% recentResults.forEach(function(r) { 
                                                        var tot = (Number(r.ca_score || r.test_score || 0) + Number(r.exam_score || 0));
                                                    %>
                                                    <tr>
                                                        <td class="fw-semibold"><%= r.subject_name || r.subjectName %></td>
                                                        <td><%= r.ca_score || r.test_score || 0 %></td>
                                                        <td><%= r.exam_score || 0 %></td>
                                                        <td><strong><%= tot %></strong></td>
                                                        <td><span class="badge bg-primary-subtle text-primary fw-bold"><%= r.grade || '-' %></span></td>
                                                        <td><small class="text-muted"><%= r.remarks || r.remark || '-' %></small></td>
                                                    </tr>
                                                    <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="text-center py-4 text-muted">
                                                            No test or exam scores available for this child yet.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Class Events</h5>
                                    <% if (typeof upcomingEvents !== 'undefined' && upcomingEvents && upcomingEvents.length > 0) { %>
                                        <ul class="list-group list-group-flush">
                                            <% upcomingEvents.forEach(function(ev) { %>
                                                <li class="list-group-item px-0 py-2">
                                                    <div class="fw-semibold text-body"><%= ev.title %></div>
                                                    <small class="text-muted"><%= ev.description || '' %></small>
                                                    <div class="text-primary small font-monospace mt-1">
                                                        <%= ev.eventDate ? (typeof moment !== 'undefined' ? moment(ev.eventDate).format('DD MMM YYYY') : ev.eventDate) : '' %>
                                                    </div>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    <% } else { %>
                                        <p class="text-muted small mb-0">No specific events scheduled for this class.</p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title mb-3">Quick Navigation</h5>
                                    <div class="d-grid gap-2">
                                        <a href="/parent/make-payment?studentId=<%= child.id %>" class="btn btn-primary text-start">
                                            <i class="bi bi-wallet2 me-2"></i>Pay Fees for <%= child.firstName %>
                                        </a>
                                        <a href="/parent/reports?studentId=<%= child.id %>" class="btn btn-outline-info text-start">
                                            <i class="bi bi-file-earmark-pdf me-2"></i>View Term Report Card
                                        </a>
                                        <a href="/parent/attendance" class="btn btn-outline-secondary text-start">
                                            <i class="bi bi-clock-history me-2"></i>Daily Attendance Records
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            © EduSuite School Management System
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="/assets/js/vendor.min.js"></script>
    <script src="/assets/js/app.min.js"></script>
</body>
</html>
