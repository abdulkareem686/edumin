<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="utf-8" />
   <title>
      <%= isEdit ? 'Edit' : 'Create' %> Lesson Note - School Management System
   </title>
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
   <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
   <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
   <style>
      .required-field::after {
         content: " *";
         color: red;
      }

      .form-section {
         margin-bottom: 2rem;
         padding: 1.5rem;
         border: 1px solid #e9ecef;
         border-radius: 0.5rem;
         background-color: #f8f9fa;
      }

      .form-section-title {
         color: #3b5de7;
         border-bottom: 2px solid #3b5de7;
         padding-bottom: 0.5rem;
         margin-bottom: 1.5rem;
      }

      .week-selector {
         display: flex;
         flex-wrap: wrap;
         gap: 10px;
      }

      .week-btn {
         width: 60px;
         text-align: center;
      }

      .week-btn.active {
         background-color: #3b5de7;
         color: white;
         border-color: #3b5de7;
      }

      .existing-warning {
         background-color: #fff3cd;
         border: 1px solid #ffc107;
         border-radius: 8px;
         padding: 15px;
         margin-bottom: 20px;
      }

      .file-list {
         margin-top: 10px;
      }

      .file-item {
         background-color: #e9ecef;
         border-radius: 5px;
         padding: 8px 12px;
         margin-bottom: 8px;
         display: flex;
         justify-content: space-between;
         align-items: center;
      }

      .file-upload-area {
         border: 2px dashed #dee2e6;
         border-radius: 8px;
         padding: 20px;
         text-align: center;
         cursor: pointer;
         transition: all 0.3s;
      }

      .file-upload-area:hover {
         border-color: #3b5de7;
         background-color: #f8f9fa;
      }
   </style>
</head>

<body class="loading"
   data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
   <div class="wrapper">
      <!-- Left Sidebar -->
      <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/app-sidebar') %>
        <!-- Left Sidebar End -->

        

      <div class="content-page">
         <div class="content">
            <!-- Topbar -->
                <%- include('partials/app-navbar') %>
                <!-- end Topbar -->

            <div class="container-fluid">
               <div class="row">
                  <div class="col-12">
                     <div class="page-title-box">
                        <div class="page-title-right">
                           <a href="/lesson-notes" class="btn btn-outline-secondary">
                              <i class="bi bi-arrow-left me-1"></i> Back to Notes
                           </a>
                        </div>
                        <h4 class="page-title">
                           <%= isEdit ? 'Edit' : 'Create' %> Lesson Note
                        </h4>
                     </div>
                  </div>
               </div>

               <% if (error) { %>
                  <div class="alert alert-danger">
                     <%= error %>
                  </div>
                  <% } %>

                     <!-- Existing Lesson Note Warning -->
                     <div id="existingWarning" class="existing-warning" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        <strong>Warning:</strong> A lesson note already exists for this selection.
                        <span id="existingInfo"></span>
                        <a href="#" id="editExistingLink" class="btn btn-sm btn-warning ms-2">Edit Existing</a>
                     </div>

                     <div class="row">
                        <div class="col-12">
                           <div class="card">
                              <div class="card-body">
                                 <form action="/lesson-notes/save" method="post" id="lessonNoteForm"
                                    enctype="multipart/form-data">
                                    <% if (isEdit) { %>
                                       <input type="hidden" name="lessonNoteId" value="<%= lessonNote.id %>">
                                       <% } %>

                                          <!-- Basic Information Section -->
                                          <div class="form-section">
                                             <h5 class="form-section-title"><i class="bi bi-info-circle me-2"></i>Basic
                                                Information</h5>
                                             <div class="row">
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Academic Year</label>
                                                      <select class="form-select" name="academicYear" id="academicYear"
                                                         required>
                                                         <option value="">Select Academic Year</option>
                                                         <% academicYears.forEach(function(year) { %>
                                                            <option value="<%= year.year_name %>"
                                                               <%=(lessonNote.academic_year===year.year_name)
                                                               ? 'selected' : '' %>>
                                                               <%= year.year_name %>
                                                            </option>
                                                            <% }); %>
                                                      </select>
                                                   </div>
                                                </div>
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Term</label>
                                                      <select class="form-select" name="term" id="term" required>
                                                         <option value="">Select Term</option>
                                                         <% terms.forEach(function(t) { %>
                                                            <option value="<%= t.term_name %>"
                                                               <%=(lessonNote.term===t.term_name) ? 'selected' : '' %>>
                                                               <%= t.term_name %>
                                                            </option>
                                                            <% }); %>
                                                      </select>
                                                   </div>
                                                </div>
                                             </div>

                                             <!-- Class and Department Selection -->
                                             <div class="row">
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Class</label>
                                                      <select class="form-select" name="classId" id="classId" required>
                                                         <option value="">Select Class</option>
                                                         <% if (allClasses && allClasses.length> 0) {
                                                            for(var i = 0; i < allClasses.length; i++) { var
                                                               cls=allClasses[i]; %>
                                                               <option value="<%= cls.id %>">
                                                                  <%= cls.className %>
                                                                     <%= cls.department ? '(' + cls.department + ')'
                                                                        : '' %> - <%= cls.level || '' %>
                                                               </option>
                                                               <% } } else { %>
                                                                  <option value="">No classes available</option>
                                                                  <% } %>
                                                      </select>
                                                   </div>
                                                </div>
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Subject</label>
                                                      <select class="form-select" name="subjectId" id="subjectId"
                                                         required>
                                                         <option value="">Select Subject</option>
                                                         <% if (subjects && subjects.length> 0) {
                                                            for(var i = 0; i < subjects.length; i++) { var
                                                               subject=subjects[i]; %>
                                                               <option value="<%= subject.id %>">
                                                                  <%= subject.name %> (<%= subject.subject_code %>)
                                                               </option>
                                                               <% } } else { %>
                                                                  <option value="">No subjects available</option>
                                                                  <% } %>
                                                      </select>
                                                   </div>
                                                </div>
                                             </div>

                                             <div class="row">
                                                <div class="col-12">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Week Number</label>
                                                      <div class="week-selector" id="weekSelector">
                                                         <% for (var w=1; w <=11; w++) { %>
                                                            <button type="button"
                                                               class="btn btn-outline-primary week-btn <%= (lessonNote.week_number == w) ? 'active' : '' %>"
                                                               data-week="<%= w %>">
                                                               Week <%= w %>
                                                            </button>
                                                            <% } %>
                                                      </div>
                                                      <input type="hidden" name="weekNumber" id="weekNumber"
                                                         value="<%= lessonNote.week_number || '' %>" required>
                                                   </div>
                                                </div>
                                             </div>
                                             <div class="row">
                                                <div class="col-12">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Title</label>
                                                      <input type="text" class="form-control" name="title"
                                                         value="<%= lessonNote.title || '' %>" required>
                                                   </div>
                                                </div>
                                             </div>
                                          </div>

                                          <!-- File Upload Section -->
                                          <div class="form-section">
                                             <h5 class="form-section-title"><i
                                                   class="bi bi-file-earmark-arrow-up me-2"></i>Upload Documents</h5>
                                             <div class="row">
                                                <div class="col-12">
                                                   <div class="mb-3">
                                                      <label class="form-label">Lesson Note File (Word/PDF)</label>
                                                      <div class="file-upload-area" id="fileUploadArea">
                                                         <i class="bi bi-cloud-upload fs-1 text-muted"></i>
                                                         <p class="mt-2 mb-0">Click or drag files here to upload</p>
                                                         <small class="text-muted">Supported formats: .doc, .docx, .pdf
                                                            (Max 10MB)</small>
                                                         <input type="file" name="lessonNoteFile" id="lessonNoteFile"
                                                            accept=".doc,.docx,.pdf" style="display: none;">
                                                      </div>
                                                      <div id="uploadedFileInfo" class="file-list"
                                                         style="display: none;">
                                                         <div class="file-item">
                                                            <div>
                                                               <i class="bi bi-file-earmark-text me-2"></i>
                                                               <span id="fileName"></span>
                                                               <span class="badge bg-info ms-2" id="fileSize"></span>
                                                            </div>
                                                            <button type="button" class="btn btn-sm btn-danger"
                                                               onclick="removeFile()">
                                                               <i class="bi bi-trash"></i>
                                                            </button>
                                                         </div>
                                                      </div>
                                                      <input type="hidden" name="existingFile" id="existingFile"
                                                         value="<%= lessonNote.file_path || '' %>">
                                                   </div>
                                                </div>
                                             </div>
                                          </div>

                                          <!-- Lesson Content Section -->
                                          <div class="form-section">
                                             <h5 class="form-section-title"><i class="bi bi-file-text me-2"></i>Lesson
                                                Content</h5>
                                             <div class="row">
                                                <div class="col-12">
                                                   <div class="mb-3">
                                                      <label class="form-label required-field">Content / Lesson
                                                         Body</label>
                                                      <textarea class="form-control summernote" name="content" rows="10"
                                                         required><%= lessonNote.content || '' %></textarea>
                                                      <small class="text-muted">Detailed lesson content, step-by-step
                                                         explanation</small>
                                                   </div>
                                                </div>
                                             </div>
                                             <div class="row">
                                                <div class="col-12">
                                                   <div class="mb-3">
                                                      <label class="form-label">Learning Objectives</label>
                                                      <textarea class="form-control" name="objectives" rows="3"
                                                         placeholder="What students should be able to do after this lesson..."><%= lessonNote.objectives || '' %></textarea>
                                                   </div>
                                                </div>
                                             </div>
                                          </div>

                                          <!-- Materials Section -->
                                          <div class="form-section">
                                             <h5 class="form-section-title"><i class="bi bi-box-seam me-2"></i>Materials
                                                & Resources</h5>
                                             <div class="row">
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label">Teaching Materials</label>
                                                      <textarea class="form-control" name="materials" rows="3"
                                                         placeholder="Books, equipment, visual aids..."><%= lessonNote.materials || '' %></textarea>
                                                   </div>
                                                </div>
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label">References</label>
                                                      <textarea class="form-control" name="reference_materials" rows="3"
                                                         placeholder="Textbook references, online resources..."><%= lessonNote.reference_materials || '' %></textarea>
                                                   </div>
                                                </div>
                                             </div>
                                          </div>

                                          <!-- Status Section -->
                                          <div class="form-section">
                                             <h5 class="form-section-title"><i class="bi bi-flag me-2"></i>Status</h5>
                                             <div class="row">
                                                <div class="col-md-6">
                                                   <div class="mb-3">
                                                      <label class="form-label">Status</label>
                                                      <select class="form-select" name="status">
                                                         <option value="draft" <%=(lessonNote.status==='draft' )
                                                            ? 'selected' : '' %>>Draft</option>
                                                         <option value="published" <%=(lessonNote.status==='published' )
                                                            ? 'selected' : '' %>>Published</option>
                                                         <option value="archived" <%=(lessonNote.status==='archived' )
                                                            ? 'selected' : '' %>>Archived</option>
                                                      </select>
                                                   </div>
                                                </div>
                                             </div>
                                          </div>

                                          <div class="text-end mt-4">
                                             <a href="/lesson-notes" class="btn btn-light me-2">Cancel</a>
                                             <button type="submit" class="btn btn-primary">
                                                <%= isEdit ? 'Update' : 'Create' %> Lesson Note
                                             </button>
                                          </div>
                                 </form>
                              </div>
                           </div>
                        </div>
                     </div>
            </div>
         </div>

         <footer class="footer">
            <div class="container-fluid">
               <div class="row">
                  <div class="col-md-6">© EduSuite</div>
               </div>
            </div>
         </footer>
      </div>
   </div>

   <script src="/assets/js/vendor.min.js"></script>
   <script src="/assets/js/app.min.js"></script>
   <!-- Summernote for rich text editor -->
   <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.css" rel="stylesheet">
   <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>
   
   <script>
      // ============================================
      // Initialize Summernote
      // ============================================
      $(document).ready(function () {
         $('.summernote').summernote({
            height: 300,
            toolbar: [
               ['style', ['style']],
               ['font', ['bold', 'underline', 'clear']],
               ['color', ['color']],
               ['para', ['ul', 'ol', 'paragraph']],
               ['table', ['table']],
               ['insert', ['link', 'picture', 'video']],
               ['view', ['fullscreen', 'codeview', 'help']]
            ]
         });
      });

      // ============================================
      // DOM Elements
      // ============================================
      var fileUploadArea = document.getElementById('fileUploadArea');
      var fileInput = document.getElementById('lessonNoteFile');
      var uploadedFileInfo = document.getElementById('uploadedFileInfo');
      var fileNameSpan = document.getElementById('fileName');
      var fileSizeSpan = document.getElementById('fileSize');
      var weekNumberInput = document.getElementById('weekNumber');
      var isEdit = <%= typeof isEdit !== 'undefined' && isEdit ? 'true' : 'false' %>;

      // ============================================
      // File Upload Handling
      // ============================================
      // Check if there's an existing file
      var existingFile = document.getElementById('existingFile') ? document.getElementById('existingFile').value : '';
      if (existingFile) {
         var fileName = existingFile.split('/').pop();
         if (fileNameSpan) {
            fileNameSpan.innerHTML = '<i class="bi bi-file-earmark-text me-2"></i> ' + fileName;
         }
         if (fileSizeSpan) {
            fileSizeSpan.textContent = 'Uploaded';
         }
         if (uploadedFileInfo) {
            uploadedFileInfo.style.display = 'block';
         }
      }

      if (fileUploadArea) {
         fileUploadArea.addEventListener('click', function () {
            if (fileInput) fileInput.click();
         });

         fileUploadArea.addEventListener('dragover', function (e) {
            e.preventDefault();
            fileUploadArea.style.borderColor = '#3b5de7';
            fileUploadArea.style.backgroundColor = '#f8f9fa';
         });

         fileUploadArea.addEventListener('dragleave', function (e) {
            e.preventDefault();
            fileUploadArea.style.borderColor = '#dee2e6';
            fileUploadArea.style.backgroundColor = 'transparent';
         });

         fileUploadArea.addEventListener('drop', function (e) {
            e.preventDefault();
            fileUploadArea.style.borderColor = '#dee2e6';
            fileUploadArea.style.backgroundColor = 'transparent';
            var files = e.dataTransfer.files;
            if (files.length > 0) {
               handleFile(files[0]);
            }
         });
      }

      if (fileInput) {
         fileInput.addEventListener('change', function (e) {
            if (e.target.files.length > 0) {
               handleFile(e.target.files[0]);
            }
         });
      }

      function handleFile(file) {
         var validTypes = [
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'application/pdf'
         ];
         var maxSize = 10 * 1024 * 1024;

         if (validTypes.indexOf(file.type) === -1) {
            showToast('Invalid file type. Please upload .doc, .docx, or .pdf files only.', 'danger');
            fileInput.value = '';
            return;
         }

         if (file.size > maxSize) {
            showToast('File size exceeds 10MB limit.', 'danger');
            fileInput.value = '';
            return;
         }

         var fileSize = (file.size / 1024 / 1024).toFixed(2) + ' MB';
         if (fileNameSpan) {
            fileNameSpan.innerHTML = '<i class="bi bi-file-earmark-text me-2"></i> ' + file.name;
         }
         if (fileSizeSpan) {
            fileSizeSpan.textContent = fileSize;
         }
         if (uploadedFileInfo) {
            uploadedFileInfo.style.display = 'block';
         }
         // Clear existing file value when new file is uploaded
         var existingFileInput = document.getElementById('existingFile');
         if (existingFileInput) {
            existingFileInput.value = '';
         }
      }

      window.removeFile = function () {
         if (fileInput) {
            fileInput.value = '';
         }
         if (uploadedFileInfo) {
            uploadedFileInfo.style.display = 'none';
         }
         var existingFileInput = document.getElementById('existingFile');
         if (existingFileInput) {
            existingFileInput.value = '';
         }
      };

      // ============================================
      // Load Subjects when Class is Selected
      // ============================================
      var classSelect = document.getElementById('classId');
      var subjectSelect = document.getElementById('subjectId');

      if (classSelect) {
         classSelect.addEventListener('change', function () {
            var classId = this.value;

            if (classId) {
               subjectSelect.disabled = true;
               subjectSelect.innerHTML = '<option value="">Loading subjects...</option>';

               fetch('/api/subjects-by-class?classId=' + encodeURIComponent(classId))
                  .then(function (response) {
                     return response.json();
                  })
                  .then(function (data) {
                     if (data.success && data.subjects && data.subjects.length > 0) {
                        subjectSelect.innerHTML = '<option value="">-- Select Subject --</option>';
                        for (var i = 0; i < data.subjects.length; i++) {
                           var option = document.createElement('option');
                           option.value = data.subjects[i].id;
                           option.textContent = data.subjects[i].name + ' (' + data.subjects[i].subject_code + ')';
                           subjectSelect.appendChild(option);
                        }
                        subjectSelect.disabled = false;
                        showToast('Subjects loaded successfully', 'success');
                     } else {
                        subjectSelect.innerHTML = '<option value="">No subjects available for this class</option>';
                        subjectSelect.disabled = true;
                        showToast('No subjects found for this class', 'warning');
                     }
                     // Check for existing lesson note after subjects load
                     checkExistingLessonNote();
                  })
                  .catch(function (error) {
                     console.error('Error loading subjects:', error);
                     subjectSelect.innerHTML = '<option value="">Error loading subjects</option>';
                     subjectSelect.disabled = true;
                     showToast('Failed to load subjects', 'danger');
                  });
            } else {
               subjectSelect.innerHTML = '<option value="">-- Select Subject --</option>';
               subjectSelect.disabled = true;
            }
         });
      }

      // ============================================
      // Week Selector
      // ============================================
      var weekButtons = document.querySelectorAll('.week-btn');

      if (weekButtons.length > 0) {
         weekButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
               weekButtons.forEach(function (b) {
                  b.classList.remove('active');
               });
               this.classList.add('active');
               if (weekNumberInput) {
                  weekNumberInput.value = this.getAttribute('data-week');
               }
               checkExistingLessonNote();
            });
         });
      }

      // ============================================
      // Check if Lesson Note Already Exists
      // ============================================
      function checkExistingLessonNote() {
         var classId = classSelect ? classSelect.value : null;
         var subjectId = subjectSelect ? subjectSelect.value : null;
         var academicYear = document.getElementById('academicYear') ? document.getElementById('academicYear').value : null;
         var term = document.getElementById('term') ? document.getElementById('term').value : null;
         var weekNumber = weekNumberInput ? weekNumberInput.value : null;

         // Only check if we're not in edit mode
         if (!isEdit && classId && subjectId && academicYear && term && weekNumber) {
            var url = '/api/lesson-notes/check?classId=' + encodeURIComponent(classId) +
               '&subjectId=' + encodeURIComponent(subjectId) +
               '&academicYear=' + encodeURIComponent(academicYear) +
               '&term=' + encodeURIComponent(term) +
               '&weekNumber=' + encodeURIComponent(weekNumber);

            fetch(url)
               .then(function (response) {
                  return response.json();
               })
               .then(function (data) {
                  var warningDiv = document.getElementById('existingWarning');
                  var existingInfoSpan = document.getElementById('existingInfo');
                  var editLink = document.getElementById('editExistingLink');

                  if (data.exists) {
                     if (warningDiv) {
                        warningDiv.style.display = 'block';
                     }
                     if (existingInfoSpan) {
                        existingInfoSpan.innerHTML = '"' + (data.title || 'Untitled') + '" (' + (data.status || 'draft') + ')';
                     }
                     if (editLink) {
                        editLink.href = '/lesson-notes/edit/' + data.lessonNoteId;
                     }
                  } else {
                     if (warningDiv) {
                        warningDiv.style.display = 'none';
                     }
                  }
               })
               .catch(function (error) {
                  console.error('Error checking lesson note:', error);
               });
         } else {
            var warningDiv = document.getElementById('existingWarning');
            if (warningDiv) {
               warningDiv.style.display = 'none';
            }
         }
      }

      // ============================================
      // Event Listeners for Checking Existing Lesson Note
      // ============================================
      var academicYearSelect = document.getElementById('academicYear');
      var termSelect = document.getElementById('term');

      if (classSelect) classSelect.addEventListener('change', checkExistingLessonNote);
      if (subjectSelect) subjectSelect.addEventListener('change', checkExistingLessonNote);
      if (academicYearSelect) academicYearSelect.addEventListener('change', checkExistingLessonNote);
      if (termSelect) termSelect.addEventListener('change', checkExistingLessonNote);

      // ============================================
      // Auto-dismiss Alerts
      // ============================================
      setTimeout(function () {
         var alerts = document.querySelectorAll('.alert');
         alerts.forEach(function (alert) {
            setTimeout(function () {
               alert.classList.remove('show');
               setTimeout(function () {
                  if (alert.parentNode) {
                     alert.remove();
                  }
               }, 300);
            }, 5000);
         });
      }, 5000);

      // ============================================
      // Toast Notification System
      // ============================================
      function showToast(message, type) {
         var container = document.querySelector('.toast-container');
         if (!container) {
            container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
         }

         // Remove existing toasts if too many
         var existingToasts = container.querySelectorAll('.toast');
         if (existingToasts.length >= 5) {
            existingToasts[0].remove();
         }

         var iconMap = {
            'success': 'bi-check-circle',
            'danger': 'bi-exclamation-triangle',
            'warning': 'bi-exclamation-triangle',
            'info': 'bi-info-circle'
         };

         var toast = document.createElement('div');
         toast.className = 'toast align-items-center text-white bg-' + type + ' border-0 fade show';
         toast.setAttribute('role', 'alert');
         toast.setAttribute('aria-live', 'assertive');
         toast.setAttribute('aria-atomic', 'true');
         toast.innerHTML = `
            <div class="d-flex">
               <div class="toast-body">
                  <i class="bi ${iconMap[type] || 'bi-info-circle'} me-2"></i>
                  ${message}
               </div>
               <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
         `;

         container.appendChild(toast);

         // Auto dismiss after 5 seconds
         setTimeout(function () {
            if (toast.parentNode) {
               toast.classList.remove('show');
               setTimeout(function () {
                  if (toast.parentNode) {
                     toast.remove();
                  }
               }, 300);
            }
         }, 5000);
      }

      // ============================================
      // Notification Functions
      // ============================================
      window.markRead = function (notificationId) {
         fetch('/admin/notifications/mark-read/' + notificationId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
         })
            .then(function (response) {
               return response.json();
            })
            .then(function (data) {
               if (data.success) {
                  location.reload();
               }
            })
            .catch(function (error) {
               console.error('Error marking notification as read:', error);
            });
      };

      window.markAllRead = function () {
         fetch('/admin/notifications/mark-all-read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
         })
            .then(function (response) {
               return response.json();
            })
            .then(function (data) {
               if (data.success) {
                  location.reload();
               }
            })
            .catch(function (error) {
               console.error('Error marking all notifications as read:', error);
            });
      };

      // ============================================
      // Form Validation Before Submit
      // ============================================
      var lessonNoteForm = document.getElementById('lessonNoteForm');
      if (lessonNoteForm) {
         lessonNoteForm.addEventListener('submit', function (e) {
            var content = $('.summernote').summernote('code');
            if (!content || content.trim() === '' || content === '<p><br></p>') {
               e.preventDefault();
               showToast('Please enter lesson content before submitting.', 'warning');
               return false;
            }

            var title = document.querySelector('input[name="title"]');
            if (title && (!title.value || title.value.trim() === '')) {
               e.preventDefault();
               showToast('Please enter a title for the lesson note.', 'warning');
               title.focus();
               return false;
            }

            return true;
         });
      }

      // ============================================
      // Confirm Navigation Away with Unsaved Changes
      // ============================================
      var formChanged = false;
      var formInputs = document.querySelectorAll('#lessonNoteForm input, #lessonNoteForm textarea, #lessonNoteForm select');

      formInputs.forEach(function (input) {
         input.addEventListener('change', function () {
            formChanged = true;
         });
      });

      // Summernote change detection
      $('.summernote').on('summernote.change', function () {
         formChanged = true;
      });

      window.addEventListener('beforeunload', function (e) {
         if (formChanged) {
            e.preventDefault();
            e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
            return e.returnValue;
         }
      });

      // Reset form changed flag on submit
      if (lessonNoteForm) {
         lessonNoteForm.addEventListener('submit', function () {
            formChanged = false;
         });
      }

      // ============================================
      // Initialize any existing selections
      // ============================================
      // If editing, trigger class change to load subjects
      if (isEdit && classSelect && classSelect.value) {
         // Trigger change to load subjects
         var event = new Event('change');
         classSelect.dispatchEvent(event);
      }

      // Initial check for existing lesson note
      setTimeout(checkExistingLessonNote, 500);

      console.log('Lesson Notes Form initialized successfully');
      console.log('Edit mode:', isEdit);
   </script>
   
</body>

</html>