                    <!-- Start Content-->
<div class="container-fluid">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                
                <h4 class="page-title">Teacher Profile: <%= teacher.firstName %> <%= teacher.lastName %></h4>
            </div>
        </div>
    </div>     

    <div class="row">
        <div class="col-sm-12">
            <!-- Profile Header -->
            <div class="card bg-primary">
                <div class="card-body profile-user-box">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="avatar-lg">
                                <% if (teacher.imagePath) { %>
                                    <img src="<%= teacher.imagePath %>" alt="<%= teacher.firstName %>" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px;">
                                <% } else { %>
                                    <div class="avatar-lg bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                        <span class="display-4 text-primary"><%= teacher.firstName.charAt(0) %><%= teacher.lastName.charAt(0) %></span>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="col">
                            <div>
                                <h4 class="mt-1 mb-1 text-white"><%= teacher.firstName %> <%= teacher.lastName %></h4>
                                <p class="font-13 text-white-50">
                                    <%= teacher.designation || 'Teacher' %> - <%= teacher.department || 'Department' %>
                                </p>
                                
                                <ul class="mb-0 list-inline text-light">
                                    <li class="list-inline-item me-3">
                                        <h5 class="mb-1"><%= teacher.joiningDate ? moment(teacher.joiningDate).format('YYYY') : 'N/A' %></h5>
                                        <p class="mb-0 font-13 text-white-50">Joining Year</p>
                                    </li>
                                    <li class="list-inline-item me-3">
                                        <h5 class="mb-1"><%= teacher.education || 'N/A' %></h5>
                                        <p class="mb-0 font-13 text-white-50">Education</p>
                                    </li>
                                    <li class="list-inline-item">
                                        <h5 class="mb-1"><%= teacher.nationality || 'N/A' %></h5>
                                        <p class="mb-0 font-13 text-white-50">Nationality</p>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-auto">
                            <a href="/" class="btn btn-light">
                                <i class="mdi mdi-home me-1"></i> Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-xl-4">
            <!-- Personal Information -->
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mt-0 mb-3">Personal Information</h4>
                    
                    <hr>

                    <div class="text-start">
                        <p class="text-muted mb-2"><strong>Full Name:</strong> 
                            <span class="ms-2"><%= teacher.firstName %> <%= teacher.lastName %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Email:</strong> 
                            <span class="ms-2"><%= teacher.email %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Mobile:</strong>
                            <span class="ms-2"><%= teacher.mobileNumber || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Date of Birth:</strong> 
                            <span class="ms-2"><%= teacher.dateOfBirth ? moment(teacher.dateOfBirth).format('MMMM Do, YYYY') : 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Gender:</strong> 
                            <span class="ms-2"><%= teacher.gender || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Education:</strong> 
                            <span class="ms-2"><%= teacher.education || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-0"><strong>Nationality:</strong> 
                            <span class="ms-2"><%= teacher.nationality || 'N/A' %></span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4 class="header-title mt-0 mb-3">Contact Information</h4>
                    
                    <hr>
                    
                    <div class="text-start">
                        <p class="text-muted mb-2"><strong>Emergency Contact:</strong> 
                            <span class="ms-2"><%= teacher.emergencyContactName || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Emergency Phone:</strong>
                            <span class="ms-2"><%= teacher.emergencyContactNumber || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-0"><strong>Address:</strong> 
                            <span class="ms-2"><%= teacher.address || 'N/A' %></span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Geographical Information -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4 class="header-title mt-0 mb-3">Geographical Information</h4>
                    
                    <hr>
                    
                    <div class="text-start">
                        <p class="text-muted mb-2"><strong>State of Origin:</strong> 
                            <span class="ms-2"><%= teacher.stateOfOrigin || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>LGA of Origin:</strong>
                            <span class="ms-2"><%= teacher.localGovernment || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-2"><strong>Residential State:</strong> 
                            <span class="ms-2"><%= teacher.residentialState || 'N/A' %></span>
                        </p>

                        <p class="text-muted mb-0"><strong>Residential LGA:</strong> 
                            <span class="ms-2"><%= teacher.residentialLGA || 'N/A' %></span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <!-- Professional Information -->
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mb-3">Professional Information</h4>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Designation</strong></label>
                                <p class="text-muted"><%= teacher.designation || 'N/A' %></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Department</strong></label>
                                <p class="text-muted"><%= teacher.department || 'N/A' %></p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Joining Date</strong></label>
                                <p class="text-muted"><%= teacher.joiningDate ? moment(teacher.joiningDate).format('MMMM Do, YYYY') : 'N/A' %></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Years of Service</strong></label>
                                <p class="text-muted">
                                    <% if (teacher.joiningDate) { %>
                                        <%= moment().diff(moment(teacher.joiningDate), 'years') %> years
                                    <% } else { %>
                                        N/A
                                    <% } %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Employee ID</strong></label>
                                <p class="text-muted">TCH-<%= teacher.id.toString().padStart(4, '0') %></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label"><strong>Status</strong></label>
                                <p class="text-muted">
                                    <span class="badge bg-<%= teacher.is_active ? 'success' : 'danger' %>">
                                        <%= teacher.is_active ? 'Active' : 'Inactive' %>
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
            <!-- Performance Metrics -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4 class="header-title mb-3">Performance Metrics</h4>
                    
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="card border-primary mb-0">
                                <div class="card-body">
                                    <h1 class="display-4">4.7</h1>
                                    <p class="text-muted mb-0">Average Rating</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-success mb-0">
                                <div class="card-body">
                                    <h1 class="display-4">92%</h1>
                                    <p class="text-muted mb-0">Attendance</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-info mb-0">
                                <div class="card-body">
                                    <h1 class="display-4">86%</h1>
                                    <p class="text-muted mb-0">Pass Rate</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-warning mb-0">
                                <div class="card-body">
                                    <h1 class="display-4">3</h1>
                                    <p class="text-muted mb-0">Classes</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card mt-3">
                <div class="card-body">
                    <h4 class="header-title mb-3">Quick Actions</h4>
                    
                    <div class="row">
                        
                        <div class="col-md-3">
                            <a href="mailto:<%= teacher.email %>" class="btn btn-outline-success w-100 mb-2">
                                <i class="mdi mdi-email me-1"></i> Send Email
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="tel:<%= teacher.mobileNumber %>" class="btn btn-outline-info w-100 mb-2">
                                <i class="mdi mdi-phone me-1"></i> Call Teacher
                            </a>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>                </div> <!-- content -->

                <!-- Footer Start -->
                <footer class="footer">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-6">
                                <script>document.write(new Date().getFullYear())</script> © School Management System
                            </div>
                            <div class="col-md-6">
                                <div class="text-md-end footer-links d-none d-md-block">
                                    <a href="javascript: void(0);">About</a>
                                    <a href="javascript: void(0);">Support</a>
                                    <a href="javascript: void(0);">Contact Us</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
                <!-- end Footer -->

            </div>

            <!-- ============================================================== -->
            <!-- End Page content -->
            <!-- ============================================================== -->
        </div>
        <!-- END wrapper -->

        <!-- Right Sidebar -->
        <!-- (content remains the same) -->

        <!-- bundle -->
        <script src="/assets/js/vendor.min.js"></script>
        <script src="/assets/js/app.min.js"></script>

        <!-- third party js -->
        <script src="/assets/js/vendor/Chart.bundle.min.js"></script>
        <!-- third party js ends -->

        <!-- demo app -->
        <script src="/assets/js/pages/demo.profile.js"></script>
        <!-- end demo js-->
    </body>
</html>