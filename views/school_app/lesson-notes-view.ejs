<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="utf-8" />
   <title>View Lesson Note - School Management System</title>
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link href="/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
   <link href="/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
   <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
   <style>
      .lesson-header {
         background: linear-gradient(135deg, #3b5de7 0%, #5a7ce8 100%);
         color: white;
         padding: 30px;
         border-radius: 10px;
         margin-bottom: 25px;
      }

      .lesson-section {
         margin-bottom: 2rem;
         padding: 1.5rem;
         border: 1px solid #e9ecef;
         border-radius: 0.5rem;
         background-color: #f8f9fa;
      }

      .lesson-section-title {
         color: #3b5de7;
         border-bottom: 2px solid #3b5de7;
         padding-bottom: 0.5rem;
         margin-bottom: 1.5rem;
      }

      .badge-week {
         background: rgba(255, 255, 255, 0.2);
         padding: 5px 15px;
         border-radius: 20px;
         font-size: 0.8rem;
      }

      .comment-box {
         background-color: #fff;
         border: 1px solid #e9ecef;
         border-radius: 8px;
         padding: 15px;
         margin-bottom: 15px;
      }

      .comment-meta {
         font-size: 0.75rem;
         color: #6c757d;
         margin-bottom: 8px;
      }

      .status-published {
         background: #28a745;
         color: white;
         padding: 3px 10px;
         border-radius: 20px;
         font-size: 0.7rem;
      }

      .status-draft {
         background: #ffc107;
         color: #856404;
         padding: 3px 10px;
         border-radius: 20px;
         font-size: 0.7rem;
      }

      .status-archived {
         background: #6c757d;
         color: white;
         padding: 3px 10px;
         border-radius: 20px;
         font-size: 0.7rem;
      }
   </style>
</head>

<body class="loading"
   data-layout-config='{"leftSideBarTheme":"dark","layoutBoxed":false, "leftSidebarCondensed":false, "leftSidebarScrollable":false,"darkMode":false, "showRightSidebarOnStart": true}'>
   <div class="wrapper">
      <!-- Left Sidebar -->
      <!-- ========== Left Sidebar Start ========== -->
        <%- include('partials/app-sidebar') %>
        <!-- Left Sidebar End -->

        

      <div class="content-page">
         <div class="content">
            <!-- Topbar -->
                <%- include('partials/app-navbar') %>
                <!-- end Topbar -->

            <div class="container-fluid">
               <div class="row">
                  <div class="col-12">
                     <div class="page-title-box">
                        <div class="page-title-right">
                           <a href="/lesson-notes" class="btn btn-outline-secondary">
                              <i class="bi bi-arrow-left me-1"></i> Back to Notes
                           </a>
                           <a href="/lesson-notes/edit/<%= lessonNote.id %>" class="btn btn-primary ms-2">
                              <i class="bi bi-pencil me-1"></i> Edit
                           </a>
                           <a href="/lesson-notes/delete/<%= lessonNote.id %>" class="btn btn-danger ms-2"
                              onclick="return confirm('Delete this lesson note?')">
                              <i class="bi bi-trash me-1"></i> Delete
                           </a>
                        </div>
                        <h4 class="page-title">Lesson Note Details</h4>
                     </div>
                  </div>
               </div>

               <!-- Lesson Header -->
               <div class="lesson-header">
                  <div class="d-flex justify-content-between align-items-start">
                     <div>
                        <h2 class="mb-2">
                           <%= lessonNote.title %>
                        </h2>
                        <div class="mt-2">
                           <span class="badge-week me-2"><i class="bi bi-calendar-week"></i> Week <%=
                                 lessonNote.week_number %></span>
                           <span class="badge-week me-2"><i class="bi bi-building"></i>
                              <%= lessonNote.className %>
                           </span>
                           <span class="badge-week me-2"><i class="bi bi-book"></i>
                              <%= lessonNote.subject_name %>
                           </span>
                           <span class="badge-week"><i class="bi bi-person"></i>
                              <%= lessonNote.teacher_name %>
                           </span>
                        </div>
                        <div class="mt-3">
                           <small><i class="bi bi-calendar"></i> Created: <%= lessonNote.created_date %></small><br>
                           <small><i class="bi bi-pencil-square"></i> Last Updated: <%= lessonNote.updated_date %>
                                 </small>
                        </div>
                     </div>
                     <div>
                        <span class="status-<%= lessonNote.status %>">
                           <%= lessonNote.status ? lessonNote.status.toUpperCase() : 'DRAFT' %>
                        </span>
                     </div>
                  </div>
               </div>

               <!-- Academic Info -->
               <div class="lesson-section">
                  <h5 class="lesson-section-title"><i class="bi bi-calendar-range me-2"></i>Academic Information</h5>
                  <div class="row">
                     <div class="col-md-4">
                        <strong>Academic Year:</strong>
                        <%= lessonNote.academic_year %>
                     </div>
                     <div class="col-md-4">
                        <strong>Term:</strong>
                        <%= lessonNote.term %>
                     </div>
                     <div class="col-md-4">
                        <strong>Week:</strong> Week <%= lessonNote.week_number %>
                     </div>
                  </div>
               </div>

               <!-- Content Section -->
               <div class="lesson-section">
                  <h5 class="lesson-section-title"><i class="bi bi-file-text me-2"></i>Lesson Content</h5>
                  <div class="lesson-content">
                     <%= lessonNote.content.replace(/\n/g, '<br>' ) %>
                  </div>
               </div>

               <!-- Objectives Section -->
               <% if (lessonNote.objectives) { %>
                  <div class="lesson-section">
                     <h5 class="lesson-section-title"><i class="bi bi-bullseye me-2"></i>Learning Objectives</h5>
                     <div>
                        <%= lessonNote.objectives.replace(/\n/g, '<br>' ) %>
                     </div>
                  </div>
                  <% } %>

                     <!-- Materials Section -->
                     <% if (lessonNote.materials) { %>
                        <div class="lesson-section">
                           <h5 class="lesson-section-title"><i class="bi bi-box-seam me-2"></i>Teaching Materials</h5>
                           <div>
                              <%= lessonNote.materials.replace(/\n/g, '<br>' ) %>
                           </div>
                        </div>
                        <% } %>

                           <!-- References Section -->
                           <% if (lessonNote.references) { %>
                              <div class="lesson-section">
                                 <h5 class="lesson-section-title"><i class="bi bi-bookmark-star me-2"></i>References
                                 </h5>
                                 <div>
                                    <%= lessonNote.references.replace(/\n/g, '<br>' ) %>
                                 </div>
                              </div>
                              <% } %>

                                 <!-- Comments Section -->
                                 <div class="lesson-section">
                                    <h5 class="lesson-section-title"><i class="bi bi-chat-dots me-2"></i>Comments &
                                       Feedback</h5>

                                    <% if (comments && comments.length> 0) { %>
                                       <% comments.forEach(function(comment) { %>
                                          <div class="comment-box">
                                             <div class="comment-meta">
                                                <strong>
                                                   <%= comment.user_role==='admin' ? 'Admin' : 'Teacher' %>
                                                </strong>
                                                <i class="bi bi-dot"></i>
                                                <%= moment(comment.created_at).format('MMMM D, YYYY h:mm A') %>
                                             </div>
                                             <p class="mb-0">
                                                <%= comment.comment %>
                                             </p>
                                          </div>
                                          <% }); %>
                                             <% } else { %>
                                                <div class="text-center text-muted py-3">
                                                   <i class="bi bi-chat-square-text fs-1"></i>
                                                   <p class="mt-2">No comments yet</p>
                                                </div>
                                                <% } %>

                                                   <!-- Add Comment Form -->
                                                   <div class="mt-4">
                                                      <h6>Add Comment</h6>
                                                      <form id="commentForm">
                                                         <input type="hidden" name="lessonNoteId"
                                                            value="<%= lessonNote.id %>">
                                                         <div class="mb-3">
                                                            <textarea class="form-control" name="comment" rows="3"
                                                               placeholder="Write your comment here..."></textarea>
                                                         </div>
                                                         <button type="submit" class="btn btn-primary">Post
                                                            Comment</button>
                                                      </form>
                                                   </div>
                                 </div>
            </div>
         </div>

         <footer class="footer">
            <div class="container-fluid">
               <div class="row">
                  <div class="col-md-6">© EduSuite</div>
               </div>
            </div>
         </footer>
      </div>
   </div>

   <script src="/assets/js/vendor.min.js"></script>
   <script src="/assets/js/app.min.js"></script>
   <script>
      document.getElementById('commentForm').addEventListener('submit', async function (e) {
         e.preventDefault();
         const formData = new FormData(this);

         try {
            const response = await fetch('/lesson-notes/add-comment', {
               method: 'POST',
               body: formData
            });
            const result = await response.json();

            if (result.success) {
               location.reload();
            } else {
               alert('Error: ' + result.error);
            }
         } catch (error) {
            console.error('Error:', error);
            alert('Failed to add comment');
         }
      });
   </script>
</body>

</html>