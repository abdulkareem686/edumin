    <script>
        $(document).ready(function() {
            $('#reportSelectionForm').on('submit', function(e) {
                const classId = $('#classId').val();
                const term = $('#term').val();
                const academicYear = $('#academicYear').val();
                
                if (classId && term && academicYear) {
                    // Redirect to the specific term report for the selected class
                    const termSlug = term.toLowerCase().replace(' ', '-');
                    window.location.href = `/${termSlug}/${classId}?academicYear=${encodeURIComponent(academicYear)}`;
                    e.preventDefault();
                }
            });
            
            // Auto-submit when all fields are selected
            $('#classId, #term, #academicYear').change(function() {
                const classId = $('#classId').val();
                const term = $('#term').val();
                const academicYear = $('#academicYear').val();
                
                if (classId && term && academicYear) {
                    $('#reportSelectionForm').submit();
                }
            });
        });
    </script>
