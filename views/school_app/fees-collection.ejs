<!-- Fees Table -->
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="header-title">Fee Collection Records</h4>
            <span class="badge bg-primary">
                Total: <%= fees.length %> records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-centered table-striped dt-responsive nowrap w-100" id="fees-datatable">
                <thead class="table-light">
                    <tr>
                        <th>Receipt No</th>
                        <th>Student Name</th>
                        <th>Fee Type</th>
                        <th>Payment Type</th>
                        <th>Bill Amount</th>
                        <th>Amount Paid</th>
                        <th>Balance</th>
                        <th>Payment Date</th>
                        <th>Academic Period</th>
                        <th>Status</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (fees.length > 0) { %>
                        <% fees.forEach(function(fee) { %>
                        <tr>
                            <td>
                                <a href="/fee-receipt/<%= fee.id %>" class="text-primary fw-semibold">
                                    <%= fee.receiptNumber || 'N/A' %>
                                </a>
                            </td>
                            <td class="table-user">
                                <a href="/student-profile/<%= fee.studentId %>" class="text-body fw-semibold">
                                    <%= fee.studentName %>
                                </a>
                                <br>
                                <small class="text-muted">
                                    <%= fee.studentClassName || fee.className || 'N/A' %>
                                    <% if (fee.department) { %> - <%= fee.department %><% } %>
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark"><%= fee.feeType %></span>
                            </td>
                            <td>
                                <span class="badge bg-secondary"><%= fee.paymentType %></span>
                            </td>
                            <td>
                                <span class="fw-bold">₦<%= (fee.billAmount || fee.amount).toLocaleString('en-NG') %></span>
                            </td>
                            <td>
                                <span class="fw-bold text-success">₦<%= (fee.amountPaid || fee.amount).toLocaleString('en-NG') %></span>
                            </td>
                            <td>
                                <% if (fee.balance !== null && fee.balance !== undefined) { %>
                                    <% if (fee.balance > 0) { %>
                                        <span class="text-danger fw-bold">-₦<%= Math.abs(fee.balance).toLocaleString('en-NG') %></span>
                                        <br>
                                        <small class="text-muted">Due</small>
                                    <% } else if (fee.balance < 0) { %>
                                        <span class="text-info fw-bold">+₦<%= Math.abs(fee.balance).toLocaleString('en-NG') %></span>
                                        <br>
                                        <small class="text-muted">Credit</small>
                                    <% } else { %>
                                        <span class="text-success">₦0.00</span>
                                        <br>
                                        <small class="text-muted">Paid</small>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-muted">N/A</span>
                                <% } %>
                            </td>
                            <td>
                                <%= moment(fee.paymentDate).format('DD MMM YYYY') %>
                                <br>
                                <small class="text-muted">
                                    <%= moment(fee.created_at).fromNow() %>
                                </small>
                            </td>
                            <td>
                                <% if (fee.academicYear && fee.term) { %>
                                    <span class="text-muted">
                                        <%= fee.academicYear %>
                                        <br>
                                        <small><%= fee.term %></small>
                                    </span>
                                <% } else { %>
                                    <span class="text-muted">Not specified</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge <%= 
                                    fee.status === 'paid' ? 'bg-success' : 
                                    fee.status === 'pending' ? 'bg-warning' : 
                                    fee.status === 'partial' ? 'bg-warning' :
                                    fee.status === 'overpaid' ? 'bg-info' : 
                                    'bg-danger' %>">
                                    <%= fee.status.charAt(0).toUpperCase() + fee.status.slice(1) %>
                                </span>
                                <% if (fee.status === 'partial') { %>
                                    <br>
                                    <small class="text-muted">
                                        ₦<%= (fee.billAmount - fee.amountPaid).toLocaleString('en-NG') %> due
                                    </small>
                                <% } else if (fee.status === 'overpaid') { %>
                                    <br>
                                    <small class="text-muted">
                                        +₦<%= (fee.amountPaid - fee.billAmount).toLocaleString('en-NG') %> credit
                                    </small>
                                <% } %>
                            </td>
                            <td>
                                <div class="d-flex">
                                    <a href="/fee-receipt/<%= fee.id %>" class="action-icon text-info me-2" title="View Receipt" data-bs-toggle="tooltip">
                                        <i class="mdi mdi-receipt"></i>
                                    </a>
                                    <a href="/edit-fee/<%= fee.id %>" class="action-icon text-primary me-2" title="Edit" data-bs-toggle="tooltip">
                                        <i class="mdi mdi-square-edit-outline"></i>
                                    </a>
                                    <a href="/delete-fee/<%= fee.id %>" class="action-icon text-danger" title="Delete" data-bs-toggle="tooltip"
                                       onclick="return confirm('Are you sure you want to delete this fee record?')">
                                        <i class="mdi mdi-delete"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="11" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="mdi mdi-cash-remove display-4"></i>
                                    <h5 class="mt-3">No fee records found</h5>
                                    <p>Try adjusting your filters or add new fee records</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

