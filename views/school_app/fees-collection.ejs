                <!-- Filters Section -->
<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Filter Fees</h5>
                <form id="filterForm" class="row g-3">
                    <div class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Academic Year</label>
        <select class="form-select" name="academicYear" id="filterAcademicYear">
            <option value="">All Academic Years</option>
            <% academicYears.forEach(year => { %>
                <option value="<%= year.year_name %>" 
                    <%= selectedAcademicYear === year.year_name ? 'selected' : '' %>>
                    <%= year.year_name %>
                </option>
            <% }); %>
        </select>
    </div>
    
    <div class="col-md-2">
        <label class="form-label">Term</label>
        <select class="form-select" name="term" id="filterTerm">
            <option value="">All Terms</option>
            <option value="First Term" <%= selectedTerm === 'First Term' ? 'selected' : '' %>>First Term</option>
            <option value="Second Term" <%= selectedTerm === 'Second Term' ? 'selected' : '' %>>Second Term</option>
            <option value="Third Term" <%= selectedTerm === 'Third Term' ? 'selected' : '' %>>Third Term</option>
        </select>
    </div>
    
    <div class="col-md-3">
        <label class="form-label">Class</label>
        <select class="form-select" name="classId" id="filterClass">
            <option value="">All Classes</option>
            <% classes.forEach(cls => { %>
                <option value="<%= cls.id %>" <%= selectedClassId == cls.id ? 'selected' : '' %>>
                    <%= cls.className %> 
                    <% if (cls.department) { %>(<%= cls.department %>)<% } %>
                    - <%= cls.level %>
                </option>
            <% }); %>
        </select>
    </div>
    
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select class="form-select" name="status" id="filterStatus">
            <option value="">All Status</option>
            <option value="paid" <%= selectedStatus === 'paid' ? 'selected' : '' %>>Paid</option>
            <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="partial" <%= selectedStatus === 'partial' ? 'selected' : '' %>>Partial</option>
            <option value="overpaid" <%= selectedStatus === 'overpaid' ? 'selected' : '' %>>Overpaid</option>
        </select>
    </div>
    
    <div class="col-md-2">
        <label class="form-label">Fee Type</label>
        <select class="form-select" name="feeType" id="filterFeeType">
            <option value="">All Fee Types</option>
            <% if (typeof feeTypes !== 'undefined' && feeTypes.length > 0) { %>
                <% feeTypes.forEach(type => { %>
                    <option value="<%= type %>" <%= selectedFeeType === type ? 'selected' : '' %>>
                        <%= type %>
                    </option>
                <% }); %>
            <% } else { %>
                <!-- Fallback options if feeTypes is empty -->
                <option value="Tuition" <%= selectedFeeType === 'Tuition' ? 'selected' : '' %>>Tuition</option>
                <option value="Examination" <%= selectedFeeType === 'Examination' ? 'selected' : '' %>>Examination</option>
                <option value="Library" <%= selectedFeeType === 'Library' ? 'selected' : '' %>>Library</option>
                <option value="Sports" <%= selectedFeeType === 'Sports' ? 'selected' : '' %>>Sports</option>
                <option value="Transportation" <%= selectedFeeType === 'Transportation' ? 'selected' : '' %>>Transportation</option>
                <option value="Other" <%= selectedFeeType === 'Other' ? 'selected' : '' %>>Other</option>
            <% } %>
        </select>
    </div>
    
    <div class="col-md-12">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="mdi mdi-filter me-1"></i> Apply Filters
            </button>
            <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">
                <i class="mdi mdi-refresh me-1"></i> Reset
            </button>
            <button type="button" class="btn btn-success ms-auto" onclick="exportToExcel()">
                <i class="mdi mdi-file-excel me-1"></i> Export to Excel
            </button>
        </div>
    </div>
</div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card widget-flat bg-primary text-white">
            <div class="card-body">
                <div class="float-end">
                    <i class="mdi mdi-cash-multiple widget-icon"></i>
                </div>
                <h5 class="text-white fw-normal mt-0">Total Collected</h5>
                <h3 class="mt-3 mb-3">
                    ₦<%= fees.reduce((sum, fee) => sum + parseFloat(fee.amountPaid || fee.amount), 0).toLocaleString('en-NG') %>
                </h3>
                <p class="mb-0">
                    <span class="text-white-50">From <%= fees.filter(fee => fee.status === 'paid' || fee.status === 'partial' || fee.status === 'overpaid').length %> payments</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card widget-flat bg-warning text-white">
            <div class="card-body">
                <div class="float-end">
                    <i class="mdi mdi-clock-alert widget-icon"></i>
                </div>
                <h5 class="text-white fw-normal mt-0">Pending</h5>
                <h3 class="mt-3 mb-3">
                    ₦<%= fees.reduce((sum, fee) => fee.status === 'pending' ? sum + parseFloat(fee.amount) : sum, 0).toLocaleString('en-NG') %>
                </h3>
                <p class="mb-0">
                    <span class="text-white-50"><%= fees.filter(fee => fee.status === 'pending').length %> pending fees</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card widget-flat bg-info text-white">
            <div class="card-body">
                <div class="float-end">
                    <i class="mdi mdi-account-multiple widget-icon"></i>
                </div>
                <h5 class="text-white fw-normal mt-0">Total Students</h5>
                <h3 class="mt-3 mb-3">
                    <%= new Set(fees.map(fee => fee.studentId)).size %>
                </h3>
                <p class="mb-0">
                    <span class="text-white-50">With fee records</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-xl-3 col-md-6">
        <div class="card widget-flat bg-success text-white">
            <div class="card-body">
                <div class="float-end">
                    <i class="mdi mdi-calendar-month widget-icon"></i>
                </div>
                <h5 class="text-white fw-normal mt-0">This Month</h5>
                <h3 class="mt-3 mb-3">
                    ₦<%= fees.filter(fee => {
                        const feeDate = new Date(fee.paymentDate);
                        const now = new Date();
                        return feeDate.getMonth() === now.getMonth() && feeDate.getFullYear() === now.getFullYear();
                    }).reduce((sum, fee) => sum + parseFloat(fee.amountPaid || fee.amount), 0).toLocaleString('en-NG') %>
                </h3>
                <p class="mb-0">
                    <span class="text-white-50">Current month collection</span>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Fees Table -->
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="header-title">Fee Collection Records</h4>
            <span class="badge bg-primary">
                Total: <%= fees.length %> records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-centered table-striped dt-responsive nowrap w-100" id="fees-datatable">
                <thead class="table-light">
                    <tr>
                        <th>Receipt No</th>
                        <th>Student Name</th>
                        <th>Fee Type</th>
                        <th>Payment Type</th>
                        <th>Bill Amount</th>
                        <th>Amount Paid</th>
                        <th>Balance</th>
                        <th>Payment Date</th>
                        <th>Academic Period</th>
                        <th>Status</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (fees.length > 0) { %>
                        <% fees.forEach(function(fee) { %>
                        <tr>
                            <td>
                                <a href="/fee-receipt/<%= fee.id %>" class="text-primary fw-semibold">
                                    <%= fee.receiptNumber || 'N/A' %>
                                </a>
                            </td>
                            <td class="table-user">
                                <a href="/student-profile/<%= fee.studentId %>" class="text-body fw-semibold">
                                    <%= fee.studentName %>
                                </a>
                                <br>
                                <small class="text-muted">
                                    <%= fee.studentClassName || fee.className || 'N/A' %>
                                    <% if (fee.department) { %> - <%= fee.department %><% } %>
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark"><%= fee.feeType %></span>
                            </td>
                            <td>
                                <span class="badge bg-secondary"><%= fee.paymentType %></span>
                            </td>
                            <td>
                                <span class="fw-bold">₦<%= (fee.billAmount || fee.amount).toLocaleString('en-NG') %></span>
                            </td>
                            <td>
                                <span class="fw-bold text-success">₦<%= (fee.amountPaid || fee.amount).toLocaleString('en-NG') %></span>
                            </td>
                            <td>
                                <% if (fee.balance !== null && fee.balance !== undefined) { %>
                                    <% if (fee.balance > 0) { %>
                                        <span class="text-danger fw-bold">-₦<%= Math.abs(fee.balance).toLocaleString('en-NG') %></span>
                                        <br>
                                        <small class="text-muted">Due</small>
                                    <% } else if (fee.balance < 0) { %>
                                        <span class="text-info fw-bold">+₦<%= Math.abs(fee.balance).toLocaleString('en-NG') %></span>
                                        <br>
                                        <small class="text-muted">Credit</small>
                                    <% } else { %>
                                        <span class="text-success">₦0.00</span>
                                        <br>
                                        <small class="text-muted">Paid</small>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-muted">N/A</span>
                                <% } %>
                            </td>
                            <td>
                                <%= moment(fee.paymentDate).format('DD MMM YYYY') %>
                                <br>
                                <small class="text-muted">
                                    <%= moment(fee.created_at).fromNow() %>
                                </small>
                            </td>
                            <td>
                                <% if (fee.academicYear && fee.term) { %>
                                    <span class="text-muted">
                                        <%= fee.academicYear %>
                                        <br>
                                        <small><%= fee.term %></small>
                                    </span>
                                <% } else { %>
                                    <span class="text-muted">Not specified</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge <%= 
                                    fee.status === 'paid' ? 'bg-success' : 
                                    fee.status === 'pending' ? 'bg-warning' : 
                                    fee.status === 'partial' ? 'bg-warning' :
                                    fee.status === 'overpaid' ? 'bg-info' : 
                                    'bg-danger' %>">
                                    <%= fee.status.charAt(0).toUpperCase() + fee.status.slice(1) %>
                                </span>
                                <% if (fee.status === 'partial') { %>
                                    <br>
                                    <small class="text-muted">
                                        ₦<%= (fee.billAmount - fee.amountPaid).toLocaleString('en-NG') %> due
                                    </small>
                                <% } else if (fee.status === 'overpaid') { %>
                                    <br>
                                    <small class="text-muted">
                                        +₦<%= (fee.amountPaid - fee.billAmount).toLocaleString('en-NG') %> credit
                                    </small>
                                <% } %>
                            </td>
                            <td>
                                <div class="d-flex">
                                    <a href="/fee-receipt/<%= fee.id %>" class="action-icon text-info me-2" title="View Receipt" data-bs-toggle="tooltip">
                                        <i class="mdi mdi-receipt"></i>
                                    </a>
                                    <a href="/edit-fee/<%= fee.id %>" class="action-icon text-primary me-2" title="Edit" data-bs-toggle="tooltip">
                                        <i class="mdi mdi-square-edit-outline"></i>
                                    </a>
                                    <a href="/delete-fee/<%= fee.id %>" class="action-icon text-danger" title="Delete" data-bs-toggle="tooltip"
                                       onclick="return confirm('Are you sure you want to delete this fee record?')">
                                        <i class="mdi mdi-delete"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="11" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="mdi mdi-cash-remove display-4"></i>
                                    <h5 class="mt-3">No fee records found</h5>
                                    <p>Try adjusting your filters or add new fee records</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
<% if (fees.length > 0) { %>
<div class="row mt-3">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted">
                    <% if (typeof totalCount !== 'undefined') { %>
                        Showing <%= ((currentPage - 1) * limit) + 1 %> to <%= Math.min(currentPage * limit, totalCount) %> of <%= totalCount %> records
                    <% } else { %>
                        Showing <%= fees.length %> record(s)
                    <% } %>
                </span>
            </div>
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav>
                <ul class="pagination pagination-rounded mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= generatePaginationLink(1) %>" aria-label="First">
                            <span aria-hidden="true">&laquo;&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= generatePaginationLink(currentPage - 1) %>" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    
                    <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="<%= generatePaginationLink(i) %>"><%= i %></a>
                        </li>
                    <% } %>
                    
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= generatePaginationLink(currentPage + 1) %>" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= generatePaginationLink(totalPages) %>" aria-label="Last">
                            <span aria-hidden="true">&raquo;&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <% } %>
        </div>
    </div>
</div>
<% } %>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize tooltips
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });

    // Filter form submission
    document.getElementById('filterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        applyFilters();
    });

    // Auto-apply filters when dropdowns change
    const filterSelects = document.querySelectorAll('#filterAcademicYear, #filterTerm, #filterClass, #filterStatus, #filterFeeType');
    filterSelects.forEach(select => {
        select.addEventListener('change', function() {
            applyFilters();
        });
    });
});

function applyFilters() {
    const form = document.getElementById('filterForm');
    const formData = new FormData(form);
    const params = new URLSearchParams();
    
    for (const [key, value] of formData.entries()) {
        if (value) {
            params.append(key, value);
        }
    }
    
    window.location.href = '/fees-collection?' + params.toString();
}

function resetFilters() {
    window.location.href = '/fees-collection';
}

function exportToExcel() {
    // Simple Excel export implementation
    const table = document.getElementById('fees-datatable');
    let csv = [];
    
    // Get headers
    const headers = [];
    for (let i = 0; i < table.rows[0].cells.length - 1; i++) { // Skip actions column
        headers.push(table.rows[0].cells[i].textContent.trim());
    }
    csv.push(headers.join(','));

    // Add this function to generate pagination links
function generatePaginationLink(page) {
    const url = new URL(window.location.href);
    url.searchParams.set('page', page);
    return url.toString();
}
    
    // Get data
    for (let i = 1; i < table.rows.length; i++) {
        const row = [];
        const cells = table.rows[i].cells;
        
        for (let j = 0; j < cells.length - 1; j++) { // Skip actions column
            let text = cells[j].textContent.trim();
            // Remove extra spaces and newlines
            text = text.replace(/\s+/g, ' ').replace(/,/g, ';');
            row.push(`"${text}"`);
        }
        
        csv.push(row.join(','));
    }
    
    // Download CSV
    const csvString = csv.join('\n');
    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    
    link.setAttribute('href', url);
    link.setAttribute('download', `fee-collection-${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}
</script>                        <!-- end row -->
                        
