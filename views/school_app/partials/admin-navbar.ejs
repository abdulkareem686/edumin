<%
    var activeRole = (typeof role !== 'undefined' && role)
                  || (typeof userRole !== 'undefined' && userRole)
                  || (typeof session !== 'undefined' && session && session.role)
                  || '';

    if (activeRole === 'teacher') {
%>
<%- include('teacher-navbar') %>
<% } else if (activeRole === 'parent') { %>
<%- include('parent-navbar') %>
<% } else { %>

<!-- Topbar -->
<div class="navbar-custom">
    <div class="d-flex align-items-center gap-2 flex-grow-1">
        <button class="button-menu-mobile open-left" type="button" aria-label="Toggle navigation">
            <i class="mdi mdi-menu"></i>
        </button>

        <div class="app-search d-none d-lg-block">
            <form role="search" onsubmit="return false;">
                <div class="input-group">
                    <span class="mdi mdi-magnify search-icon"></span>
                    <input type="search" class="form-control" placeholder="Search students, staff, records…" id="top-search" aria-label="Search">
                </div>
            </form>
        </div>
    </div>

    <ul class="list-unstyled topbar-menu float-end mb-0">
        <!-- ═ Notifications ═ -->
        <li class="dropdown notification-list">
            <a class="nav-link dropdown-toggle arrow-none" data-bs-toggle="dropdown" href="#" role="button"
               aria-haspopup="true" aria-expanded="false" aria-label="Notifications">
                <i class="dripicons-bell noti-icon"></i>
                <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                    <span class="noti-icon-badge"><%= unreadCount %></span>
                <% } %>
            </a>

            <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated dropdown-lg">
                <div class="dropdown-item noti-title">
                    <h5 class="m-0 d-flex align-items-center justify-content-between">
                        <span>
                            Notifications
                            <span class="text-muted fw-normal">(<span id="notificationCount"><%= typeof totalCount !== 'undefined' ? totalCount : 0 %></span>)</span>
                        </span>
                        <a href="javascript: void(0);" class="text-primary small fw-semibold"
                           onclick="if (typeof markAllRead === 'function') markAllRead();">
                            Mark all read
                        </a>
                    </h5>
                </div>

                <div style="max-height: 320px; overflow-y: auto;" id="notificationList">
                    <% if (typeof notifications !== 'undefined' && notifications && notifications.length > 0) {
                        for (var i = 0; i < Math.min(notifications.length, 10); i++) {
                            var notification = notifications[i]; %>
                            <a href="javascript:void(0);"
                               class="dropdown-item notify-item notification-item <%= !notification.is_read ? 'notification-unread' : '' %>"
                               data-id="<%= notification.id %>"
                               onclick="if (typeof markRead === 'function') markRead(<%= notification.id %>);">
                                <p class="notify-details mb-0"><%= notification.message %></p>
                                <p class="text-muted mb-0">
                                    <small><i class="mdi mdi-clock-outline me-1"></i><%= notification.formatted_date || '' %></small>
                                </p>
                            </a>
                        <% } if (notifications.length > 10) { %>
                            <div class="text-center py-2">
                                <small class="text-muted">+ <%= notifications.length - 10 %> more notifications</small>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="text-center text-muted py-4">
                            <i class="mdi mdi-bell-off-outline fs-2 d-block mb-2 opacity-50"></i>
                            <p class="mb-0 small">No notifications</p>
                        </div>
                    <% } %>
                </div>

                <a href="/admin/notifications" class="dropdown-item text-center text-primary notify-item notify-all">
                    View all notifications <i class="mdi mdi-arrow-right ms-1"></i>
                </a>
            </div>
        </li>

        <!-- ═ User menu ═ -->
        <li class="dropdown notification-list">
            <a class="nav-link dropdown-toggle nav-user arrow-none me-0" data-bs-toggle="dropdown" href="#"
               role="button" aria-haspopup="true" aria-expanded="false">
                <span class="account-user-avatar">
                    <img src="/assets/images/users/avatar-1.jpg" alt=""
                         class="rounded-circle" width="38" height="38">
                </span>
                <span class="account-user-meta d-none d-sm-inline-flex flex-column text-start lh-sm">
                    <span class="account-user-name">
                        <%= typeof username !== 'undefined' && username ? username : 'Admin' %>
                    </span>
                    <span class="account-position">
                        <i class="mdi mdi-shield-account"></i> Administrator
                    </span>
                </span>
                <i class="mdi mdi-chevron-down d-none d-sm-inline-block ms-1 text-muted"></i>
            </a>

            <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated topbar-dropdown-menu profile-dropdown">
                <div class="dropdown-header noti-title">
                    <h6 class="text-overflow m-0">Signed in as</h6>
                    <div class="fw-bold small"><%= typeof username !== 'undefined' && username ? username : 'Admin' %></div>
                </div>
                <a href="/admin/profile" class="dropdown-item notify-item">
                    <i class="mdi mdi-account-circle-outline me-2"></i><span>My profile</span>
                </a>
                <div class="dropdown-divider"></div>
                <a href="/logout" class="dropdown-item notify-item">
                    <i class="mdi mdi-logout me-2"></i><span>Sign out</span>
                </a>
            </div>
        </li>
    </ul>
</div>
<!-- end Topbar -->
<% } %>
