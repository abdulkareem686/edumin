    <script>
        // Add date validation to ensure term dates are within academic year
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('start_date');
            const endDate = document.getElementById('end_date');
            
            const termStartDates = [
                document.getElementById('first_term_start'),
                document.getElementById('second_term_start'),
                document.getElementById('third_term_start')
            ];
            
            const termEndDates = [
                document.getElementById('first_term_end'),
                document.getElementById('second_term_end'),
                document.getElementById('third_term_end')
            ];
            
            function validateTermDates() {
                const academicStart = new Date(startDate.value);
                const academicEnd = new Date(endDate.value);
                
                if (!startDate.value || !endDate.value) return;
                
                for (let i = 0; i < termStartDates.length; i++) {
                    const termStart = new Date(termStartDates[i].value);
                    const termEnd = new Date(termEndDates[i].value);
                    
                    if (termStartDates[i].value && termStart < academicStart) {
                        termStartDates[i].setCustomValidity('Term start date cannot be before academic year start date');
                    } else {
                        termStartDates[i].setCustomValidity('');
                    }
                    
                    if (termEndDates[i].value && termEnd > academicEnd) {
                        termEndDates[i].setCustomValidity('Term end date cannot be after academic year end date');
                    } else {
                        termEndDates[i].setCustomValidity('');
                    }
                }
            }
            
            startDate.addEventListener('change', validateTermDates);
            endDate.addEventListener('change', validateTermDates);
            
            termStartDates.forEach(input => input.addEventListener('change', validateTermDates));
            termEndDates.forEach(input => input.addEventListener('change', validateTermDates));
        });
    </script>
