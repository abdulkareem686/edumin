        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Academic Year Information</h6>
            </div>
            <div class="card-body">
                <form method="POST" action="/add-academic-year">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="year_name" class="form-label">Academic Year Name *</label>
                                <input type="text" class="form-control" id="year_name" name="year_name" 
                                       value="<%= formData.year_name %>" required 
                                       placeholder="e.g., 2023/2024">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Status</label>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="is_current" name="is_current"
                                           <%= formData.is_current ? 'checked' : '' %>>
                                    <label class="form-check-label" for="is_current">
                                        Set as current academic year
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="start_date" class="form-label">Start Date *</label>
                                <input type="date" class="form-control" id="start_date" name="start_date" 
                                       value="<%= formData.start_date %>" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="end_date" class="form-label">End Date *</label>
                                <input type="date" class="form-control" id="end_date" name="end_date" 
                                       value="<%= formData.end_date %>">
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- First Term -->
                    <div class="card term-card mb-4">
                        <div class="card-header">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-calendar-alt me-2"></i>First Term
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="first_term_start" class="form-label">Start Date *</label>
                                        <input type="date" class="form-control" id="first_term_start" name="first_term_start" 
                                               value="<%= formData.first_term_start %>" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="first_term_end" class="form-label">End Date *</label>
                                        <input type="date" class="form-control" id="first_term_end" name="first_term_end" 
                                               value="<%= formData.first_term_end %>">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Second Term -->
                    <div class="card term-card mb-4">
                        <div class="card-header">
                            <h6 class="m-0 font-weight-bold text-primary">
                                <i class="fas fa-calendar-alt me-2"></i>Second Term
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="second_term_start" class="form-label">Start Date *</label>
                                        <input type="date" class="form-control" id="second_term_start" name="second_term_start" 
                                               value="<%= formData.second_term_start %>">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="second_term_end" class="form-label">End Date *</label>
                                        <input type="date" class="form-control" id="second_term_end" name="second_term_end" 
                                               value="<%= formData.second_term_end %>">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Third Term -->
                    <div class="card term-card mb-4">
                        <div class="card-header">
