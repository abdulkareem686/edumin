                            <div class="flex-grow-1">
                                <h5>Staff</h5>
                                <h3><%= summary.total_staff || 0 %></h3>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h5>Total Paid (<%= currentMonth %>)</h5>
                                <h3>₦<%= (summary.total_paid || 0).toLocaleString() %></h3>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <a href="/process-salaries" class="btn btn-primary w-100 quick-action-btn">
                                    <i class="bi bi-calculator me-2"></i>Process Salaries
                                </a>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <a href="/salary-payments" class="btn btn-success w-100 quick-action-btn">
                                    <i class="bi bi-list-check me-2"></i>View Payments
                                </a>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <a href="/salary-structures" class="btn btn-info w-100 quick-action-btn">
                                    <i class="bi bi-gear me-2"></i>Salary Structures
                                </a>
                            </div>
                            
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <a href="/salary-adjustments" class="btn btn-secondary w-100 quick-action-btn">
                                    <i class="bi bi-sliders me-2"></i>Adjustments
                                </a>
                            </div>
                            <div class="col-xl-2 col-md-4 col-sm-6">
                                <button onclick="triggerAutoProcessing()" class="btn btn-danger w-100 quick-action-btn">
                                    <i class="bi bi-lightning me-2"></i>Auto Process
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Payments -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Recent Salary Payments</h5>
                    </div>
                    <div class="card-body">
                        <% if (recentPayments && recentPayments.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover table-centered">
                                    <thead>
                                        <tr>
                                            <th>Employee</th>
                                            <th>Position</th>
                                            <th>Month</th>
                                            <th>Net Salary</th>
                                            <th>Status</th>
                                            <th>Payment Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% recentPayments.forEach(payment => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="/assets/images/users/avatar-1.jpg" alt="user-image" class="rounded-circle" width="32" height="32">
                                                    <div class="ms-2">
                                                        <%= payment.first_name %> <%= payment.last_name %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= payment.position %></td>
                                            <td><span class="badge bg-light text-dark"><%= payment.month %></span></td>
                                            <td><strong class="text-success">₦<%= payment.net_salary.toLocaleString() %></strong></td>
                                            <td>
                                                <span class="badge bg-<%= payment.status === 'paid' ? 'success' : payment.status === 'pending' ? 'warning' : 'danger' %> status-badge">
                                                    <i class="bi bi-<%= payment.status === 'paid' ? 'check-circle' : payment.status === 'pending' ? 'clock' : 'x-circle' %> me-1"></i>
                                                    <%= payment.status %>
                                                </span>
                                            </td>
                                            <td><%= payment.payment_date ? moment(payment.payment_date).format('MMM D, YYYY') : '-' %></td>
                                            <td>
                                                <a href="/salary-slip/<%= payment.id %>" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-cash-coin"></i>
                                <h5 class="text-muted">No salary payments found</h5>
                                <p class="text-muted mb-4">Start processing salaries to see payment records</p>
                                <a href="/process-salaries" class="btn btn-primary">
                                    <i class="bi bi-calculator me-1"></i>Process Salaries
                                </a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Summary -->
        <div class="row mt-4">
            <div class="col-md-6">
                <div class="summary-card">
                    <h5>Payment Status - <%= currentMonth %></h5>
                    <div class="summary-stats">
                        <div class="summary-stat">
                            <h3><%= summary.paid_count || 0 %></h3>
                            <p>Paid</p>
                        </div>
                        <div class="summary-stat">
                            <h3><%= summary.pending_count || 0 %></h3>
                            <p>Pending</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Quick Stats</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3 p-2 border-bottom">
                            <span>Total Employees:</span>
                            <strong><%= summary.total_employees || 0 %></strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 p-2 border-bottom">
                            <span>Total Paid This Month:</span>
                            <strong class="text-success">₦<%= (summary.total_paid || 0).toLocaleString() %></strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center p-2">
                            <span>Average Salary:</span>
                            <strong>₦<%= (summary.total_paid / (summary.paid_count || 1)).toLocaleString() %></strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function triggerAutoProcessing() {
            if (!confirm('Are you sure you want to trigger automatic salary processing?')) {
                return;
            }

            try {
                const response = await fetch('/trigger-salary-processing', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const result = await response.json();
                
                if (result.success) {
                    alert('Salary processing triggered successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (error) {
                alert('Failed to trigger salary processing');
                console.error('Error:', error);
            }
        }
    </script>
